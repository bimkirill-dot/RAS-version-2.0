<Window x:Class="RASv2.ModelHistory.UI.SortWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RASv2.ModelHistory.UI"
        Title="RAS-Model History — сортировка и группировка"
        Width="560" SizeToContent="Height" MinWidth="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        FontSize="12" Background="{DynamicResource Spy.Bg}" Foreground="{DynamicResource Spy.Text}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <local:ThemeResources />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel Margin="14,12,14,12">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="Сбросить" Width="100" Height="26" Command="{Binding ResetCommand}"
                    ToolTip="По времени, новые сверху, без заголовков; операции — одной строкой" />
            <Button DockPanel.Dock="Right" Content="Отмена" Width="100" Height="26" Margin="8,0,0,0" IsCancel="True"
                    Command="{Binding CancelCommand}" />
            <Button DockPanel.Dock="Right" Content="OK" Width="100" Height="26" IsDefault="True" Command="{Binding OkCommand}" />
        </DockPanel>

        <StackPanel>
            <ItemsControl ItemsSource="{Binding Levels}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource Spy.Line}" BorderThickness="0,0,0,1" Padding="0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Caption}" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" Height="24" ItemsSource="{Binding Fields}" DisplayMemberPath="Label"
                                          SelectedItem="{Binding Field}" />
                                <RadioButton Grid.Column="2" Margin="14,0,0,0" Content="По возрастанию" GroupName="{Binding GroupName}"
                                             IsChecked="{Binding Ascending}" IsEnabled="{Binding HasField}" />
                                <RadioButton Grid.Column="3" Margin="12,0,0,0" Content="По убыванию" GroupName="{Binding GroupName}"
                                             IsChecked="{Binding Descending}" IsEnabled="{Binding HasField}" />
                                <CheckBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,6,0,0" Content="Заголовок"
                                          IsChecked="{Binding Header}" IsEnabled="{Binding HasField}"
                                          ToolTip="Строка над каждой группой одинаковых значений, например «Автор: Иванов (124)». Группу можно свернуть." />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <CheckBox Margin="0,12,0,0" Content="Записи одной операции Revit — одной строкой" IsChecked="{Binding GroupByOperation}"
                      ToolTip="Например, «Перемещение · 12 элементов»; строка раскрывается значком ▸, двойным щелчком или клавишей →" />
            <TextBlock Margin="20,4,0,0" Style="{StaticResource Spy.MutedText}" FontSize="11"
                       Text="Щелчок по заголовку столбца таблицы делает этот столбец первым уровнем сортировки (повторный щелчок — обратный порядок)." />
        </StackPanel>
    </DockPanel>
</Window>
