<Window x:Class="RASv2.ClashAnalysis.UI.ExportTasksWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RASv2.ClashAnalysis.UI"
        Title="Задачи выгрузки" Width="1500" Height="860" MinWidth="880" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}" FontFamily="Segoe UI" FontSize="13">
    <!-- «Задачи выгрузки» (DECISIONS.md модуля, «Дерево задач с наследованием (03.11.2026)», «Боковая панель (03.11.2026)»): слева —
         дерево (задача — серым фоном, под ней подзадачи любой глубины), справа — настройки выбранной строки (ExportTaskPanel), а
         не отдельным окном (разработчик: «чтобы настройки задач и подзадач открывались в боковой панели»); граница двигается.
         Раскладка дерева — по рисунку разработчика (30.10.2026); номер, название и сводка — текстом, без рамок полей. Кнопки,
         кисти — общие образцы ядра (подключаются до разметки); ключи своих стилей не совпадают с кистями ядра. -->
    <Window.Resources>
        <!-- строка — спокойно, как в остальных окнах плагина (разработчик, 03.11.2026: «синие строки — слишком жёстко»): задача —
             серым фоном строки, подзадача — без фона, под мышью — фон наведения, выбранная — фон наведения и рамка акцентом.
             Толщина рамки и отступы не меняются — строки не прыгают -->
        <Style x:Key="TaskRowBox" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="6,4,8,4" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Fg}" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsTop}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Row}" />
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Hover}" />
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Hover}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- ячейка таблицы: «—» и значение от строки выше — бледно -->
        <Style x:Key="Cell" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>
        <!-- ячейка, по которой щёлкают (форматы): как текст, без рамки и фона -->
        <Style x:Key="CellButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ColHead" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>
        <Style x:Key="RowIcon" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="Height" Value="24" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
        <!-- статус: зелёная галочка — выгружено без ошибок, красный треугольник — с ошибками, жёлтый — модель изменилась после
             выгрузки, серый «?» — Revit Server дату не сообщил (разработчик, 07.11.2026) -->
        <SolidColorBrush x:Key="MarkOk" Color="#2E9E55" />
        <SolidColorBrush x:Key="MarkChanged" Color="#E0A100" />
        <Style x:Key="Mark" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- кнопки строки — у строки под мышью, у выбранной и у выгружаемой (■), поверх конца текста; высота строки не меняется -->
        <Style x:Key="RowActions" TargetType="StackPanel">
            <Setter Property="Opacity" Value="0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsTarget}" Value="True">
                    <Setter Property="Opacity" Value="1" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
                    <Setter Property="Opacity" Value="1" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Opacity" Value="1" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- пределы ширины дерева и панели в сумме меньше окна наименьшей ширины — иначе панель уходит за край -->
            <!-- дерево шире панели: было 1,2 : 1 по снимку разработчика (04.11.2026); с выключателями, статусом, запуском и временем
                 (07.11.2026) — 1,7 : 1, иначе названия не помещаются (панели и так хватает: 80 % экрана) -->
            <ColumnDefinition Width="1.7*" MinWidth="260" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" MinWidth="480" />
        </Grid.ColumnDefinitions>

        <!-- ══ дерево ══ -->
        <!-- ширина таблицы не раздвигает окно: дерево — своя доля, длинное — многоточием (на 880 панель уходила за край) -->
        <local:NoWidthDecorator>
        <DockPanel Margin="20,14,14,16">
            <!-- сервер недоступен или файл проекта не прочитан — строкой сверху -->
            <TextBlock x:Name="Banner" DockPanel.Dock="Top" Foreground="{DynamicResource Error}" TextWrapping="Wrap" Margin="0,0,0,8"
                       Visibility="Collapsed" />
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                <StackPanel x:Name="Toolbar" DockPanel.Dock="Right" Orientation="Horizontal">
                    <!-- импорт задачи из файла коллеги (02.11.2026); Segoe MDL2: E8B5 — импорт -->
                    <Button Style="{StaticResource IconButton}" Content="&#xE8B5;" Click="Import_Click" ToolTip="Импорт задачи…" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE710;" Margin="4,0,0,0" Click="AddTop_Click" ToolTip="Новая задача" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE713;" Margin="4,0,0,0" Click="Settings_Click"
                            ToolTip="Общие настройки" />
                </StackPanel>
                <TextBlock Text="Задачи" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
            <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource Line}" Margin="0,0,0,6" />

            <!-- шапка таблицы (разработчик, 05.11.2026: «список — таблицей»): столбцы — как у строк; справа — место полосы прокрутки.
                 Выключатели NWC / NWF / Отчёты / Форматы — по наброску, принятому 07.11.2026 («давай попробуем»); «Подзадачи» убраны
                 (видно по дереву) -->
            <Border x:Name="TableHead" DockPanel.Dock="Top" BorderThickness="1" BorderBrush="Transparent" Padding="6,0,8,4" Margin="0,0,4,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.6*" />
                        <ColumnDefinition Width="58" />
                        <ColumnDefinition Width="{Binding Tests}" />
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="58" />
                        <ColumnDefinition Width="{Binding Formats}" />
                        <ColumnDefinition Width="116" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="{Binding Time}" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource ColHead}" Text="Название" Margin="58,0,10,0" />
                    <TextBlock Grid.Column="1" Style="{StaticResource ColHead}" Text="Модели" />
                    <TextBlock Grid.Column="2" Style="{StaticResource ColHead}" Text="Проверки" Visibility="{Binding WideVisibility}" />
                    <TextBlock Grid.Column="3" Style="{StaticResource ColHead}" Text="NWC" ToolTip="Выгружать NWC" />
                    <TextBlock Grid.Column="4" Style="{StaticResource ColHead}" Text="NWF" ToolTip="Формировать NWF" />
                    <TextBlock Grid.Column="5" Style="{StaticResource ColHead}" Text="Отчёты" ToolTip="Формировать отчёты" />
                    <TextBlock Grid.Column="6" Style="{StaticResource ColHead}" Text="Форматы" Visibility="{Binding WideVisibility}" />
                    <TextBlock Grid.Column="7" Style="{StaticResource ColHead}" Text="Статус" />
                    <TextBlock Grid.Column="8" Style="{StaticResource ColHead}" Text="Запуск" ToolTip="Когда строку выгружали последний раз" />
                    <TextBlock Grid.Column="9" Style="{StaticResource ColHead}" Text="Время" Visibility="{Binding TimeVisibility}"
                               ToolTip="Сколько займёт — по прошлым выгрузкам; во время выгрузки — сколько идёт" />
                </Grid>
            </Border>

            <ScrollViewer x:Name="TreeScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          ScrollChanged="TreeScroll_ScrollChanged">
                <ItemsControl x:Name="RowsList" Margin="0,0,4,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- щелчок по строке — её настройки справа; перетаскивание — перенос внутри уровня -->
                            <Border Style="{StaticResource TaskRowBox}" Margin="{Binding RowMargin}" AllowDrop="True"
                                    PreviewMouseLeftButtonDown="Row_MouseDown" MouseMove="Row_MouseMove"
                                    DragOver="Row_DragOver" Drop="Row_Drop">
                                <Grid>
                                    <!-- столбцы — как у шапки; отступ уровня — внутри «Названия», остальные столбцы ровно друг под другом;
                                         кнопки строки — поверх правого края, только когда видны (место не держат) -->
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2.6*" />
                                        <ColumnDefinition Width="58" />
                                        <ColumnDefinition Width="{Binding Layout.Tests}" />
                                        <ColumnDefinition Width="44" />
                                        <ColumnDefinition Width="44" />
                                        <ColumnDefinition Width="58" />
                                        <ColumnDefinition Width="{Binding Layout.Formats}" />
                                        <ColumnDefinition Width="116" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="{Binding Layout.Time}" />
                                    </Grid.ColumnDefinitions>
                                    <DockPanel Margin="{Binding Indent}" VerticalAlignment="Center">
                                        <Button Style="{StaticResource RowIcon}" Width="22" Margin="0" FontSize="10" Foreground="{DynamicResource Muted}"
                                                Content="{Binding Arrow}" Visibility="{Binding ArrowVisibility}" Click="Toggle_Click" />
                                        <TextBlock Text="{Binding Number}" Foreground="{DynamicResource Muted}" FontSize="12"
                                                   MinWidth="28" Margin="2,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Name}" FontSize="{Binding NameSize}" FontWeight="{Binding NameWeight}" ToolTip="{Binding Name}"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    </DockPanel>
                                    <TextBlock Grid.Column="1" Style="{StaticResource Cell}" Text="{Binding ModelsText}" Foreground="{Binding ModelsBrush}"
                                               ToolTip="{Binding ModelsTip}" />
                                    <TextBlock Grid.Column="2" Style="{StaticResource Cell}" Text="{Binding TestsText}" Foreground="{Binding TestsBrush}"
                                               ToolTip="{Binding TestsTip}" Visibility="{Binding Layout.WideVisibility}" />
                                    <!-- выключатели: у строки с подзадачами — сразу у всех ниже, «■» — у подзадач по-разному -->
                                    <CheckBox Grid.Column="3" HorizontalAlignment="Left" Tag="Nwc" IsChecked="{Binding Columns.NwcState, Mode=OneWay}"
                                              IsEnabled="{Binding Idle}" Click="Flag_Click" ToolTip="Выгружать NWC" />
                                    <!-- имя NWF — в подсказке: обычно это название строки, а столбец с именем не оставлял места названиям -->
                                    <CheckBox Grid.Column="4" HorizontalAlignment="Left" Tag="Nwf" IsChecked="{Binding Columns.NwfState, Mode=OneWay}"
                                              IsEnabled="{Binding Idle}" Click="Flag_Click" ToolTip="{Binding NwfTip}" />
                                    <CheckBox Grid.Column="5" HorizontalAlignment="Left" Tag="Reports" IsChecked="{Binding Columns.ReportsState, Mode=OneWay}"
                                              IsEnabled="{Binding ReportsOn}" Click="Flag_Click" ToolTip="Формировать отчёты" />
                                    <!-- форматы — список с галочками; от строки выше — бледно и «↑» -->
                                    <Button Grid.Column="6" Style="{StaticResource CellButton}" Click="Formats_Click" Visibility="{Binding Layout.WideVisibility}"
                                            IsEnabled="{Binding Idle}" ToolTip="{Binding FormatsTip}">
                                        <DockPanel Margin="0,0,10,0">
                                            <TextBlock DockPanel.Dock="Right" FontFamily="Segoe MDL2 Assets" FontSize="9" Text="&#xE70D;" Margin="4,1,0,0"
                                                       VerticalAlignment="Center" Foreground="{DynamicResource Muted}" />
                                            <TextBlock Style="{StaticResource Cell}" Margin="0" Text="{Binding FormatsText}" Foreground="{Binding FormatsBrush}" />
                                        </DockPanel>
                                    </Button>
                                    <!-- статус: идёт выгрузка — текстом; иначе — значки (щелчок — журнал запуска) и «Повторить» у ошибок -->
                                    <Grid Grid.Column="7" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource Cell}" Text="{Binding LiveText}" Foreground="{Binding LiveBrush}"
                                                   Visibility="{Binding LiveVisibility}" />
                                        <StackPanel Orientation="Horizontal" Visibility="{Binding MarksVisibility}">
                                            <Button Style="{StaticResource CellButton}" HorizontalAlignment="Left" Click="Status_Click"
                                                    ToolTip="{Binding StatusTip}" ToolTipService.ShowDuration="60000">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource Mark}" Text="&#xE73E;" Foreground="{StaticResource MarkOk}"
                                                               Visibility="{Binding OkVisibility}" />
                                                    <TextBlock Style="{StaticResource Mark}" Text="&#xE7BA;" Foreground="{DynamicResource Error}"
                                                               Visibility="{Binding ErrorVisibility}" />
                                                    <TextBlock Style="{StaticResource Mark}" Text="&#xE7BA;" Foreground="{StaticResource MarkChanged}"
                                                               Visibility="{Binding ChangedVisibility}" />
                                                    <TextBlock Style="{StaticResource Mark}" Text="?" FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="14"
                                                               Foreground="{DynamicResource Muted}" Visibility="{Binding UnknownVisibility}" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource LinkButton}" FontSize="12" VerticalAlignment="Center" Content="Повторить"
                                                    Click="Retry_Click" Visibility="{Binding RetryVisibility}"
                                                    ToolTip="Выгрузить заново только NWC и NWF с ошибками" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Grid.Column="8" Style="{StaticResource Cell}" Text="{Binding RunAt}" ToolTip="{Binding RunAtTip}" />
                                    <TextBlock Grid.Column="9" Style="{StaticResource Cell}" Text="{Binding TimeText}" Foreground="{Binding TimeBrush}"
                                               ToolTip="{Binding TimeTip}" Visibility="{Binding Layout.TimeVisibility}" />
                                    <!-- фон — как у строки под мышью и выбранной: кнопки видны только у них -->
                                    <StackPanel Grid.ColumnSpan="10" HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center"
                                                Style="{StaticResource RowActions}" Background="{DynamicResource Hover}">
                                        <!-- ▷ — выгрузить (идёт другая — в очередь), у выгружаемой — ✕ «Остановить»; Segoe MDL2: E768, E711 -->
                                        <Button Click="Run_Click" ToolTip="{Binding RunTip}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource RowIcon}">
                                                    <Setter Property="Content" Value="&#xE768;" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsTarget}" Value="True">
                                                            <Setter Property="Content" Value="&#xE711;" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Style="{StaticResource RowIcon}" Content="&#xE710;" Click="AddSub_Click" ToolTip="Новая подзадача"
                                                Visibility="{Binding EditVisibility}" />
                                        <!-- копия подзадачи (вторая критичность — копия первой) -->
                                        <Button Style="{StaticResource RowIcon}" Content="&#xE8C8;" Click="Copy_Click" ToolTip="Копия"
                                                Visibility="{Binding CopyVisibility}" />
                                        <Button Style="{StaticResource RowIcon}" Content="&#xE74D;" Click="Delete_Click" ToolTip="Удалить"
                                                Visibility="{Binding EditVisibility}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
        </local:NoWidthDecorator>

        <!-- граница — двигается мышью -->
        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent"
                      ResizeBehavior="PreviousAndNext" Cursor="SizeWE" />
        <Border Grid.Column="1" Width="1" Background="{DynamicResource Line}" IsHitTestVisible="False" />

        <!-- ══ настройки выбранной строки ══ -->
        <ContentControl x:Name="Side" Grid.Column="2" Focusable="False">
            <TextBlock x:Name="SideEmpty" Text="Выберите задачу слева" Foreground="{DynamicResource Muted}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
        </ContentControl>
    </Grid>
</Window>
