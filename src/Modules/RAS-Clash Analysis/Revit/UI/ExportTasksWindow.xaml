<Window x:Class="RASv2.ClashAnalysis.UI.ExportTasksWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Задачи выгрузки" Width="1040" Height="600" MinWidth="760" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}" FontFamily="Segoe UI" FontSize="13">
    <!-- «Задачи выгрузки» (DECISIONS.md модуля): проект синей строкой, его задачи серыми с отступом. Раскладка — по рисунку
         разработчика (30.10.2026), с «Запустить» и «+» в строке; номер, название и сводка — текстом, без рамок полей (разбор
         02.11.2026: рамки звали нажать и править). Кнопки, кисти — общие образцы ядра (подключаются до разметки); ключи своих
         стилей не совпадают с кистями ядра. -->
    <Window.Resources>
        <!-- строка: у задачи — акцент, у подзадачи — фон строки; текст и значки берут цвет строки -->
        <Style x:Key="TaskRowBox" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Row}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,6" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Fg}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsTask}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Accent}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentFg}" />
                    <Setter Property="Padding" Value="6,10" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RowIcon" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Foreground"
                    Value="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource AncestorType=Border}}" />
            <Setter Property="Margin" Value="2,0,0,0" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="20,14,20,16">
        <!-- сервер недоступен или файл проекта не прочитан — строкой сверху -->
        <TextBlock x:Name="Banner" DockPanel.Dock="Top" Foreground="{DynamicResource Error}" TextWrapping="Wrap" Margin="0,0,0,8"
                   Visibility="Collapsed" />
        <StackPanel x:Name="Toolbar" DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,12">
            <!-- импорт проекта с задачами из файла коллеги (02.11.2026); Segoe MDL2: E8B5 — импорт -->
            <Button Style="{StaticResource IconButton}" Content="&#xE8B5;" Click="Import_Click" ToolTip="Импорт проекта…" />
            <Button Style="{StaticResource IconButton}" Content="&#xE710;" Margin="4,0,0,0" Click="AddTask_Click" ToolTip="Новый проект" />
            <Button Style="{StaticResource IconButton}" Content="&#xE713;" Margin="4,0,0,0" Click="Settings_Click"
                    ToolTip="Общие настройки" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="RowsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource TaskRowBox}" Margin="{Binding Indent}" AllowDrop="True"
                                PreviewMouseLeftButtonDown="Row_MouseDown" MouseMove="Row_MouseMove"
                                DragOver="Row_DragOver" Drop="Row_Drop">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="48" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Style="{StaticResource RowIcon}" Width="26" Margin="0" FontSize="12"
                                        Content="{Binding Arrow}" Visibility="{Binding ArrowVisibility}" Click="Toggle_Click" />
                                <TextBlock Grid.Column="1" Text="{Binding Number}" Opacity="0.75" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding Name}" FontSize="{Binding NameSize}" FontWeight="SemiBold" Margin="0,0,12,0"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Name}" />
                                <!-- сводка — бледнее названия, цвет строки (на синей строке — белым) -->
                                <TextBlock Grid.Column="3" Text="{Binding Summary}" Opacity="0.75" Margin="0,0,12,0"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Summary}" />
                                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource RowIcon}" Content="&#xE768;" Visibility="{Binding RunVisibility}"
                                            Click="Run_Click" ToolTip="Запустить" />
                                    <!-- задача (блок) — только у проекта: проект — каталог задач (02.11.2026), третьего уровня нет -->
                                    <Button Style="{StaticResource RowIcon}" Content="&#xE710;" Click="AddChild_Click" ToolTip="Задача"
                                            Visibility="{Binding AddChildVisibility}" />
                                    <Button Style="{StaticResource RowIcon}" Content="&#xE70F;" Click="Edit_Click" ToolTip="Изменить" />
                                    <Button Style="{StaticResource RowIcon}" Content="&#xE74D;" Click="Delete_Click" ToolTip="Удалить" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
