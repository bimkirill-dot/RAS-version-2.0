<Window x:Class="RASv2.ClashAnalysis.UI.ExportTasksWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Задачи выгрузки" Width="1040" Height="600" MinWidth="760" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}" FontFamily="Segoe UI" FontSize="13">
    <!-- «Задачи выгрузки» (DECISIONS.md модуля): дерево задач — задача (проект) синей строкой, подзадачи серыми с отступом.
         Раскладка — по рисунку разработчика (30.10.2026), с добавленными «Запустить» и «+» в строке. Кнопки, кисти — общие
         образцы ядра (подключаются до разметки); ключи своих стилей не совпадают с кистями ядра. -->
    <Window.Resources>
        <!-- строка: у задачи — акцент, у подзадачи — фон строки; текст и значки берут цвет строки -->
        <Style x:Key="TaskRowBox" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Row}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,6" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Fg}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsTask}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Accent}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentFg}" />
                    <Setter Property="Padding" Value="6,10" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RowIcon" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Foreground"
                    Value="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource AncestorType=Border}}" />
            <Setter Property="Margin" Value="2,0,0,0" />
        </Style>
        <Style x:Key="Cell" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Field}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Fg}" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="20,14,20,16">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,12">
            <Button Style="{StaticResource IconButton}" Content="&#xE710;" Click="AddTask_Click" ToolTip="Новая задача" />
            <Button Style="{StaticResource IconButton}" Content="&#xE713;" Margin="4,0,0,0" Click="Settings_Click"
                    ToolTip="Общие настройки" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="RowsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource TaskRowBox}" Margin="{Binding Indent}" AllowDrop="True"
                                PreviewMouseLeftButtonDown="Row_MouseDown" MouseMove="Row_MouseMove"
                                DragOver="Row_DragOver" Drop="Row_Drop">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Style="{StaticResource RowIcon}" Width="26" Margin="0" FontSize="12"
                                        Content="{Binding Arrow}" Visibility="{Binding ArrowVisibility}" Click="Toggle_Click" />
                                <Border Grid.Column="1" Style="{StaticResource Cell}">
                                    <TextBlock Text="{Binding Number}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource Cell}">
                                    <TextBlock Text="{Binding Name}" FontSize="{Binding NameSize}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Name}" />
                                </Border>
                                <Border Grid.Column="3" Style="{StaticResource Cell}">
                                    <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource Muted}"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Summary}" />
                                </Border>
                                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource RowIcon}" Content="&#xE768;" Visibility="{Binding RunVisibility}"
                                            Click="Run_Click" ToolTip="Запустить" />
                                    <Button Style="{StaticResource RowIcon}" Content="&#xE710;" Click="AddChild_Click" ToolTip="Подзадача" />
                                    <Button Style="{StaticResource RowIcon}" Content="&#xE70F;" Click="Edit_Click" ToolTip="Изменить" />
                                    <Button Style="{StaticResource RowIcon}" Content="&#xE74D;" Click="Delete_Click" ToolTip="Удалить" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
