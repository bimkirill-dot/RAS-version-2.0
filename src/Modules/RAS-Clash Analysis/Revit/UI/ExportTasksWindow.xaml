<Window x:Class="RASv2.ClashAnalysis.UI.ExportTasksWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Задачи выгрузки" Width="1500" Height="860" MinWidth="1100" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}" FontFamily="Segoe UI" FontSize="13">
    <!-- «Задачи выгрузки» (DECISIONS.md модуля, «Дерево задач с наследованием (03.11.2026)», «Боковая панель (03.11.2026)»): слева —
         дерево (задача синей строкой, под ней подзадачи любой глубины), справа — настройки выбранной строки (ExportTaskPanel), а
         не отдельным окном (разработчик: «чтобы настройки задач и подзадач открывались в боковой панели»); граница двигается.
         Раскладка дерева — по рисунку разработчика (30.10.2026); номер, название и сводка — текстом, без рамок полей. Кнопки,
         кисти — общие образцы ядра (подключаются до разметки); ключи своих стилей не совпадают с кистями ядра. -->
    <Window.Resources>
        <!-- строка: у задачи — акцент, у подзадачи — фон строки; выбранная — рамкой; текст и значки берут цвет строки -->
        <Style x:Key="TaskRowBox" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Row}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,6" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Fg}" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsTop}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Accent}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentFg}" />
                    <Setter Property="Padding" Value="6,10" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsSelected}" Value="True" />
                        <Condition Binding="{Binding IsTop}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource Hover}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                    <Setter Property="BorderThickness" Value="2" />
                    <Setter Property="Padding" Value="5,5" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsSelected}" Value="True" />
                        <Condition Binding="{Binding IsTop}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="BorderBrush" Value="{DynamicResource Fg}" />
                    <Setter Property="BorderThickness" Value="2" />
                    <Setter Property="Padding" Value="5,9" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RowIcon" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Foreground"
                    Value="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource AncestorType=Border}}" />
            <Setter Property="Margin" Value="2,0,0,0" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="440" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="1.5*" MinWidth="640" />
        </Grid.ColumnDefinitions>

        <!-- ══ дерево ══ -->
        <DockPanel Margin="20,14,16,16">
            <!-- сервер недоступен или файл проекта не прочитан — строкой сверху -->
            <TextBlock x:Name="Banner" DockPanel.Dock="Top" Foreground="{DynamicResource Error}" TextWrapping="Wrap" Margin="0,0,0,8"
                       Visibility="Collapsed" />
            <StackPanel x:Name="Toolbar" DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,12">
                <!-- импорт задачи из файла коллеги (02.11.2026); Segoe MDL2: E8B5 — импорт -->
                <Button Style="{StaticResource IconButton}" Content="&#xE8B5;" Click="Import_Click" ToolTip="Импорт задачи…" />
                <Button Style="{StaticResource IconButton}" Content="&#xE710;" Margin="4,0,0,0" Click="AddTop_Click" ToolTip="Новая задача" />
                <Button Style="{StaticResource IconButton}" Content="&#xE713;" Margin="4,0,0,0" Click="Settings_Click"
                        ToolTip="Общие настройки" />
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="RowsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- щелчок по строке — её настройки справа; перетаскивание — перенос внутри уровня -->
                            <Border Style="{StaticResource TaskRowBox}" Margin="{Binding Indent}" AllowDrop="True"
                                    PreviewMouseLeftButtonDown="Row_MouseDown" MouseMove="Row_MouseMove"
                                    DragOver="Row_DragOver" Drop="Row_Drop">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="44" />
                                        <!-- название — целиком (до 260), сводка — сразу за ним и обрезается -->
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button Style="{StaticResource RowIcon}" Width="26" Margin="0" FontSize="12"
                                            Content="{Binding Arrow}" Visibility="{Binding ArrowVisibility}" Click="Toggle_Click" />
                                    <TextBlock Grid.Column="1" Text="{Binding Number}" Opacity="0.75" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding Name}" FontSize="{Binding NameSize}" FontWeight="SemiBold"
                                               MaxWidth="260" Margin="0,0,12,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Name}" />
                                    <!-- сводка — бледнее названия, цвет строки (на синей строке — белым) -->
                                    <TextBlock Grid.Column="3" Text="{Binding Summary}" Opacity="0.75" Margin="0,0,8,0"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Summary}" />
                                    <!-- места кнопок остаются и у строки, где их нет, — значки строк стоят ровно -->
                                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource RowIcon}" Content="&#xE768;" Click="Run_Click" ToolTip="Запустить" />
                                        <Button Style="{StaticResource RowIcon}" Content="&#xE710;" Click="AddSub_Click" ToolTip="Новая подзадача" />
                                        <!-- копия подзадачи (вторая критичность — копия первой) -->
                                        <Button Style="{StaticResource RowIcon}" Content="&#xE8C8;" Click="Copy_Click" ToolTip="Копия"
                                                Visibility="{Binding CopyVisibility}" />
                                        <Button Style="{StaticResource RowIcon}" Content="&#xE74D;" Click="Delete_Click" ToolTip="Удалить" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>

        <!-- граница — двигается мышью -->
        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent"
                      ResizeBehavior="PreviousAndNext" Cursor="SizeWE" />
        <Border Grid.Column="1" Width="1" Background="{DynamicResource Line}" IsHitTestVisible="False" />

        <!-- ══ настройки выбранной строки ══ -->
        <ContentControl x:Name="Side" Grid.Column="2" Focusable="False">
            <TextBlock x:Name="SideEmpty" Text="Выберите задачу слева" Foreground="{DynamicResource Muted}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
        </ContentControl>
    </Grid>
</Window>
