<Window x:Class="RASv2.ClashAnalysis.UI.ElementIdWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ID элемента" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}" FontFamily="Segoe UI" FontSize="13">
    <!-- «ID элемента связи» (DECISIONS.md модуля): номер выделенного элемента — в связи (Tab) или в самой модели — и
         «Копировать». Кнопки, поля, кисти — общие образцы ядра (подключаются до разметки). -->
    <Window.Resources>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <!-- номер — крупно, выделяется мышью; рамка — как у поля, фон — как у значения только для чтения -->
        <Style x:Key="IdBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="8,0" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="20,16,20,16">
        <ScrollViewer MaxHeight="480" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="Items">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="4" Padding="12,10" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Hint}" Text="{Binding Model}" ToolTip="{Binding Model}" />
                                <TextBlock Style="{StaticResource Hint}" Text="{Binding What}" ToolTip="{Binding What}" Margin="0,2,0,0" />
                                <DockPanel Margin="0,8,0,0">
                                    <Button DockPanel.Dock="Right" Content="Копировать" Tag="{Binding Id}" Margin="8,0,0,0" Click="Copy_Click"
                                            ToolTip="Скопировать номер" />
                                    <TextBox Style="{StaticResource IdBox}" Text="{Binding Id, Mode=OneWay}" />
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <DockPanel Margin="0,8,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="CopyAll" Content="Копировать все" Margin="0,0,8,0" Click="CopyAll_Click" Visibility="Collapsed"
                        ToolTip="Все номера — по одному в строке" />
                <Button Content="Закрыть" Style="{StaticResource PrimaryButton}" IsDefault="True" IsCancel="True" Click="Close_Click" />
            </StackPanel>
            <TextBlock x:Name="Note" Style="{StaticResource Hint}" VerticalAlignment="Center" TextWrapping="Wrap" TextTrimming="None" />
        </DockPanel>
    </StackPanel>
</Window>
