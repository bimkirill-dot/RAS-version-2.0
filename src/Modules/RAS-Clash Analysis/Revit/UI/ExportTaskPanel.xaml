<UserControl x:Class="RASv2.ClashAnalysis.UI.ExportTaskPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}" FontFamily="Segoe UI" FontSize="13"
        SizeChanged="Panel_SizeChanged">
    <!-- Настройки задачи или подзадачи «Задач выгрузки» — боковая панель главного окна (разработчик, 03.11.2026: «настройки
         открываются в боковой панели, а не отдельным окном»; DECISIONS.md модуля, «Разделы окна задачи — по разработчику
         (03.11.2026)»): «Общее», «Экспорт», «NWF», «Отчёты». Одна сетка на все строки (разработчик: «надписи, поля — ровнее»):
         подпись — по самой длинной, значение — на всю ширину (поле, «Обзор» за ним, пример — под ним), справа — колонка «от «…»» /
         «Изменить» одной ширины. Кнопки, поля, кисти — общие образцы ядра (подключаются до разметки); ключи своих стилей не
         совпадают с кистями ядра. -->
    <UserControl.Resources>
        <!-- заголовок столбца таблицы моделей: щелчок — порядок по нему -->
        <Style x:Key="SortHead" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter TextElement.Foreground="{DynamicResource Muted}" TextElement.FontSize="12" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- сообщение внизу панели — только когда есть текст -->
        <Style x:Key="Msg" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- заголовок раздела с линией под ним -->
        <Style x:Key="SectionHead" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="0,0,0,4" />
            <Setter Property="Margin" Value="0,16,0,8" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- строка: подпись | значение | от кого -->
        <Style x:Key="RowGrid" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <!-- подпись — по высоте первой строки значения (поле — 30) -->
        <!-- не шире 150 — длинная подпись переносится, а не раздвигает столбец подписей всей панели (09.11.2026: на узкой панели полям
             оставалось мало места — «Изменит» обрезалось, отбор моделей расползался) -->
        <Style x:Key="Cap" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="MaxWidth" Value="150" />
            <Setter Property="Margin" Value="0,6,12,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <!-- первая строка значения — высотой с поле: текст, ссылки, кнопки — по её середине -->
        <Style x:Key="FirstLine" TargetType="DockPanel">
            <Setter Property="MinHeight" Value="30" />
        </Style>
        <!-- правая колонка: «от «…»» и «Изменить» — вправо, по середине первой строки -->
        <Style x:Key="Side" TargetType="StackPanel">
            <Setter Property="Grid.Column" Value="3" />
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="12,0,0,0" />
            <Style.Triggers>
                <!-- узкая панель (разработчик, 03.11.2026: «на любой ширине — удобно»): «от «…»» и «Изменить» — под значением -->
                <DataTrigger Binding="{Binding Narrow, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                    <Setter Property="Grid.Column" Value="1" />
                    <Setter Property="Grid.Row" Value="1" />
                    <Setter Property="HorizontalAlignment" Value="Left" />
                    <!-- по содержимому: пустая (нечего вернуть) — без пустой строки -->
                    <Setter Property="Height" Value="Auto" />
                    <Setter Property="Margin" Value="0,2,0,0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="From" TargetType="TextBlock" BasedOn="{StaticResource Note}">
            <Setter Property="Margin" Value="0,0,8,0" />
            <Style.Triggers>
                <!-- пусто (своё значение — только «Вернуть …») — места не держит: ссылки стоят ровно (разработчик, 05.11.2026: «подровняй») -->
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SideLink" TargetType="Button" BasedOn="{StaticResource LinkButton}">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- пример — под полем -->
        <Style x:Key="Example" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style x:Key="Chip" TargetType="Button" BasedOn="{StaticResource LinkButton}">
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="ToolTip" Value="Вставить в строку" />
        </Style>
        <Style x:Key="Browse" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Grid.Column" Value="2" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Content" Value="&#xF12B;" />
            <Setter Property="ToolTip" Value="Обзор" />
        </Style>
        <Style x:Key="ColHead" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,8,4" />
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="20,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock x:Name="Info" Style="{StaticResource Msg}" Foreground="{DynamicResource Muted}" FontSize="12" />
                    <TextBlock x:Name="Error" Style="{StaticResource Msg}" Foreground="{DynamicResource Error}" />
                </StackPanel>
                <!-- «Сохранить» и «Отменить» — первыми, справа: не уходят за край; «Экспорт», «Импорт», «Журнал» — в остаток, узко — в две строки -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="Сохранить" Style="{StaticResource PrimaryButton}" Click="Save_Click" />
                    <!-- «Отменить» — правки этой строки пропадают; новая несохранённая строка исчезает -->
                    <Button Content="Отменить" Margin="8,0,0,0" Click="Cancel_Click" />
                </StackPanel>
                <WrapPanel Margin="0,0,8,0">
                    <Button Content="Экспорт…" Margin="0,2,8,2" Click="Export_Click" ToolTip="С подзадачами — в файл, чтобы поделиться" />
                    <Button Content="Импорт…" Margin="0,2,8,2" Click="Import_Click"
                            ToolTip="Импорт подзадач: задача или подзадача из файла — подзадачей сюда" />
                    <!-- журнал последней выгрузки строки (разработчик, 07.11.2026); не выгружали — папка журналов задачи -->
                    <Button Content="Журнал" Margin="0,2,0,2" Click="Journal_Click"
                            ToolTip="Журнал последней выгрузки этой строки; не выгружали — папка «Журналы выгрузки» задачи" />
                </WrapPanel>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <!-- колонки подписи и «от «…»» — по самому длинному тексту, одинаковые во всех строках; поля — на остальное -->
            <StackPanel Margin="20,0,20,16" Grid.IsSharedSizeScope="True">

                <!-- ══ Общее ══ -->
                <Border Style="{StaticResource SectionHead}" Margin="0,10,0,8">
                    <DockPanel>
                        <!-- где строка в дереве -->
                        <TextBlock x:Name="PathInfo" DockPanel.Dock="Right" Style="{StaticResource Note}" />
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Общее" />
                    </DockPanel>
                </Border>
                <Grid Style="{StaticResource RowGrid}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="Cap" /><ColumnDefinition /><ColumnDefinition Width="36" /><ColumnDefinition Width="Auto" SharedSizeGroup="Side" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource Cap}" Text="Название" />
                    <TextBox x:Name="TaskName" Grid.Column="1" TextChanged="Any_Changed" />
                </Grid>
                <Grid Style="{StaticResource RowGrid}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="Cap" /><ColumnDefinition /><ColumnDefinition Width="36" /><ColumnDefinition Width="Auto" SharedSizeGroup="Side" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource Cap}" Text="Папка задачи" />
                    <Button Grid.Column="2" x:Name="FolderBrowse" Style="{StaticResource Browse}" Click="BrowseProject_Click" />
                    <DockPanel Grid.Column="1" VerticalAlignment="Top">
                        <TextBox x:Name="Folder" TextChanged="Any_Changed" />
                    </DockPanel>
                    <StackPanel Style="{StaticResource Side}">
                        <TextBlock x:Name="FolderFrom" Style="{StaticResource From}" />
                        <Button x:Name="FolderLink" Style="{StaticResource SideLink}" />
                    </StackPanel>
                </Grid>

                <!-- ══ Модели — свой раздел (разработчик, 09.11.2026): нужны NWC, выгрузке RVT и пересохранению ══ -->
                <Border Style="{StaticResource SectionHead}">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Модели" />
                </Border>
                <!-- от кого и «Изменить» (у подзадачи), «Убрать выбранные»; сколько моделей — в шапке таблицы (разработчик, 09.11.2026:
                     «количество показывается ужасно — в таблицу») -->
                <Grid x:Name="ModelsHeadRow" Style="{StaticResource RowGrid}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="Cap" /><ColumnDefinition /><ColumnDefinition Width="36" /><ColumnDefinition Width="Auto" SharedSizeGroup="Side" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <WrapPanel Grid.ColumnSpan="4" VerticalAlignment="Top">
                        <TextBlock x:Name="ModelsSummary" VerticalAlignment="Center" Margin="0,4,12,4" Visibility="Collapsed" />
                        <Button x:Name="ModelsShow" Style="{StaticResource SideLink}" Margin="0,0,12,0" Click="ModelsShow_Click" />
                        <!-- пакетное удаление (разработчик, 05.11.2026): выделить в списке (Ctrl, Shift, Ctrl+A) — убрать разом; Delete — то же -->
                        <!-- «от «…»» и «Изменить» — здесь же, слева (справа на узкой панели они уходили на вторую строку под пустой) -->
                        <TextBlock x:Name="ModelsFrom" Style="{StaticResource From}" VerticalAlignment="Center" />
                        <Button x:Name="ModelsLink" Style="{StaticResource SideLink}" Margin="0,0,12,0" Click="ModelsLink_Click" />
                        <Button x:Name="ModelsRemove" Style="{StaticResource SideLink}" Margin="0,0,12,0" Click="RemoveSelected_Click"
                                Visibility="Collapsed" />
                    </WrapPanel>
                </Grid>
                <!-- модели — таблицей (разработчик, 09.11.2026): галочка (снята — модель не делается совсем), модель, имя NWC, блок, путь
                     на Revit Server или папка (было — версия Revit: «не надо»), когда изменена; путь, имя RVT, отдел, когда выгружена NWC — в подсказке строки; щелчок по заголовку — порядок;
                     выделение — Ctrl, Shift, Ctrl+A — для «Убрать выбранные»; корзина — при наведении -->
                <Border x:Name="ModelsPanel" Background="{DynamicResource Row}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                        CornerRadius="4" Padding="4" Margin="0,0,0,8">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="9,2,3,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="{Binding NwcColumn}" />
                                <ColumnDefinition Width="46" />
                                <ColumnDefinition Width="{Binding PathColumn}" />
                                <ColumnDefinition Width="112" />
                                <ColumnDefinition Width="30" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Note}" Text="Вкл." ToolTip="Снята — модель не делается: ни NWC, ни RVT, ни пересохранение" />
                            <Button Grid.Column="1" x:Name="SortName" Style="{StaticResource SortHead}" Tag="Name" Click="ModelsSort_Click" />
                            <Button Grid.Column="2" x:Name="SortNwc" Style="{StaticResource SortHead}" Tag="Nwc" Click="ModelsSort_Click" Visibility="{Binding NwcTableVisibility}" />
                            <Button Grid.Column="3" x:Name="SortBlock" Style="{StaticResource SortHead}" Tag="Block" Click="ModelsSort_Click" />
                            <Button Grid.Column="4" x:Name="SortPath" Style="{StaticResource SortHead}" Tag="Path" Click="ModelsSort_Click" Visibility="{Binding WideTableVisibility}"
                                    ToolTip="Где модель: папка на Revit Server или сетевая папка" />
                            <Button Grid.Column="5" x:Name="SortDate" Style="{StaticResource SortHead}" Tag="Date" Click="ModelsSort_Click" />
                            <!-- «+» — добавить модели (разработчик, 09.11.2026: «вместо огромной кнопки — плюсик в таблице, как у задач») -->
                            <Button Grid.Column="6" x:Name="AddModels" Style="{StaticResource IconButton}" Content="&#xE710;" Width="26" Height="24"
                                    FontSize="12" Margin="0,-4,0,-4" HorizontalAlignment="Center" Click="AddModels_Click"
                                    ToolTip="Добавить модели Revit или готовые NWC…" />
                        </Grid>
                        <TextBlock x:Name="ModelsEmpty" DockPanel.Dock="Bottom" Style="{StaticResource Note}" Margin="9,4,0,6"
                                   Text="Моделей нет — «+» справа вверху" />
                        <ListBox x:Name="ModelsList" MaxHeight="420" SelectionMode="Extended" Background="Transparent" BorderThickness="0"
                                 Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 SelectionChanged="ModelsList_SelectionChanged" KeyDown="ModelsList_KeyDown" MouseDoubleClick="ModelsList_DoubleClick">
                            <!-- выделенная — как выбранная строка дерева: фон наведения и рамка акцентом; толщина рамки не меняется -->
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                                                        CornerRadius="3" Padding="8,2,2,2">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hover}" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hover}" />
                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Background="Transparent" Margin="0,3" ToolTip="{Binding Tip}" ToolTipService.ShowDuration="60000">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36" />
                                            <ColumnDefinition Width="3*" />
                                            <ColumnDefinition Width="{Binding DataContext.NwcColumn, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                            <ColumnDefinition Width="46" />
                                            <ColumnDefinition Width="{Binding DataContext.PathColumn, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                            <ColumnDefinition Width="112" />
                                            <ColumnDefinition Width="30" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox VerticalAlignment="Center" IsChecked="{Binding On, Mode=OneWay}" Click="ModelOn_Click"
                                                  IsEnabled="{Binding DataContext.ModelsOwn, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  ToolTip="Снята — модель не делается: ни NWC, ни RVT, ни пересохранение. Выделено несколько (Ctrl, Shift) — у всех выделенных" />
                                        <TextBlock Grid.Column="1" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                   Margin="0,0,10,0" Opacity="{Binding RowOpacity}" />
                                        <TextBlock Grid.Column="2" Text="{Binding NwcName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                   Visibility="{Binding DataContext.NwcTableVisibility, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   Margin="0,0,10,0" Foreground="{DynamicResource Muted}" Opacity="{Binding RowOpacity}" />
                                        <TextBlock Grid.Column="3" Text="{Binding Block}" VerticalAlignment="Center" Opacity="{Binding RowOpacity}" />
                                        <!-- где модель (разработчик, 09.11.2026: вместо версии Revit — «путь на Revit Server») -->
                                        <TextBlock Grid.Column="4" Text="{Binding PathText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                   Visibility="{Binding DataContext.WideTableVisibility, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   Margin="0,0,10,0" Foreground="{DynamicResource Muted}" Opacity="{Binding RowOpacity}" />
                                        <TextBlock Grid.Column="5" Text="{Binding ModifiedText}" VerticalAlignment="Center" Opacity="{Binding RowOpacity}" />
                                        <Button Grid.Column="6" Content="&#xE74D;" ToolTip="Убрать модель" Click="DeleteModel_Click"
                                                Visibility="{Binding DataContext.ModelsEditVisibility, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                                    <Setter Property="Opacity" Value="0" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Grid}}" Value="True">
                                                            <Setter Property="Opacity" Value="1" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- ══ Экспорт ══ -->
                <Border Style="{StaticResource SectionHead}">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="NWC" />
                </Border>
                <!-- тот же выключатель, что «NWC» в списке задач (разработчик, 08.11.2026) -->
                <Grid Style="{StaticResource RowGrid}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="Cap" /><ColumnDefinition /><ColumnDefinition Width="36" /><ColumnDefinition Width="Auto" SharedSizeGroup="Side" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource Cap}" Text="Экспортировать NWC" />
                    <DockPanel Grid.Column="1" Style="{StaticResource FirstLine}" VerticalAlignment="Top">
                        <CheckBox x:Name="MakeNwc" VerticalAlignment="Center" Checked="Any_Changed" Unchecked="Any_Changed" />
                    </DockPanel>
                </Grid>
                <!-- вида нет, если в общих «Экспорт: Целый проект» -->
                <Grid x:Name="ViewRow" Style="{StaticResource RowGrid}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="Cap" /><ColumnDefinition /><ColumnDefinition Width="36" /><ColumnDefinition Width="Auto" SharedSizeGroup="Side" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource Cap}" Text="Выгружать вид" />
                    <TextBox x:Name="ViewName" Grid.Column="1" VerticalAlignment="Top" />
                    <StackPanel Style="{StaticResource Side}">
                        <TextBlock x:Name="ViewFrom" Style="{StaticResource From}" />
                        <Button x:Name="ViewLink" Style="{StaticResource SideLink}" />
                    </StackPanel>
                </Grid>

                <!-- внутри папки задачи; полный путь — тоже можно -->
                <Grid Style="{StaticResource RowGrid}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="Cap" /><ColumnDefinition /><ColumnDefinition Width="36" /><ColumnDefinition Width="Auto" SharedSizeGroup="Side" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource Cap}" Text="Папка для NWC" />
                    <Button Grid.Column="2" x:Name="NwcBrowse" Style="{StaticResource Browse}" Tag="{Binding ElementName=NwcFolder}" Click="Browse_Click" />
                    <StackPanel Grid.Column="1">
                        <DockPanel>
                            <TextBox x:Name="NwcFolder" TextChanged="Any_Changed" />
                        </DockPanel>
                        <StackPanel x:Name="NwcChips" Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Style="{StaticResource Note}" Text="Метки:" />
                            <Button Style="{StaticResource Chip}" Content="{}{Блок}" Tag="{Binding ElementName=NwcFolder}" Click="Chip_Click" />
                            <Button Style="{StaticResource Chip}" Content="{}{Отдел}" Tag="{Binding ElementName=NwcFolder}" Click="Chip_Click" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Style="{StaticResource Side}">
                        <TextBlock x:Name="NwcFrom" Style="{StaticResource From}" />
                        <Button x:Name="NwcLink" Style="{StaticResource SideLink}" />
                    </StackPanel>
                </Grid>

                <!-- в разделе NWC (разработчик, 09.11.2026: «эту информацию — в раздел NWC»); отбор моделей по дате изменения (разработчик, 03.11.2026): не изменялась в срок — NWC актуален, в списке — серой -->
                <Grid Style="{StaticResource RowGrid}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="Cap" /><ColumnDefinition /><ColumnDefinition Width="36" /><ColumnDefinition Width="Auto" SharedSizeGroup="Side" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource Cap}" Text="Отбор моделей" />
                    <!-- узко — «от «…»» и «Изменить» над отбором, а не под ним (разработчик, 07.11.2026: «Изменить поднимем выше — сейчас
                         не понятно, что нажимать»): поля от строки выше не меняются, пока не нажато «Изменить» -->
                    <WrapPanel x:Name="EditedWrap" Grid.Column="1" VerticalAlignment="Top">
                        <WrapPanel.Style>
                            <Style TargetType="WrapPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Narrow, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                        <Setter Property="Grid.Row" Value="1" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </WrapPanel.Style>
                        <CheckBox x:Name="EditedOn" VerticalAlignment="Center" Margin="0,4,10,4" Checked="Any_Changed" Unchecked="Any_Changed">
                            <TextBlock Text="Только отредактированные" TextWrapping="Wrap"
                                       ToolTip="Выгружать только модели, отредактированные в выбранный срок; остальные — серые в таблице моделей" />
                        </CheckBox>
                        <ComboBox x:Name="EditedMode" Width="100" MinHeight="28" VerticalContentAlignment="Center" Margin="0,3,8,3"
                                  SelectionChanged="Any_Changed">
                            <ComboBoxItem Content="после" />
                            <ComboBoxItem Content="до" />
                            <ComboBoxItem Content="за период" />
                        </ComboBox>
                        <!-- дата — полем, как остальные (встроенный DatePicker WPF выбивался из окон плагина), и календарём; Segoe MDL2: E787 -->
                        <!-- поля даты — с отступом сверху и снизу: на узкой панели они переносятся под список и не должны к нему прижиматься (09.11.2026) -->
                        <StackPanel Orientation="Horizontal" Margin="0,3,10,3">
                            <!-- «за период» — «с … по …»: подпись переносится вместе со своим полем (09.11.2026) -->
                            <TextBlock x:Name="EditedSince" Text="с" Width="24" VerticalAlignment="Center" />
                            <TextBox x:Name="EditedDate1" Width="96" TextChanged="Any_Changed" ToolTip="дд.мм.гггг" />
                            <Button x:Name="EditedPick1" Style="{StaticResource IconButton}" Content="&#xE787;" Margin="2,0,0,0"
                                    Tag="{Binding ElementName=EditedDate1}" Click="PickDate_Click" ToolTip="Календарь" />
                        </StackPanel>
                        <StackPanel x:Name="EditedDate2Box" Orientation="Horizontal" Margin="0,3">
                            <TextBlock x:Name="EditedDash" Text="по" Width="24" VerticalAlignment="Center" />
                            <TextBox x:Name="EditedDate2" Width="96" TextChanged="Any_Changed" ToolTip="дд.мм.гггг" />
                            <Button x:Name="EditedPick2" Style="{StaticResource IconButton}" Content="&#xE787;" Margin="2,0,0,0"
                                    Tag="{Binding ElementName=EditedDate2}" Click="PickDate_Click" ToolTip="Календарь" />
                        </StackPanel>
                    </WrapPanel>
                    <StackPanel x:Name="EditedSide">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel" BasedOn="{StaticResource Side}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Narrow, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                        <Setter Property="Grid.Column" Value="1" />
                                        <Setter Property="Grid.Row" Value="0" />
                                        <Setter Property="HorizontalAlignment" Value="Left" />
                                        <Setter Property="Height" Value="Auto" />
                                        <Setter Property="Margin" Value="0,10,0,2" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock x:Name="EditedFromText" Style="{StaticResource From}" />
                        <Button x:Name="EditedLink" Style="{StaticResource SideLink}" Click="EditedLink_Click" />
                    </StackPanel>
                </Grid>

                <!-- параметры экспортёра и «Удалить перед выгрузкой» — по общим настройкам или свои (то же окно, что шестерёнка) -->
                <Grid Style="{StaticResource RowGrid}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="Cap" /><ColumnDefinition /><ColumnDefinition Width="36" /><ColumnDefinition Width="Auto" SharedSizeGroup="Side" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource Cap}" Text="Настройки NWC Exporter" />
                    <WrapPanel Grid.Column="1" VerticalAlignment="Top">
                        <TextBlock x:Name="ExportFrom" VerticalAlignment="Center" Margin="0,4,10,4" />
                        <Button x:Name="ExportEdit" Style="{StaticResource SideLink}" Content="Изменить" Click="ExportEdit_Click" />
                    </WrapPanel>
                    <StackPanel Style="{StaticResource Side}">
                        <Button x:Name="ExportReset" Style="{StaticResource SideLink}" Click="ExportReset_Click" />
                    </StackPanel>
                </Grid>

                <!-- ══ NWF ══ -->
                <Border Style="{StaticResource SectionHead}">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="NWF" />
                </Border>
                <!-- NWF собирает строка без подзадач; у строки с подзадачами галочка недоступна, а поля ниже задаются для подзадач -->
                <Grid Style="{StaticResource RowGrid}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="Cap" /><ColumnDefinition /><ColumnDefinition Width="36" /><ColumnDefinition Width="Auto" SharedSizeGroup="Side" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource Cap}" Text="Формировать NWF" />
                    <DockPanel Grid.Column="1" Style="{StaticResource FirstLine}" VerticalAlignment="Top">
                        <CheckBox x:Name="MakeNwf" VerticalAlignment="Center" Checked="Any_Changed" Unchecked="Any_Changed" />
                    </DockPanel>
                </Grid>
                <!-- галочка снята — всё ниже серое и не правится (разработчик, 03.11.2026) -->
                <StackPanel x:Name="NwfFields">
                    <Grid Style="{StaticResource RowGrid}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="Cap" /><ColumnDefinition /><ColumnDefinition Width="36" /><ColumnDefinition Width="Auto" SharedSizeGroup="Side" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource Cap}" Text="Имя NWF" />
                        <TextBox x:Name="NwfName" Grid.Column="1" VerticalAlignment="Top" TextChanged="Any_Changed" />
                    </Grid>

                    <!-- снята — NWF без проверок: человек выполняет их вручную (разработчик, 08.11.2026) -->
                    <Grid Style="{StaticResource RowGrid}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="Cap" /><ColumnDefinition /><ColumnDefinition Width="36" /><ColumnDefinition Width="Auto" SharedSizeGroup="Side" /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Cap}" Text="Выполнять проверки" />
                        <DockPanel Grid.Column="1" Style="{StaticResource FirstLine}" VerticalAlignment="Top">
                            <CheckBox x:Name="RunTests" VerticalAlignment="Center" Checked="Any_Changed" Unchecked="Any_Changed"
                                      ToolTip="Загрузить проверки (если их ещё нет в NWF) и прогнать; снята — NWF обновляется, проверки — вручную" />
                        </DockPanel>
                    </Grid>

                    <Grid Style="{StaticResource RowGrid}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="Cap" /><ColumnDefinition /><ColumnDefinition Width="36" /><ColumnDefinition Width="Auto" SharedSizeGroup="Side" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource Cap}" Text="Проверки" />
                        <!-- на две колонки: корзины — в колонке «Обзора», поля кончаются на одной линии с остальными -->
                        <StackPanel Grid.Column="1" Grid.ColumnSpan="2">
                            <!-- от уровня выше — именами в строку; свои — списком с корзинами -->
                            <DockPanel Style="{StaticResource FirstLine}">
                                <TextBlock x:Name="TestsInline" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                            <StackPanel x:Name="TestsPanel">
                                <ItemsControl x:Name="TestsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel MinHeight="28">
                                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE74D;" Margin="4,0,0,0" Width="32"
                                                        Click="DeleteTests_Click" ToolTip="Убрать файл" />
                                                <TextBlock ToolTip="{Binding Path}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                                    <Run Text="{Binding Name, Mode=OneWay}" />
                                                    <Run Text="{Binding Folder, Mode=OneWay}" Foreground="{DynamicResource Muted}" FontSize="12" />
                                                </TextBlock>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Content="Добавить…" HorizontalAlignment="Left" Margin="0,2,0,0" Click="AddTests_Click"
                                        ToolTip="Файлы проверок .xml из Clash Detective — можно несколько" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Side}">
                            <TextBlock x:Name="TestsFrom" Style="{StaticResource From}" />
                            <Button x:Name="TestsLink" Style="{StaticResource SideLink}" Click="TestsLink_Click" />
                        </StackPanel>
                    </Grid>

                    <!-- скрыть — поисковые наборы Navisworks из файла «Экспорт поисковых наборов» (разработчик, 03.11.2026) -->
                    <Grid Style="{StaticResource RowGrid}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="Cap" /><ColumnDefinition /><ColumnDefinition Width="36" /><ColumnDefinition Width="Auto" SharedSizeGroup="Side" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource Cap}" Text="Скрыть" />
                        <StackPanel Grid.Column="1" Grid.ColumnSpan="2">
                            <DockPanel Style="{StaticResource FirstLine}">
                                <TextBlock x:Name="HideInline" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                            <StackPanel x:Name="HidePanel">
                                <ItemsControl x:Name="HideList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel MinHeight="28" Margin="0,0,0,2">
                                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE74D;" Margin="4,0,0,0" Width="32"
                                                        VerticalAlignment="Center" Click="DeleteHide_Click" ToolTip="Удалить правило" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Text}" Style="{StaticResource Note}" TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding Text}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Content="Добавить правила…" HorizontalAlignment="Left" Margin="0,2,0,0" Click="AddHide_Click"
                                        ToolTip="Файл поисковых наборов Navisworks: «Наборы» → «Экспорт поисковых наборов»" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Side}">
                            <TextBlock x:Name="HideFrom" Style="{StaticResource From}" />
                            <Button x:Name="HideLink" Style="{StaticResource SideLink}" Click="HideLink_Click" />
                        </StackPanel>
                    </Grid>

                    <Grid Style="{StaticResource RowGrid}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="Cap" /><ColumnDefinition /><ColumnDefinition Width="36" /><ColumnDefinition Width="Auto" SharedSizeGroup="Side" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource Cap}" Text="Папка для NWF" />
                        <Button Grid.Column="2" x:Name="NwfBrowse" Style="{StaticResource Browse}" Tag="{Binding ElementName=NwfFolder}" Click="Browse_Click" />
                        <StackPanel Grid.Column="1">
                            <TextBox x:Name="NwfFolder" TextChanged="Any_Changed" />
                            <StackPanel x:Name="NwfChips" Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Style="{StaticResource Note}" Text="Метки:" />
                                <Button Style="{StaticResource Chip}" Content="{}{Блок}" Tag="{Binding ElementName=NwfFolder}" Click="Chip_Click" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Side}">
                            <TextBlock x:Name="NwfFrom" Style="{StaticResource From}" />
                            <Button x:Name="NwfLink" Style="{StaticResource SideLink}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- ══ Отчёты ══ -->
                <Border Style="{StaticResource SectionHead}">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Отчёты" />
                </Border>
                <Grid Style="{StaticResource RowGrid}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="Cap" /><ColumnDefinition /><ColumnDefinition Width="36" /><ColumnDefinition Width="Auto" SharedSizeGroup="Side" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource Cap}" Text="Формировать отчёты" />
                    <DockPanel Grid.Column="1" Style="{StaticResource FirstLine}" VerticalAlignment="Top">
                        <CheckBox x:Name="MakeReports" VerticalAlignment="Center" Checked="Any_Changed" Unchecked="Any_Changed" />
                    </DockPanel>
                </Grid>
                <StackPanel x:Name="ReportFields">
                    <!-- форматы — выпадающий список с галочками: все форматы отчёта Clash Detective (разработчик, 03.11.2026) -->
                    <Grid Style="{StaticResource RowGrid}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="Cap" /><ColumnDefinition /><ColumnDefinition Width="36" /><ColumnDefinition Width="Auto" SharedSizeGroup="Side" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource Cap}" Text="Формат отчётов" />
                        <ComboBox x:Name="Formats" Grid.Column="1" VerticalAlignment="Top" MinHeight="30" VerticalContentAlignment="Center"
                                  IsEditable="True" IsReadOnly="True" StaysOpenOnEdit="True" DropDownClosed="Formats_Closed">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding On}" Checked="Format_Changed" Unchecked="Format_Changed" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <StackPanel Style="{StaticResource Side}">
                            <TextBlock x:Name="FormatsFrom" Style="{StaticResource From}" />
                            <Button x:Name="FormatsLink" Style="{StaticResource SideLink}" Click="FormatsLink_Click" />
                        </StackPanel>
                    </Grid>

                    <Grid Style="{StaticResource RowGrid}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="Cap" /><ColumnDefinition /><ColumnDefinition Width="36" /><ColumnDefinition Width="Auto" SharedSizeGroup="Side" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource Cap}" Text="Папка для отчётов" />
                        <Button Grid.Column="2" x:Name="ReportBrowse" Style="{StaticResource Browse}" Tag="{Binding ElementName=ReportFolder}" Click="Browse_Click" />
                        <StackPanel Grid.Column="1">
                            <TextBox x:Name="ReportFolder" TextChanged="Any_Changed" />
                            <StackPanel x:Name="ReportChips" Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Style="{StaticResource Note}" Text="Метки:" />
                                <Button Style="{StaticResource Chip}" Content="{}{Дата}" Tag="{Binding ElementName=ReportFolder}" Click="Chip_Click" />
                                <Button Style="{StaticResource Chip}" Content="{}{Формат}" Tag="{Binding ElementName=ReportFolder}" Click="Chip_Click" />
                                <Button Style="{StaticResource Chip}" Content="{}{Блок}" Tag="{Binding ElementName=ReportFolder}" Click="Chip_Click" />
                            </StackPanel>
                            <TextBlock x:Name="ReportExample" Style="{StaticResource Example}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Side}">
                            <TextBlock x:Name="ReportFrom" Style="{StaticResource From}" />
                            <Button x:Name="ReportLink" Style="{StaticResource SideLink}" />
                        </StackPanel>
                    </Grid>

                    <!-- отчёт без коллизий или со всеми исправленными — удалить (разработчик, 11.11.2026); сайту пустой отчёт нужен — снята по умолчанию -->
                    <Grid Style="{StaticResource RowGrid}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="Cap" /><ColumnDefinition /><ColumnDefinition Width="36" /><ColumnDefinition Width="Auto" SharedSizeGroup="Side" /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Cap}" Text="Удалять пустые" />
                        <DockPanel Grid.Column="1" Style="{StaticResource FirstLine}" VerticalAlignment="Top">
                            <CheckBox x:Name="DeleteEmptyReports" VerticalAlignment="Center" Checked="Any_Changed" Unchecked="Any_Changed" Click="DeleteEmptyReports_Click"
                                      ToolTip="Отчёт проверки, в которой нет коллизий или все исправлены, удаляется. Действует и на подзадачи; у подзадачи можно поставить или снять своё. Не ставьте, если отчёты загружаются на сайт коллизий: без пустого отчёта сайт не узнает, что коллизии исправлены" />
                        </DockPanel>
                        <!-- от строки выше — «от «…»»; щёлкнули галочку у подзадачи — своё, «Вернуть от «…»» (12.11.2026) -->
                        <StackPanel x:Name="DeleteEmptySide" Grid.Column="3" Style="{StaticResource Side}">
                            <TextBlock x:Name="DeleteEmptyFrom" Style="{StaticResource From}" />
                            <Button x:Name="DeleteEmptyLink" Style="{StaticResource SideLink}" Content="Вернуть" Click="DeleteEmptyLink_Click" />
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- ══ RVT — для заказчика (разработчик, 08.11.2026): модели строки без связей, очищенные, в папку RVT ══ -->
                <Border Style="{StaticResource SectionHead}">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Экспорт RVT" />
                </Border>
                <Grid Style="{StaticResource RowGrid}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="Cap" /><ColumnDefinition /><ColumnDefinition Width="36" /><ColumnDefinition Width="Auto" SharedSizeGroup="Side" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource Cap}" Text="Экспортировать RVT" />
                    <DockPanel Grid.Column="1" Style="{StaticResource FirstLine}" VerticalAlignment="Top">
                        <CheckBox x:Name="MakeRvt" VerticalAlignment="Center" Checked="Any_Changed" Unchecked="Any_Changed"
                                  ToolTip="Модели строки — отдельными RVT: без связей, очищенные от неиспользуемого; как — в общих настройках («Экспорт RVT»)" />
                    </DockPanel>
                </Grid>
                <StackPanel x:Name="RvtFields">
                    <Grid Style="{StaticResource RowGrid}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="Cap" /><ColumnDefinition /><ColumnDefinition Width="36" /><ColumnDefinition Width="Auto" SharedSizeGroup="Side" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource Cap}" Text="Папка для RVT" />
                        <Button Grid.Column="2" x:Name="RvtBrowse" Style="{StaticResource Browse}" Tag="{Binding ElementName=RvtFolder}" Click="Browse_Click" />
                        <StackPanel Grid.Column="1">
                            <TextBox x:Name="RvtFolder" TextChanged="Any_Changed" />
                            <StackPanel x:Name="RvtChips" Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Style="{StaticResource Note}" Text="Метки:" />
                                <Button Style="{StaticResource Chip}" Content="{}{Блок}" Tag="{Binding ElementName=RvtFolder}" Click="Chip_Click" />
                                <Button Style="{StaticResource Chip}" Content="{}{Отдел}" Tag="{Binding ElementName=RvtFolder}" Click="Chip_Click" />
                                <Button Style="{StaticResource Chip}" Content="{}{Дата}" Tag="{Binding ElementName=RvtFolder}" Click="Chip_Click" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Side}">
                            <TextBlock x:Name="RvtFrom" Style="{StaticResource From}" />
                            <Button x:Name="RvtLink" Style="{StaticResource SideLink}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
                <!-- настройки выгрузки RVT — по общим или свои -->
                <Grid Style="{StaticResource RowGrid}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="Cap" /><ColumnDefinition /><ColumnDefinition Width="36" /><ColumnDefinition Width="Auto" SharedSizeGroup="Side" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource Cap}" Text="Настройки" />
                    <WrapPanel Grid.Column="1" VerticalAlignment="Top">
                        <TextBlock x:Name="RvtOptionsFrom" VerticalAlignment="Center" Margin="0,4,10,4" />
                        <Button x:Name="RvtOptionsEdit" Style="{StaticResource SideLink}" Content="Изменить" Click="RvtOptionsEdit_Click" />
                    </WrapPanel>
                    <StackPanel Style="{StaticResource Side}">
                        <Button x:Name="RvtOptionsReset" Style="{StaticResource SideLink}" Click="RvtOptionsReset_Click" />
                    </StackPanel>
                </Grid>
                <!-- настройки выгрузки RVT — здесь же (разработчик, 08.11.2026: «не отдельным окном, а прямо тут, как у NWC»): по общим —
                     серые, «Изменить» — свои у строки (и у подзадач), «Вернуть» — снова по общим -->
                <StackPanel x:Name="RvtOptionsBox">
                    <Grid Style="{StaticResource RowGrid}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="Cap" /><ColumnDefinition /><ColumnDefinition Width="36" /><ColumnDefinition Width="Auto" SharedSizeGroup="Side" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource Cap}" Text="Проверка (Audit)" />
                        <DockPanel Grid.Column="1" Style="{StaticResource FirstLine}" VerticalAlignment="Top">
                            <CheckBox x:Name="RvtAuditBox" VerticalAlignment="Center" Checked="Any_Changed" Unchecked="Any_Changed" ToolTip="Revit исправляет ошибки модели; открытие дольше" />
                        </DockPanel>
                    </Grid>
                    <Grid Style="{StaticResource RowGrid}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="Cap" /><ColumnDefinition /><ColumnDefinition Width="36" /><ColumnDefinition Width="Auto" SharedSizeGroup="Side" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource Cap}" Text="Рабочие наборы" />
                        <ComboBox Grid.Column="1" x:Name="RvtWorksetsBox" HorizontalAlignment="Left" Width="240" MinHeight="28"
                                  VerticalContentAlignment="Center" VerticalAlignment="Top" SelectionChanged="Any_Changed">
                            <ComboBoxItem Content="Оставить, все освободить" />
                            <ComboBoxItem Content="Без рабочих наборов" />
                        </ComboBox>
                    </Grid>
                    <Grid Style="{StaticResource RowGrid}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="Cap" /><ColumnDefinition /><ColumnDefinition Width="36" /><ColumnDefinition Width="Auto" SharedSizeGroup="Side" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource Cap}" Text="Перезаписывать RVT" />
                        <DockPanel Grid.Column="1" Style="{StaticResource FirstLine}" VerticalAlignment="Top">
                            <CheckBox x:Name="RvtOverwriteBox" VerticalAlignment="Center" Checked="Any_Changed" Unchecked="Any_Changed" ToolTip="Снята — модель с уже лежащим RVT пропускается" />
                        </DockPanel>
                    </Grid>
                    <Grid Style="{StaticResource RowGrid}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="Cap" /><ColumnDefinition /><ColumnDefinition Width="36" /><ColumnDefinition Width="Auto" SharedSizeGroup="Side" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource Cap}" Text="Обрезать имя после" />
                        <TextBox Grid.Column="1" x:Name="RvtTrimBox" HorizontalAlignment="Left" Width="160" VerticalAlignment="Top" TextChanged="Any_Changed"
                                 ToolTip="Часть имени модели, после которой всё отрезается; пусто — имя модели как есть" />
                    </Grid>
                </StackPanel>

                <!-- ══ Пересохранение RVT — свой раздел (разработчик, 08.11.2026): на то же место, сжатые, освобождённые ══ -->
                <Border Style="{StaticResource SectionHead}">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Пересохранение RVT" />
                </Border>
                <!-- тот же выключатель, что в списке -->
                <Grid Style="{StaticResource RowGrid}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="Cap" /><ColumnDefinition /><ColumnDefinition Width="36" /><ColumnDefinition Width="Auto" SharedSizeGroup="Side" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource Cap}" Text="Пересохранить RVT" />
                    <DockPanel Grid.Column="1" Style="{StaticResource FirstLine}" VerticalAlignment="Top">
                        <CheckBox x:Name="Resave" VerticalAlignment="Center" Checked="Any_Changed" Unchecked="Any_Changed"
                                  ToolTip="Модели строки — на то же место, сжатые и освобождённые; перед заменой — резервная копия" />
                    </DockPanel>
                </Grid>
                <Grid Style="{StaticResource RowGrid}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="Cap" /><ColumnDefinition /><ColumnDefinition Width="36" /><ColumnDefinition Width="Auto" SharedSizeGroup="Side" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource Cap}" Text="Настройки" />
                    <WrapPanel Grid.Column="1" VerticalAlignment="Top">
                        <TextBlock x:Name="ResaveOptionsFrom" VerticalAlignment="Center" Margin="0,4,10,4" />
                        <Button x:Name="ResaveOptionsEdit" Style="{StaticResource SideLink}" Content="Изменить" Click="ResaveOptionsEdit_Click" />
                    </WrapPanel>
                    <StackPanel Style="{StaticResource Side}">
                        <Button x:Name="ResaveOptionsReset" Style="{StaticResource SideLink}" Click="ResaveOptionsReset_Click" />
                    </StackPanel>
                </Grid>
                <!-- настройки пересохранения — здесь же, как у RVT -->
                <StackPanel x:Name="ResaveOptionsBox">
                    <Grid Style="{StaticResource RowGrid}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="Cap" /><ColumnDefinition /><ColumnDefinition Width="36" /><ColumnDefinition Width="Auto" SharedSizeGroup="Side" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource Cap}" Text="Сжать модель" />
                        <DockPanel Grid.Column="1" Style="{StaticResource FirstLine}" VerticalAlignment="Top">
                            <CheckBox x:Name="ResaveCompactBox" VerticalAlignment="Center" Checked="Any_Changed" Unchecked="Any_Changed" ToolTip="«Сжать файл» при сохранении — меньше вес, сохранение дольше" />
                        </DockPanel>
                    </Grid>
                    <Grid Style="{StaticResource RowGrid}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="Cap" /><ColumnDefinition /><ColumnDefinition Width="36" /><ColumnDefinition Width="Auto" SharedSizeGroup="Side" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource Cap}" Text="Проверка (Audit)" />
                        <DockPanel Grid.Column="1" Style="{StaticResource FirstLine}" VerticalAlignment="Top">
                            <CheckBox x:Name="ResaveAuditBox" VerticalAlignment="Center" Checked="Any_Changed" Unchecked="Any_Changed" ToolTip="Revit исправляет ошибки модели при открытии; открытие дольше" />
                        </DockPanel>
                    </Grid>
                    <Grid Style="{StaticResource RowGrid}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="Cap" /><ColumnDefinition /><ColumnDefinition Width="36" /><ColumnDefinition Width="Auto" SharedSizeGroup="Side" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource Cap}" Text="Резервные копии" />
                        <Button Grid.Column="2" x:Name="ResaveBackupBrowse" Style="{StaticResource Browse}" Tag="{Binding ElementName=ResaveBackupBox}" Click="Browse_Click" />
                        <StackPanel Grid.Column="1">
                            <TextBox x:Name="ResaveBackupBox" TextChanged="Any_Changed"
                                     ToolTip="Прежние модели перед заменой: на каждый запуск — папка с датой и временем; пусто — на этом компьютере" />
                            <TextBlock x:Name="ResaveBackupNote" Style="{StaticResource Note}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
