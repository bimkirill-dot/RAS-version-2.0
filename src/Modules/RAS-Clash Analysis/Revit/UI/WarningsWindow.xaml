<Window x:Class="RASv2.ClashAnalysis.UI.WarningsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Предупреждения" Width="1100" Height="700" MinWidth="760" MinHeight="400" ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" PreviewKeyDown="Window_PreviewKeyDown"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}" FontFamily="Segoe UI" FontSize="13">
    <!-- «Предупреждения» «Менеджера задач» (разработчик, 12.11.2026; набросок принят): слева — дерево задач с числом предупреждений,
         справа — предупреждения выбранной строки и её подзадач: ошибки, изменения, пропуски. Кисти и кнопки — общие образцы ядра;
         ключи своих стилей не совпадают с кистями ядра. -->
    <Window.Resources>
        <SolidColorBrush x:Key="MarkChanged" Color="#E0A100" />
        <!-- строка дерева: под мышью — фон наведения, выбранная — фон наведения и рамка акцентом -->
        <Style x:Key="TreeItem" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="B" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="6"
                                Padding="8,5" Margin="0,0,0,1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource Hover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource Hover}" />
                                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel Margin="20,14,20,16">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Показать:" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{DynamicResource Muted}" />
            <CheckBox x:Name="ShowErrors" Content="Ошибки" IsChecked="True" Margin="0,0,16,0" VerticalAlignment="Center"
                      Checked="Filter_Changed" Unchecked="Filter_Changed" />
            <CheckBox x:Name="ShowChanges" Content="Изменения" IsChecked="True" Margin="0,0,16,0" VerticalAlignment="Center"
                      Checked="Filter_Changed" Unchecked="Filter_Changed" ToolTip="Модели, изменённые после выгрузки своей NWC" />
            <CheckBox x:Name="ShowSkips" Content="Пропуски" VerticalAlignment="Center" Checked="Filter_Changed" Unchecked="Filter_Changed"
                      ToolTip="Что не выгружалось и почему: NWC актуальна, модель не найдена, выключена…" />
        </StackPanel>
        <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource Line}" Margin="0,0,0,10" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="200" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ListBox x:Name="Rows" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource TreeItem}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="Rows_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="{Binding Indent}">
                            <!-- ▾ / ▸ — свернуть подзадачи; у строки без подзадач — пустое место той же ширины -->
                            <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Width="18" Height="20" MinHeight="0" FontSize="10"
                                    Margin="0,0,4,0" Content="{Binding Arrow}" Visibility="{Binding ArrowVisibility}" Click="Toggle_Click" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" Foreground="{Binding CountBrush}" FontWeight="SemiBold"
                                       Margin="8,0,0,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Name}" FontWeight="{Binding Weight}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                       ToolTip="{Binding Name}" />
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <GridSplitter Grid.Column="1" Width="9" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent"
                          ResizeBehavior="PreviousAndNext" />
            <Border Grid.Column="1" Width="1" Background="{DynamicResource Line}" IsHitTestVisible="False" />
            <ScrollViewer x:Name="Scroll" Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="Details" Margin="18,0,8,0" />
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
