<Window x:Class="RASv2.ClashAnalysis.UI.ModelPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавить модели" Width="720" Height="620" MinWidth="520" MinHeight="360"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}" FontFamily="Segoe UI" FontSize="13">
    <!-- Выбор моделей для строки «Задач выгрузки» (DECISIONS.md модуля): Revit Server — деревом с галочками (папки подгружаются
         при раскрытии; галочка на папке — все модели внутри), сетевые папки — окном Windows («Папка на диске или в сети…»).
         Набросок принят разработчиком 02.11.2026 («ну так давай сделаем»). С 03.11.2026: версия Revit Server — любая («все
         версии моделей из любого Revit»), содержимое папок — из кэша сразу, с сервера — в фоне; «Обновить» — заново с сервера.
         Кнопки, поля, кисти — общие образцы ядра
         (подключаются до разметки); ключи своих стилей не совпадают с кистями ядра. -->
    <Window.Resources>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            <Setter Property="Padding" Value="2" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="20,14,20,16">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="Откуда" VerticalAlignment="Center" Margin="0,0,12,0" />
            <!-- Segoe MDL2 Assets: E72C — обновить -->
            <Button x:Name="RefreshButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE72C;" Margin="8,0,0,0"
                    ToolTip="Обновить с сервера" Click="Refresh_Click" />
            <ComboBox x:Name="Year" DockPanel.Dock="Right" Width="120" MinHeight="28" VerticalContentAlignment="Center" Margin="12,0,0,0"
                      SelectionChanged="Year_Changed" />
            <TextBlock DockPanel.Dock="Right" Text="Версия" VerticalAlignment="Center" Margin="12,0,0,0" />
            <ComboBox x:Name="Source" MinHeight="28" VerticalContentAlignment="Center" SelectionChanged="Source_Changed" />
        </DockPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="AddButton" Content="Добавить" Style="{StaticResource PrimaryButton}" IsDefault="True"
                        IsEnabled="False" Click="Add_Click" />
                <Button Content="Отмена" IsCancel="True" Margin="8,0,0,0" />
            </StackPanel>
            <TextBlock x:Name="Status" VerticalAlignment="Center" TextWrapping="Wrap" />
        </DockPanel>

        <TreeView x:Name="Tree" Background="{DynamicResource Field}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                  Padding="4">
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                    <StackPanel Orientation="Horizontal">
                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Visibility="{Binding CheckVisibility}"
                                  VerticalAlignment="Center" Margin="0,0,6,0" />
                        <!-- Segoe MDL2 Assets: F12B — папка, E7C3 — файл модели (E8B7 рисуется листом — сверено снимком) -->
                        <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Muted}" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Size}" Style="{StaticResource Note}" Margin="10,0,0,0" />
                        <!-- дата изменения — из сведений о модели, подгружается в фоне (разработчик, 03.11.2026) -->
                        <TextBlock Text="{Binding Date}" Style="{StaticResource Note}" Margin="10,0,0,0" />
                    </StackPanel>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
    </DockPanel>
</Window>
