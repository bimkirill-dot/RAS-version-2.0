<Window x:Class="RASv2.ClashAnalysis.UI.ExportRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Выгрузка NWC" Width="900" Height="560" MinWidth="560" MinHeight="300"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="True"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}" FontFamily="Segoe UI" FontSize="13">
    <!-- Ход выгрузки NWC (DECISIONS.md модуля, «Ход и итог»): модели и их шаг, время, «готово N из M», «Отмена» — после текущей
         модели; в конце — итог, журнал и папка NWC. Кнопки, кисти — общие образцы ядра (подключаются до разметки). -->
    <Window.Resources>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <!-- состояние: идёт — акцентом, ошибка — красным, пропущена — бледно -->
        <Style x:Key="RunRowBox" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="4,6" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Working">
                    <Setter Property="Background" Value="{DynamicResource Hover}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Skipped">
                    <Setter Property="Opacity" Value="0.6" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StateText" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Failed">
                    <Setter Property="Foreground" Value="{DynamicResource Error}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Working">
                    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel Margin="20,14,20,16">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock x:Name="Head" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="Sub" Style="{StaticResource Note}" Margin="0,4,0,0" />
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="LogButton" Content="Журнал" Margin="0,0,8,0" Click="Log_Click" ToolTip="Журнал этой выгрузки: шаги, время, ошибки, несостыковки" />
                <Button x:Name="FolderButton" Content="Папка NWC" Margin="0,0,8,0" Click="Folder_Click" Visibility="Collapsed" />
                <Button x:Name="CancelButton" Content="Отмена" Click="Cancel_Click" ToolTip="Остановить после текущей модели" />
                <Button x:Name="CloseButton" Content="Закрыть" Style="{StaticResource PrimaryButton}" Click="Close_Click" Visibility="Collapsed" />
            </StackPanel>
            <TextBlock x:Name="Foot" Style="{StaticResource Note}" VerticalAlignment="Center" />
        </DockPanel>

        <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
            <ScrollViewer x:Name="Scroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="RowsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource RunRowBox}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="64" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Number}" Foreground="{DynamicResource Muted}" FontSize="12" VerticalAlignment="Top" Margin="0,1,0,0" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource StateText}" Text="{Binding StateName}" VerticalAlignment="Top" />
                                    <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                                        <TextBlock Style="{StaticResource Note}" Text="{Binding Detail}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="3" Text="{Binding TimeText}" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Top" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
