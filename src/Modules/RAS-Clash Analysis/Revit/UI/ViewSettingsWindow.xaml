<Window x:Class="RASv2.ClashAnalysis.UI.ViewSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки вида коллизии" Width="500" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}" FontFamily="Segoe UI" FontSize="13">
    <!-- Личные настройки вида для «Показать в Revit» (DECISIONS.md модуля, «Мост в Revit…»). Раскладка — по рисунку
         разработчика (29.10.2026). Кнопки, поля, кисти — общие образцы ядра (подключаются до разметки). -->
    <Window.Resources>
        <Style x:Key="Head" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,16,0,6" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="22,0,0,4" />
        </Style>
        <!-- длинная подпись — переносом на новую строку, а не обрезкой (разработчик, 20.10.2026: «текст не влезает») -->
        <DataTemplate x:Key="Wrapped">
            <TextBlock Text="{Binding}" TextWrapping="Wrap" />
        </DataTemplate>
        <!-- недоступное — бледным: текст с цветом темы сам не сереет -->
        <Style TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
            <Setter Property="ContentTemplate" Value="{StaticResource Wrapped}" />
            <Setter Property="Margin" Value="0,3" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="ContentTemplate" Value="{StaticResource Wrapped}" />
            <Setter Property="Margin" Value="0,3" />
        </Style>
        <Style x:Key="Num" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="56" />
            <Setter Property="HorizontalContentAlignment" Value="Right" />
        </Style>
        <Style x:Key="Unit" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="20,14,20,18">
        <TextBlock Style="{StaticResource Head}" Margin="0,0,0,6" Text="Тип вида" />
        <RadioButton x:Name="Kind3D" GroupName="kind" Content="3D-вид — с рамкой обрезки" Checked="Kind_Changed" />
        <RadioButton x:Name="KindPlan" GroupName="kind" Content="План — на уровне коллизии, секущая плоскость на её высоте" Checked="Kind_Changed" />
        <RadioButton x:Name="KindSection" GroupName="kind" Content="Разрез — через коллизию (у стены — вдоль стены)" Checked="Kind_Changed" />
        <RadioButton x:Name="KindAuto" GroupName="kind" Content="Авто — по элементам" Checked="Kind_Changed" />
        <TextBlock Style="{StaticResource Hint}" Text="Перекрытие или фундаментная плита — план, стена — разрез, остальное — 3D." />

        <TextBlock Style="{StaticResource Head}" Text="Отображение пересечения" />
        <CheckBox x:Name="Isolate" Content="Изолировать элементы коллизии" />
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="Категории элементов…" Click="Categories_Click"
                    ToolTip="Какие категории видны в исходном файле и в связанном" />
            <TextBlock x:Name="CategoriesSummary" Foreground="{DynamicResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" />
        </StackPanel>

        <TextBlock Style="{StaticResource Head}" Text="Обрезка вида" />
        <RadioButton x:Name="CropAuto" GroupName="crop" Content="Авто — по размеру места коллизии" />
        <StackPanel Orientation="Horizontal" Margin="0,1">
            <RadioButton x:Name="CropMargin" GroupName="crop" Content="С отступом" VerticalAlignment="Center" />
            <TextBox x:Name="MarginBox" Style="{StaticResource Num}" Margin="10,0,0,0" />
            <TextBlock Style="{StaticResource Unit}" Text="м" />
        </StackPanel>
        <RadioButton x:Name="CropView" GroupName="crop" Content="Границы вида — рамка вашего 3D-вида" />

        <TextBlock Style="{StaticResource Head}" Text="Отображение элементов" />
        <CheckBox x:Name="Paint" Content="Покраска" />
        <TextBlock Style="{StaticResource Hint}" Text="Как в Navisworks: первый элемент — красный, второй — зелёный." />

        <Border BorderBrush="{DynamicResource Line}" BorderThickness="1"
                CornerRadius="4" Padding="12,8,12,10" Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="36" />
                    <RowDefinition Height="36" />
                </Grid.RowDefinitions>
                <TextBlock Grid.ColumnSpan="3" Text="Прозрачность" Margin="0,0,0,4" />
                <TextBlock Grid.Row="1" Text="Элементов коллизии" VerticalAlignment="Center" />
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="ClashTransparency" Style="{StaticResource Num}" />
                <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource Unit}" Text="%" />
                <TextBlock Grid.Row="2" Text="Остальных элементов" VerticalAlignment="Center" />
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="OtherTransparency" Style="{StaticResource Num}" />
                <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource Unit}" Text="%" />
            </Grid>
        </Border>

        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <TextBlock Text="Стиль" VerticalAlignment="Center" Margin="0,0,12,0" />
            <ComboBox x:Name="StyleBox" Width="220" MinHeight="28" VerticalContentAlignment="Center">
                <ComboBoxItem Content="Каркас" />
                <ComboBoxItem Content="Скрытые линии" />
                <ComboBoxItem Content="Тонированный" />
                <ComboBoxItem Content="Согласованные цвета" />
                <ComboBoxItem Content="Реалистичный" />
            </ComboBox>
        </StackPanel>

        <TextBlock Style="{StaticResource Head}" Text="Предупреждения на сайте" />
        <CheckBox x:Name="WarnUnloaded" Content="Нужная связь выгружена" />
        <CheckBox x:Name="WarnMissingLink" Content="Нужной связи нет в модели" />
        <TextBlock Style="{StaticResource Hint}" Text="Когда показать нельзя совсем (нет моделей коллизии, нет элемента) — сообщение будет всегда." />

        <TextBlock x:Name="Error" Foreground="{DynamicResource Error}" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Сохранить" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Save_Click" />
            <Button Content="Отмена" IsCancel="True" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
