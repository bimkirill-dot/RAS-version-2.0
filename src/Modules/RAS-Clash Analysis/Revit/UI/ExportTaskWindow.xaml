<Window x:Class="RASv2.ClashAnalysis.UI.ExportTaskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Задача" Width="900" Height="640" MinWidth="720" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}" FontFamily="Segoe UI" FontSize="13">
    <!-- Задача проекта «Задач выгрузки» (карандаш у задачи; DECISIONS.md модуля, набросок 03.11.2026): например, «Высокая
         критичность» — файлы проверок, имя и папка NWF, папка отчётов, форматы, блоки. Всё, что зависит от регламента, задаёт
         человек; вторая критичность — копия задачи. Экспорт задачи — поделиться. Кнопки, поля, кисти — общие образцы ядра
         (подключаются до разметки); ключи своих стилей не совпадают с кистями ядра. -->
    <Window.Resources>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
        <Style x:Key="Example" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Chip" TargetType="Button" BasedOn="{StaticResource LinkButton}">
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="ToolTip" Value="Вставить в строку" />
        </Style>
        <Style x:Key="Browse" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Content" Value="&#xF12B;" />
            <Setter Property="ToolTip" Value="Обзор" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="20,12">
            <DockPanel>
                <Button DockPanel.Dock="Left" Content="Экспорт…" Click="Export_Click" ToolTip="Задача — в файл, чтобы поделиться" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Сохранить" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Save_Click" />
                    <Button Content="Отмена" IsCancel="True" Margin="8,0,0,0" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center" Margin="16,0">
                    <TextBlock x:Name="Info" Style="{StaticResource Note}" TextWrapping="Wrap" />
                    <TextBlock x:Name="Error" Foreground="{DynamicResource Error}" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="20,16,20,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- у подписи — тот же нижний отступ, что у поля: иначе она ниже середины поля -->
                <TextBlock Style="{StaticResource Caption}" Text="Название" Margin="0,0,12,14" />
                <TextBox x:Name="TaskName" Grid.Column="1" Margin="0,0,0,14" TextChanged="Any_Changed" />

                <TextBlock Grid.Row="1" Style="{StaticResource Caption}" Text="Файлы проверок" VerticalAlignment="Top" Margin="0,2,12,0" />
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,14">
                    <ItemsControl x:Name="TestsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,0,4">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE74D;" Margin="4,0,0,0"
                                            Click="DeleteTests_Click" ToolTip="Убрать файл" />
                                    <TextBlock ToolTip="{Binding Path}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                        <Run Text="{Binding Name, Mode=OneWay}" />
                                        <Run Text="{Binding Folder, Mode=OneWay}" Foreground="{DynamicResource Muted}" FontSize="12" />
                                    </TextBlock>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="NoTests" Style="{StaticResource Note}" HorizontalAlignment="Left" Text="Файлов нет" Margin="0,0,0,4" />
                    <Button Content="Добавить…" HorizontalAlignment="Left" Click="AddTests_Click"
                            ToolTip="Файлы проверок .xml из Clash Detective — можно несколько" />
                </StackPanel>

                <!-- NWF — постоянная, одна на блок задачи: имя и папка с {Блок} -->
                <TextBlock Grid.Row="2" Style="{StaticResource Caption}" Text="Имя NWF" Margin="0,0,12,8" />
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBox x:Name="NwfName" Width="260" TextChanged="Any_Changed" />
                    <TextBlock x:Name="NwfNameExample" Style="{StaticResource Example}" Margin="16,0,0,0" />
                </StackPanel>
                <TextBlock Grid.Row="3" Style="{StaticResource Caption}" Text="Папка для NWF" Margin="0,0,12,14" />
                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,14">
                    <TextBox x:Name="NwfFolder" Width="260" TextChanged="Any_Changed" />
                    <Button Style="{StaticResource Browse}" Tag="{Binding ElementName=NwfFolder}" Click="Browse_Click" />
                    <TextBlock x:Name="NwfExample" Style="{StaticResource Example}" Margin="16,0,0,0" />
                </StackPanel>

                <TextBlock Grid.Row="4" Style="{StaticResource Caption}" Text="Папка для отчётов" />
                <DockPanel Grid.Row="4" Grid.Column="1">
                    <Button DockPanel.Dock="Right" Style="{StaticResource Browse}" Tag="{Binding ElementName=ReportFolder}" Click="Browse_Click" />
                    <TextBox x:Name="ReportFolder" TextChanged="Any_Changed" />
                </DockPanel>
                <StackPanel Grid.Row="5" Grid.Column="1" Margin="0,4,0,14">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Note}" Text="Метки:" />
                        <Button Style="{StaticResource Chip}" Content="{}{Блок}" Tag="{Binding ElementName=ReportFolder}" Click="Chip_Click" />
                        <Button Style="{StaticResource Chip}" Content="{}{Дата}" Tag="{Binding ElementName=ReportFolder}" Click="Chip_Click" />
                        <Button Style="{StaticResource Chip}" Content="{}{Формат}" Tag="{Binding ElementName=ReportFolder}" Click="Chip_Click" />
                    </StackPanel>
                    <TextBlock x:Name="ReportExample" Style="{StaticResource Example}" />
                </StackPanel>

                <TextBlock Grid.Row="6" Style="{StaticResource Caption}" Text="Форматы отчётов" Margin="0,0,12,14" />
                <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,14">
                    <CheckBox x:Name="Xml" Content="XML" Checked="Any_Changed" Unchecked="Any_Changed" />
                    <CheckBox x:Name="Html" Content="HTML" Margin="20,0,0,0" Checked="Any_Changed" Unchecked="Any_Changed" />
                </StackPanel>

                <!-- блоки — из моделей проекта (сами, по именам); снятый блок задача не делает -->
                <TextBlock Grid.Row="7" Style="{StaticResource Caption}" Text="Блоки" VerticalAlignment="Top" Margin="0,2,12,0" />
                <StackPanel Grid.Row="7" Grid.Column="1">
                    <ItemsControl x:Name="BlocksList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Name}" IsChecked="{Binding On}" Margin="0,0,20,6" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="NoBlocks" Style="{StaticResource Note}" HorizontalAlignment="Left" TextWrapping="Wrap"
                               Text="Блоков нет — модели добавляются в проекте (карандаш проекта)" />
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
