<Window x:Class="RASv2.ClashAnalysis.UI.ExportTaskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Задача" Width="900" Height="620" MinWidth="720" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}" FontFamily="Segoe UI" FontSize="13">
    <!-- Задача проекта «Задач выгрузки» (карандаш у задачи, DECISIONS.md модуля): обычно блок — название (оно же имя NWF),
         модели, файл проверок (как у проекта или свой: два NWF на блок — две задачи со своими файлами). Папки — у проекта;
         внизу — куда ляжет. Кнопки, поля, кисти — общие образцы ядра (подключаются до разметки); ключи своих стилей не
         совпадают с кистями ядра. -->
    <Window.Resources>
        <Style x:Key="Head" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="HeadBar" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,20,0,8" />
        </Style>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
        <Style x:Key="Example" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style x:Key="ColHead" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,8,4" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="20,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Сохранить" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Save_Click" />
                    <Button Content="Отмена" IsCancel="True" Margin="8,0,0,0" />
                </StackPanel>
                <TextBlock x:Name="Error" Foreground="{DynamicResource Error}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20,0,20,16">

                <DockPanel Style="{StaticResource HeadBar}">
                    <TextBlock Style="{StaticResource Head}" Text="Название" />
                </DockPanel>
                <TextBox x:Name="TaskName" TextChanged="Any_Changed" ToolTip="Оно же имя NWF задачи" />

                <DockPanel Style="{StaticResource HeadBar}">
                    <TextBlock Style="{StaticResource Head}" Text="Модели" />
                    <TextBlock x:Name="ModelsInfo" Style="{StaticResource Note}" Margin="12,0,0,0" />
                </DockPanel>
                <Grid x:Name="ModelsHead" Margin="0,0,40,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="80" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource ColHead}" Text="Модель" />
                    <TextBlock Grid.Column="1" Style="{StaticResource ColHead}" Text="Имя NWC" />
                    <TextBlock Grid.Column="2" Style="{StaticResource ColHead}" Text="Блок" />
                    <TextBlock Grid.Column="3" Style="{StaticResource ColHead}" Text="Отдел" />
                </Grid>
                <ItemsControl x:Name="ModelsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="260" />
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="40" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Path}" ToolTip="{Binding Path}" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                    <!-- сразу при наборе: Enter («Сохранить») не уводит курсор из поля -->
                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" ToolTip="Пусто — имя из имени модели" />
                                    <TextBlock Text="не по шаблону — имя как есть" Visibility="{Binding MismatchVisibility}"
                                               Foreground="{DynamicResource Muted}" FontSize="12" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding Block}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{Binding Department}" VerticalAlignment="Center" />
                                <Button Grid.Column="4" Style="{StaticResource IconButton}" Content="&#xE74D;" HorizontalAlignment="Right"
                                        VerticalAlignment="Top" Click="DeleteModel_Click" ToolTip="Убрать модель" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!-- одна кнопка — и Revit Server (с папки проекта), и сетевые папки (окно «Добавить модели») -->
                <Button Content="Добавить модели…" HorizontalAlignment="Left" Margin="0,2,0,0" Click="AddModels_Click" />

                <DockPanel Style="{StaticResource HeadBar}">
                    <TextBlock Style="{StaticResource Head}" Text="Проверки" />
                </DockPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Caption}" Text="Файл проверок" />
                    <DockPanel Grid.Column="1">
                        <Button x:Name="BrowseTests" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE8E5;"
                                Margin="4,0,0,0" Click="BrowseTests_Click" ToolTip="Выбрать файл (.xml из Clash Detective)" />
                        <TextBox x:Name="TestsFile" />
                    </DockPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock x:Name="TestsFrom" Style="{StaticResource Note}" Margin="0,0,8,0" />
                        <Button x:Name="TestsLink" Style="{StaticResource LinkButton}" />
                    </StackPanel>
                </Grid>

                <!-- куда ляжет — по папкам проекта -->
                <DockPanel Style="{StaticResource HeadBar}">
                    <TextBlock Style="{StaticResource Head}" Text="Куда" />
                </DockPanel>
                <TextBlock x:Name="NwcWhere" Style="{StaticResource Example}" />
                <TextBlock x:Name="NwfWhere" Style="{StaticResource Example}" />
                <TextBlock x:Name="ReportWhere" Style="{StaticResource Example}" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
