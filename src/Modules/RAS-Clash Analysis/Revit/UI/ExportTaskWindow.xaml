<Window x:Class="RASv2.ClashAnalysis.UI.ExportTaskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Задача" Width="1000" Height="780" MinWidth="820" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}" FontFamily="Segoe UI" FontSize="13">
    <!-- Настройки задачи или подзадачи «Задач выгрузки» (карандаш; DECISIONS.md модуля, «Разделы окна задачи — по разработчику
         (03.11.2026)»): «Общее», «Экспорт», «NWF и отчёты». Одна сетка на все строки (разработчик: «надписи, поля — ровнее»):
         подпись — 150, значение — на всю ширину (поле, «Обзор» за ним, пример — под ним), справа — колонка «от «…»» /
         «Изменить» одной ширины. Кнопки, поля, кисти — общие образцы ядра (подключаются до разметки); ключи своих стилей не
         совпадают с кистями ядра. -->
    <Window.Resources>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- заголовок раздела с линией под ним -->
        <Style x:Key="SectionHead" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="0,0,0,6" />
            <Setter Property="Margin" Value="0,24,0,14" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- строка: подпись | значение | от кого -->
        <Style x:Key="RowGrid" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <!-- подпись — по высоте первой строки значения (поле — 30) -->
        <Style x:Key="Cap" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,6,12,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <!-- первая строка значения — высотой с поле: текст, ссылки, кнопки — по её середине -->
        <Style x:Key="FirstLine" TargetType="DockPanel">
            <Setter Property="MinHeight" Value="30" />
        </Style>
        <!-- правая колонка: «от «…»» и «Изменить» — вправо, по середине первой строки -->
        <Style x:Key="Side" TargetType="StackPanel">
            <Setter Property="Grid.Column" Value="3" />
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="12,0,0,0" />
        </Style>
        <Style x:Key="From" TargetType="TextBlock" BasedOn="{StaticResource Note}">
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style x:Key="SideLink" TargetType="Button" BasedOn="{StaticResource LinkButton}">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- пример — под полем -->
        <Style x:Key="Example" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <Style x:Key="Chip" TargetType="Button" BasedOn="{StaticResource LinkButton}">
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="ToolTip" Value="Вставить в строку" />
        </Style>
        <Style x:Key="Browse" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Grid.Column" Value="2" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Content" Value="&#xF12B;" />
            <Setter Property="ToolTip" Value="Обзор" />
        </Style>
        <Style x:Key="ColHead" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,8,4" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="20,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Content="Экспорт…" Click="Export_Click" ToolTip="С подзадачами — в файл, чтобы поделиться" />
                    <Button Content="Импорт подзадач…" Margin="8,0,0,0" Click="Import_Click"
                            ToolTip="Задача или подзадача из файла — подзадачей сюда" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Сохранить" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Save_Click" />
                    <Button Content="Отмена" IsCancel="True" Margin="8,0,0,0" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center" Margin="16,0">
                    <TextBlock x:Name="Info" Style="{StaticResource Note}" TextWrapping="Wrap" />
                    <TextBlock x:Name="Error" Foreground="{DynamicResource Error}" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20,0,20,16">

                <!-- ══ Общее ══ -->
                <Border Style="{StaticResource SectionHead}" Margin="0,16,0,14">
                    <DockPanel>
                        <!-- где строка в дереве -->
                        <TextBlock x:Name="PathInfo" DockPanel.Dock="Right" Style="{StaticResource Note}" />
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Общее" />
                    </DockPanel>
                </Border>
                <Grid Style="{StaticResource RowGrid}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition /><ColumnDefinition Width="36" /><ColumnDefinition Width="250" /></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Cap}" Text="Название" />
                    <TextBox x:Name="TaskName" Grid.Column="1" TextChanged="Any_Changed" />
                </Grid>
                <Grid Style="{StaticResource RowGrid}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition /><ColumnDefinition Width="36" /><ColumnDefinition Width="250" /></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Cap}" Text="Папка задачи" />
                    <Button Grid.Column="2" x:Name="FolderBrowse" Style="{StaticResource Browse}" Click="BrowseProject_Click" />
                    <DockPanel Grid.Column="1" VerticalAlignment="Top">
                        <TextBox x:Name="Folder" TextChanged="Any_Changed" />
                    </DockPanel>
                    <StackPanel Style="{StaticResource Side}">
                        <TextBlock x:Name="FolderFrom" Style="{StaticResource From}" />
                        <Button x:Name="FolderLink" Style="{StaticResource SideLink}" />
                    </StackPanel>
                </Grid>

                <!-- ══ Экспорт ══ -->
                <Border Style="{StaticResource SectionHead}">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Экспорт" />
                </Border>
                <!-- вида нет, если в общих «Экспорт: Целый проект» -->
                <Grid x:Name="ViewRow" Style="{StaticResource RowGrid}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition /><ColumnDefinition Width="36" /><ColumnDefinition Width="250" /></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Cap}" Text="Выгружать вид" />
                    <TextBox x:Name="ViewName" Grid.Column="1" VerticalAlignment="Top" />
                    <StackPanel Style="{StaticResource Side}">
                        <TextBlock x:Name="ViewFrom" Style="{StaticResource From}" />
                        <Button x:Name="ViewLink" Style="{StaticResource SideLink}" />
                    </StackPanel>
                </Grid>

                <!-- внутри папки задачи; полный путь — тоже можно -->
                <Grid Style="{StaticResource RowGrid}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition /><ColumnDefinition Width="36" /><ColumnDefinition Width="250" /></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Cap}" Text="Папка для NWC" />
                    <Button Grid.Column="2" x:Name="NwcBrowse" Style="{StaticResource Browse}" Tag="{Binding ElementName=NwcFolder}" Click="Browse_Click" />
                    <StackPanel Grid.Column="1">
                        <DockPanel>
                            <TextBox x:Name="NwcFolder" TextChanged="Any_Changed" />
                        </DockPanel>
                        <StackPanel x:Name="NwcChips" Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Style="{StaticResource Note}" Text="Метки:" />
                            <Button Style="{StaticResource Chip}" Content="{}{Блок}" Tag="{Binding ElementName=NwcFolder}" Click="Chip_Click" />
                            <Button Style="{StaticResource Chip}" Content="{}{Отдел}" Tag="{Binding ElementName=NwcFolder}" Click="Chip_Click" />
                        </StackPanel>
                        <TextBlock x:Name="NwcExample" Style="{StaticResource Example}" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource Side}">
                        <TextBlock x:Name="NwcFrom" Style="{StaticResource From}" />
                        <Button x:Name="NwcLink" Style="{StaticResource SideLink}" />
                    </StackPanel>
                </Grid>

                <!-- модели: одной строкой, список по блокам — по «Показать» -->
                <Grid Style="{StaticResource RowGrid}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition /><ColumnDefinition Width="36" /><ColumnDefinition Width="250" /></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Cap}" Text="Модели" />
                    <DockPanel Grid.Column="1" Style="{StaticResource FirstLine}" VerticalAlignment="Top">
                        <Button x:Name="AddModels" DockPanel.Dock="Right" Content="Добавить модели…" Margin="12,0,0,0" Click="AddModels_Click" />
                        <Button x:Name="ModelsShow" DockPanel.Dock="Right" Style="{StaticResource SideLink}" Margin="12,0,0,0" Click="ModelsShow_Click" />
                        <TextBlock x:Name="ModelsSummary" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <StackPanel Style="{StaticResource Side}">
                        <TextBlock x:Name="ModelsFrom" Style="{StaticResource From}" />
                        <Button x:Name="ModelsLink" Style="{StaticResource SideLink}" Click="ModelsLink_Click" />
                    </StackPanel>
                </Grid>
                <StackPanel x:Name="ModelsPanel" Margin="150,0,0,16">
                    <Grid Margin="0,0,40,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="240" />
                            <ColumnDefinition Width="70" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource ColHead}" Text="Блок" />
                        <TextBlock Grid.Column="1" Style="{StaticResource ColHead}" Text="Модель" />
                        <TextBlock Grid.Column="2" Style="{StaticResource ColHead}" Text="Имя NWC" />
                        <TextBlock Grid.Column="3" Style="{StaticResource ColHead}" Text="Отдел" />
                    </Grid>
                    <ItemsControl x:Name="ModelsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="{Binding Gap}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="240" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="40" />
                                    </Grid.ColumnDefinitions>
                                    <!-- блок — у первой модели блока; у модели без блока в имени — поле: блок вписывается руками -->
                                    <TextBlock Text="{Binding BlockTitle}" FontWeight="SemiBold" VerticalAlignment="Center"
                                               Visibility="{Binding TitleVisibility}" />
                                    <TextBox Text="{Binding Block, UpdateSourceTrigger=PropertyChanged}" Width="60" HorizontalAlignment="Left"
                                             Visibility="{Binding BoxVisibility}" LostFocus="Block_LostFocus"
                                             ToolTip="В имени модели блока нет — впишите (например, S1)" />
                                    <!-- имя модели — первым, папка — бледным: длинный путь не прячет имя (разбор 02.11.2026) -->
                                    <TextBlock Grid.Column="1" ToolTip="{Binding Path}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                               Margin="0,0,8,0">
                                        <Run Text="{Binding FileName, Mode=OneWay}" />
                                        <Run Text="{Binding Folder, Mode=OneWay}" Foreground="{DynamicResource Muted}" FontSize="12" />
                                    </TextBlock>
                                    <!-- имя NWC — текстом, правится по двойному щелчку -->
                                    <Grid Grid.Column="2" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Visibility="{Binding ShowVisibility}"
                                                   MouseLeftButtonDown="NwcName_MouseDown" Background="Transparent"
                                                   ToolTip="Двойной щелчок — поправить имя NWC" />
                                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding EditVisibility}"
                                                 LostFocus="NwcName_LostFocus" ToolTip="Пусто — имя из имени модели" />
                                    </Grid>
                                    <TextBlock Grid.Column="3" Text="{Binding Department}" VerticalAlignment="Center" />
                                    <Button Grid.Column="4" Style="{StaticResource IconButton}" Content="&#xE74D;" HorizontalAlignment="Right"
                                            VerticalAlignment="Center" Click="DeleteModel_Click" ToolTip="Убрать модель"
                                            Visibility="{Binding DataContext.ModelsEditVisibility, RelativeSource={RelativeSource AncestorType=Window}}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- параметры экспортёра и «Удалить перед выгрузкой» — по общим настройкам или свои (то же окно, что шестерёнка) -->
                <Grid Style="{StaticResource RowGrid}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition /><ColumnDefinition Width="36" /><ColumnDefinition Width="250" /></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Cap}" Text="Настройки" />
                    <DockPanel Grid.Column="1" Style="{StaticResource FirstLine}" VerticalAlignment="Top">
                        <Button x:Name="ExportEdit" DockPanel.Dock="Right" Content="Изменить…" Margin="12,0,0,0" Click="ExportEdit_Click" />
                        <TextBlock x:Name="ExportFrom" VerticalAlignment="Center" />
                    </DockPanel>
                    <StackPanel Style="{StaticResource Side}">
                        <Button x:Name="ExportReset" Style="{StaticResource SideLink}" Click="ExportReset_Click" />
                    </StackPanel>
                </Grid>

                <!-- ══ NWF и отчёты ══ -->
                <Border Style="{StaticResource SectionHead}">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="NWF и отчёты" />
                </Border>
                <!-- NWF собирает строка без подзадач; у строки с подзадачами галочка недоступна -->
                <Grid Style="{StaticResource RowGrid}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition /><ColumnDefinition Width="36" /><ColumnDefinition Width="250" /></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Cap}" Text="Формировать NWF" />
                    <DockPanel Grid.Column="1" Style="{StaticResource FirstLine}" VerticalAlignment="Top">
                        <CheckBox x:Name="MakeNwf" VerticalAlignment="Center" Checked="Any_Changed" Unchecked="Any_Changed" />
                    </DockPanel>
                </Grid>
                <Grid Style="{StaticResource RowGrid}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition /><ColumnDefinition Width="36" /><ColumnDefinition Width="250" /></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Cap}" Text="Имя NWF" />
                    <StackPanel Grid.Column="1">
                        <TextBox x:Name="NwfName" TextChanged="Any_Changed" />
                        <TextBlock x:Name="NwfNameExample" Style="{StaticResource Example}" />
                    </StackPanel>
                </Grid>

                <Grid Style="{StaticResource RowGrid}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition /><ColumnDefinition Width="36" /><ColumnDefinition Width="250" /></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Cap}" Text="Проверки" />
                    <!-- на две колонки: корзины — в колонке «Обзора», поля кончаются на одной линии с остальными -->
                    <StackPanel Grid.Column="1" Grid.ColumnSpan="2">
                        <!-- от уровня выше — именами в строку; свои — списком с корзинами -->
                        <DockPanel Style="{StaticResource FirstLine}">
                            <TextBlock x:Name="TestsInline" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <StackPanel x:Name="TestsPanel">
                            <ItemsControl x:Name="TestsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel MinHeight="30">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE74D;" Margin="4,0,0,0" Width="32"
                                                    Click="DeleteTests_Click" ToolTip="Убрать файл" />
                                            <TextBlock ToolTip="{Binding Path}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                                <Run Text="{Binding Name, Mode=OneWay}" />
                                                <Run Text="{Binding Folder, Mode=OneWay}" Foreground="{DynamicResource Muted}" FontSize="12" />
                                            </TextBlock>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="Добавить…" HorizontalAlignment="Left" Margin="0,4,0,0" Click="AddTests_Click"
                                    ToolTip="Файлы проверок .xml из Clash Detective — можно несколько" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Style="{StaticResource Side}">
                        <TextBlock x:Name="TestsFrom" Style="{StaticResource From}" />
                        <Button x:Name="TestsLink" Style="{StaticResource SideLink}" Click="TestsLink_Click" />
                    </StackPanel>
                </Grid>

                <!-- скрыть в NWF по имени элемента (разработчик, 03.11.2026: в задаче, передаётся подзадачам) -->
                <Grid Style="{StaticResource RowGrid}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition /><ColumnDefinition Width="36" /><ColumnDefinition Width="250" /></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Cap}" Text="Скрыть в NWF" />
                    <StackPanel Grid.Column="1" Grid.ColumnSpan="2">
                        <DockPanel Style="{StaticResource FirstLine}">
                            <TextBlock x:Name="HideInline" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <StackPanel x:Name="HidePanel">
                            <ItemsControl x:Name="HideList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,0,0,6">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE74D;" Margin="4,0,0,0" Width="32"
                                                    Click="DeleteHide_Click" ToolTip="Удалить правило" />
                                            <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" ToolTip="Часть имени элемента" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="Добавить правило" HorizontalAlignment="Left" Click="AddHide_Click" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Style="{StaticResource Side}">
                        <TextBlock x:Name="HideFrom" Style="{StaticResource From}" />
                        <Button x:Name="HideLink" Style="{StaticResource SideLink}" Click="HideLink_Click" />
                    </StackPanel>
                </Grid>

                <Grid Style="{StaticResource RowGrid}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition /><ColumnDefinition Width="36" /><ColumnDefinition Width="250" /></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Cap}" Text="Папка для NWF" />
                    <Button Grid.Column="2" x:Name="NwfBrowse" Style="{StaticResource Browse}" Tag="{Binding ElementName=NwfFolder}" Click="Browse_Click" />
                    <StackPanel Grid.Column="1">
                        <DockPanel>
                            <TextBox x:Name="NwfFolder" TextChanged="Any_Changed" />
                        </DockPanel>
                        <TextBlock x:Name="NwfExample" Style="{StaticResource Example}" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource Side}">
                        <TextBlock x:Name="NwfFrom" Style="{StaticResource From}" />
                        <Button x:Name="NwfLink" Style="{StaticResource SideLink}" />
                    </StackPanel>
                </Grid>

                <Grid Style="{StaticResource RowGrid}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition /><ColumnDefinition Width="36" /><ColumnDefinition Width="250" /></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Cap}" Text="Папка для отчётов" />
                    <Button Grid.Column="2" x:Name="ReportBrowse" Style="{StaticResource Browse}" Tag="{Binding ElementName=ReportFolder}" Click="Browse_Click" />
                    <StackPanel Grid.Column="1">
                        <DockPanel>
                            <TextBox x:Name="ReportFolder" TextChanged="Any_Changed" />
                        </DockPanel>
                        <StackPanel x:Name="ReportChips" Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Style="{StaticResource Note}" Text="Метки:" />
                            <Button Style="{StaticResource Chip}" Content="{}{Блок}" Tag="{Binding ElementName=ReportFolder}" Click="Chip_Click" />
                            <Button Style="{StaticResource Chip}" Content="{}{Дата}" Tag="{Binding ElementName=ReportFolder}" Click="Chip_Click" />
                            <Button Style="{StaticResource Chip}" Content="{}{Формат}" Tag="{Binding ElementName=ReportFolder}" Click="Chip_Click" />
                        </StackPanel>
                        <TextBlock x:Name="ReportExample" Style="{StaticResource Example}" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource Side}">
                        <TextBlock x:Name="ReportFrom" Style="{StaticResource From}" />
                        <Button x:Name="ReportLink" Style="{StaticResource SideLink}" />
                    </StackPanel>
                </Grid>

                <!-- форматы — выпадающий список с галочками: все форматы отчёта Clash Detective (разработчик, 03.11.2026) -->
                <Grid Style="{StaticResource RowGrid}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition /><ColumnDefinition Width="36" /><ColumnDefinition Width="250" /></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Cap}" Text="Формат отчётов" />
                    <ComboBox x:Name="Formats" Grid.Column="1" VerticalAlignment="Top" MinHeight="30" VerticalContentAlignment="Center"
                              IsEditable="True" IsReadOnly="True" StaysOpenOnEdit="True" DropDownClosed="Formats_Closed">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Name}" IsChecked="{Binding On}" Checked="Format_Changed" Unchecked="Format_Changed" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <StackPanel Style="{StaticResource Side}">
                        <TextBlock x:Name="FormatsFrom" Style="{StaticResource From}" />
                        <Button x:Name="FormatsLink" Style="{StaticResource SideLink}" Click="FormatsLink_Click" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
