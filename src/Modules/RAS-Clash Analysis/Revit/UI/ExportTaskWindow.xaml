<Window x:Class="RASv2.ClashAnalysis.UI.ExportTaskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Задача" Width="980" Height="720" MinWidth="780" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}" FontFamily="Segoe UI" FontSize="13">
    <!-- Настройки задачи или подзадачи «Задач выгрузки» (карандаш; DECISIONS.md модуля, «Окно настроек — по смыслу (03.11.2026)»,
         набросок принят — «давай делаем»): разделы «Проект» (у задачи верхнего уровня), «Что входит» (модели, проверки), «NWF» (у
         строки без подзадач), «Куда класть» (папки, форматы, вид — свёрнуты в строку путей, пока у строки там своего нет).
         Наследование — одна подпись на раздел или строку («от «…»»). Кнопки, поля, кисти — общие образцы ядра (подключаются до
         разметки); ключи своих стилей не совпадают с кистями ядра. -->
    <Window.Resources>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- заголовок раздела с линией под ним -->
        <Style x:Key="SectionHead" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="0,0,0,6" />
            <Setter Property="Margin" Value="0,22,0,12" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- подпись слева в строке раздела -->
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Width" Value="150" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="TopCaption" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
        <Style x:Key="Spaced" TargetType="FrameworkElement">
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="Example" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- «от «…»» рядом со значением -->
        <Style x:Key="From" TargetType="TextBlock" BasedOn="{StaticResource Note}">
            <Setter Property="Margin" Value="12,0,8,0" />
        </Style>
        <Style x:Key="Chip" TargetType="Button" BasedOn="{StaticResource LinkButton}">
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="ToolTip" Value="Вставить в строку" />
        </Style>
        <Style x:Key="Browse" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Content" Value="&#xF12B;" />
            <Setter Property="ToolTip" Value="Обзор" />
        </Style>
        <Style x:Key="ColHead" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,8,4" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="20,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Content="Экспорт…" Click="Export_Click" ToolTip="С подзадачами — в файл, чтобы поделиться" />
                    <Button Content="Импорт подзадач…" Margin="8,0,0,0" Click="Import_Click"
                            ToolTip="Задача или подзадача из файла — подзадачей сюда" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Сохранить" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Save_Click" />
                    <Button Content="Отмена" IsCancel="True" Margin="8,0,0,0" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center" Margin="16,0">
                    <TextBlock x:Name="Info" Style="{StaticResource Note}" TextWrapping="Wrap" />
                    <TextBlock x:Name="Error" Foreground="{DynamicResource Error}" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20,14,20,16">
                <!-- название и где строка в дереве -->
                <DockPanel>
                    <TextBlock x:Name="PathInfo" DockPanel.Dock="Right" Style="{StaticResource Note}" Margin="16,0,0,0" />
                    <TextBox x:Name="TaskName" FontSize="16" TextChanged="Any_Changed" />
                </DockPanel>

                <!-- ── Проект (у задачи верхнего уровня): папка проекта переезжает сюда из «Куда класть» ── -->
                <StackPanel x:Name="ProjectSection">
                    <Border Style="{StaticResource SectionHead}">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Проект" />
                    </Border>
                </StackPanel>

                <!-- ── Что входит ── -->
                <Border Style="{StaticResource SectionHead}">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Что входит" />
                </Border>
                <DockPanel Style="{StaticResource Spaced}">
                    <TextBlock Style="{StaticResource Caption}" Text="Модели" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="AddModels" Content="Добавить модели…" Margin="12,0,0,0" Click="AddModels_Click" />
                        <TextBlock x:Name="ModelsFrom" Style="{StaticResource From}" />
                        <Button x:Name="ModelsLink" Style="{StaticResource LinkButton}" Click="ModelsLink_Click" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="ModelsSummary" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <Button x:Name="ModelsShow" Style="{StaticResource LinkButton}" Margin="12,0,0,0" Click="ModelsShow_Click" />
                    </StackPanel>
                </DockPanel>
                <StackPanel x:Name="ModelsPanel" Margin="150,0,0,16">
                    <Grid Margin="0,0,40,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="240" />
                            <ColumnDefinition Width="70" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource ColHead}" Text="Блок" />
                        <TextBlock Grid.Column="1" Style="{StaticResource ColHead}" Text="Модель" />
                        <TextBlock Grid.Column="2" Style="{StaticResource ColHead}" Text="Имя NWC" />
                        <TextBlock Grid.Column="3" Style="{StaticResource ColHead}" Text="Отдел" />
                    </Grid>
                    <ItemsControl x:Name="ModelsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="{Binding Gap}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="240" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="40" />
                                    </Grid.ColumnDefinitions>
                                    <!-- блок — у первой модели блока; у модели без блока в имени — поле: блок вписывается руками -->
                                    <TextBlock Text="{Binding BlockTitle}" FontWeight="SemiBold" VerticalAlignment="Center"
                                               Visibility="{Binding TitleVisibility}" />
                                    <TextBox Text="{Binding Block, UpdateSourceTrigger=PropertyChanged}" Width="60" HorizontalAlignment="Left"
                                             Visibility="{Binding BoxVisibility}" LostFocus="Block_LostFocus"
                                             ToolTip="В имени модели блока нет — впишите (например, S1)" />
                                    <!-- имя модели — первым, папка — бледным: длинный путь не прячет имя (разбор 02.11.2026) -->
                                    <TextBlock Grid.Column="1" ToolTip="{Binding Path}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                               Margin="0,0,8,0">
                                        <Run Text="{Binding FileName, Mode=OneWay}" />
                                        <Run Text="{Binding Folder, Mode=OneWay}" Foreground="{DynamicResource Muted}" FontSize="12" />
                                    </TextBlock>
                                    <!-- имя NWC — текстом, правится по двойному щелчку (набросок 03.11.2026: поля ввода в каждой строке — шум) -->
                                    <Grid Grid.Column="2" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Visibility="{Binding ShowVisibility}"
                                                   MouseLeftButtonDown="NwcName_MouseDown" Background="Transparent"
                                                   ToolTip="Двойной щелчок — поправить имя NWC" />
                                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding EditVisibility}"
                                                 LostFocus="NwcName_LostFocus" ToolTip="Пусто — имя из имени модели" />
                                    </Grid>
                                    <TextBlock Grid.Column="3" Text="{Binding Department}" VerticalAlignment="Center" />
                                    <Button Grid.Column="4" Style="{StaticResource IconButton}" Content="&#xE74D;" HorizontalAlignment="Right"
                                            VerticalAlignment="Center" Click="DeleteModel_Click" ToolTip="Убрать модель"
                                            Visibility="{Binding DataContext.ModelsEditVisibility, RelativeSource={RelativeSource AncestorType=Window}}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <DockPanel Style="{StaticResource Spaced}">
                    <TextBlock Style="{StaticResource TopCaption}" Text="Проверки" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,6,0,0">
                        <TextBlock x:Name="TestsFrom" Style="{StaticResource From}" />
                        <Button x:Name="TestsLink" Style="{StaticResource LinkButton}" Click="TestsLink_Click" />
                    </StackPanel>
                    <StackPanel>
                        <!-- от уровня выше — именами в строку; свои — списком с корзинами -->
                        <TextBlock x:Name="TestsInline" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                        <StackPanel x:Name="TestsPanel">
                            <ItemsControl x:Name="TestsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,4,0,0">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE74D;" Margin="4,0,0,0"
                                                    Click="DeleteTests_Click" ToolTip="Убрать файл" />
                                            <TextBlock ToolTip="{Binding Path}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                                <Run Text="{Binding Name, Mode=OneWay}" />
                                                <Run Text="{Binding Folder, Mode=OneWay}" Foreground="{DynamicResource Muted}" FontSize="12" />
                                            </TextBlock>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="Добавить…" HorizontalAlignment="Left" Margin="0,6,0,0" Click="AddTests_Click"
                                    ToolTip="Файлы проверок .xml из Clash Detective — можно несколько" />
                        </StackPanel>
                    </StackPanel>
                </DockPanel>

                <!-- ── NWF (у строки без подзадач) ── -->
                <StackPanel x:Name="NwfSection">
                    <Border Style="{StaticResource SectionHead}">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="NWF" />
                    </Border>
                    <StackPanel Orientation="Horizontal" Style="{StaticResource Spaced}">
                        <CheckBox x:Name="MakeNwf" Content="Формировать NWF" Width="150" VerticalAlignment="Center"
                                  Checked="Any_Changed" Unchecked="Any_Changed" />
                        <TextBlock Text="Имя" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox x:Name="NwfName" Width="240" TextChanged="Any_Changed" />
                        <TextBlock x:Name="NwfNameExample" Style="{StaticResource Example}" Margin="16,0,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- ── Куда класть: свёрнуто — строка итоговых путей; развёрнуто — поля ── -->
                <Border Style="{StaticResource SectionHead}">
                    <DockPanel>
                        <Button x:Name="WhereToggle" DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Click="WhereToggle_Click" />
                        <TextBlock x:Name="WhereFrom" DockPanel.Dock="Right" Style="{StaticResource From}" />
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Куда класть" />
                    </DockPanel>
                </Border>
                <StackPanel x:Name="WhereSummary">
                    <TextBlock x:Name="WhereLine1" TextWrapping="Wrap" />
                    <TextBlock x:Name="WhereLine2" Style="{StaticResource Note}" HorizontalAlignment="Left" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel x:Name="WherePanel">
                    <DockPanel x:Name="FolderRow" Style="{StaticResource Spaced}">
                        <TextBlock Style="{StaticResource Caption}" Text="Папка проекта" />
                        <Button x:Name="FolderLink" DockPanel.Dock="Right" Style="{StaticResource LinkButton}" />
                        <TextBlock x:Name="FolderFrom" DockPanel.Dock="Right" Style="{StaticResource From}" />
                        <Button x:Name="FolderBrowse" DockPanel.Dock="Right" Style="{StaticResource Browse}" Click="BrowseProject_Click" />
                        <TextBox x:Name="Folder" TextChanged="Any_Changed" />
                    </DockPanel>

                    <!-- внутри папки проекта; полный путь — тоже можно -->
                    <DockPanel Style="{StaticResource Spaced}">
                        <TextBlock Style="{StaticResource TopCaption}" Text="Папка для NWC" />
                        <StackPanel>
                            <DockPanel>
                                <Button x:Name="NwcLink" DockPanel.Dock="Right" Style="{StaticResource LinkButton}" />
                                <TextBlock x:Name="NwcFrom" DockPanel.Dock="Right" Style="{StaticResource From}" />
                                <Button x:Name="NwcBrowse" DockPanel.Dock="Right" Style="{StaticResource Browse}" Tag="{Binding ElementName=NwcFolder}"
                                        Click="Browse_Click" />
                                <TextBox x:Name="NwcFolder" TextChanged="Any_Changed" />
                            </DockPanel>
                            <StackPanel x:Name="NwcChips" Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Style="{StaticResource Note}" Text="Метки:" />
                                <Button Style="{StaticResource Chip}" Content="{}{Блок}" Tag="{Binding ElementName=NwcFolder}" Click="Chip_Click" />
                                <Button Style="{StaticResource Chip}" Content="{}{Отдел}" Tag="{Binding ElementName=NwcFolder}" Click="Chip_Click" />
                            </StackPanel>
                            <TextBlock x:Name="NwcExample" Style="{StaticResource Example}" />
                        </StackPanel>
                    </DockPanel>

                    <DockPanel Style="{StaticResource Spaced}">
                        <TextBlock Style="{StaticResource Caption}" Text="Папка для NWF" />
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="NwfFolder" Width="260" TextChanged="Any_Changed" />
                            <Button x:Name="NwfBrowse" Style="{StaticResource Browse}" Tag="{Binding ElementName=NwfFolder}" Click="Browse_Click" />
                            <TextBlock x:Name="NwfFrom" Style="{StaticResource From}" />
                            <Button x:Name="NwfLink" Style="{StaticResource LinkButton}" />
                            <TextBlock x:Name="NwfExample" Style="{StaticResource Example}" Margin="16,0,0,0" />
                        </StackPanel>
                    </DockPanel>

                    <DockPanel Style="{StaticResource Spaced}">
                        <TextBlock Style="{StaticResource TopCaption}" Text="Папка для отчётов" />
                        <StackPanel>
                            <DockPanel>
                                <Button x:Name="ReportLink" DockPanel.Dock="Right" Style="{StaticResource LinkButton}" />
                                <TextBlock x:Name="ReportFrom" DockPanel.Dock="Right" Style="{StaticResource From}" />
                                <Button x:Name="ReportBrowse" DockPanel.Dock="Right" Style="{StaticResource Browse}" Tag="{Binding ElementName=ReportFolder}"
                                        Click="Browse_Click" />
                                <TextBox x:Name="ReportFolder" TextChanged="Any_Changed" />
                            </DockPanel>
                            <StackPanel x:Name="ReportChips" Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Style="{StaticResource Note}" Text="Метки:" />
                                <Button Style="{StaticResource Chip}" Content="{}{Блок}" Tag="{Binding ElementName=ReportFolder}" Click="Chip_Click" />
                                <Button Style="{StaticResource Chip}" Content="{}{Дата}" Tag="{Binding ElementName=ReportFolder}" Click="Chip_Click" />
                                <Button Style="{StaticResource Chip}" Content="{}{Формат}" Tag="{Binding ElementName=ReportFolder}" Click="Chip_Click" />
                            </StackPanel>
                            <TextBlock x:Name="ReportExample" Style="{StaticResource Example}" />
                        </StackPanel>
                    </DockPanel>

                    <DockPanel Style="{StaticResource Spaced}">
                        <TextBlock Style="{StaticResource Caption}" Text="Форматы отчётов" />
                        <StackPanel Orientation="Horizontal">
                            <CheckBox x:Name="Xml" Content="XML" VerticalAlignment="Center" Checked="Any_Changed" Unchecked="Any_Changed" />
                            <CheckBox x:Name="Html" Content="HTML" VerticalAlignment="Center" Margin="20,0,0,0" Checked="Any_Changed" Unchecked="Any_Changed" />
                            <TextBlock x:Name="FormatsFrom" Style="{StaticResource From}" />
                            <Button x:Name="FormatsLink" Style="{StaticResource LinkButton}" Click="FormatsLink_Click" />
                        </StackPanel>
                    </DockPanel>

                    <!-- вида нет, если в общих «Экспорт: Целый проект» -->
                    <DockPanel x:Name="ViewRow" Style="{StaticResource Spaced}">
                        <TextBlock Style="{StaticResource Caption}" Text="Вид для выгрузки" />
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="ViewName" Width="260" />
                            <TextBlock x:Name="ViewFrom" Style="{StaticResource From}" />
                            <Button x:Name="ViewLink" Style="{StaticResource LinkButton}" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
