<Window x:Class="RASv2.ClashAnalysis.UI.ExportNodeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки" Width="900" Height="640" MinWidth="720" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}" FontFamily="Segoe UI" FontSize="13">
    <!-- Настройки строки «Задач выгрузки» (карандаш, DECISIONS.md модуля) — только то, что различается между проектами (разбор
         настроек, 02.11.2026): название, модели, папки, вид; остальное — общее (шестерёнка). Каждая строка папок и вида
         наследуется отдельно: «как у «…»» бледным и «Изменить», своя — «Вернуть как у «…»»; у задачи — своё сразу. Модели —
         только у одной строки на ветке. Кнопки, поля, кисти — общие образцы ядра (подключаются до разметки); ключи своих
         стилей не совпадают с кистями ядра. -->
    <Window.Resources>
        <Style x:Key="Head" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="HeadBar" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,20,0,8" />
        </Style>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
        <Style x:Key="Example" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,10" />
        </Style>
        <Style x:Key="ColHead" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,8,4" />
        </Style>
        <!-- «как у …» и «Изменить» / «Вернуть как у …» справа от поля -->
        <Style x:Key="FieldState" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="12,0,0,0" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="20,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Сохранить" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Save_Click" />
                    <Button Content="Отмена" IsCancel="True" Margin="8,0,0,0" />
                </StackPanel>
                <TextBlock x:Name="Error" Foreground="{DynamicResource Error}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20,0,20,16">

                <DockPanel Style="{StaticResource HeadBar}">
                    <TextBlock Style="{StaticResource Head}" Text="Название" />
                </DockPanel>
                <TextBox x:Name="NodeName" TextChanged="Any_Changed" />

                <!-- Модели: у одной строки на ветке; у остальных — где они -->
                <DockPanel Style="{StaticResource HeadBar}">
                    <TextBlock Style="{StaticResource Head}" Text="Модели" />
                    <TextBlock x:Name="ModelsInfo" Style="{StaticResource Note}" Margin="12,0,0,0" />
                </DockPanel>
                <StackPanel x:Name="ModelsPanel">
                    <Grid x:Name="ModelsHead" Margin="0,0,40,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="56" />
                            <ColumnDefinition Width="80" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource ColHead}" Text="Модель" />
                        <TextBlock Grid.Column="1" Style="{StaticResource ColHead}" Text="Имя NWC" />
                        <TextBlock Grid.Column="2" Style="{StaticResource ColHead}" Text="Блок" />
                        <TextBlock Grid.Column="3" Style="{StaticResource ColHead}" Text="Отдел" />
                    </Grid>
                    <ItemsControl x:Name="ModelsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="260" />
                                        <ColumnDefinition Width="56" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="40" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Path}" ToolTip="{Binding Path}" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                        <!-- сразу при наборе: Enter («Сохранить») не уводит курсор из поля -->
                                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" ToolTip="Пусто — имя из имени модели" />
                                        <TextBlock Text="не по шаблону — имя как есть" Visibility="{Binding MismatchVisibility}"
                                                   Foreground="{DynamicResource Muted}" FontSize="12" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Block}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{Binding Department}" VerticalAlignment="Center" />
                                    <Button Grid.Column="4" Style="{StaticResource IconButton}" Content="&#xE74D;" HorizontalAlignment="Right"
                                            VerticalAlignment="Top" Click="DeleteModel_Click" ToolTip="Убрать модель" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- одна кнопка — и сетевые папки, и Revit Server (разработчик, 02.11.2026: «какая разница, с Revit Server или с
                         компьютера — одной кнопкой») -->
                    <Button Content="Добавить модели…" HorizontalAlignment="Left" Margin="0,2,0,0" Click="AddModels_Click" />
                </StackPanel>

                <!-- Папки и вид: строка — своя или как у строки выше -->
                <DockPanel Style="{StaticResource HeadBar}">
                    <TextBlock Style="{StaticResource Head}" Text="Папки и вид" />
                </DockPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- папки NWC нет у строки ниже строки с моделями (критичность): NWC выгружает блок -->
                    <TextBlock x:Name="NwcCaption" Style="{StaticResource Caption}" Text="Папка NWC" />
                    <TextBox x:Name="NwcFolder" Grid.Column="1" TextChanged="Any_Changed" />
                    <StackPanel x:Name="NwcState" Grid.Column="2" Style="{StaticResource FieldState}">
                        <TextBlock x:Name="NwcFrom" Style="{StaticResource Note}" Margin="0,0,8,0" />
                        <Button x:Name="NwcLink" Style="{StaticResource LinkButton}" />
                    </StackPanel>
                    <TextBlock x:Name="NwcExample" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource Example}" />

                    <TextBlock Grid.Row="2" Style="{StaticResource Caption}" Text="Папка отчётов" />
                    <TextBox x:Name="ReportFolder" Grid.Row="2" Grid.Column="1" TextChanged="Any_Changed" />
                    <StackPanel Grid.Row="2" Grid.Column="2" Style="{StaticResource FieldState}">
                        <TextBlock x:Name="ReportFrom" Style="{StaticResource Note}" Margin="0,0,8,0" />
                        <Button x:Name="ReportLink" Style="{StaticResource LinkButton}" />
                    </StackPanel>
                    <TextBlock x:Name="ReportExample" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource Example}" />

                    <!-- вида нет, если в общих «Экспорт: Целый проект» -->
                    <TextBlock x:Name="ViewCaption" Grid.Row="4" Style="{StaticResource Caption}" Text="Вид для выгрузки" />
                    <TextBox x:Name="ViewName" Grid.Row="4" Grid.Column="1" Width="240" HorizontalAlignment="Left" />
                    <StackPanel x:Name="ViewState" Grid.Row="4" Grid.Column="2" Style="{StaticResource FieldState}">
                        <TextBlock x:Name="ViewFrom" Style="{StaticResource Note}" Margin="0,0,8,0" />
                        <Button x:Name="ViewLink" Style="{StaticResource LinkButton}" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
