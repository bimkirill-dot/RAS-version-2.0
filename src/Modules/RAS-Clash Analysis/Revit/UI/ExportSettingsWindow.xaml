<Window x:Class="RASv2.ClashAnalysis.UI.ExportSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Общие настройки выгрузки" Width="780" Height="860" MinWidth="730" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}" FontFamily="Segoe UI" FontSize="13">
    <!-- Общие настройки «Задач выгрузки» (шестерёнка главного окна, DECISIONS.md модуля) — всё, что одно на компанию (разбор
         настроек, 02.11.2026). Параметры выгрузки NWC — как в окне экспортёра Navisworks в Revit: подписи и значения списков —
         дословно из экспортёра Revit 2026 (`ru-RU\nwexportrevit.name`), порядок — по снимку разработчика; параметров, которых нет
         в Revit API («Внедрить текстуры», «Отделить пользовательские свойства», «Свойства типа для элементов», «Точное
         сечение»), нет. Дальше — что удалить перед выгрузкой, имя модели и метки, отделы. Подпись — вправо до общей границы,
         значение — слева, строки разделены линиями. Кнопки, поля, кисти — общие образцы ядра (подключаются до разметки); ключи
         своих стилей не совпадают с кистями ядра. -->
    <Window.Resources>
        <Style x:Key="Head" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="HeadBar" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,22,0,4" />
        </Style>
        <Style x:Key="OptionRow" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="0,6" />
            <Setter Property="MinHeight" Value="40" />
        </Style>
        <Style x:Key="OptionName" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,14,0" />
        </Style>
        <Style x:Key="Inline" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8,0" />
        </Style>
        <Style x:Key="ColHead" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,8,4" />
        </Style>
        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="20,12">
            <DockPanel>
                <!-- поделиться с коллегой (разработчик, 02.11.2026): импорт заполняет окно, сохраняется по «Сохранить» -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Content="Экспорт…" Click="Export_Click" ToolTip="Общие настройки — в файл, чтобы поделиться" />
                    <Button Content="Импорт…" Margin="8,0,0,0" Click="Import_Click" ToolTip="Общие настройки из файла — в это окно" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Сохранить" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Save_Click" />
                    <Button Content="Отмена" IsCancel="True" Margin="8,0,0,0" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center" Margin="16,0">
                    <TextBlock x:Name="Info" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" />
                    <TextBlock x:Name="Error" Foreground="{DynamicResource Error}" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20,0,20,16">

                <!-- «По умолчанию» — только параметры экспортёра (значения со снимка разработчика): таблицу отделов не стирает -->
                <DockPanel Style="{StaticResource HeadBar}">
                    <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="По умолчанию" Click="Defaults_Click" />
                    <TextBlock Style="{StaticResource Head}" Text="Параметры выгрузки NWC" />
                </DockPanel>
                <Border Style="{StaticResource OptionRow}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="380" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource OptionName}" Text="Конвертировать идентификаторы объектов" />
                        <!-- всегда включено: по номерам элементов работают «Показать в Revit» и «Коллизии элемента» -->
                        <CheckBox Grid.Column="1" IsChecked="True" IsEnabled="False"
                                  ToolTipService.ShowOnDisabled="True" ToolTip="Нужно сайту коллизий: «Показать в Revit», «Коллизии элемента»" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource OptionRow}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="380" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource OptionName}" Text="Конвертировать параметры объектов" />
                        <ComboBox Grid.Column="1" x:Name="Parameters" Width="140">
                            <ComboBoxItem Content="Нет" />
                            <ComboBoxItem Content="Объекты" />
                            <ComboBoxItem Content="Все" />
                        </ComboBox>
                    </Grid>
                </Border>
                <Border Style="{StaticResource OptionRow}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="380" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource OptionName}" Text="Координаты" />
                        <ComboBox Grid.Column="1" x:Name="Coordinates" Width="200">
                            <ComboBoxItem Content="Внутренние для проекта" />
                            <ComboBoxItem Content="Общие" />
                        </ComboBox>
                    </Grid>
                </Border>
                <Border Style="{StaticResource OptionRow}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="380" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource OptionName}" Text="Коэффициент фасетизации" />
                        <TextBox Grid.Column="1" x:Name="Faceting" Width="140" HorizontalAlignment="Left" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource OptionRow}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="380" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource OptionName}" Text="Преобразование свойств элементов из предыдущих версий" />
                        <CheckBox Grid.Column="1" x:Name="ElementProperties" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource OptionRow}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="380" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource OptionName}" Text="Преобразовать URL-адреса" />
                        <CheckBox Grid.Column="1" x:Name="Urls" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource OptionRow}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="380" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource OptionName}" Text="Преобразовать источники света" />
                        <CheckBox Grid.Column="1" x:Name="Lights" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource OptionRow}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="380" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource OptionName}" Text="Преобразовать помещение как атрибут" />
                        <CheckBox Grid.Column="1" x:Name="RoomAsAttribute" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource OptionRow}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="380" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource OptionName}" Text="Преобразовать связанные CAD файлы" />
                        <CheckBox Grid.Column="1" x:Name="LinkedCad" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource OptionRow}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="380" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource OptionName}" Text="Преобразовать связанные файлы" />
                        <CheckBox Grid.Column="1" x:Name="LinkedFiles" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource OptionRow}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="380" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource OptionName}" Text="Преобразовать элементы конструкции" />
                        <CheckBox Grid.Column="1" x:Name="Parts" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource OptionRow}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="380" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource OptionName}" Text="Проверять и находить отсутствующие материалы" />
                        <CheckBox Grid.Column="1" x:Name="MissingMaterials" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource OptionRow}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="380" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource OptionName}" Text="Разделить файл на уровни" />
                        <CheckBox Grid.Column="1" x:Name="Levels" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource OptionRow}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="380" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource OptionName}" Text="Экспорт" />
                        <!-- «Вид» (в экспортёре — «Текущий вид»; разработчик: «замени на просто „вид“») — вид с этим именем: модель
                             открывает плагин; имя — в этой же строке; у задачи может быть свой вид (карандаш) -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <ComboBox x:Name="Scope" Width="130" SelectionChanged="Scope_Changed">
                                <ComboBoxItem Content="Целый проект" />
                                <ComboBoxItem Content="Вид" />
                            </ComboBox>
                            <TextBox x:Name="ViewName" Width="160" Margin="8,0,0,0" ToolTip="Имя вида для выгрузки" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource OptionRow}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="380" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource OptionName}" Text="Экспортировать геометрию помещения" />
                        <CheckBox Grid.Column="1" x:Name="RoomGeometry" />
                    </Grid>
                </Border>

                <DockPanel Style="{StaticResource HeadBar}">
                    <TextBlock Style="{StaticResource Head}" Text="Удалить из модели перед выгрузкой" />
                </DockPanel>
                <Border Style="{StaticResource OptionRow}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="380" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource OptionName}" Text="Связи Revit" />
                        <CheckBox Grid.Column="1" x:Name="RemoveRevitLinks" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource OptionRow}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="380" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource OptionName}" Text="DWG и другие CAD — связанные и импортированные" />
                        <CheckBox Grid.Column="1" x:Name="RemoveCad" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource OptionRow}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="380" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource OptionName}" Text="Облака точек" />
                        <CheckBox Grid.Column="1" x:Name="RemovePointClouds" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource OptionRow}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="380" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource OptionName}" Text="Связи IFC" />
                        <CheckBox Grid.Column="1" x:Name="RemoveIfc" />
                    </Grid>
                </Border>

                <!-- имя модели — один регламент на компанию: обрезка имени NWC и метки (разбор настроек, 02.11.2026) -->
                <DockPanel Style="{StaticResource HeadBar}">
                    <TextBlock Style="{StaticResource Head}" Text="Имя модели и метки" />
                </DockPanel>
                <Border Style="{StaticResource OptionRow}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="380" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource OptionName}" Text="Обрезать имя NWC по шаблону" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <CheckBox x:Name="TrimName" Checked="Any_Changed" Unchecked="Any_Changed" />
                            <TextBlock Style="{StaticResource Inline}" Text="частей через «_»" />
                            <TextBox x:Name="NameParts" Width="56" HorizontalContentAlignment="Right" TextChanged="Any_Changed" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource OptionRow}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="380" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource OptionName}" Text="{}{Блок}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBlock Text="часть имени:" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox x:Name="BlockPrefix" Width="56" TextChanged="Any_Changed" />
                            <TextBlock Style="{StaticResource Inline}" Text="и цифры" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource OptionRow}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="380" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource OptionName}" Text="{}{Отдел}" />
                        <TextBlock Grid.Column="1" Text="код из таблицы «Отделы», найденный в имени" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource OptionRow}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="380" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource OptionName}" Text="{}{Дата}" />
                        <ComboBox Grid.Column="1" x:Name="DateFormat" Width="200" SelectionChanged="Any_Changed" />
                    </Grid>
                </Border>
                <TextBlock x:Name="NameExample" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" />

                <DockPanel Style="{StaticResource HeadBar}">
                    <TextBlock Style="{StaticResource Head}" Text="Отделы" />
                </DockPanel>
                <Grid Margin="0,4,40,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="200" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource ColHead}" Text="Код" />
                    <TextBlock Grid.Column="1" Style="{StaticResource ColHead}" Text="Эталон (.rte)" />
                    <TextBlock Grid.Column="2" Style="{StaticResource ColHead}" Text="Шаблон вида" />
                </Grid>
                <ItemsControl x:Name="DepartmentsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="40" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding Department, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" TextChanged="Any_Changed" />
                                <DockPanel Grid.Column="1" Margin="0,0,8,0">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE8E5;" Margin="4,0,0,0"
                                            Click="BrowseEtalon_Click" ToolTip="Выбрать файл" />
                                    <TextBox Text="{Binding Etalon, UpdateSourceTrigger=PropertyChanged}" />
                                </DockPanel>
                                <TextBox Grid.Column="2" Text="{Binding ViewTemplate, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xE74D;" HorizontalAlignment="Right"
                                        Click="DeleteDepartment_Click" ToolTip="Удалить отдел" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="Добавить отдел" HorizontalAlignment="Left" Click="AddDepartment_Click" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
