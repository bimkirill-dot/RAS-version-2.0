<Window x:Class="RASv2.ClashAnalysis.UI.ExportSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Общие настройки выгрузки NWC" Width="680" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}" FontFamily="Segoe UI" FontSize="13">
    <!-- Общие настройки «Задач выгрузки» (шестерёнка главного окна, DECISIONS.md модуля): параметры окна экспортёра Navisworks
         в Revit — те же подписи и тот же порядок, по снимку разработчика (02.11.2026); подписи и значения списков — дословно из
         экспортёра Revit 2026 (`ru-RU\nwexportrevit.name`); строки разделены линиями. Параметров,
         которых нет в Revit API («Внедрить текстуры», «Отделить пользовательские свойства», «Свойства типа для элементов»,
         «Точное сечение»), здесь нет. Кнопки, поля, кисти — общие образцы ядра (подключаются до разметки); ключи своих стилей
         не совпадают с кистями ядра. -->
    <Window.Resources>
        <Style x:Key="OptionRow" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="0,6" />
            <Setter Property="MinHeight" Value="40" />
        </Style>
        <Style x:Key="OptionName" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,14,0" />
        </Style>
        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="20,12">
            <DockPanel>
                <Button DockPanel.Dock="Left" Content="По умолчанию" Click="Defaults_Click" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Сохранить" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Save_Click" />
                    <Button Content="Отмена" IsCancel="True" Margin="8,0,0,0" />
                </StackPanel>
                <TextBlock x:Name="Error" Foreground="{DynamicResource Error}" TextWrapping="Wrap" VerticalAlignment="Center"
                           Margin="16,0" />
            </DockPanel>
        </Border>

        <!-- строка: подпись — вправо до общей границы, значение — слева от неё, как в окне экспортёра -->
        <StackPanel Margin="20,8,20,12">
            <Border Style="{StaticResource OptionRow}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="380" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource OptionName}" Text="Конвертировать идентификаторы объектов" />
                    <!-- всегда включено: по номерам элементов работают «Показать в Revit» и «Коллизии элемента» -->
                    <CheckBox Grid.Column="1" IsChecked="True" IsEnabled="False"
                              ToolTipService.ShowOnDisabled="True" ToolTip="Нужно сайту коллизий: «Показать в Revit», «Коллизии элемента»" />
                </Grid>
            </Border>
            <Border Style="{StaticResource OptionRow}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="380" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource OptionName}" Text="Конвертировать параметры объектов" />
                    <ComboBox Grid.Column="1" x:Name="Parameters" Width="140">
                        <ComboBoxItem Content="Нет" />
                        <ComboBoxItem Content="Объекты" />
                        <ComboBoxItem Content="Все" />
                    </ComboBox>
                </Grid>
            </Border>
            <Border Style="{StaticResource OptionRow}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="380" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource OptionName}" Text="Координаты" />
                    <ComboBox Grid.Column="1" x:Name="Coordinates" Width="200">
                        <ComboBoxItem Content="Внутренние для проекта" />
                        <ComboBoxItem Content="Общие" />
                    </ComboBox>
                </Grid>
            </Border>
            <Border Style="{StaticResource OptionRow}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="380" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource OptionName}" Text="Коэффициент фасетизации" />
                    <TextBox Grid.Column="1" x:Name="Faceting" Width="140" />
                </Grid>
            </Border>
            <Border Style="{StaticResource OptionRow}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="380" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource OptionName}" Text="Преобразование свойств элементов из предыдущих версий" />
                    <CheckBox Grid.Column="1" x:Name="ElementProperties" />
                </Grid>
            </Border>
            <Border Style="{StaticResource OptionRow}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="380" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource OptionName}" Text="Преобразовать URL-адреса" />
                    <CheckBox Grid.Column="1" x:Name="Urls" />
                </Grid>
            </Border>
            <Border Style="{StaticResource OptionRow}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="380" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource OptionName}" Text="Преобразовать источники света" />
                    <CheckBox Grid.Column="1" x:Name="Lights" />
                </Grid>
            </Border>
            <Border Style="{StaticResource OptionRow}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="380" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource OptionName}" Text="Преобразовать помещение как атрибут" />
                    <CheckBox Grid.Column="1" x:Name="RoomAsAttribute" />
                </Grid>
            </Border>
            <Border Style="{StaticResource OptionRow}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="380" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource OptionName}" Text="Преобразовать связанные CAD файлы" />
                    <CheckBox Grid.Column="1" x:Name="LinkedCad" />
                </Grid>
            </Border>
            <Border Style="{StaticResource OptionRow}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="380" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource OptionName}" Text="Преобразовать связанные файлы" />
                    <CheckBox Grid.Column="1" x:Name="LinkedFiles" />
                </Grid>
            </Border>
            <Border Style="{StaticResource OptionRow}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="380" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource OptionName}" Text="Преобразовать элементы конструкции" />
                    <CheckBox Grid.Column="1" x:Name="Parts" />
                </Grid>
            </Border>
            <Border Style="{StaticResource OptionRow}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="380" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource OptionName}" Text="Проверять и находить отсутствующие материалы" />
                    <CheckBox Grid.Column="1" x:Name="MissingMaterials" />
                </Grid>
            </Border>
            <Border Style="{StaticResource OptionRow}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="380" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource OptionName}" Text="Разделить файл на уровни" />
                    <CheckBox Grid.Column="1" x:Name="Levels" />
                </Grid>
            </Border>
            <Border Style="{StaticResource OptionRow}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="380" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource OptionName}" Text="Экспорт" />
                    <ComboBox Grid.Column="1" x:Name="Scope" Width="200" SelectionChanged="Scope_Changed">
                        <ComboBoxItem Content="Целый проект" />
                        <ComboBoxItem Content="Текущий вид" />
                    </ComboBox>
                </Grid>
            </Border>
            <!-- своя строка (в окне экспортёра её нет): «Текущий вид» — модель открывает плагин, вид — по имени; «Выбор» не нужен -->
            <Border Style="{StaticResource OptionRow}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="380" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource OptionName}" Text="Вид для выгрузки" />
                    <TextBox Grid.Column="1" x:Name="ViewName" Width="200" />
                </Grid>
            </Border>
            <Border Style="{StaticResource OptionRow}" BorderThickness="0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="380" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource OptionName}" Text="Экспортировать геометрию помещения" />
                    <CheckBox Grid.Column="1" x:Name="RoomGeometry" />
                </Grid>
            </Border>
        </StackPanel>
    </DockPanel>
</Window>
