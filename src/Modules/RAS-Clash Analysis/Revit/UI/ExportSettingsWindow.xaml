<Window x:Class="RASv2.ClashAnalysis.UI.ExportSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Общие настройки выгрузки" Width="780" Height="760" MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}" FontFamily="Segoe UI" FontSize="13">
    <!-- Общие настройки «Задач выгрузки» (шестерёнка главного окна, DECISIONS.md модуля). Примерное окно — по списку настроек
         (разработчик, 30.10.2026: «сделай примерное окно, дальше будем из этого исходить»). Кнопки, поля, кисти — общие
         образцы ядра (подключаются до разметки); ключи своих стилей не совпадают с кистями ядра. -->
    <Window.Resources>
        <Style x:Key="Head" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,18,0,8" />
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
        <Style x:Key="Example" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,8" />
        </Style>
        <Style x:Key="Num" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="56" />
            <Setter Property="HorizontalContentAlignment" Value="Right" />
        </Style>
        <Style x:Key="ColHead" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,8,4" />
        </Style>
        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Margin" Value="0,3,24,3" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="20,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Сохранить" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Save_Click" />
                    <Button Content="Отмена" IsCancel="True" Margin="8,0,0,0" />
                </StackPanel>
                <TextBlock x:Name="Error" Foreground="{DynamicResource Error}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20,0,20,16">

                <TextBlock Style="{StaticResource Head}" Text="Папки" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource Caption}" Text="Папка NWC" />
                    <TextBox Grid.Column="1" x:Name="NwcFolder" TextChanged="Any_Changed" />
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="NwcExample" Style="{StaticResource Example}" />
                    <TextBlock Grid.Row="2" Style="{StaticResource Caption}" Text="Папка отчётов" />
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="ReportFolder" TextChanged="Any_Changed" />
                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="ReportExample" Style="{StaticResource Example}" />
                    <TextBlock Grid.Row="4" Style="{StaticResource Caption}" Text="Формат даты" />
                    <ComboBox Grid.Row="4" Grid.Column="1" x:Name="DateFormat" Width="200" HorizontalAlignment="Left" MinHeight="28"
                              VerticalContentAlignment="Center" SelectionChanged="Any_Changed" />
                </Grid>

                <TextBlock Style="{StaticResource Head}" Text="Метки" />
                <TextBlock x:Name="BuiltIn" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8" />
                <ItemsControl x:Name="LabelsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="{}{" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" Margin="0,0,4,0" />
                                <TextBox Width="220" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" TextChanged="Any_Changed" />
                                <TextBlock Text="}" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" Margin="4,0,0,0" />
                                <Button Style="{StaticResource IconButton}" Content="&#xE74D;" Margin="6,0,0,0" Click="DeleteLabel_Click"
                                        ToolTip="Удалить метку" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="Добавить метку" HorizontalAlignment="Left" Click="AddLabel_Click" />

                <TextBlock Style="{StaticResource Head}" Text="Имя модели" />
                <CheckBox x:Name="TrimName" Content="Обрезать имя NWC по шаблону" Checked="Any_Changed" Unchecked="Any_Changed" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Style="{StaticResource Caption}" Text="Частей через «_»" />
                    <TextBox x:Name="NameParts" Style="{StaticResource Num}" TextChanged="Any_Changed" />
                    <TextBlock Style="{StaticResource Caption}" Text="Раздел — часть №" Margin="28,0,12,0" />
                    <TextBox x:Name="SectionPart" Style="{StaticResource Num}" TextChanged="Any_Changed" />
                </StackPanel>
                <TextBlock x:Name="NameExample" Style="{StaticResource Example}" Margin="0,8,0,0" />

                <TextBlock Style="{StaticResource Head}" Text="Отделы" />
                <Grid Margin="0,0,40,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="200" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource ColHead}" Text="Отдел" />
                    <TextBlock Grid.Column="1" Style="{StaticResource ColHead}" Text="Эталон (.rte)" />
                    <TextBlock Grid.Column="2" Style="{StaticResource ColHead}" Text="Шаблон вида" />
                </Grid>
                <ItemsControl x:Name="DepartmentsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="40" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding Department, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                                <DockPanel Grid.Column="1" Margin="0,0,8,0">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE8E5;" Margin="4,0,0,0"
                                            Click="BrowseEtalon_Click" ToolTip="Выбрать файл" />
                                    <TextBox Text="{Binding Etalon, UpdateSourceTrigger=PropertyChanged}" />
                                </DockPanel>
                                <TextBox Grid.Column="2" Text="{Binding ViewTemplate, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xE74D;" HorizontalAlignment="Right"
                                        Click="DeleteDepartment_Click" ToolTip="Удалить отдел" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Добавить отдел" Click="AddDepartment_Click" />
                    <Button Content="Проверить" Margin="8,0,0,0" Click="CheckDepartments_Click"
                            ToolTip="Есть ли в каждом эталоне такой шаблон вида" />
                </StackPanel>

                <TextBlock Style="{StaticResource Head}" Text="Вид и выгрузка" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Caption}" Text="Вид для выгрузки" />
                    <TextBox x:Name="ViewName" Width="220" />
                    <Button Content="Настройки выгрузки NWC…" Margin="24,0,0,0" Click="NwcOptions_Click" />
                </StackPanel>

                <TextBlock Style="{StaticResource Head}" Text="Удалить из модели перед выгрузкой" />
                <WrapPanel>
                    <CheckBox x:Name="RemoveRevitLinks" Content="Связи Revit" />
                    <CheckBox x:Name="RemoveCad" Content="DWG и другие CAD" />
                    <CheckBox x:Name="RemovePointClouds" Content="Облака точек" />
                    <CheckBox x:Name="RemoveIfc" Content="IFC" />
                </WrapPanel>

                <TextBlock Style="{StaticResource Head}" Text="Временная папка для копий моделей (на этом компьютере)" />
                <TextBox x:Name="TempFolder" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
