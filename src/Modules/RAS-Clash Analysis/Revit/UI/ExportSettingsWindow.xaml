<Window x:Class="RASv2.ClashAnalysis.UI.ExportSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Общие настройки выгрузки" Width="940" Height="780" MinWidth="820" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}" FontFamily="Segoe UI" FontSize="13">
    <!-- Общие настройки «Задач выгрузки» (шестерёнка главного окна, DECISIONS.md модуля) — всё, что одно на компанию. Меню разделов
         слева (разработчик, 07.11.2026: «зачем всё в одно меню вмещаем — боковое меню с разделами»): «Общее» — метки, отделы,
         копирование моделей; «Экспорт NWC» (разработчик, 08.11.2026) — параметры NWC Exporter (как в окне экспортёра Navisworks в Revit: подписи и значения —
         дословно из экспортёра Revit 2026, порядок — по снимку разработчика), имя NWC, очистка модели перед экспортом. Разделы для
         выгрузки RVT и пересохранения моделей — когда до них дойдём. «Настройки отчётов» (08.11.2026) — как вкладка «Отчёт» Clash
         Detective: содержимое, группы конфликтов, только отфильтрованные, статусы. Подпись — вправо до общей границы, значение — слева, строки
         разделены линиями. Кнопки, поля, кисти — общие образцы ядра (подключаются до разметки); ключи своих стилей не совпадают с
         кистями ядра. -->
    <Window.Resources>
        <Style x:Key="Head" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="HeadBar" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,14,0,2" />
        </Style>
        <Style x:Key="OptionRow" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="0,3" />
            <Setter Property="MinHeight" Value="36" />
        </Style>
        <!-- раздел меню слева: выбранный — фоном наведения и полосой акцентом -->
        <Style x:Key="NavItem" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Box" Background="Transparent" CornerRadius="6" Margin="0,0,0,2">
                            <DockPanel>
                                <Border x:Name="Bar" DockPanel.Dock="Left" Width="3" CornerRadius="2" Margin="0,6" Background="Transparent" />
                                <ContentPresenter Margin="12,8" />
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource Hover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource Hover}" />
                                <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Accent}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <SolidColorBrush x:Key="NoteWarn" Color="#E0A100" />
        <Style x:Key="OptionName" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,14,0" />
        </Style>
        <Style x:Key="Inline" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8,0" />
        </Style>
        <Style x:Key="ColHead" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,8,4" />
        </Style>
        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="20,10">
            <DockPanel>
                <!-- поделиться с коллегой (разработчик, 02.11.2026): импорт заполняет окно, сохраняется по «Сохранить» -->
                <StackPanel x:Name="FileButtons" DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Content="Экспорт…" Click="Export_Click" ToolTip="Общие настройки — в файл, чтобы поделиться" />
                    <Button Content="Импорт…" Margin="8,0,0,0" Click="Import_Click" ToolTip="Общие настройки из файла — в это окно" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Сохранить" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Save_Click" />
                    <Button Content="Отмена" IsCancel="True" Margin="8,0,0,0" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center" Margin="16,0">
                    <TextBlock x:Name="Info" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" />
                    <TextBlock x:Name="Error" Foreground="{DynamicResource Error}" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- меню разделов -->
        <Border x:Name="NavBox" DockPanel.Dock="Left" Width="190" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0" Padding="10,14">
            <ListBox x:Name="Nav" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource NavItem}"
                     SelectionChanged="Nav_Changed" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBoxItem Content="Общее" Tag="General" />
                <ListBoxItem Content="Экспорт NWC" Tag="Nwc" />
                <ListBoxItem Content="Экспорт RVT" Tag="Rvt" />
                <ListBoxItem Content="Пересохранение RVT" Tag="Resave" />
                <ListBoxItem Content="Настройки отчётов" Tag="Report" />
            </ListBox>
        </Border>

        <ScrollViewer x:Name="Scroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="20,0,20,16">

            <!-- ══ Общее: метки, отделы, копирование моделей ══ -->
            <StackPanel x:Name="General">
                <!-- метки — один регламент на компанию: что они значат (разбор настроек, 02.11.2026) -->
                <DockPanel Style="{StaticResource HeadBar}">
                    <TextBlock Style="{StaticResource Head}" Text="Метки" />
                </DockPanel>
                <Border Style="{StaticResource OptionRow}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="320" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource OptionName}" Text="{}{Блок}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBlock Text="маски через запятую:" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <!-- маски блока (12.11.2026): «S, P» — буквы и цифры после; «#» — где цифры; две нашлись — первая по списку -->
                            <TextBox x:Name="BlockMasks" Width="160" TextChanged="Any_Changed"
                                     ToolTip="Часть имени модели, по которой узнаётся блок. «S, P» — S или P и цифры после (S6, P10). «#» — где цифры, если иначе (Б#А — Б2А). Нашлись две — берётся первая по списку. S1 и S01 — один блок, пишется S01." />
                            <TextBlock Style="{StaticResource Inline}" Text="«S» — S и цифры, «#» — где цифры" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource OptionRow}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="320" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource OptionName}" Text="{}{Отдел}" />
                        <TextBlock Grid.Column="1" Text="код из таблицы «Отделы», найденный в имени" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource OptionRow}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="320" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource OptionName}" Text="{}{Дата}" />
                        <ComboBox Grid.Column="1" x:Name="DateFormat" Width="200" SelectionChanged="Any_Changed" />
                    </Grid>
                </Border>
                <!-- пример меток — на том же имени, что у обрезки (разработчик, 03.11.2026) -->
                <TextBlock x:Name="LabelsExample" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="320,6,0,0" />


                <DockPanel Style="{StaticResource HeadBar}" Margin="0,22,0,2">
                    <TextBlock Style="{StaticResource Head}" Text="Отделы" />
                </DockPanel>
                <!-- коды отделов — для {Отдел}; эталона и шаблона вида нет (разработчик, 03.11.2026) -->
                <ItemsControl x:Name="DepartmentsList" Margin="320,4,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="40" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding Department, UpdateSourceTrigger=PropertyChanged}" TextChanged="Any_Changed" ToolTip="Код отдела, например KJ" />
                                <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE74D;" HorizontalAlignment="Right"
                                        Click="DeleteDepartment_Click" ToolTip="Удалить отдел" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="Добавить отдел" HorizontalAlignment="Left" Margin="320,0,0,0" Click="AddDepartment_Click" />

                <!-- копии моделей Revit Server наперёд, пока Revit выгружает текущую (разработчик, 04.11.2026: «по умолчанию 4»);
                     под ним — зачем и что лучше не менять (разработчик, 07.11.2026) -->
                <DockPanel Style="{StaticResource HeadBar}" Margin="0,22,0,2">
                    <TextBlock Style="{StaticResource Head}" Text="Копирование моделей" />
                </DockPanel>
                <Border Style="{StaticResource OptionRow}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="320" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource OptionName}" Text="Копий с Revit Server одновременно" />
                        <TextBox Grid.Column="1" x:Name="ParallelCopies" Width="60" HorizontalAlignment="Left" />
                    </Grid>
                </Border>
                <DockPanel Margin="0,10,0,0">
                    <TextBlock DockPanel.Dock="Left" FontFamily="Segoe MDL2 Assets" FontSize="14" Text="&#xE7BA;" Foreground="{StaticResource NoteWarn}"
                               Margin="0,1,8,0" VerticalAlignment="Top" />
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="12"
                               Text="Копирование модели с Revit Server — самый долгий шаг выгрузки. Пока Revit выгружает одну модель, следующие копируются заранее, по нескольку сразу: так выгрузка идёт быстрее. Больше копий — сильнее нагрузка на Revit Server и сеть (мешает коллегам, которые синхронизируются), меньше — выгрузка дольше. Значение по умолчанию — 4; менять его не рекомендуется." />
                </DockPanel>
            </StackPanel>

            <!-- ══ Экспорт NWC: параметры NWC Exporter, имя NWC, очистка модели ══ -->
            <StackPanel x:Name="NwcSection" Visibility="Collapsed">
                <!-- «По умолчанию» — только параметры экспортёра (значения со снимка разработчика) -->
                <DockPanel Style="{StaticResource HeadBar}">
                    <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="По умолчанию" Click="Defaults_Click" />
                    <TextBlock Style="{StaticResource Head}" Text="Параметры NWC Exporter" />
                </DockPanel>
                <Border Style="{StaticResource OptionRow}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="320" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource OptionName}" Text="Конвертировать идентификаторы объектов" />
                        <!-- всегда включено: по номерам элементов работают «Показать в Revit» и «Коллизии элемента» -->
                        <CheckBox Grid.Column="1" IsChecked="True" IsEnabled="False"
                                  ToolTipService.ShowOnDisabled="True" ToolTip="Нужно сайту коллизий: «Показать в Revit», «Коллизии элемента»" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource OptionRow}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="320" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource OptionName}" Text="Конвертировать параметры объектов" />
                        <ComboBox Grid.Column="1" x:Name="Parameters" Width="140">
                            <ComboBoxItem Content="Нет" />
                            <ComboBoxItem Content="Объекты" />
                            <ComboBoxItem Content="Все" />
                        </ComboBox>
                    </Grid>
                </Border>
                <Border Style="{StaticResource OptionRow}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="320" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource OptionName}" Text="Координаты" />
                        <ComboBox Grid.Column="1" x:Name="Coordinates" Width="200">
                            <ComboBoxItem Content="Внутренние для проекта" />
                            <ComboBoxItem Content="Общие" />
                        </ComboBox>
                    </Grid>
                </Border>
                <Border Style="{StaticResource OptionRow}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="320" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource OptionName}" Text="Коэффициент фасетизации" />
                        <TextBox Grid.Column="1" x:Name="Faceting" Width="140" HorizontalAlignment="Left" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource OptionRow}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="320" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource OptionName}" Text="Преобразование свойств элементов из предыдущих версий" />
                        <CheckBox Grid.Column="1" x:Name="ElementProperties" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource OptionRow}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="320" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource OptionName}" Text="Преобразовать URL-адреса" />
                        <CheckBox Grid.Column="1" x:Name="Urls" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource OptionRow}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="320" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource OptionName}" Text="Преобразовать источники света" />
                        <CheckBox Grid.Column="1" x:Name="Lights" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource OptionRow}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="320" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource OptionName}" Text="Преобразовать помещение как атрибут" />
                        <CheckBox Grid.Column="1" x:Name="RoomAsAttribute" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource OptionRow}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="320" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource OptionName}" Text="Преобразовать связанные CAD файлы" />
                        <CheckBox Grid.Column="1" x:Name="LinkedCad" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource OptionRow}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="320" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource OptionName}" Text="Преобразовать связанные файлы" />
                        <CheckBox Grid.Column="1" x:Name="LinkedFiles" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource OptionRow}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="320" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource OptionName}" Text="Преобразовать элементы конструкции" />
                        <CheckBox Grid.Column="1" x:Name="Parts" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource OptionRow}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="320" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource OptionName}" Text="Проверять и находить отсутствующие материалы" />
                        <CheckBox Grid.Column="1" x:Name="MissingMaterials" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource OptionRow}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="320" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource OptionName}" Text="Разделить файл на уровни" />
                        <CheckBox Grid.Column="1" x:Name="Levels" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource OptionRow}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="320" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource OptionName}" Text="Экспорт" />
                        <!-- «Вид» (в экспортёре — «Текущий вид»; разработчик: «замени на просто „вид“») — вид с этим именем: модель
                             открывает плагин; имя — в этой же строке; у задачи может быть свой вид (карандаш) -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <ComboBox x:Name="Scope" Width="130" SelectionChanged="Scope_Changed">
                                <ComboBoxItem Content="Целый проект" />
                                <ComboBoxItem Content="Вид" />
                            </ComboBox>
                            <TextBox x:Name="ViewName" Width="160" Margin="8,0,0,0" ToolTip="Имя вида для выгрузки" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource OptionRow}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="320" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource OptionName}" Text="Экспортировать геометрию помещения" />
                        <CheckBox Grid.Column="1" x:Name="RoomGeometry" />
                    </Grid>
                </Border>

                <!-- имя NWC (разработчик, 07.11.2026: «Имя NWC: обрезать всё после — и пользователь сам вводит после чего») -->
                <StackPanel x:Name="NameBlock">
                    <DockPanel Style="{StaticResource HeadBar}" Margin="0,22,0,2">
                        <TextBlock Style="{StaticResource Head}" Text="Имя NWC" />
                    </DockPanel>
                    <Border Style="{StaticResource OptionRow}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="320" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource OptionName}" Text="Обрезать всё после" />
                            <TextBox Grid.Column="1" x:Name="TrimAfter" Width="160" HorizontalAlignment="Left" TextChanged="Any_Changed"
                                     ToolTip="Часть имени модели, после которой всё отрезается; пусто — имя модели как есть" />
                        </Grid>
                    </Border>
                    <TextBlock x:Name="NameExample" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="320,6,0,0" />
                </StackPanel>

                <DockPanel Style="{StaticResource HeadBar}" Margin="0,22,0,2">
                    <TextBlock Style="{StaticResource Head}" Text="Очистка модели перед экспортом NWC" />
                </DockPanel>
                <Border Style="{StaticResource OptionRow}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="320" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource OptionName}" Text="Связи Revit" />
                        <CheckBox Grid.Column="1" x:Name="RemoveRevitLinks" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource OptionRow}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="320" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource OptionName}" Text="DWG и другие CAD — связанные и импортированные" />
                        <CheckBox Grid.Column="1" x:Name="RemoveCad" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource OptionRow}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="320" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource OptionName}" Text="Облака точек" />
                        <CheckBox Grid.Column="1" x:Name="RemovePointClouds" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource OptionRow}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="320" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource OptionName}" Text="Связи IFC" />
                        <CheckBox Grid.Column="1" x:Name="RemoveIfc" />
                    </Grid>
                </Border>
            </StackPanel>

            <!-- ══ Экспорт RVT — для заказчика (разработчик, 08.11.2026): проверка при открытии, рабочие наборы, что с уже лежащим, имя ══ -->
            <StackPanel x:Name="RvtSection" Visibility="Collapsed">
                <DockPanel Style="{StaticResource HeadBar}">
                    <TextBlock Style="{StaticResource Head}" Text="Выгрузка RVT" />
                </DockPanel>
                <Border Style="{StaticResource OptionRow}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="320" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource OptionName}" Text="Проверка при открытии (Audit)" />
                        <CheckBox Grid.Column="1" x:Name="RvtAudit" ToolTip="Revit исправляет ошибки модели; открытие дольше" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource OptionRow}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="320" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource OptionName}" Text="Рабочие наборы" />
                        <ComboBox Grid.Column="1" x:Name="RvtWorksets" Width="260">
                            <ComboBoxItem Content="Оставить, все освободить" />
                            <ComboBoxItem Content="Без рабочих наборов" />
                        </ComboBox>
                    </Grid>
                </Border>
                <Border Style="{StaticResource OptionRow}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="320" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource OptionName}" Text="Перезаписывать, если RVT уже есть" />
                        <CheckBox Grid.Column="1" x:Name="RvtOverwrite" ToolTip="Снята — модель с уже лежащим RVT пропускается" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource OptionRow}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="320" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource OptionName}" Text="Имя RVT: обрезать всё после" />
                        <TextBox Grid.Column="1" x:Name="RvtTrimAfter" Width="160" HorizontalAlignment="Left" TextChanged="Any_Changed"
                                 ToolTip="Часть имени модели, после которой всё отрезается; пусто — имя модели как есть" />
                    </Grid>
                </Border>
                <TextBlock x:Name="RvtNameExample" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="320,6,0,0" />

                <DockPanel Margin="0,22,0,0">
                    <TextBlock DockPanel.Dock="Left" FontFamily="Segoe MDL2 Assets" FontSize="14" Text="&#xE946;" Foreground="{DynamicResource Muted}"
                               Margin="0,1,8,0" VerticalAlignment="Top" />
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="12"
                               Text="Каждая модель строки открывается отсоединённо (если у строки стоит и NWC — тем же открытием, после NWC), из неё удаляются все связи — Revit, DWG и другие CAD, облака точек, IFC, — три раза выполняется очистка от неиспользуемого, и модель сохраняется в папку RVT строки в своей версии Revit. В Revit 2023 стандартной очистки для плагинов нет — удаляются неиспользуемые семейства и типы; в Revit 2026 — стандартная очистка." />
                </DockPanel>
            </StackPanel>

            <!-- ══ Пересохранение RVT — свой раздел (разработчик, 08.11.2026): сжать, проверить, папка резервных копий ══ -->
            <StackPanel x:Name="ResaveSection" Visibility="Collapsed">
                <!-- пересохранение на место (разработчик, 08.11.2026: «чтобы уменьшить вес файла»; «сжать», «проверить», папка копий — меняется) -->
                <DockPanel Style="{StaticResource HeadBar}">
                    <TextBlock Style="{StaticResource Head}" Text="Пересохранение на место" />
                </DockPanel>
                <Border Style="{StaticResource OptionRow}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="320" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource OptionName}" Text="Сжать модель" />
                        <CheckBox Grid.Column="1" x:Name="ResaveCompact" ToolTip="«Сжать файл» при сохранении — меньше вес, сохранение дольше" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource OptionRow}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="320" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource OptionName}" Text="Проверить модель (Audit)" />
                        <CheckBox Grid.Column="1" x:Name="ResaveAudit" ToolTip="Revit исправляет ошибки модели при открытии; открытие дольше" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource OptionRow}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="320" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource OptionName}" Text="Папка резервных копий" />
                        <DockPanel Grid.Column="1">
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xF12B;" Margin="6,0,0,0"
                                    Click="BackupBrowse_Click" ToolTip="Выбрать папку" />
                            <TextBox x:Name="ResaveBackup" TextChanged="Any_Changed"
                                     ToolTip="Сюда — прежние модели перед заменой: на каждый запуск — папка с датой и временем; пусто — на этом компьютере" />
                        </DockPanel>
                    </Grid>
                </Border>
                <TextBlock x:Name="ResaveBackupNote" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="320,6,0,0" />
                <DockPanel Margin="0,16,0,0">
                    <TextBlock DockPanel.Dock="Left" FontFamily="Segoe MDL2 Assets" FontSize="14" Text="&#xE7BA;" Foreground="{StaticResource NoteWarn}"
                               Margin="0,1,8,0" VerticalAlignment="Top" />
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="12"
                               Text="Модель открывается отсоединённо с рабочими наборами и сохраняется центральной туда же, откуда взята (Revit Server или сетевая папка), в своей версии Revit; рабочие наборы освобождаются. У коллег прежние локальные копии перестают синхронизироваться — перед запуском плагин спросит. Прежние модели перед заменой копируются в папку резервных копий — на каждый запуск своя папка с датой и временем; лишние удаляйте сами." />
                </DockPanel>
            </StackPanel>

            <!-- ══ Настройки отчётов: как вкладка «Отчёт» Clash Detective (разработчик, 08.11.2026) ══ -->
            <StackPanel x:Name="ReportSection" Visibility="Collapsed">
                <DockPanel Style="{StaticResource HeadBar}">
                    <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="По умолчанию" Click="ReportDefaults_Click" />
                    <TextBlock Style="{StaticResource Head}" Text="Содержимое" />
                </DockPanel>
                <ItemsControl x:Name="ReportFields" Margin="0,6,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Name}" IsChecked="{Binding On}" Margin="0,4,12,4" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <DockPanel Style="{StaticResource HeadBar}" Margin="0,22,0,2">
                    <TextBlock Style="{StaticResource Head}" Text="Включить конфликты" />
                </DockPanel>
                <Border Style="{StaticResource OptionRow}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="320" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource OptionName}" Text="Для групп конфликтов включить" />
                        <ComboBox Grid.Column="1" x:Name="GroupMode" Width="240" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource OptionRow}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="320" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource OptionName}" Text="Включить только отфильтрованные результаты" />
                        <CheckBox Grid.Column="1" x:Name="FilteredOnly" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource OptionRow}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="320" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource OptionName}" Text="Включить эти статусы" />
                        <ItemsControl Grid.Column="1" x:Name="ReportStatuses" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding On}" Margin="0,4,16,4" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
            </StackPanel>

            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
