<Window x:Class="RASv2.ClashAnalysis.UI.ExportProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Проект" Width="900" Height="760" MinWidth="720" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}" FontFamily="Segoe UI" FontSize="13">
    <!-- Настройки проекта «Задач выгрузки» (карандаш у проекта, DECISIONS.md модуля): проект — каталог задач-блоков, его
         настройки общие для всех задач (разработчик, 02.11.2026). Папки — строки внутри папки проекта, по умолчанию — по
         регламенту; под строкой — её метки (нажимаются) и пример; у каждого пути — «Обзор». Файлы проверок — списком. Внизу —
         экспорт проекта с задачами и импорт задач. Кнопки, поля, кисти — общие образцы ядра (подключаются до разметки); ключи
         своих стилей не совпадают с кистями ядра. -->
    <Window.Resources>
        <Style x:Key="Head" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,20,0,8" />
        </Style>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
        <Style x:Key="Example" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Under" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,4,0,12" />
        </Style>
        <Style x:Key="Chip" TargetType="Button" BasedOn="{StaticResource LinkButton}">
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="ToolTip" Value="Вставить в строку" />
        </Style>
        <!-- «Обзор» справа от поля -->
        <Style x:Key="Browse" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="DockPanel.Dock" Value="Right" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Content" Value="&#xF12B;" />
            <Setter Property="ToolTip" Value="Обзор" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="20,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Content="Экспорт…" Click="Export_Click" ToolTip="Проект с задачами — в файл, чтобы поделиться" />
                    <Button Content="Импорт задач…" Margin="8,0,0,0" Click="ImportTasks_Click"
                            ToolTip="Задача или все задачи проекта из файла — в этот проект" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Сохранить" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Save_Click" />
                    <Button Content="Отмена" IsCancel="True" Margin="8,0,0,0" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center" Margin="16,0">
                    <TextBlock x:Name="Info" Style="{StaticResource Note}" TextWrapping="Wrap" />
                    <TextBlock x:Name="Error" Foreground="{DynamicResource Error}" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="20,0,20,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.ColumnSpan="3" Style="{StaticResource Head}" Text="Проект" />
                <TextBlock Grid.Row="1" Style="{StaticResource Caption}" Text="Название" />
                <TextBox x:Name="ProjectName" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" TextChanged="Any_Changed" />
                <TextBlock Grid.Row="2" Style="{StaticResource Caption}" Text="Папка проекта" />
                <DockPanel Grid.Row="2" Grid.Column="1">
                    <Button Style="{StaticResource Browse}" Click="BrowseProject_Click" />
                    <TextBox x:Name="Folder" TextChanged="Any_Changed" />
                </DockPanel>

                <!-- папки — внутри папки проекта; полный путь — тоже можно -->
                <TextBlock Grid.Row="3" Grid.ColumnSpan="3" Style="{StaticResource Head}" Text="Папки внутри проекта" />
                <TextBlock Grid.Row="4" Style="{StaticResource Caption}" Text="Папка для NWC" />
                <DockPanel Grid.Row="4" Grid.Column="1">
                    <Button Style="{StaticResource Browse}" Tag="{Binding ElementName=NwcFolder}" Click="BrowseInner_Click" />
                    <TextBox x:Name="NwcFolder" TextChanged="Any_Changed" />
                </DockPanel>
                <StackPanel Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource Under}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Note}" Text="Метки:" />
                        <Button Style="{StaticResource Chip}" Content="{}{Блок}" Tag="{Binding ElementName=NwcFolder}" Click="Chip_Click" />
                        <Button Style="{StaticResource Chip}" Content="{}{Отдел}" Tag="{Binding ElementName=NwcFolder}" Click="Chip_Click" />
                    </StackPanel>
                    <TextBlock x:Name="NwcExample" Style="{StaticResource Example}" />
                </StackPanel>
                <TextBlock Grid.Row="6" Style="{StaticResource Caption}" Text="Папка для NWF" />
                <DockPanel Grid.Row="6" Grid.Column="1">
                    <Button Style="{StaticResource Browse}" Tag="{Binding ElementName=NwfFolder}" Click="BrowseInner_Click" />
                    <TextBox x:Name="NwfFolder" TextChanged="Any_Changed" />
                </DockPanel>
                <StackPanel Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource Under}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Note}" Text="Метки:" />
                        <Button Style="{StaticResource Chip}" Content="{}{Блок}" Tag="{Binding ElementName=NwfFolder}" Click="Chip_Click" />
                    </StackPanel>
                    <TextBlock x:Name="NwfExample" Style="{StaticResource Example}" />
                </StackPanel>
                <TextBlock Grid.Row="8" Style="{StaticResource Caption}" Text="Папка для отчётов" />
                <DockPanel Grid.Row="8" Grid.Column="1">
                    <Button Style="{StaticResource Browse}" Tag="{Binding ElementName=ReportFolder}" Click="BrowseInner_Click" />
                    <TextBox x:Name="ReportFolder" TextChanged="Any_Changed" />
                </DockPanel>
                <StackPanel Grid.Row="9" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource Under}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Note}" Text="Метки:" />
                        <Button Style="{StaticResource Chip}" Content="{}{Блок}" Tag="{Binding ElementName=ReportFolder}" Click="Chip_Click" />
                        <Button Style="{StaticResource Chip}" Content="{}{Дата}" Tag="{Binding ElementName=ReportFolder}" Click="Chip_Click" />
                    </StackPanel>
                    <TextBlock x:Name="ReportExample" Style="{StaticResource Example}" />
                </StackPanel>

                <TextBlock Grid.Row="10" Grid.ColumnSpan="3" Style="{StaticResource Head}" Text="Проверки и вид" />
                <TextBlock Grid.Row="11" Style="{StaticResource Caption}" Text="Файлы проверок" VerticalAlignment="Top" Margin="0,6,12,0" />
                <StackPanel Grid.Row="11" Grid.Column="1" Margin="0,0,0,8">
                    <ItemsControl x:Name="TestsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,0,4">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE74D;" Margin="4,0,0,0"
                                            Click="DeleteTests_Click" ToolTip="Убрать файл" />
                                    <TextBlock ToolTip="{Binding Path}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                        <Run Text="{Binding Name, Mode=OneWay}" />
                                        <Run Text="{Binding Folder, Mode=OneWay}" Foreground="{DynamicResource Muted}" FontSize="12" />
                                    </TextBlock>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="Добавить…" HorizontalAlignment="Left" Click="AddTests_Click"
                            ToolTip="Файлы проверок .xml из Clash Detective — можно несколько" />
                </StackPanel>
                <!-- вида нет, если в общих «Экспорт: Целый проект» -->
                <TextBlock x:Name="ViewCaption" Grid.Row="12" Style="{StaticResource Caption}" Text="Вид для выгрузки" />
                <TextBox x:Name="ViewName" Grid.Row="12" Grid.Column="1" Width="240" HorizontalAlignment="Left" />
                <StackPanel x:Name="ViewState" Grid.Row="12" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock x:Name="ViewFrom" Style="{StaticResource Note}" Margin="0,0,8,0" />
                    <Button x:Name="ViewLink" Style="{StaticResource LinkButton}" />
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
