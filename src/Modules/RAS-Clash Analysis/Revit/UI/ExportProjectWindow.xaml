<Window x:Class="RASv2.ClashAnalysis.UI.ExportProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Проект" Width="960" Height="760" MinWidth="760" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}" FontFamily="Segoe UI" FontSize="13">
    <!-- Проект «Задач выгрузки» (карандаш у проекта; DECISIONS.md модуля, набросок 03.11.2026): название, папка проекта, папка
         для NWC (одна модель — один NWC на все задачи), вид, модели — один раз на проект, по блокам (блок и отдел — из имени
         модели; блока в имени нет — вписывается руками). Внизу — экспорт проекта с задачами и импорт задач. Кнопки, поля, кисти —
         общие образцы ядра (подключаются до разметки); ключи своих стилей не совпадают с кистями ядра. -->
    <Window.Resources>
        <Style x:Key="Head" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
        <Style x:Key="Example" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="ColHead" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,8,4" />
        </Style>
        <Style x:Key="Chip" TargetType="Button" BasedOn="{StaticResource LinkButton}">
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="ToolTip" Value="Вставить в строку" />
        </Style>
        <!-- «Обзор» справа от поля -->
        <Style x:Key="Browse" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="DockPanel.Dock" Value="Right" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Content" Value="&#xF12B;" />
            <Setter Property="ToolTip" Value="Обзор" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="20,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Content="Экспорт…" Click="Export_Click" ToolTip="Проект с моделями и задачами — в файл, чтобы поделиться" />
                    <Button Content="Импорт задач…" Margin="8,0,0,0" Click="ImportTasks_Click"
                            ToolTip="Задача или все задачи проекта из файла — в этот проект" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Сохранить" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Save_Click" />
                    <Button Content="Отмена" IsCancel="True" Margin="8,0,0,0" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center" Margin="16,0">
                    <TextBlock x:Name="Info" Style="{StaticResource Note}" TextWrapping="Wrap" />
                    <TextBlock x:Name="Error" Foreground="{DynamicResource Error}" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20,16,20,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- у подписи — тот же нижний отступ, что у поля: иначе она ниже середины поля -->
                    <TextBlock Style="{StaticResource Caption}" Text="Название" Margin="0,0,12,8" />
                    <TextBox x:Name="ProjectName" Grid.Column="1" Margin="0,0,0,8" TextChanged="Any_Changed" />
                    <TextBlock Grid.Row="1" Style="{StaticResource Caption}" Text="Папка проекта" Margin="0,0,12,8" />
                    <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,8">
                        <Button Style="{StaticResource Browse}" Click="BrowseProject_Click" />
                        <TextBox x:Name="Folder" TextChanged="Any_Changed" />
                    </DockPanel>

                    <!-- внутри папки проекта; полный путь — тоже можно -->
                    <TextBlock Grid.Row="2" Style="{StaticResource Caption}" Text="Папка для NWC" />
                    <DockPanel Grid.Row="2" Grid.Column="1">
                        <Button Style="{StaticResource Browse}" Click="BrowseNwc_Click" />
                        <TextBox x:Name="NwcFolder" TextChanged="Any_Changed" />
                    </DockPanel>
                    <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4,0,12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Note}" Text="Метки:" />
                            <Button Style="{StaticResource Chip}" Content="{}{Блок}" Click="Chip_Click" />
                            <Button Style="{StaticResource Chip}" Content="{}{Отдел}" Click="Chip_Click" />
                        </StackPanel>
                        <TextBlock x:Name="NwcExample" Style="{StaticResource Example}" />
                    </StackPanel>

                    <!-- вида нет, если в общих «Экспорт: Целый проект» -->
                    <TextBlock x:Name="ViewCaption" Grid.Row="4" Style="{StaticResource Caption}" Text="Вид для выгрузки" />
                    <StackPanel x:Name="ViewRow" Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                        <TextBox x:Name="ViewName" Width="240" />
                        <TextBlock x:Name="ViewFrom" Style="{StaticResource Note}" Margin="12,0,8,0" />
                        <Button x:Name="ViewLink" Style="{StaticResource LinkButton}" />
                    </StackPanel>
                </Grid>

                <!-- модели — один раз на проект, по блокам; одна кнопка — и Revit Server (галочка на папке — все модели в ней),
                     и сетевые папки -->
                <DockPanel Margin="0,22,0,8">
                    <Button DockPanel.Dock="Right" Content="Добавить модели…" Click="AddModels_Click" />
                    <TextBlock x:Name="ModelsHead" Style="{StaticResource Head}" Text="Модели" />
                </DockPanel>
                <Grid x:Name="ModelsCols" Margin="0,0,40,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="70" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource ColHead}" Text="Блок" />
                    <TextBlock Grid.Column="1" Style="{StaticResource ColHead}" Text="Модель" />
                    <TextBlock Grid.Column="2" Style="{StaticResource ColHead}" Text="Имя NWC" />
                    <TextBlock Grid.Column="3" Style="{StaticResource ColHead}" Text="Отдел" />
                </Grid>
                <ItemsControl x:Name="ModelsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="{Binding Gap}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="260" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="40" />
                                </Grid.ColumnDefinitions>
                                <!-- блок — у первой модели блока; у модели без блока в имени — поле: блок вписывается руками -->
                                <TextBlock Text="{Binding BlockTitle}" FontWeight="SemiBold" VerticalAlignment="Center"
                                           Visibility="{Binding TitleVisibility}" />
                                <TextBox Text="{Binding Block, UpdateSourceTrigger=PropertyChanged}" Width="70" HorizontalAlignment="Left"
                                         Visibility="{Binding BoxVisibility}" LostFocus="Block_LostFocus"
                                         ToolTip="В имени модели блока нет — впишите (например, S1); пусто — модель не выгружается" />
                                <!-- имя модели — первым, папка — бледным: длинный путь не прячет имя (разбор 02.11.2026) -->
                                <TextBlock Grid.Column="1" ToolTip="{Binding Path}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                           Margin="0,0,8,0">
                                    <Run Text="{Binding FileName, Mode=OneWay}" />
                                    <Run Text="{Binding Folder, Mode=OneWay}" Foreground="{DynamicResource Muted}" FontSize="12" />
                                </TextBlock>
                                <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                    <!-- сразу при наборе: Enter («Сохранить») не уводит курсор из поля -->
                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" ToolTip="Пусто — имя из имени модели" />
                                    <TextBlock Text="не по шаблону — имя как есть" Visibility="{Binding MismatchVisibility}"
                                               Foreground="{DynamicResource Muted}" FontSize="12" />
                                </StackPanel>
                                <TextBlock Grid.Column="3" Text="{Binding Department}" VerticalAlignment="Center" />
                                <Button Grid.Column="4" Style="{StaticResource IconButton}" Content="&#xE74D;" HorizontalAlignment="Right"
                                        VerticalAlignment="Top" Click="DeleteModel_Click" ToolTip="Убрать модель" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="NoModels" Style="{StaticResource Note}" HorizontalAlignment="Left" Text="Моделей нет" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
