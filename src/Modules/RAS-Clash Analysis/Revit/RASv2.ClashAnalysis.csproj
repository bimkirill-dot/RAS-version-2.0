<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Модуль «RAS-Clash Analysis» в Revit — мост: «Показать в Revit» с сайта коллизий (DECISIONS.md модуля,
    «Мост в Revit: „Показать в Revit“ — договорённость»). Зависит только от ядра. Сайт — отдельный проект (..\Site).
  -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <AssemblyName>RASv2.ClashAnalysis</AssemblyName>
    <RootNamespace>RASv2.ClashAnalysis</RootNamespace>
    <UseRevitApi>true</UseRevitApi>
    <UseWPF>true</UseWPF>
    <OutputPath>$(RasOut)parts\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- ядро лежит в той же папке сборки — отдельная копия рядом с модулем не нужна -->
    <ProjectReference Include="..\..\..\Core\RASv2.Core.csproj" Private="false" />
    <!-- какая модель — модель элемента из отчёта: общее с сайтом (..\Reports), исходником, без копии -->
    <Compile Include="..\Reports\ModelNames.cs" Link="Reports\ModelNames.cs" />
    <!-- названия проверок из XML Navisworks (файлы проверок «Задач выгрузки»): общее с сайтом, исходником, без копии -->
    <Compile Include="..\Site\Logic\TestCategories.cs" Link="Site\TestCategories.cs" />
    <!-- иконки кнопок: Icons\<имя>32.png и Icons\<имя>16.png, вшиты в сборку (RibbonIcons в ядре) -->
    <None Remove="Icons\*.png" />
    <EmbeddedResource Include="Icons\*.png" LogicalName="Icons.%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- HttpClient (Export\RevitServerClient — папки и модели Revit Server): в .NET Framework 4.8 — своя сборка самого .NET,
       в .NET 8 — уже в составе -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="System.Net.Http" />
  </ItemGroup>

</Project>
