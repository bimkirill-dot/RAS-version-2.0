@* Ввод блоков (DECISIONS.md модуля, «Блоки — вручную»): карточка блока — папка внутри папки проекта («Обзор…») и имя на
   сайте (подставляется из папки, пока его не меняли руками), корзина; «+» — добавить блок. С заголовком (Title) — плюсик
   в заголовке (окно добавления проекта), без него — кнопка под карточками (раздел «Проект»). Список — у вызывающего. *@
@if (Title != null)
{
    <div class="bf-head">
        <span class="bf-title">@Title&nbsp;@if (Items.Count > 0) { <span class="muted">(@Items.Count)</span> }</span>
        <button class="btn small bf-add" title="Добавить блок" @onclick="Add">+ Блок</button>
    </div>
}
@if (Items.Count == 0 && Title != null)
{
    <div class="bf-empty muted">
        Блоков пока нет. Выберите папку проекта — сайт предложит папки, похожие на блоки (S1, «Блок 2»), — или добавьте блок плюсиком.
    </div>
}
<div class="bf-list">
    @for (var i = 0; i < Items.Count; i++)
    {
        var block = Items[i];
        var number = i + 1;
        <div class="block-card">
            <div class="bc-head">
                <span class="bc-title">@(string.IsNullOrWhiteSpace(block.Name) ? $"Блок {number}" : block.Name)</span>
                @if (block.Suggested) { <span class="bc-tag" title="Сайт нашёл эту папку в папке проекта">найден в папке</span> }
                <button class="btn link small b-del" title="Убрать блок" @onclick="() => Remove(block)">
                    <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true"><path d="M3 4.5h10M6.5 4.5V3h3v1.5M4.5 4.5l.6 8.5h5.8l.6-8.5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>
                </button>
            </div>
            <label class="bc-field">
                <span>Папка блока</span>
                <span class="bc-folder">
                    <input class="b-folder" placeholder="Папка внутри папки проекта, например S1" @bind="block.Folder" @bind:after="() => FolderTyped(block)" />
                    <button class="btn small" disabled="@string.IsNullOrWhiteSpace(ProjectFolder)" title="Выбрать папку внутри папки проекта" @onclick="() => Pick(block)">Обзор…</button>
                </span>
            </label>
            <label class="bc-field">
                <span>Имя на сайте</span>
                <input class="b-name" placeholder="Как у папки, например S1" value="@block.Name"
                       @onchange="e => NameTyped(block, e.Value?.ToString())" />
            </label>
        </div>
    }
</div>
@if (Title == null)
{
    <div class="block-actions">
        <button class="btn small" @onclick="Add">+ Добавить блок</button>
    </div>
}
@if (_error != null) { <div class="error small">@_error</div> }
<FolderPicker @bind-Open="_open" Title="Папка блока — внутри папки проекта" Start="@StartFolder"
              Extra="@(new[] { ("Папка проекта", ProjectFolders.Clean(ProjectFolder)) })" Chosen="Chosen" />

@code {
    /// <summary>Папка проекта: папки блоков — внутри неё.</summary>
    [Parameter] public string ProjectFolder { get; set; }
    [Parameter] public List<BlockDraft> Items { get; set; } = new();
    /// <summary>Заголовок списка с плюсиком («Список блоков»); null — без заголовка, кнопка «+ Добавить блок» снизу.</summary>
    [Parameter] public string Title { get; set; }
    /// <summary>Список изменился (строку добавили, убрали, выбрали папку) — чтобы страница показала или спрятала «Сохранить».</summary>
    [Parameter] public EventCallback Changed { get; set; }

    private bool _open;
    private BlockDraft _target;
    private string _error;

    private string StartFolder => _target == null || string.IsNullOrWhiteSpace(_target.Folder)
        ? ProjectFolders.Clean(ProjectFolder)
        : Path.Combine(ProjectFolders.Clean(ProjectFolder), ProjectFolders.Clean(_target.Folder));

    private Task Add()
    {
        Items.Add(new BlockDraft());
        _error = null;
        return Changed.InvokeAsync();
    }

    private Task Remove(BlockDraft b)
    {
        Items.Remove(b);
        return Changed.InvokeAsync();
    }

    private Task NameTyped(BlockDraft b, string name)
    {
        b.Name = name ?? string.Empty;
        b.NameTouched = !string.IsNullOrWhiteSpace(b.Name);
        return Changed.InvokeAsync();
    }

    /// <summary>Папку вписали руками — имя из неё, если его не меняли.</summary>
    private Task FolderTyped(BlockDraft b)
    {
        AutoName(b, ProjectFolders.Clean(b.Folder));
        return Changed.InvokeAsync();
    }

    private void Pick(BlockDraft b)
    {
        _target = b;
        _error = null;
        _open = true;
    }

    /// <summary>Папка выбрана: внутри папки проекта — относительный путь, имя — из неё (если не меняли руками).</summary>
    private Task Chosen(string path)
    {
        var relative = ProjectBlocks.Relative(ProjectFolder, path);
        if (relative == null)
        {
            _error = "Папка блока должна быть внутри папки проекта.";
            return Task.CompletedTask;
        }
        _target.Folder = relative;
        AutoName(_target, relative);
        return Changed.InvokeAsync();
    }

    private static void AutoName(BlockDraft b, string folder)
    {
        if (b.NameTouched || string.IsNullOrWhiteSpace(folder)) return;
        var last = folder.Split('\\').Last();
        b.Name = ReportPath.Block(last) ?? last;
    }

    /// <summary>
    /// Готовые блоки из карточек: пустые пропускаются, папки — относительно папки проекта; что не так (папка вне
    /// проекта или её нет, повторы) — текст, всё хорошо — null.
    /// </summary>
    public static string Collect(string projectFolder, IEnumerable<BlockDraft> items, out List<(string Name, string Folder)> blocks)
    {
        blocks = new List<(string Name, string Folder)>();
        foreach (var b in items)
        {
            if (string.IsNullOrWhiteSpace(b.Name) && string.IsNullOrWhiteSpace(b.Folder)) continue;
            var relative = string.IsNullOrWhiteSpace(b.Folder) ? "" : ProjectBlocks.Relative(projectFolder, b.Folder);
            if (relative == null) return $"Папка блока «{b.Name?.Trim()}» — вне папки проекта: {b.Folder}";
            if (relative.Length > 0 && !Directory.Exists(Path.Combine(ProjectFolders.Clean(projectFolder), relative)))
                return $"Папка блока «{b.Name?.Trim()}» не найдена: {relative}";
            blocks.Add(((b.Name ?? "").Trim(), relative));
        }
        return ProjectBlocks.Validate(blocks);
    }

    /// <summary>Подсказка по папке проекта: вложенные папки, похожие на блоки (S1, «Блок 2»), — карточками.</summary>
    public static List<BlockDraft> Suggest(string projectFolder)
    {
        var root = ProjectFolders.Clean(projectFolder);
        try
        {
            if (root.Length == 0 || !Directory.Exists(root)) return new List<BlockDraft>();
            return ProjectBlocks.Suggest(Directory.GetDirectories(root).Select(Path.GetFileName))
                .Select(x => new BlockDraft { Name = x.Name, Folder = x.Folder, Suggested = true }).ToList();
        }
        catch (Exception ex) when (ex is IOException || ex is UnauthorizedAccessException)
        {
            return new List<BlockDraft>();
        }
    }
}
