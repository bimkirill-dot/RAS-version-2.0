@* Маленький график в строку (карточка и список проектов): как менялось число по неделям, шкала — от наименьшего до наибольшего;
   последняя точка — кружком, значения — в подсказке. *@
@if (Values != null && Values.Count > 1)
{
    <svg class="spark" viewBox="0 0 @W @H" width="@W" height="@H" role="img" aria-label="@Title">
        <title>@Title</title>
        <polyline points="@Points" />
        <circle cx="@F(X(Values.Count - 1))" cy="@F(Y(Values[^1]))" r="2.5" />
    </svg>
}

@code {
    [Parameter] public List<int> Values { get; set; }
    [Parameter] public string Title { get; set; }

    private const int W = 96, H = 26, Pad = 3;
    // шкала — от наименьшего до наибольшего (как принято у таких графиков): иначе изменения рядом с итогом не видны
    private double X(int i) => Pad + (W - 2 * Pad) * i / (double)(Values.Count - 1);
    private double Y(int v)
    {
        var min = Values.Min();
        var max = Values.Max();
        return max == min ? H / 2.0 : H - Pad - (H - 2 * Pad) * (v - min) / (double)(max - min);
    }
    private string Points => string.Join(" ", Values.Select((v, i) => $"{F(X(i))},{F(Y(v))}"));
    private static string F(double v) => v.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);
}
