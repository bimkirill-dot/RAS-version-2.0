@inherits LayoutComponentBase

<header class="top">
    <a class="brand" href="/">
        <svg class="brand-mark" viewBox="0 0 28 28" aria-hidden="true">
            <rect x="2" y="7" width="15" height="15" rx="3" fill="var(--accent)" opacity=".9" />
            <rect x="11" y="3" width="15" height="15" rx="3" fill="var(--active)" opacity=".8" />
            <rect x="11" y="7" width="6" height="11" fill="var(--panel)" opacity=".85" />
        </svg>
        <span class="brand-name">RAS <span>Clash Analysis</span></span>
        <span class="brand-sub">единая база коллизий</span>
    </a>
    @* тема — без связи с сайтом (обычный обработчик): работает и пока страница подключается *@
    <button class="theme-toggle" onclick="ras.toggleTheme()" title="Светлая / тёмная тема">◐</button>
</header>

<main>
    @Body
</main>

<div id="blazor-error-ui">
    Что-то пошло не так — подробности в журнале сайта.
    <a href="" class="reload">Обновить страницу</a>
    <a class="dismiss">✕</a>
</div>
