@inherits LayoutComponentBase

<header class="top">
    @* знак RAS — тёмно-синяя плашка с узкими высокими буквами, как логотип прежнего плагина (вариант А, 13.10.2026; без подписи) *@
    <a class="brand" href="/" title="Проекты">
        <span class="ras-plate">RAS</span>
        <span class="brand-name">Clash Analysis</span>
    </a>
    @* тема — без связи с сайтом (обычный обработчик): работает и пока страница подключается *@
    <button class="theme-toggle" onclick="ras.toggleTheme()" title="Светлая / тёмная тема">◐</button>
</header>

<main>
    @Body
</main>

<div id="blazor-error-ui">
    Что-то пошло не так — подробности в журнале сайта.
    <a href="" class="reload">Обновить страницу</a>
    <a class="dismiss">✕</a>
</div>
