@inherits LayoutComponentBase

<header class="top">
    @* без знака компании — продукт для любой компании (14.10.2026): «Clash Analysis · Менеджер коллизий» *@
    <a class="brand" href="/" title="Проекты">
        <span class="brand-name">Clash Analysis</span>
        <span class="brand-dot" aria-hidden="true">·</span>
        <span class="brand-sub">Менеджер коллизий</span>
    </a>
    @* тема — без связи с сайтом (обычный обработчик): работает и пока страница подключается *@
    <a class="theme-toggle head-btn" href="settings" title="Настройки сайта">⚙</a>
    <button class="theme-toggle head-btn" onclick="ras.toggleTheme()" title="Светлая / тёмная тема">◐</button>
</header>

<main>
    @Body
</main>

<div id="blazor-error-ui">
    Что-то пошло не так — подробности в журнале сайта.
    <a href="" class="reload">Обновить страницу</a>
    <a class="dismiss">✕</a>
</div>
