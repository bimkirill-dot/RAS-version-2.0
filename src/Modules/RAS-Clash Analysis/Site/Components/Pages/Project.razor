@page "/project/{Id:long}"
@implements IDisposable
@inject ClashStore Store
@inject ReportImporter Importer
@inject ProjectViewState ViewState
@inject IJSRuntime JS

<PageTitle>@(_project?.Name ?? "Проект") · RAS Clash Analysis</PageTitle>

@if (_project == null)
{
    <h1>Проект не найден</h1>
    <p><a href="/">К проектам</a></p>
    return;
}

<div class="project-page">
    <div class="project-head">
        <div class="ph-title">
            <nav class="crumbs"><a href="/">Проекты</a> ›</nav>
            <h1>@_project.Name</h1>
            <div class="muted small">@(_lastRun.HasValue ? "Последний прогон — " + Fmt.Day(_lastRun.Value) : "Отчётов ещё нет") · @Fmt.Plural(ScopeReports.Count(), "отчёт", "отчёта", "отчётов")</div>
        </div>
        @if (_tests.Count > 0)
        {
            @* итоги выбранного на лентах — крупными цифрами (для показа руководству) *@
            var k = Kpi;
            <div class="kpis">
                <div class="kpi k-active"><div class="v">@k.Active</div><div class="l">Активные</div></div>
                <div class="kpi k-pending"><div class="v">@k.Pending</div><div class="l">Ждут проверки</div></div>
                <div class="kpi k-fixed"><div class="v">@k.Fixed</div><div class="l">Исправлены</div></div>
                <div class="kpi k-accepted"><div class="v">@k.Accepted</div><div class="l">Допущены</div></div>
                <div class="kpi k-progress" title="Исправлено из всех, кроме допущенных">
                    <div class="v">@FixedPercent(k) %</div><div class="l">исправлено</div>
                    <div class="kpi-bar"><i style="width:@FixedPercent(k)%"></i></div>
                </div>
            </div>
        }
    </div>

    @if (_view.Tab != 3)
    {
        @* основная лента: критичность (число — активные); «Все» — все критичности *@
        <div class="ribbon main-ribbon" role="tablist" aria-label="Критичность">
            @foreach (var cr in _criticalities)
            {
                <button class="crit @(cr == _filter.Criticality ? "on" : "") @CriticalityClass(cr)" @onclick="() => SetScope(cr, null, null)">
                    @CriticalityTitle(cr) <b>@ActiveIn(cr, null, null)</b>
                </button>
            }
            @if (ShowAllCriticalities)
            {
                <button class="crit @(_filter.Criticality == null ? "on" : "")" @onclick="() => SetScope(null, null, null)">
                    Все <b>@ActiveIn(null, null, null)</b>
                </button>
            }
            @if (_criticalities.Count == 0)
            {
                <span class="muted">Отчётов ещё нет — «Отчёты» на боковой панели, «Проверить папку сейчас».</span>
            }
        </div>

        @* дополнительная лента: отборы одной строкой — дата (прогон), тип проверки, блок, раздел, уровень, статус, поиск *@
        @if (_criticalities.Count > 0)
        {
            <div class="ribbon sub-ribbon">
                <label class="dd" title="За какой прогон: последний (что сейчас), любой прошлый или все">
                    <span>Дата</span>
                    <select value="@_view.RunDate" @onchange="OnRunDateChanged">
                        <option value="last">Последняя@(_lastRun.HasValue ? " — " + Fmt.Day(_lastRun.Value) : "")</option>
                        @foreach (var d in RunDates)
                        {
                            <option value="@d.ToString("yyyy-MM-dd")">@Fmt.Day(d)</option>
                        }
                        <option value="all">Все даты</option>
                    </select>
                </label>
                <label class="dd">
                    <span>Тип проверки</span>
                    <select value="@(_filter.TestType ?? "")" @onchange="OnTestChanged">
                        <option value="">Все (@ActiveIn(_filter.Criticality, _filter.Block, null))</option>
                        @foreach (var (name, active) in TestTypes)
                        {
                            <option value="@name">@name (@active)</option>
                        }
                    </select>
                </label>
                @if (ShowBlocks)
                {
                    <label class="dd">
                        <span>Блок</span>
                        <select value="@BlockValue" @onchange="OnBlockChanged">
                            <option value="*">Все (@ActiveIn(_filter.Criticality, null, null))</option>
                            @foreach (var b in BlocksOf(_filter.Criticality))
                            {
                                <option value="@(b == "" ? "-" : b)">@ReportPath.BlockTitle(b) (@ActiveIn(_filter.Criticality, b, null))</option>
                            }
                        </select>
                    </label>
                }
                <FacetMenu Title="Раздел" Values="_facetValues[ClashFacets.Discipline]" Selected="FacetSet(ClashFacets.Discipline)" Changed="Recompute" />
                <FacetMenu Title="Уровень" Values="_facetValues[ClashFacets.Level]" Selected="FacetSet(ClashFacets.Level)" Changed="Recompute" />
                <FacetMenu Title="Статус" Values="_facetValues[ClashFacets.State]" Selected="FacetSet(ClashFacets.State)" Changed="Recompute" />
                <input class="search" type="search" placeholder="Поиск: номер элемента, тип, имя…" value="@_filter.Search" @oninput="OnSearch" />
                @if (FilterIsSet)
                {
                    <button class="btn link small" @onclick="ResetFilter">Сбросить</button>
                }
            </div>
        }
    }

    <div class="body @(_view.Tab == 0 && SelectedVisible ? "with-panel" : "")">
            @* боковая панель — разделы этого проекта *@
            <aside class="side" aria-label="Разделы проекта">
                <div class="side-title">Проект</div>
                <button class="side-btn @(_view.Tab == 0 ? "on" : "")" @onclick="() => _view.Tab = 0" title="Коллизии — список и карточка">
                    <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 5h14M3 10h14M3 15h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" fill="none"/></svg><span>Коллизии</span><b>@ActiveIn(_filter.Criticality, _filter.Block, _filter.TestType)</b>
                </button>
                <button class="side-btn @(_view.Tab == 1 ? "on" : "")" @onclick="() => _view.Tab = 1" title="Проверки Navisworks — сколько коллизий в каждой">
                    <svg viewBox="0 0 20 20" aria-hidden="true"><rect x="3" y="3" width="6" height="6" rx="1.5" stroke="currentColor" stroke-width="1.5" fill="none"/><rect x="11" y="11" width="6" height="6" rx="1.5" stroke="currentColor" stroke-width="1.5" fill="none"/><path d="M9 6h5v5" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round"/></svg><span>Проверки</span><b>@ScopeTests.Count()</b>
                </button>
                <button class="side-btn @(_view.Tab == 2 ? "on" : "")" @onclick="() => _view.Tab = 2" title="Загруженные отчёты Navisworks этого проекта">
                    <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 2.5h7l3.5 3.5v11.5h-10.5z" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linejoin="round"/><path d="M8 10h5M8 13.5h5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg><span>Отчёты</span><b>@ScopeReports.Count()</b>
                </button>
                <button class="side-btn @(_view.Tab == 3 ? "on" : "")" @onclick="() => _view.Tab = 3" title="Название и папка проекта">
                    <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="2.6" stroke="currentColor" stroke-width="1.5" fill="none"/><path d="M10 2.5v2.2M10 15.3v2.2M2.5 10h2.2M15.3 10h2.2M4.7 4.7l1.6 1.6M13.7 13.7l1.6 1.6M4.7 15.3l1.6-1.6M13.7 6.3l1.6-1.6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg><span>Проект</span>
                </button>
            </aside>

            @if (_view.Tab == 0)
            {
                <section class="content">
                    <div class="list-title">
                        <h2>Коллизии <span class="muted">(@_clashes.Count)</span></h2>
                        @if (_view.RunDate == "last" && _lastRun.HasValue)
                        {
                            @* что принёс последний прогон — щелчок показывает именно их *@
                            <div class="run-strip">
                                @RunChip("new", "новых", "+")
                                @RunChip("fixed", "исправлено", "")
                                @RunChip("returned", "вернулось", "↺ ")
                                @if (_view.RunFilter != null)
                                {
                                    <button class="btn link small" @onclick="() => SetRunFilter(null)">✕</button>
                                }
                            </div>
                        }
                        <span class="spacer"></span>
                        <label class="dd">
                            <span>Группировка</span>
                            <select value="@_view.GroupBy" @onchange="OnGroupChanged">
                                <option value="">Нет</option>
                                <option value="test">По типу проверки</option>
                                <option value="element">По элементу</option>
                            </select>
                        </label>
                        <button class="btn" title="Скачать список (как сейчас отобран) — откроется в Excel" @onclick="ExportCsv">⤓ Excel</button>
                    </div>

                    @if (_selected.Count > 0)
                    {
                        <div class="toolbar bulk">
                            @if (_pendingState.HasValue)
                            {
                                <span class="confirm">
                                    Сделать «@StateButtonTitle(_pendingState.Value)» у @Fmt.Clashes(_selected.Count)?
                                    <button class="btn primary" @onclick="ConfirmBulk">Да</button>
                                    <button class="btn" @onclick="() => _pendingState = null">Отмена</button>
                                </span>
                            }
                            else
                            {
                                <span>Отмечено: <b>@_selected.Count</b></span>
                                <input class="comment" placeholder="Комментарий ко всем (необязательно)" @bind="_bulkComment" />
                                <button class="btn state-pending" title="Станет «Исправлена», когда следующий прогон её не найдёт" @onclick="() => AskBulk(ClashState.Pending)">Исправлена</button>
                                <button class="btn state-accepted" @onclick="() => AskBulk(ClashState.Accepted)">Допущена</button>
                                <button class="btn state-active" @onclick="() => AskBulk(ClashState.Active)">Активная</button>
                                <button class="btn link" @onclick="() => _selected.Clear()">Снять отметки</button>
                            }
                        </div>
                    }
                    else if (_notice != null)
                    {
                        <div class="toolbar"><span class="notice">@_notice</span></div>
                    }

                    <div class="list" tabindex="0" @onkeydown="ListKey">
                        @if (_clashes.Count == 0)
                        {
                            <div class="empty">
                                Ничего не найдено.
                                @if (FilterIsSet) { <button class="btn link" @onclick="ResetFilter">Сбросить отборы</button> }
                                @if (_view.RunDate != "all") { <button class="btn link" @onclick='() => SetRunDate("all")'>Все даты</button> }
                            </div>
                        }
                        else
                        {
                            <table class="grid clashes">
                                <colgroup>
                                    <col class="c-sel" /><col class="c-date" /><col class="c-test" />
                                    @if (Wide) { <col class="c-disc" /> }
                                    <col class="c-name" /><col class="c-dist" />
                                    @if (Wide) { <col class="c-grid" /> }
                                    <col class="c-level" /><col class="c-state" />
                                    @if (Wide) { <col class="c-rep" /> }
                                </colgroup>
                                <thead>
                                    <tr>
                                        <th class="sel" @onclick:stopPropagation="true">
                                            <input type="checkbox" checked="@AllSelected" @onchange="ToggleAll" title="Отметить все найденные (@_clashes.Count)" />
                                        </th>
                                        @SortHeader("date", "Дата", "Последний прогон, где была коллизия")
                                        @SortHeader("test", "Проверка")
                                        @if (Wide) { @SortHeader("disc", "Раздел") }
                                        @SortHeader("name", "Имя")
                                        @SortHeader("dist", "Расстояние", "Глубина пересечения, мм — если включена в отчёт Navisworks")
                                        @if (Wide) { @SortHeader("grid", "Оси", "Расположение по осям — если включено в отчёт Navisworks") }
                                        @SortHeader("level", "Уровень")
                                        @SortHeader("state", "Статус")
                                        @if (Wide) { @SortHeader("repeats", "Повторы", "В скольких прогонах встречалась") }
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in PageItems)
                                    {
                                        if (item.Group != null)
                                        {
                                            var g = item.Group;
                                            var collapsed = _view.GroupCollapsed.Contains(g.Key);
                                            <tr class="group-row" @onclick="() => ToggleGroup(g.Key)">
                                                <td class="sel" @onclick:stopPropagation="true">
                                                    <input type="checkbox" checked="@g.Rows.All(r => _selected.Contains(r.Id))" @onchange="e => ToggleRows(g.Rows, e)"
                                                           title="Отметить всю группу (@g.Rows.Count)" />
                                                </td>
                                                <td colspan="@(Wide ? 9 : 6)">
                                                    <span class="caret">@(collapsed ? "▸" : "▾")</span>
                                                    <span class="group-title">@g.Title</span>
                                                    @if (g.Sub != null) { <span class="mono small muted"> · @g.Sub</span> }
                                                    <span class="group-count">@Fmt.Plural(g.Rows.Count, "коллизия", "коллизии", "коллизий")</span>
                                                </td>
                                            </tr>
                                        }
                                        else
                                        {
                                            @Row(item.Row)
                                        }
                                    }
                                </tbody>
                            </table>
                        }
                    </div>

                    @if (_clashes.Count > 0)
                    {
                        <div class="pager">
                            <span class="muted">@_clashes.Count</span>
                            <button class="btn small" disabled="@(_page == 0)" @onclick="() => _page--">‹</button>
                            @foreach (var pg in PageNumbers)
                            {
                                if (pg < 0) { <span class="muted">…</span> }
                                else { <button class="btn small @(pg == _page ? "on" : "")" @onclick="() => _page = pg">@(pg + 1)</button> }
                            }
                            <button class="btn small" disabled="@(_page >= PageCount - 1)" @onclick="() => _page++">›</button>
                            <select class="page-size" value="@_view.PageSize" @onchange="OnPageSizeChanged">
                                <option value="50">50 на странице</option>
                                <option value="100">100 на странице</option>
                                <option value="200">200 на странице</option>
                            </select>
                        </div>
                    }
                </section>

                @if (SelectedVisible)
                {
                    <aside class="panel">
                        <div class="panel-nav">
                            <button class="btn small" disabled="@(SelectedIndex <= 0)" @onclick="() => Move(-1)" title="Предыдущая (↑)">‹</button>
                            <span class="muted small">@(SelectedIndex >= 0 ? $"{SelectedIndex + 1} из {_visible.Count}" : "нет в списке")</span>
                            <button class="btn small" disabled="@(SelectedIndex < 0 || SelectedIndex >= _visible.Count - 1)" @onclick="() => Move(1)" title="Следующая (↓)">›</button>
                            <label class="check small" title="После смены статуса сразу открывать следующую коллизию">
                                <input type="checkbox" @bind="_view.AutoNext" /> после статуса — к следующей
                            </label>
                            <span class="spacer"></span>
                            <a class="small" href="clash/@_view.SelectedId">отдельно</a>
                            <button class="btn link small" title="Закрыть карточку (Esc)" @onclick="() => _view.SelectedId = null">✕</button>
                        </div>
                        <ClashPanel ClashId="_view.SelectedId.Value" Compact="true" Changed="OnPanelChanged" />
                    </aside>
                }
            }
            else if (_view.Tab == 1)
            {
                <section class="content scroll">
                    <p class="muted small">
                        «Тип» — как проверка называется на сайте; по нему работает «Тип проверки» на ленте. Одинаковые проверки с разным написанием
                        («Ж Горизонтальные…» и «КЖ Горизонтальные…», «MEP» и «МЕР») объединяются, если дать им одно название типа.
                        Название меняется для всех блоков и будущих отчётов; в Navisworks ничего не меняется.
                    </p>
                    <datalist id="test-types">
                        @foreach (var type in _tests.Select(t => t.Type).Distinct().OrderBy(x => x, StringComparer.CurrentCultureIgnoreCase)) { <option value="@type"></option> }
                    </datalist>
                    <table class="grid">
                        <thead><tr><th>Проверка</th><th>Тип</th><th class="num">Активные</th><th class="num">Ждут проверки</th><th class="num">Исправлены</th><th class="num">Допущены</th><th>Последний отчёт</th></tr></thead>
                        <tbody>
                            @foreach (var t in ScopeTests)
                            {
                                <tr class="clickable" @onclick="() => ShowTest(t)" title="Показать коллизии этой проверки">
                                    <td>@if (_filter.Block == null && t.Block != "") { <span class="tag">@t.Block</span> }@t.Name</td>
                                    <td class="type-cell" @onclick:stopPropagation="true">
                                        @if (_editingType == t.Name)
                                        {
                                            <input list="test-types" @bind="_typeInput" @bind:event="oninput" placeholder="Название типа" />
                                            <button class="btn small primary" @onclick="() => SaveType(t)">Сохранить</button>
                                            <button class="btn link small" @onclick="() => _editingType = null">Отмена</button>
                                        }
                                        else
                                        {
                                            <span class="@(t.Type != t.Name ? "renamed" : "")" title="@(t.Type != t.Name ? "Своё название; в Navisworks: " + t.Name : "")">@t.Type</span>
                                            <button class="btn link small" title="Переименовать или объединить с другим типом" @onclick="() => StartEditType(t)">✎</button>
                                        }
                                    </td>
                                    <td class="num"><Bar Value="t.Counts.Active" Max="_maxActive" /></td>
                                    <td class="num">@t.Counts.Pending</td>
                                    <td class="num">@t.Counts.Fixed</td>
                                    <td class="num">@t.Counts.Accepted</td>
                                    <td>@Fmt.Date(t.LastReport)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </section>
            }
            else if (_view.Tab == 2)
            {
                <section class="content scroll">
                    <div class="toolbar">
                        <button class="btn" disabled="@Importer.Busy" @onclick="Scan">@(Importer.Busy ? "Проверяем папку…" : "Проверить папку сейчас")</button>
                        <label class="dd">
                            <span>Группировка</span>
                            <select value="@_view.ReportGroup" @onchange="OnReportGroupChanged">
                                <option value="">Без группировки</option>
                                <option value="block">По блоку</option>
                                <option value="date">По дате отчёта</option>
                                <option value="file">По файлу</option>
                                <option value="imported">По дню загрузки</option>
                            </select>
                        </label>
                        <span class="spacer"></span>
                        <span class="path" title="Папка проекта">@_project.Folder</span>
                    </div>
                    <ImportResults Results="Importer.LastResults" />
                    <table class="grid reports">
                        <thead>
                            <tr>
                                @ReportSortHeader("date", "Дата отчёта")
                                @ReportSortHeader("block", "Блок")
                                @ReportSortHeader("file", "Файл")
                                @ReportSortHeader("count", "Коллизий", "num")
                                @ReportSortHeader("imported", "Загружен")
                            </tr>
                        </thead>
                        @foreach (var g in ReportGroups())
                        {
                            var collapsed = g.Key != null && _view.ReportCollapsed.Contains(g.Key);
                            <tbody class="group">
                                @if (g.Key != null)
                                {
                                    <tr class="group-row" @onclick="() => ToggleReportGroup(g.Key)">
                                        <td colspan="5">
                                            <span class="caret">@(collapsed ? "▸" : "▾")</span>
                                            <span class="group-title">@g.Title</span>
                                            <span class="group-count">@Fmt.Plural(g.Reports.Count, "отчёт", "отчёта", "отчётов") · @Fmt.Plural(g.Reports.Sum(r => r.Results), "коллизия", "коллизии", "коллизий") в отчётах</span>
                                        </td>
                                    </tr>
                                }
                                @if (!collapsed)
                                {
                                    foreach (var r in g.Reports)
                                    {
                                        <tr>
                                            <td title="@DateSourceTitle(r.DateSource)">@(r.DateSource == ReportPath.DateFromFolder ? Fmt.Day(r.ReportDate) : Fmt.Date(r.ReportDate))@(r.DateSource == ReportPath.DateFromXml ? "" : "*")</td>
                                            <td>@ReportPath.BlockTitle(r.Block)</td>
                                            <td class="file" title="@r.FilePath">
                                                <div class="cut">@System.IO.Path.GetFileName(r.FilePath)</div>
                                                <div class="el-sub cut">@ReportFolder(r)</div>
                                                @if (r.Warning != null) { <div class="warn small" title="@r.Warning">⚠ Неполный отчёт: пропавшие коллизии не считаются исправленными</div> }
                                            </td>
                                            <td class="num">@r.Results</td>
                                            <td>@Fmt.Date(r.Imported)</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        }
                    </table>
                    @if (ScopeReports.Any(r => r.DateSource != ReportPath.DateFromXml))
                    {
                        <p class="muted">* — в отчёте нет даты обнаружения коллизий: дата — из названия папки прогона, а если её нет — время файла. Дату можно включить в настройках отчёта Navisworks.</p>
                    }
                </section>
            }
            else
            {
                <section class="content scroll">
                    <div class="form">
                        <label>Название <input @bind="_editName" /></label>
                        <label>Папка с отчётами проекта <input class="wide" @bind="_editFolder" /></label>
                        <button class="btn primary" @onclick="SaveProject">Сохранить</button>
                        @if (_editMessage != null) { <p class="@(_editError ? "error" : "muted")">@_editMessage</p> }
                    </div>
                </section>
            }
    </div>
</div>

@code {
    [Parameter] public long Id { get; set; }

    /// <summary>Строка списка: заголовок группы или коллизия.</summary>
    private sealed class ListItem
    {
        public ListGroup Group;
        public ClashRow Row;
    }

    /// <summary>Группа списка: по типу проверки или по элементу.</summary>
    private sealed class ListGroup
    {
        public string Key;
        public string Title;
        public string Sub;
        public List<ClashRow> Rows;
    }

    private ProjectView _view;
    private ClashFilter _filter;
    private ProjectRow _project;
    private List<TestRow> _tests = new();
    private List<ReportRow> _reports = new();
    private List<string> _criticalities = new();
    /// <summary>Коллизии выбранной критичности / блока / проверки — из базы; дальше — отборы на странице.</summary>
    private List<ClashRow> _base = new();
    /// <summary>После поиска и полей, без статуса (числа на вкладках статуса).</summary>
    private List<ClashRow> _faceted = new();
    private List<ClashRow> _clashes = new();
    /// <summary>После поиска, полей и отбора прогона, без статуса (числа на вкладках статуса).</summary>
    private List<ClashRow> _runFiltered = new();
    /// <summary>Строки в порядке на экране (в развёрнутых группах) — для ↑ ↓, «N из M», «Показать ещё».</summary>
    private List<ClashRow> _visible = new();
    /// <summary>Строки списка с заголовками групп — по ним страницы.</summary>
    private List<ListItem> _items = new();
    private int _page;
    /// <summary>Последний прогон выбранного (самый поздний отчёт проверок).</summary>
    private DateTime? _lastRun;
    private string _editingType, _typeInput;
    private readonly Dictionary<string, List<FacetValue>> _facetValues = ClashFacets.All.ToDictionary(f => f, _ => new List<FacetValue>());
    private readonly HashSet<long> _selected = new();
    private string _bulkComment;
    private ClashState? _pendingState;
    private string _notice;
    private int _maxActive;
    private string _editName, _editFolder, _editMessage;
    private bool _editError;
    private CancellationTokenSource _searchDelay;

    private bool FilterIsSet => !string.IsNullOrWhiteSpace(_filter.Search) || _filter.Facets.Values.Any(v => v.Count > 0) || _view.RunFilter != null;
    private bool AllSelected => _clashes.Count > 0 && _clashes.All(c => _selected.Contains(c.Id));
    private int SelectedIndex => _view.SelectedId.HasValue ? _visible.FindIndex(c => c.Id == _view.SelectedId.Value) : -1;
    private bool SelectedVisible => _view.SelectedId.HasValue;
    /// <summary>Список во всю ширину (карточка закрыта) — со всеми столбцами.</summary>
    private bool Wide => !SelectedVisible;
    private IEnumerable<TestRow> ScopeTests => _tests.Where(InScope);
    private IEnumerable<ReportRow> ScopeReports => _reports.Where(r => (_filter.Criticality == null || r.Criticality == _filter.Criticality)
                                                                      && (_filter.Block == null || r.Block == _filter.Block));
    /// <summary>Блок у строки — когда выбрана вся критичность, а блоков несколько.</summary>
    private bool ShowBlock => _filter.Block == null && BlocksOf(_filter.Criticality).Count > 1;

    private string ScopeTitle
    {
        get
        {
            var parts = new List<string> { _filter.Criticality == null ? "Все критичности" : CriticalityTitle(_filter.Criticality) };
            if (!string.IsNullOrEmpty(_filter.Block)) parts.Add(_filter.Block);
            if (_filter.TestType != null) parts.Add(_filter.TestType);
            return string.Join(" › ", parts);
        }
    }

    protected override void OnParametersSet()
    {
        _view = ViewState.For(Id);
        _filter = _view.Filter;
        if (!_view.Initialized)
        {
            // по умолчанию — то, с чем работать: активные и ждущие проверки
            FacetSet(ClashFacets.State).UnionWith(new[] { ((int)ClashState.Active).ToString(), ((int)ClashState.Pending).ToString() });
            _filter.State = null;
            _view.Initialized = true;
        }
        LoadAll();
    }

    // ───── загрузка ─────

    private void LoadAll()
    {
        _project = Store.Project(Id);
        if (_project == null) return;
        _editName ??= _project.Name;
        _editFolder ??= _project.Folder;
        _tests = Store.Tests(Id);
        _reports = Store.Reports(Id);
        _criticalities = _tests.Select(t => t.Criticality).Distinct().OrderBy(ReportPath.CriticalityOrder).ToList();
        if (!_view.ScopeChosen || (_filter.Criticality != null && !_criticalities.Contains(_filter.Criticality)))
        {
            // при открытии — первая критичность (высокая), все блоки
            _filter.Criticality = _criticalities.FirstOrDefault();
            _filter.Block = null;
            _filter.TestType = null;
            _view.ScopeChosen = _criticalities.Count > 0;
        }
        if (_filter.Block != null && !BlocksOf(_filter.Criticality).Contains(_filter.Block)) _filter.Block = null;
        if (_filter.TestType != null && !_tests.Any(t => t.Type == _filter.TestType && InScope(t))) _filter.TestType = null;
        _maxActive = ScopeTests.Select(t => t.Counts.Active).DefaultIfEmpty(0).Max();
        _lastRun = ScopeTests.Where(t => t.LastReport.HasValue).Select(t => t.LastReport).DefaultIfEmpty(null).Max();
        _base = _criticalities.Count == 0 ? new List<ClashRow>() : Store.Clashes(Id, _filter);
        Recompute();
    }

    /// <summary>
    /// Отборы на странице: дата (прогон) → поиск → поля (раздел, уровень, статус) → что принёс последний прогон;
    /// числа у значений полей; группы и строки списка по страницам.
    /// </summary>
    private void Recompute()
    {
        var dated = _base.Where(InDate).ToList();
        var searched = dated.Where(c => ClashFacets.MatchesSearch(c, _filter.Search)).ToList();
        _faceted = searched.Where(c => ClashFacets.Matches(c, _filter.Facets)).ToList();
        _clashes = Sort(_faceted.Where(InRun).ToList());
        foreach (var f in ClashFacets.All)
        {
            var values = ClashFacets.Count(searched.Where(c => InRun(c) && ClashFacets.Matches(c, _filter.Facets, except: f)), f);
            // выбранное, которого сейчас нет в списке (другие отборы), — тоже видно, с нулём: его можно снять
            var missing = FacetSet(f).Where(k => values.All(v => v.Key != k)).ToList();
            if (missing.Count > 0)
            {
                var all = ClashFacets.Count(_base, f);
                foreach (var key in missing)
                    values.Add(new FacetValue { Key = key, Title = all.FirstOrDefault(v => v.Key == key)?.Title ?? FacetTitle(f, key), Count = 0 });
            }
            _facetValues[f] = values;
        }
        BuildItems();
        _selected.IntersectWith(_clashes.Select(c => c.Id));
        _page = Math.Min(_page, Math.Max(PageCount - 1, 0));
    }

    /// <summary>Строки списка: без группировки — коллизии; с группировкой — заголовок группы и её коллизии (свёрнутая — только заголовок).</summary>
    private void BuildItems()
    {
        List<ListGroup> groups = null;
        if (_view.GroupBy == "test")
            groups = _clashes.GroupBy(c => c.Type).OrderBy(g => g.Key, StringComparer.CurrentCultureIgnoreCase)
                .Select(g => new ListGroup { Key = "t:" + g.Key, Title = g.Key, Rows = g.ToList() }).ToList();
        else if (_view.GroupBy == "element")
            groups = ClashGrouping.ByElement(_clashes).Select(g => new ListGroup
            {
                Key = "e:" + (g.Key ?? "—"),
                Title = g.Key == null ? "Остальные — по одной коллизии на элемент" : Fmt.Element(g.Element),
                Sub = g.Key == null ? null : g.Element.ElementId + " · " + Fmt.Model(g.Element.ModelFile),
                Rows = g.Rows,
            }).ToList();
        _items = new List<ListItem>();
        if (groups == null)
        {
            _items.AddRange(_clashes.Select(c => new ListItem { Row = c }));
            _visible = _clashes;
            return;
        }
        _visible = new List<ClashRow>();
        foreach (var g in groups)
        {
            _items.Add(new ListItem { Group = g });
            if (_view.GroupCollapsed.Contains(g.Key)) continue;
            _items.AddRange(g.Rows.Select(r => new ListItem { Row = r }));
            _visible.AddRange(g.Rows);
        }
    }

    // ───── дата (прогон) ─────

    /// <summary>Дни прогонов выбранного — по отчётам, новые сверху.</summary>
    private IEnumerable<DateTime> RunDates => ScopeReports.Select(r => r.ReportDate.Date).Distinct().OrderByDescending(d => d);

    /// <summary>
    /// Коллизия относится к выбранному прогону: «последний» — есть в последнем отчёте своей проверки или исправлена им;
    /// день — была в отчётах того дня или исправлена ими; «все» — любая.
    /// </summary>
    private bool InDate(ClashRow c) => _view.RunDate switch
    {
        "all" => true,
        "last" => c.InLastReport || c.FixedInLastRun,
        _ => c.Runs.Contains(_view.RunDate),
    };

    private void OnRunDateChanged(ChangeEventArgs e) => SetRunDate(e.Value?.ToString() ?? "last");

    private void SetRunDate(string date)
    {
        _view.RunDate = date;
        // «что принёс прогон» — только про последний
        if (date != "last") _view.RunFilter = null;
        _view.SelectedId = null;
        _page = 0;
        Recompute();
    }

    // ───── последний прогон ─────

    /// <summary>Коллизия проходит отбор прогона: new — появилась в последнем отчёте своей проверки, fixed — исправлена им, returned — вернулась.</summary>
    private bool InRun(ClashRow c) => _view.RunFilter switch
    {
        "new" => c.NewInLastRun,
        "fixed" => c.FixedInLastRun,
        "returned" => c.ReturnedInLastRun,
        _ => true,
    };

    private int RunCount(string kind) => kind switch
    {
        "new" => _faceted.Count(c => c.NewInLastRun),
        "fixed" => _faceted.Count(c => c.FixedInLastRun),
        _ => _faceted.Count(c => c.ReturnedInLastRun),
    };

    private RenderFragment RunChip(string kind, string title, string prefix) => __builder =>
    {
        var n = RunCount(kind);
        <button class="run-chip @kind @(_view.RunFilter == kind ? "on" : "")" disabled="@(n == 0 && _view.RunFilter != kind)"
                @onclick="() => SetRunFilter(_view.RunFilter == kind ? null : kind)" title="Показать только их">
            @prefix<b>@n</b> @title
        </button>
    };

    /// <summary>Что принёс прогон: отбор статуса снимается (исправленные иначе не видны), выбранная коллизия — сбрасывается.</summary>
    private void SetRunFilter(string kind)
    {
        _view.RunFilter = kind;
        if (kind != null) FacetSet(ClashFacets.State).Clear();
        _page = 0;
        _view.SelectedId = null;
        _notice = null;
        Recompute();
    }

    // ───── группировка ─────

    private void OnGroupChanged(ChangeEventArgs e)
    {
        _view.GroupBy = e.Value?.ToString() ?? "";
        _view.GroupCollapsed.Clear();
        _page = 0;
        Recompute();
    }

    private void ToggleGroup(string key)
    {
        if (!_view.GroupCollapsed.Remove(key)) _view.GroupCollapsed.Add(key);
        Recompute();
    }

    private void ToggleRows(List<ClashRow> rows, ChangeEventArgs e)
    {
        if (e.Value is bool on && on) _selected.UnionWith(rows.Select(r => r.Id));
        else _selected.ExceptWith(rows.Select(r => r.Id));
        _notice = null;
    }

    // ───── страницы ─────

    private int PageCount => Math.Max(1, (_items.Count + _view.PageSize - 1) / _view.PageSize);

    private IEnumerable<ListItem> PageItems => _items.Skip(_page * _view.PageSize).Take(_view.PageSize);

    /// <summary>Номера страниц: первая, последняя, соседние с текущей; пропуски — -1 («…»).</summary>
    private IEnumerable<int> PageNumbers
    {
        get
        {
            var last = PageCount - 1;
            var shown = new SortedSet<int> { 0, last };
            for (var i = _page - 2; i <= _page + 2; i++) if (i >= 0 && i <= last) shown.Add(i);
            var prev = -1;
            foreach (var i in shown)
            {
                if (prev >= 0 && i - prev > 1) yield return -1;
                yield return i;
                prev = i;
            }
        }
    }

    private void OnPageSizeChanged(ChangeEventArgs e)
    {
        _view.PageSize = int.TryParse(e.Value?.ToString(), out var n) ? n : 50;
        _page = 0;
    }

    /// <summary>Страница, на которой коллизия.</summary>
    private int PageOf(long id)
    {
        var i = _items.FindIndex(x => x.Row != null && x.Row.Id == id);
        return i < 0 ? _page : i / _view.PageSize;
    }

    /// <summary>Строка списка.</summary>
    private RenderFragment Row(ClashRow x) => __builder =>
    {
        var disc = ClashFacets.DisciplinePair(x);
        <tr id="row-@x.Id" class="@(x.Id == _view.SelectedId ? "selected" : "") @(x.InLastReport ? "" : "gone")" @onclick="() => Select(x.Id)">
            <td class="sel" @onclick:stopPropagation="true">
                <input type="checkbox" checked="@_selected.Contains(x.Id)" @onchange="e => Toggle(x.Id, e)" />
            </td>
            <td>@Fmt.Day(x.LastSeen)</td>
            <td class="cut" title="@(x.Type != x.TestName ? x.Type + " (в Navisworks: " + x.TestName + ")" : x.TestName)">
                @if (ShowBlock) { <span class="tag">@x.Block</span> }@x.Type
            </td>
            @if (Wide) { <td><Disc Pair="@disc" /></td> }
            <td class="name">
                @(x.Name ?? "—")
                @if (x.ReturnCount > 0) { <span class="tag returned" title="Возвращалась после исправления: @x.ReturnCount">↺@(x.ReturnCount > 1 ? x.ReturnCount.ToString() : "")</span> }
            </td>
            <td>@if (x.Distance.HasValue) { <span class="dist">@Fmt.MmAbs(x.Distance, x.Units)</span> } else { <span class="muted">—</span> }</td>
            @if (Wide) { <td class="cut" title="@x.GridLocation">@(x.GridLocation ?? "—")</td> }
            <td class="cut" title="@Level(x)">@Level(x)</td>
            <td><span class="badge @Fmt.StateClass(x.State)">@Fmt.State(x.State)</span></td>
            @if (Wide) { <td class="num">@x.Repeats</td> }
        </tr>
    };

    /// <summary>Скачать список, как он сейчас отобран, — CSV для Excel (разделитель «;», UTF-8 с BOM — так Excel открывает кириллицу).</summary>
    private async Task ExportCsv()
    {
        static string Q(string v) => "\"" + (v ?? "").Replace("\"", "\"\"") + "\"";
        var sb = new System.Text.StringBuilder();
        sb.AppendLine(string.Join(";", new[] { "Дата", "Критичность", "Блок", "Тип проверки", "Проверка в Navisworks", "Раздел", "Имя", "Расстояние, мм", "Оси", "Уровень",
            "Статус", "Повторы", "Возвращалась", "Элемент 1", "Номер 1", "Модель 1", "Элемент 2", "Номер 2", "Модель 2" }.Select(Q)));
        foreach (var x in _clashes)
            sb.AppendLine(string.Join(";", new[]
            {
                Fmt.Day(x.LastSeen), x.Criticality, x.Block, x.Type, x.TestName, ClashFacets.DisciplinePair(x), x.Name,
                x.Distance.HasValue ? Fmt.MmAbs(x.Distance, x.Units).Replace(" мм", "") : "", x.GridLocation, Level(x),
                Fmt.State(x.State), x.Repeats.ToString(), x.ReturnCount.ToString(),
                Fmt.Element(x.A), x.A?.ElementId?.ToString(), Fmt.Model(x.A?.ModelFile),
                Fmt.Element(x.B), x.B?.ElementId?.ToString(), Fmt.Model(x.B?.ModelFile),
            }.Select(Q)));
        var name = $"Коллизии — {_project.Name} — {DateTime.Now:yyyy-MM-dd}.csv";
        await JS.InvokeVoidAsync("ras.download", name, sb.ToString());
    }

    /// <summary>Кнопка статуса: «Исправлена» ставит «Ждёт проверки».</summary>
    private static string StateButtonTitle(ClashState s) => s == ClashState.Pending ? "Исправлена" : Fmt.State(s);

    // ───── типы проверок ─────

    private void StartEditType(TestRow t)
    {
        _editingType = t.Name;
        _typeInput = t.Type;
    }

    private void SaveType(TestRow t)
    {
        Store.SetTestType(Id, t.Name, _typeInput);
        _editingType = null;
        LoadAll();
    }

    /// <summary>Подпись значения, которого нет ни у одной коллизии (статус — по названию, остальное — как есть).</summary>
    private static string FacetTitle(string facet, string key) =>
        facet == ClashFacets.State && int.TryParse(key, out var n) ? ClashRules.Title((ClashState)n) : key;

    /// <summary>Итоги выбранного на лентах (критичность, блок, тип проверки).</summary>
    private StateCounts Kpi
    {
        get
        {
            var k = new StateCounts();
            foreach (var t in ScopeTests)
            {
                k.Active += t.Counts.Active;
                k.Pending += t.Counts.Pending;
                k.Fixed += t.Counts.Fixed;
                k.Accepted += t.Counts.Accepted;
            }
            return k;
        }
    }

    /// <summary>Сколько исправлено из всех, кроме допущенных, — %.</summary>
    private static int FixedPercent(StateCounts k)
    {
        var all = k.Active + k.Pending + k.Fixed;
        return all == 0 ? 0 : (int)Math.Round(100.0 * k.Fixed / all);
    }

    private HashSet<string> FacetSet(string facet)
    {
        if (!_filter.Facets.TryGetValue(facet, out var set)) _filter.Facets[facet] = set = new HashSet<string>();
        return set;
    }


    // ───── дерево: критичность, блок, проверка ─────

    /// <summary>Блоки критичности (null — всех критичностей).</summary>
    private List<string> BlocksOf(string criticality) => _tests.Where(t => criticality == null || t.Criticality == criticality).Select(t => t.Block).Distinct()
        .OrderBy(ReportPath.BlockOrder).ThenBy(b => b, StringComparer.CurrentCultureIgnoreCase).ToList();

    private IEnumerable<TestRow> TestsOf(string criticality, string block) =>
        _tests.Where(t => (criticality == null || t.Criticality == criticality) && t.Block == block).OrderBy(t => t.Name, StringComparer.CurrentCultureIgnoreCase);

    private bool InScope(TestRow t) => (_filter.Criticality == null || t.Criticality == _filter.Criticality)
                                       && (_filter.Block == null || t.Block == _filter.Block)
                                       && (_filter.TestType == null || t.Type == _filter.TestType);

    /// <summary>Активные в критичности, блоке, типе проверки (null — во всех).</summary>
    private int ActiveIn(string criticality, string block, string testName) =>
        _tests.Where(t => (criticality == null || t.Criticality == criticality) && (block == null || t.Block == block) && (testName == null || t.Type == testName))
            .Sum(t => t.Counts.Active);

    /// <summary>Другая критичность, блок или проверка — другая работа: отметки и выбранная коллизия сбрасываются, отборы — нет.</summary>
    private void SetScope(string criticality, string block, string testName)
    {
        _filter.Criticality = criticality;
        _filter.Block = block;
        _filter.TestType = testName;
        _view.ScopeChosen = true;
        _view.SelectedId = null;
        _selected.Clear();
        _notice = null;
        _page = 0;
        LoadAll();
    }

    /// <summary>
    /// «Тип проверки»: каждое название проверки — один раз, сколько бы блоков и критичностей его ни имели;
    /// число — активные по всем таким проверкам в выбранной критичности и блоке.
    /// </summary>
    private IEnumerable<(string Name, int Active)> TestTypes => _tests
        .Where(t => (_filter.Criticality == null || t.Criticality == _filter.Criticality) && (_filter.Block == null || t.Block == _filter.Block))
        .GroupBy(t => t.Type)
        .Select(g => (g.Key, g.Sum(t => t.Counts.Active)))
        .OrderBy(x => x.Key, StringComparer.CurrentCultureIgnoreCase);

    /// <summary>Список «Блок» — когда в папках выбранной критичности блоки есть.</summary>
    private bool ShowBlocks
    {
        get
        {
            var blocks = BlocksOf(_filter.Criticality);
            return blocks.Count > 1 || (blocks.Count == 1 && blocks[0] != "");
        }
    }

    /// <summary>«Все» на основной ленте — когда в папках есть критичность (иначе кнопка повторяла бы единственную).</summary>
    private bool ShowAllCriticalities => _criticalities.Count > 1 || (_criticalities.Count == 1 && _criticalities[0] != "");

    private string BlockValue => _filter.Block == null ? "*" : _filter.Block == "" ? "-" : _filter.Block;

    private void OnTestChanged(ChangeEventArgs e)
    {
        var name = e.Value?.ToString();
        SetScope(_filter.Criticality, _filter.Block, string.IsNullOrEmpty(name) ? null : name);
    }

    /// <summary>Другой блок: выбранный тип проверки остаётся, если он есть в этом блоке.</summary>
    private void OnBlockChanged(ChangeEventArgs e)
    {
        var v = e.Value?.ToString();
        var block = v == "*" ? null : v == "-" ? "" : v;
        var keep = _filter.TestType != null && _tests.Any(t => t.Type == _filter.TestType
                                                              && (_filter.Criticality == null || t.Criticality == _filter.Criticality)
                                                              && (block == null || t.Block == block));
        SetScope(_filter.Criticality, block, keep ? _filter.TestType : null);
    }

    // ───── отчёты: сортировка и группировка ─────

    private sealed class ReportGroup
    {
        /// <summary>null — без группировки (одна группа без заголовка).</summary>
        public string Key;
        public string Title;
        public List<ReportRow> Reports;
    }

    private RenderFragment ReportSortHeader(string key, string title, string css = null) => __builder =>
    {
        var on = _view.ReportSortKey == key;
        <th class="sortable @(on ? "sorted" : "") @css" @onclick="() => SortReports(key)" title="Сортировать">
            @title @(on ? (_view.ReportSortDesc ? "▼" : "▲") : "")
        </th>
    };

    private void SortReports(string key)
    {
        if (_view.ReportSortKey == key) _view.ReportSortDesc = !_view.ReportSortDesc;
        else
        {
            _view.ReportSortKey = key;
            // даты и числа — сначала новые и большие, остальное — по алфавиту
            _view.ReportSortDesc = key == "date" || key == "imported" || key == "count";
        }
    }

    private List<ReportRow> SortedReports(IEnumerable<ReportRow> reports)
    {
        Func<ReportRow, IComparable> key = _view.ReportSortKey switch
        {
            "block" => r => ReportPath.BlockOrder(r.Block),
            "file" => r => ReportFolder(r) + "\\" + System.IO.Path.GetFileName(r.FilePath),
            "count" => r => r.Results,
            "imported" => r => r.Imported,
            _ => r => r.ReportDate,
        };
        return (_view.ReportSortDesc ? reports.OrderByDescending(key) : reports.OrderBy(key)).ThenByDescending(r => r.ReportDate).ToList();
    }

    /// <summary>Группы отчётов по выбранному параметру; внутри — по выбранной сортировке.</summary>
    private List<ReportGroup> ReportGroups()
    {
        var reports = ScopeReports.ToList();
        switch (_view.ReportGroup)
        {
            case "block":
                return reports.GroupBy(r => r.Block).OrderBy(g => ReportPath.BlockOrder(g.Key))
                    .Select(g => new ReportGroup { Key = "b:" + g.Key, Title = ReportPath.BlockTitle(g.Key), Reports = SortedReports(g) }).ToList();
            case "date":
                return reports.GroupBy(r => r.ReportDate.Date).OrderByDescending(g => g.Key)
                    .Select(g => new ReportGroup { Key = "d:" + g.Key.ToString("yyyyMMdd"), Title = "Отчёты от " + Fmt.Day(g.Key), Reports = SortedReports(g) }).ToList();
            case "file":
                return reports.GroupBy(r => r.FilePath, StringComparer.OrdinalIgnoreCase)
                    .OrderBy(g => ReportFolder(g.First()) + "\\" + System.IO.Path.GetFileName(g.Key), StringComparer.CurrentCultureIgnoreCase)
                    .Select(g => new ReportGroup
                    {
                        Key = "f:" + g.Key, Title = System.IO.Path.GetFileName(g.Key) + (ReportFolder(g.First()) == "" ? "" : " — " + ReportFolder(g.First())),
                        Reports = SortedReports(g),
                    }).ToList();
            case "imported":
                return reports.GroupBy(r => r.Imported.Date).OrderByDescending(g => g.Key)
                    .Select(g => new ReportGroup { Key = "i:" + g.Key.ToString("yyyyMMdd"), Title = "Загружены " + Fmt.Day(g.Key), Reports = SortedReports(g) }).ToList();
            default:
                return new List<ReportGroup> { new ReportGroup { Key = null, Reports = SortedReports(reports) } };
        }
    }

    private void OnReportGroupChanged(ChangeEventArgs e)
    {
        _view.ReportGroup = e.Value?.ToString() ?? "";
        _view.ReportCollapsed.Clear();
    }

    private void ToggleReportGroup(string key)
    {
        if (!_view.ReportCollapsed.Remove(key)) _view.ReportCollapsed.Add(key);
    }

    /// <summary>Папка отчёта — от папки проекта («08.10.2026\Высокая критичность\XML\S6»): полный путь — в подсказке.</summary>
    private string ReportFolder(ReportRow r)
    {
        var dir = System.IO.Path.GetDirectoryName(r.FilePath) ?? "";
        var root = (_project?.Folder ?? "").TrimEnd('\\', '/');
        return root.Length > 0 && dir.StartsWith(root, StringComparison.OrdinalIgnoreCase) ? dir.Substring(root.Length).TrimStart('\\', '/') : dir;
    }

    private void ShowTest(TestRow t)
    {
        _view.Tab = 0;
        var flat = BlocksOf(t.Criticality).Count == 1 && t.Block == "";
        SetScope(t.Criticality, flat ? null : t.Block, t.Type);
    }

    private static string CriticalityTitle(string c) => string.IsNullOrEmpty(c) ? "Все проверки" : ReportPath.CriticalityTitle(c);

    private static string CriticalityClass(string c) => c == "Высокая" ? "crit-high" : c == "Средняя" ? "crit-mid" : "";

    // ───── поиск, сброс ─────

    private async Task OnSearch(ChangeEventArgs e)
    {
        _filter.Search = e.Value?.ToString();
        // не пересчитывать на каждую букву: ждём паузу в наборе
        _searchDelay?.Cancel();
        var delay = _searchDelay = new CancellationTokenSource();
        try { await Task.Delay(250, delay.Token); }
        catch (TaskCanceledException) { return; }
        Recompute();
    }

    /// <summary>Сбросить отборы: поиск, раздел, уровень, «что принёс прогон»; статус — к открытым (активные и ждущие проверки).</summary>
    private void ResetFilter()
    {
        _filter.Search = null;
        foreach (var set in _filter.Facets.Values) set.Clear();
        FacetSet(ClashFacets.State).UnionWith(new[] { ((int)ClashState.Active).ToString(), ((int)ClashState.Pending).ToString() });
        _view.RunFilter = null;
        _page = 0;
        Recompute();
    }

    // ───── сортировка ─────

    /// <summary>Заголовок столбца с сортировкой: щелчок — по нему, повторный — обратный порядок; ⇅ — можно сортировать.</summary>
    private RenderFragment SortHeader(string key, string title, string tip = null) => __builder =>
    {
        var on = _view.SortKey == key;
        <th class="sortable @(on ? "sorted" : "")" @onclick="() => SortBy(key)" title="@(tip ?? "Сортировать")">
            @title <span class="sort-mark">@(on ? (_view.SortDesc ? "▼" : "▲") : "⇅")</span>
        </th>
    };

    private void SortBy(string key)
    {
        if (_view.SortKey == key) _view.SortDesc = !_view.SortDesc;
        else
        {
            _view.SortKey = key;
            // даты, расстояние и повторы — сначала новые и большие
            _view.SortDesc = key == "date" || key == "dist" || key == "repeats";
        }
        Recompute();
    }

    /// <summary>Без выбранной сортировки — как пришло из базы: по блоку, проверке и номеру коллизии.</summary>
    private List<ClashRow> Sort(List<ClashRow> list)
    {
        Func<ClashRow, IComparable> key = _view.SortKey switch
        {
            "date" => c => c.LastSeen,
            "test" => c => c.Type,
            "disc" => c => ClashFacets.DisciplinePair(c) ?? "",
            "name" => c => NameNumber(c.Name),
            "dist" => c => c.Distance.HasValue ? Math.Abs(c.Distance.Value) : -1,
            "grid" => c => c.GridLocation ?? "",
            "level" => c => LevelOrder(c),
            "state" => c => StateOrder(c.State),
            "repeats" => c => c.Repeats,
            _ => null,
        };
        if (key == null) return list.ToList();
        var sorted = _view.SortDesc ? list.OrderByDescending(key) : list.OrderBy(key);
        return sorted.ThenBy(c => NameNumber(c.Name)).ToList();
    }

    private static int StateOrder(ClashState s) => s switch
    {
        ClashState.Active => 0,
        ClashState.Pending => 1,
        ClashState.Fixed => 2,
        _ => 3,
    };

    private static long NameNumber(string name)
    {
        var digits = new string((name ?? "").Where(char.IsDigit).ToArray());
        return long.TryParse(digits, out var n) ? n : long.MaxValue;
    }

    /// <summary>Уровень по номеру («-1 подвал» раньше «1 этаж», «100 кровля» последней).</summary>
    private static double LevelOrder(ClashRow c)
    {
        var key = c.A?.LevelKey ?? c.B?.LevelKey ?? "";
        var end = 0;
        while (end < key.Length && (char.IsDigit(key[end]) || (end == 0 && key[end] == '-'))) end++;
        return double.TryParse(key.Substring(0, end), out var v) ? v : double.MaxValue;
    }

    // ───── выбор и карточка ─────

    private void Select(long id)
    {
        _view.SelectedId = id;
        _notice = null;
    }

    private async Task Move(int step)
    {
        var i = SelectedIndex;
        var next = i < 0 ? 0 : i + step;
        if (next < 0 || next >= _visible.Count) return;
        _view.SelectedId = _visible[next].Id;
        _page = PageOf(_view.SelectedId.Value);
        StateHasChanged();
        await JS.InvokeVoidAsync("ras.reveal", "row-" + _view.SelectedId);
    }

    private async Task ListKey(KeyboardEventArgs e)
    {
        if (e.Key == "ArrowDown") await Move(1);
        else if (e.Key == "ArrowUp") await Move(-1);
        else if (e.Key == "Escape") _view.SelectedId = null;
    }

    /// <summary>В карточке сменили статус или добавили комментарий: обновить список; по желанию — к следующей.</summary>
    private async Task OnPanelChanged(ClashState? state)
    {
        var index = SelectedIndex;
        LoadAll();
        if (state == null || !_view.AutoNext) return;
        // коллизия могла пропасть из списка (отбор по статусу) — тогда «следующая» стоит на её месте
        var now = SelectedIndex;
        var next = now >= 0 ? now + 1 : index;
        if (next < 0 || next >= _visible.Count) return;
        _view.SelectedId = _visible[next].Id;
        _page = PageOf(_view.SelectedId.Value);
        StateHasChanged();
        await JS.InvokeVoidAsync("ras.reveal", "row-" + _view.SelectedId);
    }

    // ───── отметки и статус многим ─────

    private void Toggle(long id, ChangeEventArgs e)
    {
        if (e.Value is bool on && on) _selected.Add(id);
        else _selected.Remove(id);
        _notice = null;
    }

    private void ToggleAll(ChangeEventArgs e)
    {
        if (e.Value is bool on && on) _selected.UnionWith(_clashes.Select(c => c.Id));
        else _selected.Clear();
        _notice = null;
    }

    /// <summary>Немного коллизий — сразу; много — с вопросом: одно нажатие не должно переписать весь проект.</summary>
    private void AskBulk(ClashState state)
    {
        if (_selected.Count > 10) _pendingState = state;
        else ApplyBulk(state);
    }

    private void ConfirmBulk()
    {
        if (_pendingState.HasValue) ApplyBulk(_pendingState.Value);
        _pendingState = null;
    }

    private void ApplyBulk(ClashState state)
    {
        var total = _selected.Count;
        var changed = Store.SetState(_selected, state, _bulkComment, null);
        _notice = $"«{Fmt.State(state)}»: изменено {changed} из {total}.";
        _selected.Clear();
        _bulkComment = null;
        LoadAll();
    }

    // ───── прочее ─────

    private async Task Scan()
    {
        await Importer.ScanAsync(Id);
        LoadAll();
    }

    private void SaveProject()
    {
        _editError = true;
        if (string.IsNullOrWhiteSpace(_editName)) { _editMessage = "Укажите название."; return; }
        var folder = (_editFolder ?? "").Trim().Trim('"');
        if (!Directory.Exists(folder)) { _editMessage = "Папка не найдена или недоступна: " + folder; return; }
        Store.UpdateProject(Id, _editName, folder);
        _editError = false;
        _editMessage = "Сохранено.";
        LoadAll();
    }

    private static string DateSourceTitle(string source) => source switch
    {
        ReportPath.DateFromXml => "Дата — из отчёта (дата обнаружения коллизий)",
        ReportPath.DateFromFolder => "Дата — из названия папки прогона",
        _ => "Дата — время файла отчёта",
    };

    /// <summary>Уровень коллизии: у обоих элементов один — он; разные — «А / Б».</summary>
    private static string Level(ClashRow x)
    {
        var a = x.A?.Level;
        var b = x.B?.Level;
        if (string.IsNullOrEmpty(a)) return b ?? "—";
        if (string.IsNullOrEmpty(b) || x.A.LevelKey == x.B.LevelKey) return a;
        return a + " / " + b;
    }

    public void Dispose() => _searchDelay?.Cancel();
}
