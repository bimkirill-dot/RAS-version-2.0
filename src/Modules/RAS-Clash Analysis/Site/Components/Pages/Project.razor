    private async Task Scan()
    {
        await Importer.ScanAsync(Id);
        LoadAll();
    }

    private void SaveProject()
    {
        _editError = true;
        if (string.IsNullOrWhiteSpace(_editName)) { _editMessage = "Укажите название."; return; }
        var folder = ProjectFolders.Clean(_editFolder);
        if (!Directory.Exists(folder)) { _editMessage = "Папка не найдена или недоступна: " + folder; return; }
        var conflict = ProjectFolders.Conflict(folder, Store.Projects().Where(p => p.Id != Id).Select(p => (p.Name, p.Folder)));
        if (conflict != null) { _editMessage = conflict; return; }
        Store.UpdateProject(Id, _editName, folder);
        _editError = false;
        _editMessage = "Сохранено.";
        LoadAll();
    }

    // ───── удаление проекта ─────

    /// <summary>Что удалится — показывается в вопросе; null — вопроса нет.</summary>
    private ProjectContents _deleteAsk;
    private string _deleteName, _deleteError;
    private bool _deleting;

    private bool DeleteNameMatches =>
        string.Equals((_deleteName ?? "").Trim(), _project?.Name.Trim(), StringComparison.CurrentCultureIgnoreCase);

    private void AskDelete()
    {
        _deleteAsk = Store.ProjectContents(Id);
        _deleteName = _deleteError = null;
    }

    private void CancelDelete() => _deleteAsk = null;

    /// <summary>«комментарии (2), статусы, поставленные вручную (5)» — только то, что есть.</summary>
    private string PeopleWork => string.Join(", ", new[]
    {
        _deleteAsk.Comments > 0 ? $"комментарии ({_deleteAsk.Comments})" : null,
        _deleteAsk.ManualStates > 0 ? $"статусы, поставленные вручную ({_deleteAsk.ManualStates})" : null,
    }.Where(x => x != null));

    private async Task DeleteProject()
    {
        if (!DeleteNameMatches) return;
        _deleting = true;
        _deleteError = null;
        try
        {
            var name = _project.Name;
            await Removal.DeleteAsync(Id);
            Nav.NavigateTo("/?deleted=" + Uri.EscapeDataString(name));
        }
        catch (Exception ex)
        {
            _deleteError = "Не удалено: " + ex.Message;
        }
        finally
        {
            _deleting = false;
        }
    }

    private static string DateSourceTitle(string source) => source switch
    {
        ReportPath.DateFromXml => "Дата — из отчёта (дата обнаружения коллизий)",
        ReportPath.DateFromFolder => "Дата — из названия папки прогона",
        _ => "Дата — время файла отчёта",
    };

    /// <summary>Уровень коллизии: у обоих элементов один — он; разные — «А / Б».</summary>
    private static string Level(ClashRow x)
    {
        var a = x.A?.Level;
        var b = x.B?.Level;
        if (string.IsNullOrEmpty(a)) return b ?? "—";
        if (string.IsNullOrEmpty(b) || x.A.LevelKey == x.B.LevelKey) return a;
        return a + " / " + b;
    }

