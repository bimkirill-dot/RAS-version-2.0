    /// <summary>
    /// Из сводки — к коллизиям: ставятся отборы (блок, категория, тип проверки, этаж), статус — «Активная»; коллизия —
    /// отдельной страницей; «качество данных» — к отчётам.
    /// </summary>
    private void DrillFromSummary(SummaryDrill d)
    {
        if (d.ToReports) { Go(2); return; }
        if (d.ClashId.HasValue) { Nav.NavigateTo("clash/" + d.ClashId.Value); return; }
        Freeze();
        if (d.SetCategory) { _filter.Category = d.Category; _filter.Subcategory = d.Category == null ? null : d.Subcategory; }
        var block = d.SetBlock ? d.Block : _filter.Block;
        var type = d.TestType ?? (d.SetCategory ? null : _filter.TestType);
        if (d.TestType != null) { _filter.Category = null; _filter.Subcategory = null; }
        var levels = FacetSet(ClashFacets.Level);
        levels.Clear();
        if (d.LevelKey != null) levels.Add(d.LevelKey);
        var states = FacetSet(ClashFacets.State);
        states.Clear();
        _view.RunFilter = null;
        _filter.Search = d.Search;
        if (d.RunKind != null)
        {
            // из «моста прогона»: прогон этого дня и что он принёс (статус не отбирается — иначе исправленных не видно)
            _view.RunDate = d.RunDay;
            _view.RunFilter = d.RunKind;
        }
        else states.Add(((int)ClashState.Active).ToString());
        SetScope(_filter.Criticality, block, type);
        Go(0);
    }

