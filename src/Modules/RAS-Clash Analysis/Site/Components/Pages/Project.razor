@page "/project/{Id:long}"
@inject ClashStore Store
@inject ReportImporter Importer

<PageTitle>@(_project?.Name ?? "Проект") · RAS Clash Analysis</PageTitle>

@if (_project == null)
{
    <h1>Проект не найден</h1>
    <p><a href="/">К проектам</a></p>
    return;
}

@* Обзор проекта: где сколько коллизий. Щелчок по числу — список этих коллизий (DECISIONS.md, «Обзор → список»). *@
<nav class="crumbs"><a href="/">Проекты</a> ›</nav>
<div class="page-title">
    <h1>@_project.Name</h1>
    <span class="muted">@(_lastRun.HasValue ? "последний прогон — " + Fmt.Day(_lastRun.Value) : "отчётов ещё нет")</span>
    <span class="spacer"></span>
    <a href="project/@Id/reports">Папка и отчёты</a>
</div>

@if (_tests.Count == 0)
{
    <div class="empty-box">
        <p>В папке проекта пока не найдено отчётов Navisworks (XML).</p>
        <p class="path">@_project.Folder</p>
        <button class="btn primary" disabled="@Importer.Busy" @onclick="Scan">@(Importer.Busy ? "Ищем отчёты…" : "Найти отчёты сейчас")</button>
        <ImportResults Results="Importer.LastResults" />
    </div>
}
else
{
    <p class="lead">Активные коллизии. Щёлкните число — откроется список этих коллизий.</p>
    <table class="matrix">
        <thead>
            <tr>
                <th></th>
                @foreach (var cr in _criticalities)
                {
                    <th class="@CriticalityClass(cr)">@ColumnTitle(cr)</th>
                }
                @if (_criticalities.Count > 1) { <th>Всего</th> }
            </tr>
        </thead>
        <tbody>
            @foreach (var b in _blocks)
            {
                <tr>
                    <th class="row-title">@RowTitle(b)</th>
                    @foreach (var cr in _criticalities) { @Cell(cr, b) }
                    @if (_criticalities.Count > 1) { @Cell(null, b, total: true) }
                </tr>
            }
            @if (_blocks.Count > 1)
            {
                <tr class="total">
                    <th class="row-title">Все блоки</th>
                    @foreach (var cr in _criticalities) { @Cell(cr, null, total: true) }
                    @if (_criticalities.Count > 1) { @Cell(null, null, total: true) }
                </tr>
            }
        </tbody>
    </table>
    <p class="muted small">Под числом — сколько уже исправлено и допущено. Новые отчёты из папки проекта сайт загружает сам.</p>
}

@code {
    [Parameter] public long Id { get; set; }

    private ProjectRow _project;
    private List<TestRow> _tests = new();
    private List<string> _criticalities = new();
    private List<string> _blocks = new();
    private DateTime? _lastRun;

    protected override void OnParametersSet() => Load();

    private void Load()
    {
        _project = Store.Project(Id);
        if (_project == null) return;
        _tests = Store.Tests(Id);
        _criticalities = _tests.Select(t => t.Criticality).Distinct().OrderBy(ReportPath.CriticalityOrder).ToList();
        _blocks = _tests.Select(t => t.Block).Distinct().OrderBy(ReportPath.BlockOrder).ThenBy(b => b, StringComparer.CurrentCultureIgnoreCase).ToList();
        _lastRun = _tests.Where(t => t.LastReport.HasValue).Select(t => t.LastReport).DefaultIfEmpty(null).Max();
    }

    /// <summary>Клетка: активные (ссылка на список), под ними — исправлено / допущено; нет проверок — прочерк.</summary>
    private RenderFragment Cell(string criticality, string block, bool total = false) => __builder =>
    {
        var tests = _tests.Where(t => (criticality == null || t.Criticality == criticality) && (block == null || t.Block == block)).ToList();
        if (tests.Count == 0)
        {
            <td class="cell none">—</td>
            return;
        }
        var active = tests.Sum(t => t.Counts.Active);
        var fixedCount = tests.Sum(t => t.Counts.Fixed);
        var accepted = tests.Sum(t => t.Counts.Accepted);
        <td class="cell @(total ? "total" : "") @(active == 0 ? "clean" : "")">
            <a href="@ScopeQuery.ListLink(Id, criticality, block)" title="Открыть список: @ColumnTitle(criticality ?? "все") · @RowTitle(block ?? "все")">
                <span class="n">@(active == 0 ? "✓ 0" : active.ToString())</span>
                @if (fixedCount + accepted > 0)
                {
                    <span class="sub">исправлено @fixedCount@(accepted > 0 ? $" · допущено {accepted}" : "")</span>
                }
            </a>
        </td>
    };

    private string ColumnTitle(string c) => c == "все" ? "все критичности" : _criticalities.Count == 1 && c == "" ? "Активные" : ReportPath.CriticalityTitle(c);

    private string RowTitle(string b) => b == "все" ? "все блоки" : _blocks.Count == 1 && b == "" ? "Все коллизии" : ReportPath.BlockTitle(b);

    private static string CriticalityClass(string c) => c == "Высокая" ? "crit-high" : c == "Средняя" ? "crit-mid" : "";

    private async Task Scan()
    {
        await Importer.ScanAsync(Id);
        Load();
    }
}
