@page "/project/{Id:long}"
@implements IDisposable
@inject ClashStore Store
@inject ReportImporter Importer
@inject ProjectViewState ViewState
@inject IJSRuntime JS
@inject ProjectRemoval Removal
@inject NavigationManager Nav
@inject SiteOptions Options

<PageTitle>@(_project?.Name ?? "Проект") · Clash Analysis</PageTitle>

@if (_project == null)
{
    <h1>Проект не найден</h1>
    <p><a href="/">К проектам</a></p>
    return;
}

<div class="project-page">
    <div class="project-head">
        <div class="ph-title">
            <nav class="crumbs"><a href="/">Проекты</a> <span class="sep">/</span></nav>
            <h1>@_project.Name</h1>
            @* под названием — со значками: последний прогон, отчёты, папка проекта (полный путь — в подсказке) *@
            <div class="ph-meta">
                <span><svg viewBox="0 0 16 16" aria-hidden="true"><rect x="2" y="3" width="12" height="11" rx="2" /><path d="M2 6.5h12M5.5 1.5v3M10.5 1.5v3" /></svg>@(_lastRun.HasValue ? "Последний прогон — " + Fmt.Day(_lastRun.Value) : "Отчётов ещё нет")</span>
                <span><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 1.5h5.5L13 5v9.5H4z" /><path d="M6.5 8.5h4M6.5 11h4" /></svg>@Fmt.Plural(ScopeReports.Count(), "отчёт", "отчёта", "отчётов")</span>
                <span title="@_project.Folder"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M1.5 4.5a1 1 0 0 1 1-1h3.5l1.5 1.5h6a1 1 0 0 1 1 1v6.5a1 1 0 0 1-1 1h-11a1 1 0 0 1-1-1z" /></svg>@ShortFolder</span>
            </div>
        </div>
        @if (_tests.Count > 0)
        {
            @* итоги всего проекта — крупными цифрами (для показа руководству); от отборов не зависят *@
            var k = Kpi;
            <div class="kpis" title="Весь проект: все блоки и проверки" data-caption="по всему проекту">
                <div class="kpi k-active"><div class="v">@k.Active</div><div class="l">Активные</div></div>
                <div class="kpi k-fixed"><div class="v">@k.Fixed</div><div class="l">Исправлены</div></div>
                <div class="kpi k-accepted"><div class="v">@k.Accepted</div><div class="l">Допущены</div></div>
                <div class="kpi k-progress" title="Исправлено по всему проекту — из всех коллизий, кроме допущенных">
                    <div class="v">@FixedPercent(k) %</div><div class="l">исправлено</div>
                    <div class="kpi-bar"><i style="width:@FixedPercent(k)%"></i></div>
                </div>
            </div>
        }
    </div>

    @if (_criticalities.Count == 0)
    {
        <p class="muted">Отчётов ещё нет — «Отчёты» на боковой панели, «Проверить папку сейчас».</p>
    }

    @* строка отборов: дата, уровень, статус, поиск (блок и тип проверки — на боковой панели; критичность и раздел убраны 14.10.2026 —
       продукт для любой компании: не зависит от того, как компания называет папки и модели).
       Видна во всех разделах, и в «Проекте»: пропадала — страница будто уезжала вверх *@
    @if (_criticalities.Count > 0)
    {
        <div class="ribbon sub-ribbon">
            @* на «Отчётах» и «Проекте» отборы списка не действуют — приглушены (строка остаётся, чтобы страница не прыгала) *@
            <div class="ribbon-list @(_view.Tab == 0 ? "" : "off")">
            <label class="dd" title="За какой прогон: последний (что сейчас), любой прошлый или все">
                <span>Дата</span>
                <select value="@_view.RunDate" @onchange="OnRunDateChanged">
                    <option value="last">Последняя@(_lastRun.HasValue ? " — " + Fmt.Day(_lastRun.Value) : "")</option>
                    @foreach (var d in RunDates)
                    {
                        <option value="@d.ToString("yyyy-MM-dd")">@Fmt.Day(d)</option>
                    }
                    <option value="all">Все даты</option>
                </select>
            </label>
            <FacetMenu Title="Уровень" Values="_facetValues[ClashFacets.Level]" Selected="FacetSet(ClashFacets.Level)" Changed="Recompute" />
            <FacetMenu Title="Статус" Values="_facetValues[ClashFacets.State]" Selected="FacetSet(ClashFacets.State)" Changed="Recompute" />
            @if (FilterIsSet)
            {
                <button class="btn link small" @onclick="ResetFilter">Сбросить</button>
            }
            </div>
            @if (_view.Tab != 0)
            {
                <span class="off-note" title="Остальные отборы — для списка коллизий">Отборы — для списка коллизий</span>
            }
            @* поиск — справа (просьба разработчика 13.10.2026) *@
            <input class="search @(_view.Tab == 0 ? "" : "off")" type="search" placeholder="Поиск: номер элемента, тип, комментарий…" value="@_filter.Search" @oninput="OnSearch" />
        </div>
    }

    @* блоки вручную (DECISIONS.md, «Блоки — вручную»): без блоков отчёты не загружаются; папки вне блоков — тоже *@
    @if (_project.ManualBlocks && _blocks.Count == 0)
    {
        <div class="blocks-warn">⚠ В проекте нет блоков — отчёты не загружаются. Добавьте блоки в разделе «Проект», даже если блок один.
            @if (_view.Tab != 3) { <button class="btn small" @onclick="() => Go(3)">Добавить блоки</button> }
        </div>
    }
    else if (_project.ManualBlocks && _outside.Count > 0)
    {
        <div class="blocks-warn">⚠ В папке проекта есть @(_outside.Count == 1 ? "папка" : "папки") вне блоков — отчёты из них не загружены:
            <b>@string.Join(", ", _outside.Select(f => f == "" ? "(сама папка проекта)" : f))</b>. Добавьте блоки в разделе «Проект».
            @if (_view.Tab != 3) { <button class="btn small" @onclick="() => Go(3)">Добавить блоки</button> }
        </div>
    }

    <div class="body @(_view.Tab == 0 && SelectedVisible ? "with-panel" : "")">
            @* боковая панель — разделы этого проекта *@
            <aside class="side" aria-label="Разделы проекта">
                <div class="side-title">Проект</div>
                @* «Блок» — первым, как остальные разделы; нажать — блоки раскрываются подразделами (просьба разработчика 13.10.2026) *@
                @if (ShowBlocks)
                {
                    <button class="side-btn side-group @(_view.BlocksOpen ? "open" : "")" @onclick="() => _view.BlocksOpen = !_view.BlocksOpen"
                            title="Блок — показать коллизии одного блока" aria-expanded="@(_view.BlocksOpen ? "true" : "false")">
                        <svg viewBox="0 0 20 20" aria-hidden="true"><rect x="6.5" y="2.5" width="7" height="6" rx="1.3" stroke="currentColor" stroke-width="1.5" fill="none"/><rect x="2.5" y="11.5" width="7" height="6" rx="1.3" stroke="currentColor" stroke-width="1.5" fill="none"/><rect x="10.5" y="11.5" width="7" height="6" rx="1.3" stroke="currentColor" stroke-width="1.5" fill="none"/></svg><span>
                            Блок
                            @* выбранное — всегда второй строкой (и «все»): высота кнопки не меняется, панель не прыгает *@
                            <small class="side-chosen @(_filter.Block == null ? "all" : "")">@(_filter.Block == null ? "все" : ReportPath.BlockTitle(_filter.Block))</small>
                        </span><i class="chev" aria-hidden="true"></i>
                    </button>
                    @if (_view.BlocksOpen)
                    {
                        <div class="side-subs">
                            <button class="side-sub @(_filter.Block == null ? "on" : "")" @onclick="() => PickBlock(null)">
                                <span>Все</span><b>@ActiveIn(_filter.Criticality, null, null)</b>
                            </button>
                            @foreach (var b in BlocksOf(_filter.Criticality))
                            {
                                var block = b;
                                <button class="side-sub @(_filter.Block == block ? "on" : "")" @onclick="() => PickBlock(block)">
                                    <span>@ReportPath.BlockTitle(block)</span><b>@ActiveIn(_filter.Criticality, block, null)</b>
                                </button>
                            }
                        </div>
                    }
                }
                @* «Тип проверки» — как «Блок»: нажать — типы подразделами (просьба разработчика 13.10.2026; был списком на ленте) *@
                <button class="side-btn side-group @(_view.TypesOpen ? "open" : "")" @onclick="() => _view.TypesOpen = !_view.TypesOpen"
                        title="Тип проверки — показать коллизии одной проверки" aria-expanded="@(_view.TypesOpen ? "true" : "false")">
                    <svg viewBox="0 0 20 20" aria-hidden="true"><rect x="3" y="3" width="6" height="6" rx="1.5" stroke="currentColor" stroke-width="1.5" fill="none"/><rect x="11" y="11" width="6" height="6" rx="1.5" stroke="currentColor" stroke-width="1.5" fill="none"/><path d="M9 6h5v5" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round"/></svg><span>
                        Тип проверки
                        @* две строки всегда (длинное — многоточием, полностью — в подсказке): высота не меняется *@
                        <small class="side-chosen two @(TypeChosen == null ? "all" : "")" title="@TypeChosen">@(TypeChosen ?? "все")</small>
                    </span><i class="chev" aria-hidden="true"></i>
                </button>
                @if (_view.TypesOpen)
                {
                    <div class="side-subs">
                        <button class="side-sub @(_filter.TestType == null && _filter.Category == null ? "on" : "")" @onclick="() => PickCategory(null)">
                            <span>Все</span><b>@ActiveInCategory(null)</b>
                        </button>
                        @* категории проверок (DECISIONS.md, «Категории проверок») — заголовками; внутри — подкатегории, под ними проверки
                           (просьба разработчика 15.10.2026); стрелка — свернуть, название — выбрать всё внутри *@
                        @foreach (var node in TypeTree)
                        {
                            var cat = node.Category;
                            var open = cat == null || _view.CategoriesExpanded.Contains(cat);
                            @if (cat != null)
                            {
                                <div class="side-cat-row">
                                    <button class="side-fold @(open ? "open" : "")" title="@(open ? "Свернуть" : "Развернуть")" aria-expanded="@(open ? "true" : "false")"
                                            @onclick="() => ToggleExpanded(cat)"><i class="chev" aria-hidden="true"></i></button>
                                    <button class="side-sub side-cat @(_filter.Category == cat && _filter.Subcategory == null && _filter.TestType == null ? "on" : "") @(ActiveInCategory(cat) == 0 ? "empty" : "")" @onclick="() => PickCategory(cat)"
                                            title="Все проверки категории «@(cat == "" ? "без категории" : cat)»">
                                        <span>@CatDot(GroupColor(cat))@(cat == "" ? "Без категории" : cat)</span><b>@ActiveInCategory(cat)</b>
                                    </button>
                                </div>
                            }
                            @if (open)
                            {
                                @foreach (var (subName, subTypes) in node.Subs)
                                {
                                    var sub = subName;
                                    var subKey = cat + "\u001f" + sub;
                                    var subOpen = _view.CategoriesExpanded.Contains(subKey);
                                    <div class="side-cat-row lvl1">
                                        <button class="side-fold @(subOpen ? "open" : "") @(subTypes.Count == 0 ? "none" : "")" title="@(subOpen ? "Свернуть" : "Развернуть")" aria-expanded="@(subOpen ? "true" : "false")"
                                                disabled="@(subTypes.Count == 0)" @onclick="() => ToggleExpanded(subKey)"><i class="chev" aria-hidden="true"></i></button>
                                        <button class="side-sub side-subcat @(_filter.Category == cat && _filter.Subcategory == sub && _filter.TestType == null ? "on" : "") @(ActiveInCategory(cat, sub) == 0 ? "empty" : "")"
                                                @onclick="() => PickSubcategory(cat, sub)" title="Все проверки подкатегории «@sub»">
                                            <span>@CatDot(GroupColor(subKey))@sub</span><b>@ActiveInCategory(cat, sub)</b>
                                        </button>
                                    </div>
                                    @foreach (var (name, active) in subOpen ? subTypes : new List<(string, int)>())
                                    {
                                        var type = name;
                                        <button class="side-sub nested2 @(_filter.TestType == type ? "on" : "")" @onclick="() => PickTestType(type)" title="@type">
                                            <span>@type</span><b>@active</b>
                                        </button>
                                    }
                                }
                                @foreach (var (name, active) in node.Types)
                                {
                                    var type = name;
                                    <button class="side-sub @(cat != null ? "nested" : "") @(_filter.TestType == type ? "on" : "")" @onclick="() => PickTestType(type)" title="@type">
                                        <span>@type</span><b>@active</b>
                                    </button>
                                }
                            }
                        }
                    </div>
                }
                <button class="side-btn @(_view.Tab == 0 ? "on" : "")" @onclick="() => Go(0)" title="Коллизии — список и карточка">
                    <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 5h14M3 10h14M3 15h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" fill="none"/></svg><span>Коллизии</span><b>@ActiveIn(_filter.Criticality, _filter.Block, _filter.TestType)</b>
                </button>
                <button class="side-btn @(_view.Tab == 2 ? "on" : "")" @onclick="() => Go(2)" title="Загруженные отчёты Navisworks этого проекта">
                    <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 2.5h7l3.5 3.5v11.5h-10.5z" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linejoin="round"/><path d="M8 10h5M8 13.5h5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg><span>Отчёты</span><b>@ScopeReports.Count()</b>
                </button>
                @* «Сводка» — как «Блок»: стрелка, страницы подразделами, выбранная — второй строкой (разработчик, 19.10.2026) *@
                <button class="side-btn side-group @(_view.Tab == 5 ? "on" : "") @(_view.SummaryOpen ? "open" : "")" @onclick="ToggleSummary"
                        title="Сводка — последние изменения, обзор, сравнение отчётов" aria-expanded="@(_view.SummaryOpen ? "true" : "false")">
                    <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3.5 16.5V9.5M8 16.5V4.5M12.5 16.5v-5M17 16.5V7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" fill="none"/></svg><span>
                        Сводка
                        <small class="side-chosen">@SummaryPageTitle(_view.SummaryPage)</small>
                    </span><i class="chev" aria-hidden="true"></i>
                </button>
                @if (_view.SummaryOpen)
                {
                    <div class="side-subs">
                        @foreach (var key in SummaryPages)
                        {
                            var page = key;
                            <button class="side-sub @(_view.Tab == 5 && _view.SummaryPage == page ? "on" : "")" @onclick="() => PickSummaryPage(page)">
                                <span>@SummaryPageTitle(page)</span>
                            </button>
                        }
                    </div>
                }
                <button class="side-btn @(_view.Tab == 4 ? "on" : "")" @onclick="() => Go(4)" title="Что и когда сделано в этом проекте">
                    <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="7" stroke="currentColor" stroke-width="1.5" fill="none"/><path d="M10 6v4l2.8 1.8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" fill="none"/></svg><span>История</span>
                </button>
                <button class="side-btn @(_view.Tab == 3 ? "on" : "")" @onclick="() => Go(3)" title="Название и папка проекта">
                    <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="2.6" stroke="currentColor" stroke-width="1.5" fill="none"/><path d="M10 2.5v2.2M10 15.3v2.2M2.5 10h2.2M15.3 10h2.2M4.7 4.7l1.6 1.6M13.7 13.7l1.6 1.6M4.7 15.3l1.6-1.6M13.7 6.3l1.6-1.6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg><span>Проект</span>
                </button>
            </aside>

            @if (_view.Tab == 0)
            {
                <section class="content">
                    <div class="list-title">
                        <h2>Коллизии <span class="muted">(@_clashes.Count)</span></h2>
                        @if (_view.RunDate != "all" && _lastRun.HasValue)
                        {
                            @* что принёс прогон (последний или выбранный в «Дате») — щелчок показывает именно их *@
                            <div class="run-strip">
                                @RunChip("new", "новых", "+")
                                @RunChip("fixed", "исправлено", "")
                                @RunChip("returned", "вернулось", "↺ ")
                                @RunChip("tests", "в новых проверках", "+")
                                @if (_view.RunFilter != null)
                                {
                                    <button class="btn link small" @onclick="() => SetRunFilter(null)">✕</button>
                                }
                            </div>
                        }
                        <span class="spacer"></span>
                        <label class="dd">
                            <span>Группировка</span>
                            <select value="@_view.GroupBy" @onchange="OnGroupChanged">
                                <option value="">Без группировки</option>
                                <option value="test">По типу проверки</option>
                                <option value="element">По элементу</option>
                            </select>
                        </label>
                        <button class="btn" title="Скачать список (как сейчас отобран) — откроется в Excel" @onclick="ExportCsv">⤓ Excel</button>
                    </div>
                    @MissingBox()

                    @if (_selected.Count > 0)
                    {
                        <div class="toolbar bulk">
                            @if (_pendingState.HasValue)
                            {
                                <span class="confirm">
                                    Сделать «@StateButtonTitle(_pendingState.Value)» у @Fmt.Clashes(_selected.Count)?
                                    <button class="btn primary" @onclick="ConfirmBulk">Да</button>
                                    <button class="btn" @onclick="() => _pendingState = null">Отмена</button>
                                </span>
                            }
                            else
                            {
                                <span>Отмечено: <b>@_selected.Count</b></span>
                                <input class="comment" placeholder="Комментарий ко всем (необязательно)" @bind="_bulkComment" />
                                <button class="btn state-fixed" title="Если следующий прогон их найдёт — снова «Активная»" @onclick="() => AskBulk(ClashState.Fixed)">Исправлена</button>
                                <button class="btn state-accepted" @onclick="() => AskBulk(ClashState.Accepted)">Допущена</button>
                                <button class="btn state-active" @onclick="() => AskBulk(ClashState.Active)">Активная</button>
                                <button class="btn link" @onclick="() => _selected.Clear()">Снять отметки</button>
                            }
                        </div>
                    }
                    else if (_notice != null)
                    {
                        <div class="toolbar"><span class="notice">@_notice</span></div>
                    }

                    <div class="list" tabindex="0" @onkeydown="ListKey">
                        @if (_clashes.Count == 0)
                        {
                            <div class="empty">
                                Ничего не найдено.
                                @if (FilterIsSet) { <button class="btn link" @onclick="ResetFilter">Сбросить отборы</button> }
                                @if (_view.RunDate != "all") { <button class="btn link" @onclick='() => SetRunDate("all")'>Все даты</button> }
                            </div>
                        }
                        else
                        {
                            @* столбцы «Расстояние» и «Оси» — только если они есть в отчётах; карточка выезжает поверх списка справа,
                               список не меняется (столбцы остаются) *@
                            <table class="grid clashes">
                                <thead>
                                    <tr>
                                        <th class="sel c-sel" @onclick:stopPropagation="true">
                                            <input type="checkbox" checked="@AllSelected" @onchange="ToggleAll" title="Отметить все найденные (@_clashes.Count)" />
                                        </th>
                                        @SortHeader("date", "Дата", "Последний прогон, где была коллизия", "c-date opt")
                                        @if (_hasCategories) { @SortHeader("cat", "Категория", "Категория проверки («Настройки» → «Категории проверок»)", "c-cat opt") }
                                        @if (_hasSubcategories) { @SortHeader("sub", "Подкатегория", "Подкатегория проверки", "c-cat opt") }
                                        @SortHeader("test", "Проверка", null, "c-test")
                                        @if (HasDistance) { @SortHeader("dist", "Расстояние", "Глубина пересечения, мм", "c-dist opt") }
                                        @if (HasGrid) { @SortHeader("grid", "Оси", "Расположение по осям", "c-grid opt") }
                                        @SortHeader("state", "Статус", null, "c-state")
                                        @SortHeader("comment", "Комментарий", "Последний комментарий к коллизии (сколько всего — после точки); элементы — в подсказке", "c-what")
                                        @SortHeader("repeats", "Повторы", "В скольких прогонах коллизия была в отчётах — чем больше, тем дольше она висит", "c-rep opt")
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in PageItems)
                                    {
                                        if (item.Group != null)
                                        {
                                            var g = item.Group;
                                            var collapsed = _view.GroupCollapsed.Contains(g.Key);
                                            <tr class="group-row" @onclick="() => ToggleGroup(g.Key)">
                                                <td class="sel" @onclick:stopPropagation="true">
                                                    <input type="checkbox" checked="@g.Rows.All(r => _selected.Contains(r.Id))" @onchange="e => ToggleRows(g.Rows, e)"
                                                           title="Отметить всю группу (@g.Rows.Count)" />
                                                </td>
                                                <td colspan="@(ColumnCount - 1)">
                                                    <span class="caret">@(collapsed ? "▸" : "▾")</span>
                                                    <span class="group-title">@g.Title</span>
                                                    @if (g.Sub != null) { <span class="small muted" title="@g.SubTitle"> · @g.Sub</span> }
                                                    <span class="group-count">@Fmt.Plural(g.Rows.Count, "коллизия", "коллизии", "коллизий")</span>
                                                </td>
                                            </tr>
                                        }
                                        else
                                        {
                                            @Row(item.Row)
                                        }
                                    }
                                </tbody>
                            </table>
                        }
                    </div>

                    @if (_clashes.Count > 0)
                    {
                        <div class="pager">
                            <span class="muted">@_clashes.Count</span>
                            <button class="btn small" disabled="@(_page == 0)" @onclick="() => _page--">‹</button>
                            @foreach (var pg in PageNumbers)
                            {
                                if (pg < 0) { <span class="muted">…</span> }
                                else { <button class="btn small @(pg == _page ? "on" : "")" @onclick="() => _page = pg">@(pg + 1)</button> }
                            }
                            <button class="btn small" disabled="@(_page >= PageCount - 1)" @onclick="() => _page++">›</button>
                            <select class="page-size" value="@_view.PageSize" @onchange="OnPageSizeChanged">
                                <option value="50">50 на странице</option>
                                <option value="100">100 на странице</option>
                                <option value="200">200 на странице</option>
                            </select>
                        </div>
                    }
                </section>

                @if (SelectedVisible)
                {
                    <aside class="panel">
                        <div class="panel-nav">
                            <button class="icon-btn small-icon" disabled="@(SelectedIndex <= 0)" @onclick="() => Move(-1)" title="Предыдущая (↑)" aria-label="Предыдущая">
                                <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3.5 5.5 8l4.5 4.5" /></svg>
                            </button>
                            <span class="muted small">@(SelectedIndex >= 0 ? $"{SelectedIndex + 1} из {_visible.Count}" : "нет в списке")</span>
                            <button class="icon-btn small-icon" disabled="@(SelectedIndex < 0 || SelectedIndex >= _visible.Count - 1)" @onclick="() => Move(1)" title="Следующая (↓)" aria-label="Следующая">
                                <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M6 3.5 10.5 8 6 12.5" /></svg>
                            </button>
                            <label class="check small" title="После смены статуса сразу открывать следующую коллизию">
                                <input type="checkbox" @bind="_view.AutoNext" /> после статуса — к следующей
                            </label>
                            <span class="spacer"></span>
                            @* «отдельно» и «закрыть» — значками, как остальные кнопки сайта (просьба разработчика 15.10.2026) *@
                            <a class="icon-btn small-icon" href="clash/@_view.SelectedId" title="Открыть отдельной страницей" aria-label="Открыть отдельной страницей">
                                <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M9 2.5h4.5V7M13.5 2.5 7.5 8.5" /><path d="M11.5 9.5v3a1 1 0 0 1-1 1h-7a1 1 0 0 1-1-1v-7a1 1 0 0 1 1-1h3" /></svg>
                            </a>
                            <button class="icon-btn small-icon" title="Закрыть карточку (Esc)" aria-label="Закрыть карточку" @onclick="CloseCard">
                                <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 4l8 8M12 4l-8 8" /></svg>
                            </button>
                        </div>
                        <ClashPanel ClashId="_view.SelectedId.Value" Compact="true" Changed="OnPanelChanged" />
                    </aside>
                }
            }
            else if (_view.Tab == 2)
            {
                <section class="content scroll">
                    <div class="toolbar">
                        <button class="btn" disabled="@Importer.Busy" @onclick="Scan">@(Importer.Busy ? "Проверяем папку…" : "Проверить папку сейчас")</button>
                        <label class="dd">
                            <span>Группировка</span>
                            <select value="@_view.ReportGroup" @onchange="OnReportGroupChanged">
                                <option value="">Без группировки</option>
                                <option value="block-date">По блоку и дате</option>
                                <option value="block">По блоку</option>
                                <option value="date">По дате отчёта</option>
                                <option value="file">По файлу</option>
                                <option value="imported">По дню загрузки</option>
                            </select>
                        </label>
                        <span class="spacer"></span>
                        <span class="path" title="Папка проекта">@_project.Folder</span>
                    </div>
                    <ImportResults Results="Importer.LastResults" />
                    @MissingBox()
                    <table class="grid reports">
                        <thead>
                            <tr>
                                @ReportSortHeader("date", "Дата отчёта")
                                @ReportSortHeader("block", "Блок")
                                @ReportSortHeader("file", "Файл")
                                @ReportSortHeader("count", "Коллизий", "num")
                                @ReportSortHeader("imported", "Загружен")
                            </tr>
                        </thead>
                        @foreach (var g in ReportGroups())
                        {
                            var collapsed = g.Key != null && _view.ReportCollapsed.Contains(g.Key);
                            <tbody class="group">
                                @if (g.Key != null)
                                {
                                    <tr class="group-row" @onclick="() => ToggleReportGroup(g.Key)">
                                        <td colspan="5">
                                            <span class="caret">@(collapsed ? "▸" : "▾")</span>
                                            <span class="group-title">@g.Title</span>
                                            <span class="group-count">@Fmt.Plural(g.Reports.Count, "отчёт", "отчёта", "отчётов") · @Fmt.Plural(g.Reports.Sum(r => r.Results), "коллизия", "коллизии", "коллизий") в отчётах</span>
                                            @MissingMark(g.Block, null)
                                        </td>
                                    </tr>
                                }
                                @if (!collapsed && g.Subgroups != null)
                                {
                                    @* внутри блока — по дате: свой заголовок, сворачивается отдельно *@
                                    foreach (var sg in g.Subgroups)
                                    {
                                        var subCollapsed = !_view.ReportExpanded.Contains(sg.Key);
                                        <tr class="group-row sub" @onclick="() => ToggleReportDay(sg.Key)">
                                            <td colspan="5">
                                                <span class="caret">@(subCollapsed ? "▸" : "▾")</span>
                                                <span class="group-title">@sg.Title</span>
                                                <span class="group-count">@Fmt.Plural(sg.Reports.Count, "отчёт", "отчёта", "отчётов") · @Fmt.Plural(sg.Reports.Sum(r => r.Results), "коллизия", "коллизии", "коллизий") в отчётах</span>
                                                @SumDelta(sg.Reports, g.Subgroups.Where(x => x.Day < sg.Day).OrderByDescending(x => x.Day).FirstOrDefault()?.Reports)
                                                @MissingMark(g.Block, sg.Day)
                                            </td>
                                        </tr>
                                        @if (!subCollapsed)
                                        {
                                            foreach (var r in sg.Reports)
                                            {
                                                @ReportLine(r)
                                            }
                                            @* договорились выгружать все проверки, даже пустые: нет отчёта — ошибка выгрузки *@
                                            foreach (var (t, _) in _missing.Where(m => m.Test.Block == g.Block && m.Run == sg.Day && InCriticality(m.Test)))
                                            {
                                                <tr class="missing-row">
                                                    <td colspan="5">
                                                        ⚠ Нет отчёта: <b>@t.Name</b>
                                                        <span class="muted">— последний @(t.LastReport.HasValue ? Fmt.Day(t.LastReport.Value) : "—"), активных по нему @t.Counts.Active</span>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    }
                                }
                                else if (!collapsed)
                                {
                                    foreach (var r in g.Reports)
                                    {
                                        @ReportLine(r)
                                    }
                                }
                            </tbody>
                        }
                    </table>
                </section>
            }
            else if (_view.Tab == 5)
            {
                @* сводка проекта (DECISIONS.md, «Сводка проекта»): в отборах боковой панели *@
                <section class="content scroll">
                    <div class="list-title"><h2>@SummaryPageTitle(_view.SummaryPage)</h2><span class="muted small">@ScopeTitle</span></div>
                    <ProjectSummary ProjectId="Id" Page="@_view.SummaryPage" Rows="_base" Tests="ScopeTests.ToList()" Reports="ScopeReports.ToList()"
                                    Missing="_missing.Count(m => InCriticality(m.Test) && (_filter.Block == null || m.Test.Block == _filter.Block))"
                                    Outside="_outside" CategoryOf="CategoryOf" SubOf="SubOf" Categories="_categoryOrder" SubOrder="_subOrder"
                                    Category="@_filter.Category" Subcategory="@_filter.Subcategory" Colors="_groupColors" Drill="DrillFromSummary" />
                </section>
            }
            else if (_view.Tab == 4)
            {
                <section class="content scroll">
                    <div class="list-title"><h2>История проекта</h2></div>
                    <HistoryList ProjectId="Id" />
                </section>
            }
            else
            {
                <section class="content scroll">
                    <div class="list-title"><h2>Проект</h2></div>
                    <div class="form">
                        <label>Название <input @bind="_editName" /></label>
                        <label>Папка с отчётами проекта <input class="wide" @bind="_editFolder" /></label>
                        <button class="btn primary" @onclick="SaveProject">Сохранить</button>
                        @if (_editMessage != null) { <p class="@(_editError ? "error" : "muted")">@_editMessage</p> }
                    </div>
                    <div class="blocks-zone">
                        <h2>Блоки</h2>
                        @if (!_project.ManualBlocks)
                        {
                            <p class="muted">Проект добавлен до ручных блоков: блоки распознаются по названиям папок (S1, «Блок 2»).</p>
                        }
                        else
                        {
                            <p class="muted">
                                Блок — папка внутри папки проекта; отчёты загружаются только из папок блоков. Новые блоки действуют на отчёты,
                                которые загрузятся дальше; уже загруженное остаётся в своих блоках. Удалить можно блок, из которого ещё ничего не загружено.
                            </p>
                            @if (_blocks.Count > 0)
                            {
                                <table class="grid blocks-table">
                                    <thead><tr><th>Название</th><th>Папка</th><th class="num">Отчётов</th><th></th></tr></thead>
                                    @foreach (var b in _blocks)
                                    {
                                        var block = b;
                                        <tr>
                                            <td><b>@block.Name</b></td>
                                            <td class="path">@block.Folder</td>
                                            <td class="num">@block.Reports</td>
                                            <td>
                                                @if (block.Reports == 0)
                                                {
                                                    <button class="btn link small b-del" title="Удалить блок — из него ещё ничего не загружено" @onclick="() => DeleteBlock(block)">
                                                        <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true"><path d="M3 4.5h10M6.5 4.5V3h3v1.5M4.5 4.5l.6 8.5h5.8l.6-8.5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>
                                                    </button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </table>
                            }
                            @if (_outside.Count > 0)
                            {
                                <p class="small">Папки вне блоков:
                                    @foreach (var f in _outside.Where(f => f != ""))
                                    {
                                        var folder = f;
                                        <button class="btn small link" title="Добавить блок с этой папкой" @onclick="() => AddDraft(folder)">+ @folder</button>
                                    }
                                </p>
                            }
                            <BlocksForm ProjectFolder="@_project.Folder" Items="_newBlocks" Changed="StateHasChanged" />
                            @if (_newBlocks.Count > 0)
                            {
                                <div class="actions"><button class="btn primary" @onclick="SaveBlocks">Сохранить блоки и загрузить отчёты</button></div>
                            }
                            @if (_blocksMessage != null) { <p class="@(_blocksError ? "error" : "notice")">@_blocksMessage</p> }
                        }
                    </div>
                    @* удаление — отдельно от остального, с вопросом (DECISIONS.md модуля, «Удаление проекта») *@
                    <div class="danger-zone">
                        <h2>Удалить проект с сайта</h2>
                        <p class="muted">
                            С сайта удалятся отчёты, коллизии, история, комментарии и снимки этого проекта.
                            Папка с отчётами на диске не трогается. Перед удалением сохраняется копия базы.
                        </p>
                        <button class="btn danger" @onclick="AskDelete">Удалить проект с сайта</button>
                    </div>
                </section>
            }
    </div>
</div>

@if (_deleteAsk != null)
{
    <div class="dialog-back">
        <div class="dialog" role="dialog" aria-modal="true">
            <h2>Удалить проект «@_project.Name» с сайта?</h2>
            <p>
                Удалится: @Fmt.Plural(_deleteAsk.Reports, "отчёт", "отчёта", "отчётов"), @Fmt.Plural(_deleteAsk.Clashes, "коллизия", "коллизии", "коллизий"),
                их история, комментарии и снимки.
            </p>
            @if (_deleteAsk.Comments > 0 || _deleteAsk.ManualStates > 0)
            {
                <p class="warn">Среди них — работа людей: @PeopleWork.</p>
            }
            <p class="muted">
                Папка <span class="path">@_project.Folder</span> и отчёты в ней не удаляются. Перед удалением сохраняется копия базы.
            </p>
            <label class="dialog-field">
                Для подтверждения введите название проекта
                <input @bind="_deleteName" @bind:event="oninput" placeholder="@_project.Name" autocomplete="off" />
            </label>
            @if (_deleteError != null) { <p class="error">@_deleteError</p> }
            <div class="actions dialog-buttons">
                <button class="btn" disabled="@_deleting" @onclick="CancelDelete">Отмена</button>
                <button class="btn danger" disabled="@(!DeleteNameMatches || _deleting)" @onclick="DeleteProject">@(_deleting ? "Удаляем…" : "Удалить")</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public long Id { get; set; }
    /// <summary>Раздел в адресе (…?view=summary&amp;n=3): «назад» браузера возвращает прежний раздел с его отборами.</summary>
    [SupplyParameterFromQuery(Name = "view")] public string ViewKey { get; set; }
    [SupplyParameterFromQuery(Name = "n")] public int? StepNo { get; set; }
    /// <summary>Карточка справа открыта (…&amp;card=1) — «назад» браузера и боковая кнопка мыши её закрывают.</summary>
    [SupplyParameterFromQuery(Name = "card")] public int? CardParam { get; set; }

    private static readonly string[] TabKeys = { "clashes", "", "reports", "project", "history", "summary" };

    /// <summary>Строка списка: заголовок группы или коллизия.</summary>
    private sealed class ListItem
    {
        public ListGroup Group;
        public ClashRow Row;
    }

    /// <summary>Группа списка: по типу проверки или по элементу.</summary>
    private sealed class ListGroup
    {
        public string Key;
        public string Title;
        public string SubTitle;
        public string Sub;
        public List<ClashRow> Rows;
    }

    private ProjectView _view;
    private ClashFilter _filter;
    private ProjectRow _project;
    private List<TestRow> _tests = new();
    private List<ReportRow> _reports = new();
    private List<string> _criticalities = new();
    /// <summary>Коллизии выбранной критичности / блока / проверки — из базы; дальше — отборы на странице.</summary>
    private List<ClashRow> _base = new();
    /// <summary>После поиска и полей, без статуса (числа на вкладках статуса).</summary>
    private List<ClashRow> _faceted = new();
    private List<ClashRow> _clashes = new();
    /// <summary>После поиска, полей и отбора прогона, без статуса (числа на вкладках статуса).</summary>
    private List<ClashRow> _runFiltered = new();
    /// <summary>Строки в порядке на экране (в развёрнутых группах) — для ↑ ↓, «N из M», «Показать ещё».</summary>
    private List<ClashRow> _visible = new();
    /// <summary>Строки списка с заголовками групп — по ним страницы.</summary>
    private List<ListItem> _items = new();
    private int _page;
    /// <summary>Последний прогон выбранного (самый поздний отчёт проверок).</summary>
    private DateTime? _lastRun;
    private readonly Dictionary<string, List<FacetValue>> _facetValues = ClashFacets.All.ToDictionary(f => f, _ => new List<FacetValue>());
    private readonly HashSet<long> _selected = new();
    private string _bulkComment;
    private ClashState? _pendingState;
    private string _notice;
    private string _editName, _editFolder, _editMessage;
    private bool _editError;
    private CancellationTokenSource _searchDelay;

    private bool FilterIsSet => !string.IsNullOrWhiteSpace(_filter.Search) || _filter.Facets.Values.Any(v => v.Count > 0) || _view.RunFilter != null;
    private bool AllSelected => _clashes.Count > 0 && _clashes.All(c => _selected.Contains(c.Id));
    private int SelectedIndex => _view.SelectedId.HasValue ? _visible.FindIndex(c => c.Id == _view.SelectedId.Value) : -1;
    private bool SelectedVisible => _view.SelectedId.HasValue;
    /// <summary>Список во всю ширину (карточка закрыта) — со всеми столбцами.</summary>
    private bool Wide => !SelectedVisible;
    /// <summary>Папка проекта коротко: две последние части пути («Desktop\2025_Zamon…»).</summary>
    private string ShortFolder
    {
        get
        {
            var parts = (_project?.Folder ?? "").TrimEnd('\\', '/').Split('\\', '/');
            return parts.Length <= 2 ? _project?.Folder : "…\\" + string.Join("\\", parts.Skip(parts.Length - 2));
        }
    }
    /// <summary>Расстояние и оси есть хоть у одной коллизии — иначе их столбцов нет (в отчётах их не включили).</summary>
    private bool HasDistance => _base.Any(c => c.Distance.HasValue);
    private bool HasGrid => _base.Any(c => !string.IsNullOrEmpty(c.GridLocation));
    /// <summary>Столбцов в таблице (для строки группы).</summary>
    private int ColumnCount => 6 + (HasDistance ? 1 : 0) + (HasGrid ? 1 : 0) + (_hasCategories ? 1 : 0) + (_hasSubcategories ? 1 : 0);

    /// <summary>Подсказка «что с чем»: полностью, с номерами элементов и именем Navisworks.</summary>
    /// <summary>Подсказка столбца «Комментарий»: комментарий полностью (когда, сколько всего), затем элементы.</summary>
    private static string CommentTitle(ClashRow x) =>
        (x.LastComment == null ? "" : $"{x.LastComment}\n— {Fmt.Date(x.LastCommentTime)}" + (x.Comments > 1 ? $", всего комментариев: {x.Comments}" : "") + "\n\n")
        + WhatTitle(x);

    private static string WhatTitle(ClashRow x) =>
        $"{Fmt.Element(x.A)} (ID {x.A?.ElementId}) × {Fmt.Element(x.B)} (ID {x.B?.ElementId}) · {x.Name}";
    private IEnumerable<TestRow> ScopeTests => _tests.Where(InScope);
    private IEnumerable<ReportRow> ScopeReports => _reports.Where(r => (_filter.Criticality == null || r.Criticality == _filter.Criticality)
                                                                      && (_filter.Block == null || r.Block == _filter.Block)
                                                                      && (_filter.Category == null || r.TestIds.Any(id => _testNames.TryGetValue(id, out var n) && MatchesCategory(n))));
    /// <summary>Блок у строки — когда выбрана вся критичность, а блоков несколько.</summary>
    private bool ShowBlock => _filter.Block == null && BlocksOf(_filter.Criticality).Count > 1;

    protected override void OnParametersSet()
    {
        _view = ViewState.For(Id);
        _filter = _view.Filter;
        if (!_view.Initialized)
        {
            // по умолчанию — то, с чем работать: активные
            FacetSet(ClashFacets.State).Add(((int)ClashState.Active).ToString());
            _filter.State = null;
            _view.Initialized = true;
        }
        // шаг истории браузера: уходя — запомнить отборы прежнего шага, приходя на известный — вернуть его отборы
        var step = StepNo ?? 0;
        _view.LastStep = Math.Max(_view.LastStep, step);
        if (step != _view.Step)
        {
            if (_view.Frozen != _view.Step) _view.Steps[_view.Step] = _view.Snapshot();
            _view.Frozen = -1;
            if (_view.Steps.TryGetValue(step, out var snapshot))
            {
                _view.Restore(snapshot);
                _selected.Clear();
                _notice = null;
                _page = 0;
            }
            _view.Step = step;
        }
        var tab = Array.IndexOf(TabKeys, ViewKey ?? "");
        if (!string.IsNullOrEmpty(ViewKey) && tab >= 0) _view.Tab = tab;
        // карточка: ушли со строки с card=1 («назад») — закрыть; пришли на неё снова («вперёд») — открыть последнюю
        var card = CardParam == 1;
        if (card && !_view.CardInUrl && _view.SelectedId == null) _view.SelectedId = _view.LastCardId;
        else if (!card && _view.CardInUrl) _view.SelectedId = null;
        _view.CardInUrl = card;
        LoadAll();
    }

    /// <summary>Карточку закрыли иначе (смена отборов, прогона) — убрать card=1 из адреса, не добавляя шага.</summary>
    protected override void OnAfterRender(bool firstRender)
    {
        if (_view.CardInUrl && _view.SelectedId == null && !_closing)
        {
            _view.CardInUrl = false;
            Nav.NavigateTo(Nav.GetUriWithQueryParameter("card", (int?)null), replace: true);
        }
    }

    private bool _closing;

    /// <summary>Открыть карточку: из закрытой — новым шагом истории браузера, чтобы «назад» её закрыл.</summary>
    private void ShowCard(long id)
    {
        var wasOpen = _view.SelectedId.HasValue;
        _view.SelectedId = id;
        _view.LastCardId = id;
        if (!wasOpen && _view.Tab == 0 && !_view.CardInUrl) Nav.NavigateTo(Nav.GetUriWithQueryParameter("card", 1));
    }

    /// <summary>✕ и Esc: как «назад» браузера, если карточка открыта шагом истории; иначе просто закрыть.</summary>
    private async Task CloseCard()
    {
        if (_view.CardInUrl)
        {
            _closing = true;
            try { await JS.InvokeVoidAsync("ras.back"); }
            finally { _closing = false; }
        }
        else _view.SelectedId = null;
    }

    /// <summary>Другой раздел — новым шагом истории браузера (адрес меняется, «назад» вернёт этот раздел).</summary>
    private void Go(int tab)
    {
        if (tab == _view.Tab) return;
        Nav.NavigateTo($"project/{Id}?view={TabKeys[tab]}&n={++_view.LastStep}");
    }

    /// <summary>Запомнить отборы нынешнего шага до того, как переход их поменяет.</summary>
    private void Freeze()
    {
        _view.Steps[_view.Step] = _view.Snapshot();
        _view.Frozen = _view.Step;
    }

    // ───── загрузка ─────

    // ───── блоки вручную (DECISIONS.md, «Блоки — вручную») ─────

    private List<BlockRow> _blocks = new();
    private List<BlockDraft> _newBlocks = new();
    /// <summary>Папки с отчётами вне блоков — по последней проверке папки.</summary>
    private IReadOnlyList<string> _outside = Array.Empty<string>();
    private string _blocksMessage;
    private bool _blocksError;

    private void AddDraft(string folder)
    {
        var last = folder.Split('\\').Last();
        _newBlocks.Add(new BlockDraft { Folder = folder, Name = ReportPath.Block(last) ?? last });
    }

    private async Task SaveBlocks()
    {
        _blocksError = true;
        var problem = BlocksForm.Collect(_project.Folder, _newBlocks, out var blocks);
        if (problem == null && blocks.Count == 0) problem = "Заполните название и папку блока.";
        problem ??= Store.AddBlocks(Id, blocks);
        if (problem != null) { _blocksMessage = problem; return; }
        _newBlocks = new List<BlockDraft>();
        _blocksError = false;
        _blocksMessage = blocks.Count == 1 ? "Блок добавлен — отчёты из его папки загружаются." : "Блоки добавлены — отчёты из их папок загружаются.";
        await Importer.ScanAsync(Id);
        LoadAll();
    }

    private void DeleteBlock(BlockRow b)
    {
        var problem = Store.DeleteBlock(Id, b.Id);
        _blocksError = problem != null;
        _blocksMessage = problem ?? $"Блок «{b.Name}» удалён.";
        LoadAll();
    }

    private void LoadAll()
    {
        _project = Store.Project(Id);
        if (_project == null) return;
        _blocks = _project.ManualBlocks ? Store.Blocks(Id) : new List<BlockRow>();
        _outside = Importer.OutsideBlocks(Id);
        _editName ??= _project.Name;
        _editFolder ??= _project.Folder;
        _tests = Store.Tests(Id);
        _reports = Store.Reports(Id);
        _categoryMap = Store.CategoryMap();
        var categories = Store.Categories();
        _categoryOrder = categories.Select(c => c.Name).ToList();
        _subOrder = categories.ToDictionary(c => c.Name, c => c.Subcategories.Select(x => x.Name).ToList());
        _groupColors = new Dictionary<string, string>();
        foreach (var c in categories)
        {
            if (c.Color != null) _groupColors[c.Name] = c.Color;
            foreach (var sub in c.Subcategories)
                if ((sub.Color ?? c.Color) != null) _groupColors[c.Name + "\u001f" + sub.Name] = sub.Color ?? c.Color;
        }
        _testNames = _tests.ToDictionary(t => t.Id, t => t.Name);
        _hasCategories = _tests.Any(t => CategoryOf(t.Name) != "");
        _hasSubcategories = _tests.Any(t => SubOf(t.Name) != "");
        // выбранная категория / подкатегория остаётся, пока она есть в проекте или в «Настройках» (пустые видны по флажку)
        if (_filter.Category != null && !CategoriesHere.Contains(_filter.Category) && !(Options.ShowEmptyCategories && _categoryOrder.Contains(_filter.Category)))
            _filter.Category = null;
        if (_filter.Category == null || (_filter.Subcategory != null && !_tests.Any(t => CategoryOf(t.Name) == _filter.Category && SubOf(t.Name) == _filter.Subcategory)
                                         && !(Options.ShowEmptyCategories && _subOrder.TryGetValue(_filter.Category, out var subs) && subs.Contains(_filter.Subcategory))))
            _filter.Subcategory = null;
        _criticalities = _tests.Select(t => t.Criticality).Distinct().OrderBy(ReportPath.CriticalityOrder).ToList();
        if (!_view.ScopeChosen || (_filter.Criticality != null && !_criticalities.Contains(_filter.Criticality)))
        {
            // при открытии — все блоки и проверки (критичность в отборах больше не участвует — 14.10.2026)
            _filter.Criticality = null;
            _filter.Block = null;
            _filter.TestType = null;
            _view.ScopeChosen = _criticalities.Count > 0;
        }
        if (_filter.Block != null && !BlocksOf(_filter.Criticality).Contains(_filter.Block)) _filter.Block = null;
        if (_filter.TestType != null && !_tests.Any(t => t.Type == _filter.TestType && InScope(t))) _filter.TestType = null;
        _lastRun = ScopeTests.Where(t => t.LastReport.HasValue).Select(t => t.LastReport).DefaultIfEmpty(null).Max();
        // проверка, в которой не было ни одной коллизии, не тревожит: беспокоиться о ней нечего (14.10.2026)
        _blockFirstRun = _reports.GroupBy(r => r.Block ?? "").ToDictionary(g => g.Key, g => g.Min(r => r.ReportDate).ToString("yyyy-MM-dd"));
        _missing = RunCheck.Missing(_tests.Where(t => t.Counts.Total > 0), t => t.Criticality, t => t.Block, t => t.LastReport, _reports.Select(r => (r.Criticality, r.Block, r.ReportDate)));
        _base = _criticalities.Count == 0 ? new List<ClashRow>() : Store.Clashes(Id, _filter);
        if (_filter.Category != null) _base = _base.Where(c => MatchesCategory(c.TestName)).ToList();
        Recompute();
    }

    // ───── нет отчёта в прогоне; «Вернуть активными» ─────

    /// <summary>Проверки без отчёта в последнем прогоне своего блока и критичности (RunCheck) — с днём этого прогона.</summary>
    private List<(TestRow Test, DateTime Run)> _missing = new();

    private bool InCriticality(TestRow t) => (_filter.Criticality == null || t.Criticality == _filter.Criticality)
                                             && MatchesCategory(t.Name);

    /// <summary>
    /// Предупреждение: в последнем прогоне блока нет отчёта по проверке — договорились выгружать все, даже пустые
    /// (DECISIONS.md, «Нет отчёта в прогоне»); статусы её коллизий не меняются.
    /// </summary>
    private RenderFragment MissingBox() => __builder =>
    {
        // по критичности и блоку, без типа проверки: это про полноту прогона, и плашка не появляется-пропадает при смене типа
        var list = _missing.Where(m => InCriticality(m.Test) && (_filter.Block == null || m.Test.Block == _filter.Block)).ToList();
        if (list.Count == 0) return;
        <details class="missing-box">
            <summary>
                ⚠ Нет отчёта в последнем прогоне: @Fmt.Plural(list.Count, "проверка", "проверки", "проверок") ·
                @Fmt.Plural(list.Sum(m => m.Test.Counts.Active), "активная", "активные", "активных") по более ранним отчётам
            </summary>
            <p class="muted">Выгружайте все проверки, даже пустые: иначе не понять — исправлено всё или отчёт забыли. Статусы этих коллизий сайт не меняет.</p>
            <ul>
                @foreach (var (t, run) in list.OrderBy(m => ReportPath.CriticalityOrder(m.Test.Criticality)).ThenBy(m => ReportPath.BlockOrder(m.Test.Block)).ThenBy(m => m.Test.Name))
                {
                    <li>
                        @if (t.Block != "") { <span class="tag">@t.Block</span> }
                        <b>@t.Name</b>
                        <span class="muted">— нет в прогоне @Fmt.Day(run); последний отчёт @(t.LastReport.HasValue ? Fmt.Day(t.LastReport.Value) : "—"), активных @t.Counts.Active</span>
                        @{ var appeared = NewTestsIn(t.Block, run, t.LastReport); }
                        @if (appeared.Count > 0)
                        {
                            <div class="small">В этом прогоне блока появились: @string.Join("; ", appeared.Select(n => "«" + n + "»")). Если одна из них — эта же проверка, переименованная, её коллизии посчитаны дважды: верните прежнее название в Navisworks.</div>
                        }
                    </li>
                }
            </ul>
        </details>
    };

    /// <summary>
    /// Проверки, впервые попавшие в прогон блока (день), — если пропавшая проверка была в прошлом прогоне блока (lastReport):
    /// может быть, одна из них — она же, переименованная. Пропала раньше — к этому прогону не относится.
    /// </summary>
    private List<string> NewTestsIn(string block, DateTime run, DateTime? lastReport)
    {
        if (!_blockFirstRun.TryGetValue(block ?? "", out var first) || run.ToString("yyyy-MM-dd") == first) return new List<string>();
        var previous = _reports.Where(r => r.Block == block && r.ReportDate.Date < run.Date).Select(r => r.ReportDate.Date).DefaultIfEmpty().Max();
        if (lastReport?.Date != previous) return new List<string>();
        var ids = _reports.Where(r => r.Block == block && r.ReportDate.Date == run.Date).SelectMany(r => r.NewTestIds).ToHashSet();
        return _tests.Where(t => ids.Contains(t.Id)).Select(t => t.Name).ToList();
    }

    /// <summary>В заголовке группы «блок → дата» (видно и в свёрнутой): сколько проверок без отчёта в прогоне; block null — не по блокам.</summary>
    private RenderFragment MissingMark(string block, DateTime? day) => __builder =>
    {
        if (block == null) return;
        var n = _missing.Count(m => m.Test.Block == block && (day == null || m.Run == day) && InCriticality(m.Test));
        if (n == 0) return;
        <span class="group-missing" title="Проверки без отчёта в последнем прогоне блока — выгружайте все, даже пустые">⚠ нет отчёта: @n</span>
    };

    /// <summary>
    /// Что принесли отчёты группы (дата внутри блока — это прогон); previous — отчёты прошлого прогона блока (null — это
    /// первый прогон): проверки, которых в нём не было, и пропавшие из него.
    /// </summary>
    private RenderFragment SumDelta(IEnumerable<ReportRow> reports, IEnumerable<ReportRow> previous) => __builder =>
    {
        var list = reports.ToList();
        var sum = new RunDelta();
        foreach (var r in list) sum.Add(r.Delta);
        // «первая проверка» — первый прогон блока, если все отчёты с коллизиями — первые для своих проверок
        var withClashes = list.Where(r => r.Results > 0).ToList();
        var first = previous == null && withClashes.Count > 0 && withClashes.All(r => r.FirstRun);
        if (previous != null)
        {
            var names = _tests.ToDictionary(t => t.Id, t => t.Name);
            string Name(long id) => names.TryGetValue(id, out var n) ? n : "?";
            sum.NewTests.AddRange(list.SelectMany(r => r.NewTestIds).Distinct().Select(Name));
            sum.NewTestClashes = list.Sum(r => r.NewTestClashes);
            var now = list.SelectMany(r => r.TestIds).ToHashSet();
            sum.DroppedTests.AddRange(previous.SelectMany(r => r.TestIds).Distinct().Where(id => !now.Contains(id)).Select(Name));
        }
        <Delta Value="sum" FirstRun="first" Unchanged="!first && withClashes.Count > 0" />
    };

    private void UndoFixes(ReportRow r)
    {
        var n = Store.UndoReportFixes(r.Id);
        _notice = $"Возвращены «Активная»: {n}.";
        LoadAll();
    }

    /// <summary>
    /// Отборы на странице: дата (прогон) → поиск → поля (раздел, уровень, статус) → что принёс последний прогон;
    /// числа у значений полей; группы и строки списка по страницам.
    /// </summary>
    private void Recompute()
    {
        var dated = _base.Where(InDate).ToList();
        var searched = dated.Where(c => ClashFacets.MatchesSearch(c, _filter.Search)).ToList();
        _faceted = searched.Where(c => ClashFacets.Matches(c, _filter.Facets)).ToList();
        _runBase = searched.Where(c => ClashFacets.Matches(c, _filter.Facets, except: ClashFacets.State)).ToList();
        _clashes = Sort(_faceted.Where(InRun).ToList());
        foreach (var f in ClashFacets.All)
        {
            var values = ClashFacets.Count(searched.Where(c => InRun(c) && ClashFacets.Matches(c, _filter.Facets, except: f)), f);
            // выбранное, которого сейчас нет в списке (другие отборы), — тоже видно, с нулём: его можно снять
            var missing = FacetSet(f).Where(k => values.All(v => v.Key != k)).ToList();
            if (missing.Count > 0)
            {
                var all = ClashFacets.Count(_base, f);
                foreach (var key in missing)
                    values.Add(new FacetValue { Key = key, Title = all.FirstOrDefault(v => v.Key == key)?.Title ?? FacetTitle(f, key), Count = 0 });
            }
            _facetValues[f] = values;
        }
        BuildItems();
        _selected.IntersectWith(_clashes.Select(c => c.Id));
        _page = Math.Min(_page, Math.Max(PageCount - 1, 0));
    }

    /// <summary>Строки списка: без группировки — коллизии; с группировкой — заголовок группы и её коллизии (свёрнутая — только заголовок).</summary>
    private void BuildItems()
    {
        List<ListGroup> groups = null;
        if (_view.GroupBy == "test")
            groups = _clashes.GroupBy(c => c.Type).OrderBy(g => g.Key, StringComparer.CurrentCultureIgnoreCase)
                .Select(g => new ListGroup { Key = "t:" + g.Key, Title = g.Key, Rows = g.ToList() }).ToList();
        else if (_view.GroupBy == "element")
            groups = ClashGrouping.ByElement(_clashes).Select(g => new ListGroup
            {
                Key = "e:" + (g.Key ?? "—"),
                Title = g.Key == null ? "Остальные — по одной коллизии на элемент" : Fmt.Short(g.Element),
                Sub = g.Key == null ? null : "ID " + g.Element.ElementId,
                SubTitle = g.Key == null ? null : Fmt.Element(g.Element) + " · " + g.Element.ModelFile,
                Rows = g.Rows,
            }).ToList();
        _items = new List<ListItem>();
        if (groups == null)
        {
            _items.AddRange(_clashes.Select(c => new ListItem { Row = c }));
            _visible = _clashes;
            return;
        }
        _visible = new List<ClashRow>();
        foreach (var g in groups)
        {
            _items.Add(new ListItem { Group = g });
            if (_view.GroupCollapsed.Contains(g.Key)) continue;
            _items.AddRange(g.Rows.Select(r => new ListItem { Row = r }));
            _visible.AddRange(g.Rows);
        }
    }

    // ───── дата (прогон) ─────

    /// <summary>Дни прогонов выбранного — по отчётам, новые сверху.</summary>
    private IEnumerable<DateTime> RunDates => ScopeReports.Select(r => r.ReportDate.Date).Distinct().OrderByDescending(d => d);

    /// <summary>
    /// Коллизия относится к выбранному прогону: «последний» — есть в последнем отчёте своей проверки или исправлена им;
    /// день — была в отчётах того дня или исправлена ими; «все» — любая.
    /// </summary>
    private bool InDate(ClashRow c) => _view.RunDate switch
    {
        "all" => true,
        "last" => c.InLastReport || c.FixedInLastRun,
        _ => c.Runs.Contains(_view.RunDate),
    };

    private void OnRunDateChanged(ChangeEventArgs e) => SetRunDate(e.Value?.ToString() ?? "last");

    private void SetRunDate(string date)
    {
        _view.RunDate = date;
        // «что принёс прогон» — про выбранный прогон; «все даты» — его нет
        if (date == "all") _view.RunFilter = null;
        _view.SelectedId = null;
        _page = 0;
        Recompute();
    }

    // ───── последний прогон ─────

    /// <summary>Коллизия проходит отбор прогона: new — появилась в нём, fixed — исправлена им, returned — вернулась.</summary>
    private bool InRun(ClashRow c) => _view.RunFilter == null || RunIs(c, _view.RunFilter);

    /// <summary>
    /// Что выбранный прогон сделал с коллизией: «последний» — последний отчёт её проверки; день — отчёты того дня.
    /// </summary>
    private bool RunIs(ClashRow c, string kind)
    {
        var day = _view.RunDate;
        if (day == "all") return false;
        if (kind == "tests")
        {
            // коллизии проверок, впервые попавших в прогон (не в первый прогон блока): активные, но не «новые»
            if (c.TestFirstRun == null || c.FirstSeen.ToString("yyyy-MM-dd") != c.TestFirstRun) return false;
            if (!_blockFirstRun.TryGetValue(c.Block ?? "", out var blockFirst) || string.CompareOrdinal(c.TestFirstRun, blockFirst) <= 0) return false;
            if (day != "last") return c.TestFirstRun == day;
            var test = _tests.FirstOrDefault(t => t.Id == c.TestId);
            return test?.LastReport != null && test.LastReport.Value.ToString("yyyy-MM-dd") == c.TestFirstRun;
        }
        if (day == "last")
            return kind switch { "new" => c.NewInLastRun, "fixed" => c.FixedInLastRun, _ => c.ReturnedInLastRun };
        return kind switch
        {
            "new" => c.FirstSeen.ToString("yyyy-MM-dd") == day && day != c.TestFirstRun,
            "fixed" => c.FixedOn.Contains(day),
            _ => c.ReturnedOn.Contains(day),
        };
    }

    /// <summary>Сколько — среди отобранных всеми отборами, кроме статуса: иначе «Статус: Активная» прятал бы исправленные прогоном.</summary>
    private int RunCount(string kind) => _runBase.Count(c => RunIs(c, kind));

    private List<ClashRow> _runBase = new();

    /// <summary>Первый прогон (день «yyyy-MM-dd») каждого блока — по отчётам.</summary>
    private Dictionary<string, string> _blockFirstRun = new();

    private RenderFragment RunChip(string kind, string title, string prefix) => __builder =>
    {
        var n = RunCount(kind);
        <button class="run-chip @kind @(_view.RunFilter == kind ? "on" : "")" disabled="@(n == 0 && _view.RunFilter != kind)"
                @onclick="() => SetRunFilter(_view.RunFilter == kind ? null : kind)" title="Показать только их">
            @prefix<b>@n</b> @title
        </button>
    };

    /// <summary>Что принёс прогон: отбор статуса снимается (исправленные иначе не видны), выбранная коллизия — сбрасывается.</summary>
    private void SetRunFilter(string kind)
    {
        _view.RunFilter = kind;
        if (kind != null) FacetSet(ClashFacets.State).Clear();
        _page = 0;
        _view.SelectedId = null;
        _notice = null;
        Recompute();
    }

    // ───── группировка ─────

    private void OnGroupChanged(ChangeEventArgs e)
    {
        _view.GroupBy = e.Value?.ToString() ?? "";
        _view.GroupCollapsed.Clear();
        _page = 0;
        Recompute();
    }

    private void ToggleGroup(string key)
    {
        if (!_view.GroupCollapsed.Remove(key)) _view.GroupCollapsed.Add(key);
        Recompute();
    }

    private void ToggleRows(List<ClashRow> rows, ChangeEventArgs e)
    {
        if (e.Value is bool on && on) _selected.UnionWith(rows.Select(r => r.Id));
        else _selected.ExceptWith(rows.Select(r => r.Id));
        _notice = null;
    }

    // ───── страницы ─────

    private int PageCount => Math.Max(1, (_items.Count + _view.PageSize - 1) / _view.PageSize);

    private IEnumerable<ListItem> PageItems => _items.Skip(_page * _view.PageSize).Take(_view.PageSize);

    /// <summary>Номера страниц: первая, последняя, соседние с текущей; пропуски — -1 («…»).</summary>
    private IEnumerable<int> PageNumbers
    {
        get
        {
            var last = PageCount - 1;
            var shown = new SortedSet<int> { 0, last };
            for (var i = _page - 2; i <= _page + 2; i++) if (i >= 0 && i <= last) shown.Add(i);
            var prev = -1;
            foreach (var i in shown)
            {
                if (prev >= 0 && i - prev > 1) yield return -1;
                yield return i;
                prev = i;
            }
        }
    }

    private void OnPageSizeChanged(ChangeEventArgs e)
    {
        _view.PageSize = int.TryParse(e.Value?.ToString(), out var n) ? n : 50;
        _page = 0;
    }

    /// <summary>Страница, на которой коллизия.</summary>
    private int PageOf(long id)
    {
        var i = _items.FindIndex(x => x.Row != null && x.Row.Id == id);
        return i < 0 ? _page : i / _view.PageSize;
    }

    /// <summary>Строка списка.</summary>
    private RenderFragment Row(ClashRow x) => __builder =>
    {
        @* категория и подкатегория — своими столбцами, названия — метками своего цвета (DECISIONS.md, «Категории проверок»);
           выбранная строка — акцентом слева *@
        <tr id="row-@x.Id" class="@(x.Id == _view.SelectedId ? "selected" : "") @(x.InLastReport ? "" : "gone")" @onclick="() => Select(x.Id)">
            <td class="sel" @onclick:stopPropagation="true">
                <input type="checkbox" checked="@_selected.Contains(x.Id)" @onchange="e => Toggle(x.Id, e)" />
            </td>
            <td class="opt">@Fmt.Day(x.LastSeen)</td>
            @if (_hasCategories) { <td class="cut opt" title="@CategoryOf(x.TestName)">@CatChip(CategoryOf(x.TestName), CatColor(x.TestName, false))</td> }
            @if (_hasSubcategories) { <td class="cut opt" title="@SubOf(x.TestName)">@CatChip(SubOf(x.TestName), CatColor(x.TestName, true))</td> }
            <td class="cut" title="@(x.Type != x.TestName ? x.Type + " (в Navisworks: " + x.TestName + ")" : x.TestName)">
                @if (ShowBlock) { <span class="tag">@x.Block</span> }@x.Type
            </td>
            @if (HasDistance) { <td class="opt">@if (x.Distance.HasValue) { <span class="dist">@Fmt.MmAbs(x.Distance, x.Units)</span> } else { <span class="muted">—</span> }</td> }
            @if (HasGrid) { <td class="cut opt" title="@x.GridLocation">@(x.GridLocation ?? "—")</td> }
            <td><span class="badge @Fmt.StateClass(x.State)">@Fmt.State(x.State)</span></td>
            @* последний комментарий (вместо «что с чем» — просьба разработчика 15.10.2026); элементы и имя Navisworks — в подсказке и в карточке;
               позже здесь же — ответственный *@
            <td class="what" title="@CommentTitle(x)">
                <div class="what-line">
                    @if (x.LastComment != null)
                    {
                        <span class="cm">@x.LastComment</span>
                        @if (x.Comments > 1) { <span class="cm-n" title="Всего комментариев">· @x.Comments</span> }
                    }
                    @if (RunIs(x, "new")) { <span class="tag run-new" title="Появилась в этом прогоне">новая</span> }
                    @if (RunIs(x, "returned")) { <span class="tag run-returned" title="Вернулась после исправления в этом прогоне">↺ вернулась</span> }
                    else if (RunIs(x, "fixed")) { <span class="tag run-fixed" title="Исправлена этим прогоном">исправлена</span> }
                    else if (x.ReturnCount > 0) { <span class="tag returned" title="Возвращалась после исправления: @x.ReturnCount">↺@(x.ReturnCount > 1 ? x.ReturnCount.ToString() : "")</span> }
                </div>
            </td>
            <td class="num opt">@x.Repeats</td>
        </tr>
    };

    /// <summary>Скачать список, как он сейчас отобран, — CSV для Excel (разделитель «;», UTF-8 с BOM — так Excel открывает кириллицу).</summary>
    private async Task ExportCsv()
    {
        static string Q(string v) => "\"" + (v ?? "").Replace("\"", "\"\"") + "\"";
        var sb = new System.Text.StringBuilder();
        sb.AppendLine(string.Join(";", new[] { "Дата", "Блок", "Категория", "Подкатегория", "Тип проверки", "Проверка в Navisworks", "Имя", "Расстояние, мм", "Оси", "Уровень",
            "Статус", "Повторы", "Возвращалась", "Элемент 1", "Номер 1", "Модель 1", "Элемент 2", "Номер 2", "Модель 2", "Последний комментарий", "Комментариев" }.Select(Q)));
        foreach (var x in _clashes)
            sb.AppendLine(string.Join(";", new[]
            {
                Fmt.Day(x.LastSeen), x.Block, CategoryOf(x.TestName), SubOf(x.TestName), x.Type, x.TestName, x.Name,
                x.Distance.HasValue ? Fmt.MmAbs(x.Distance, x.Units).Replace(" мм", "") : "", x.GridLocation, Level(x),
                Fmt.State(x.State), x.Repeats.ToString(), x.ReturnCount.ToString(),
                Fmt.Element(x.A), x.A?.ElementId?.ToString(), Fmt.Model(x.A?.ModelFile),
                Fmt.Element(x.B), x.B?.ElementId?.ToString(), Fmt.Model(x.B?.ModelFile),
                x.LastComment, x.Comments.ToString(),
            }.Select(Q)));
        var name = $"Коллизии — {_project.Name} — {DateTime.Now:yyyy-MM-dd}.csv";
        await JS.InvokeVoidAsync("ras.download", name, sb.ToString());
    }

