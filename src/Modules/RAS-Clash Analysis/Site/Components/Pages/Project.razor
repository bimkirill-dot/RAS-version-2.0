    /// <summary>
    /// «Тип проверки» с категориями: категория (null — категорий нет, простой список; "" — без категории) и её типы
    /// проверок с активными — в выбранных критичности и блоке, без отбора категории (видны все категории).
    /// </summary>
    private sealed class TypeNode
    {
        /// <summary>null — категорий нет (простой список); "" — без категории.</summary>
        public string Category;
        /// <summary>Подкатегории по порядку — с их проверками.</summary>
        public List<(string Name, List<(string Name, int Active)> Types)> Subs = new();
        /// <summary>Проверки категории без подкатегории.</summary>
        public List<(string Name, int Active)> Types = new();
    }

    private List<TypeNode> TypeTree
    {
        get
        {
            var types = _tests
                .Where(t => (_filter.Criticality == null || t.Criticality == _filter.Criticality) && (_filter.Block == null || t.Block == _filter.Block))
                .GroupBy(t => t.Type)
                .Select(g => (Name: g.Key, Active: g.Sum(t => t.Counts.Active), Category: CategoryOf(g.First().Name), Sub: SubOf(g.First().Name)))
                // без активных коллизий — не показываются (просьба разработчика 15.10.2026); выбранная — видна всегда
                .Where(x => x.Active > 0 || x.Name == _filter.TestType)
                .OrderBy(x => x.Name, StringComparer.CurrentCultureIgnoreCase)
                .ToList();
            if (_categoryOrder.Count == 0)
                return new List<TypeNode> { new TypeNode { Types = types.Select(x => (x.Name, x.Active)).ToList() } };
            var order = _categoryOrder.Concat(new[] { "" }).ToList();
            var nodes = types.GroupBy(x => x.Category)
                .Select(g =>
                {
                    var subOrder = _subOrder.TryGetValue(g.Key, out var so) ? so : new List<string>();
                    return new TypeNode
                    {
                        Category = g.Key,
                        Subs = g.Where(x => x.Sub != "").GroupBy(x => x.Sub)
                            .OrderBy(s => subOrder.IndexOf(s.Key) < 0 ? int.MaxValue : subOrder.IndexOf(s.Key))
                            .Select(s => (s.Key, s.Select(x => (x.Name, x.Active)).ToList())).ToList(),
                        Types = g.Where(x => x.Sub == "").Select(x => (x.Name, x.Active)).ToList(),
                    };
                })
                .ToList();
            // «Настройки» → «показывать пустые»: категории и подкатегории из «Настроек» — все, пустые — серым с нулём
            // (проверки без активных по-прежнему скрыты — 16.10.2026)
            if (Options.ShowEmptyCategories)
                foreach (var category in _categoryOrder)
                {
                    var node = nodes.FirstOrDefault(n => n.Category == category);
                    if (node == null) nodes.Add(node = new TypeNode { Category = category });
                    var subOrder = _subOrder.TryGetValue(category, out var so) ? so : new List<string>();
                    foreach (var sub in subOrder.Where(s => node.Subs.All(x => x.Name != s)))
                        node.Subs.Add((sub, new List<(string, int)>()));
                    node.Subs = node.Subs.OrderBy(s => subOrder.IndexOf(s.Name) < 0 ? int.MaxValue : subOrder.IndexOf(s.Name)).ToList();
                }
            return nodes.OrderBy(n => order.IndexOf(n.Category) < 0 ? int.MaxValue : order.IndexOf(n.Category)).ToList();
        }
    }

