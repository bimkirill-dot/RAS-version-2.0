    private sealed class ReportGroup
    {
        /// <summary>null — без группировки (одна группа без заголовка).</summary>
        public string Key;
        public string Title;
        public List<ReportRow> Reports;
        /// <summary>Группы внутри группы («По блоку и дате»: блок → даты); null — нет.</summary>
        public List<ReportGroup> Subgroups;
        /// <summary>Блок группы «По блоку и дате»; день подгруппы — прогон.</summary>
        public string Block;
        public DateTime? Day;
    }

    /// <summary>Строка отчёта в таблице «Отчёты».</summary>
    private RenderFragment ReportLine(ReportRow r) => __builder =>
    {
        <tr>
            <td title="@DateSourceTitle(r.DateSource)">@(r.DateSource == ReportPath.DateFromFolder ? Fmt.Day(r.ReportDate) : Fmt.Date(r.ReportDate))@(r.DateSource == ReportPath.DateFromXml ? "" : "*")</td>
            <td>@ReportPath.BlockTitle(r.Block)</td>
            <td class="file" title="@r.FilePath">
                <div class="cut">@System.IO.Path.GetFileName(r.FilePath)</div>
                <div class="el-sub cut">@ReportFolder(r)</div>
                <Delta Value="r.Delta" FirstRun="r.FirstRun" Unchanged="!r.FirstRun && r.Results > 0" />
                @if (r.Warning != null) { <div class="warn small report-warning" title="@r.Warning">⚠ @r.Warning</div> }
                @if (r.Suspicious)
                {
                    <button class="btn small" title="Коллизии, которые этот отчёт отметил «Исправлена», — снова «Активная»" @onclick="() => UndoFixes(r)">Вернуть активными</button>
                }
