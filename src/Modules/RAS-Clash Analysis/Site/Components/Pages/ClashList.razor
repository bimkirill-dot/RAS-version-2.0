@page "/project/{Id:long}/clashes"
@implements IDisposable
@inject ClashStore Store
@inject ProjectViewState ViewState
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>@Heading · @(_project?.Name) · RAS Clash Analysis</PageTitle>

@if (_project == null)
{
    <h1>Проект не найден</h1>
    <p><a href="/">К проектам</a></p>
    return;
}

<div class="list-page">
    @* где мы: проект › критичность › блок; критичность и блок меняются тут же или в обзоре *@
    <div class="list-head">
        <nav class="crumbs"><a href="/">Проекты</a> › <a href="project/@Id">@_project.Name</a> ›</nav>
        <div class="page-title">
            <h1>
                <select class="title-select @CriticalityClass(_criticality)" value="@ScopeQuery.Encode(_criticality)" @onchange="@(e => Go(e.Value?.ToString(), "*"))"
                        title="Критичность">
                    @if (_criticalities.Count > 1) { <option value="*">Все критичности</option> }
                    @foreach (var cr in _criticalities) { <option value="@ScopeQuery.Encode(cr)">@CriticalityTitle(cr)</option> }
                </select>
                @if (_blocks.Count > 1 || (_blocks.Count == 1 && _blocks[0] != ""))
                {
                    <span class="sep">·</span>
                    <select class="title-select" value="@ScopeQuery.Encode(_block)" @onchange="e => Go(ScopeQuery.Encode(_criticality), e.Value?.ToString())" title="Блок">
                        <option value="*">Все блоки</option>
                        @foreach (var b in _blocks) { <option value="@ScopeQuery.Encode(b)">@ReportPath.BlockTitle(b)</option> }
                    </select>
                }
            </h1>
            <span class="spacer"></span>
            <a href="project/@Id">← Обзор проекта</a>
        </div>

        <div class="state-tabs">
            @foreach (var (state, title) in States)
            {
                <button class="stab @(_filter.State == state ? "on" : "") @(state.HasValue ? Fmt.StateClass(state.Value) : "")" @onclick="() => SetStateFilter(state)">
                    @title <b>@StateCount(state)</b>
                </button>
            }
        </div>

        @if (_selected.Count > 0)
        {
            <div class="toolbar bulk">
                @if (_pendingState.HasValue)
                {
                    <span class="confirm">
                        Сделать «@Fmt.State(_pendingState.Value)» у @Fmt.Clashes(_selected.Count)?
                        <button class="btn primary" @onclick="ConfirmBulk">Да</button>
                        <button class="btn" @onclick="() => _pendingState = null">Отмена</button>
                    </span>
                }
                else
                {
                    <span>Отмечено: <b>@_selected.Count</b></span>
                    <input class="comment" placeholder="Комментарий ко всем (необязательно)" @bind="_bulkComment" />
                    <button class="btn state-fixed" @onclick="() => AskBulk(ClashState.Fixed)">Исправлена</button>
                    <button class="btn state-accepted" @onclick="() => AskBulk(ClashState.Accepted)">Допущена</button>
                    <button class="btn state-active" @onclick="() => AskBulk(ClashState.Active)">Активная</button>
                    <button class="btn link" @onclick="() => _selected.Clear()">Снять отметки</button>
                }
            </div>
        }
        else
        {
            <div class="toolbar">
                <input class="search" type="search" placeholder="Поиск: номер элемента, тип, имя…" value="@_filter.Search" @oninput="OnSearch" />
                <FacetMenu Title="Раздел" Values="_facetValues[ClashFacets.Discipline]" Selected="FacetSet(ClashFacets.Discipline)" Changed="Recompute" />
                <FacetMenu Title="Уровень" Values="_facetValues[ClashFacets.Level]" Selected="FacetSet(ClashFacets.Level)" Changed="Recompute" />
                @if (FilterIsSet) { <button class="btn link" @onclick="ResetFilter">Сбросить</button> }
                <span class="spacer"></span>
                @if (_groups.Count > 1)
                {
                    <button class="btn link small" @onclick="ToggleAllGroups">@(_groups.All(g => _view.Collapsed.Contains(g.TestId)) ? "Развернуть все" : "Свернуть все")</button>
                }
                @if (_notice != null) { <span class="notice">@_notice</span> }
            </div>
        }
    </div>

    <div class="work @(SelectedVisible ? "with-panel" : "")">
        <div class="list" tabindex="0" @onkeydown="ListKey">
            @if (_rows.Count == 0)
            {
                <div class="empty">
                    @if (_base.Count == 0)
                    {
                        <span>Здесь коллизий нет.</span>
                    }
                    else
                    {
                        <span>Ничего не найдено.</span>
                        @if (FilterIsSet) { <button class="btn link" @onclick="ResetFilter">Сбросить поиск и отборы</button> }
                        @if (_filter.State.HasValue) { <button class="btn link" @onclick="() => SetStateFilter(null)">Показать все статусы</button> }
                    }
                </div>
            }
            else
            {
                <table class="grid clashes">
                    <colgroup>
                        <col class="c-sel" /><col class="c-name" /><col class="c-level" /><col class="c-el" /><col class="c-el" /><col class="c-state" />
                        @if (Wide) { <col class="c-date" /> }
                    </colgroup>
                    <thead>
                        <tr>
                            <th class="sel"><input type="checkbox" checked="@AllSelected" @onchange="ToggleAll" title="Отметить все (@_rows.Count)" /></th>
                            <th>Коллизия</th><th>Уровень</th><th>Элемент 1</th><th>Элемент 2</th><th>Статус</th>
                            @if (Wide) { <th>Впервые</th> }
                        </tr>
                    </thead>
                    @{ var shown = 0; }
                    @foreach (var g in _groups)
                    {
                        var collapsed = _view.Collapsed.Contains(g.TestId);
                        <tbody class="group">
                            <tr class="group-row" @onclick="() => ToggleGroup(g.TestId)">
                                <td class="sel" @onclick:stopPropagation="true">
                                    <input type="checkbox" checked="@g.Rows.All(r => _selected.Contains(r.Id))" @onchange="e => ToggleGroupSelection(g, e)"
                                           title="Отметить всю группу (@g.Rows.Count)" />
                                </td>
                                <td colspan="@(Wide ? 6 : 5)">
                                    <span class="caret">@(collapsed ? "▸" : "▾")</span>
                                    @if (g.Block != null) { <span class="tag">@g.Block</span> }
                                    <span class="group-title">@Fmt.Test(g.TestName)</span>
                                    <span class="group-count">@g.Rows.Count</span>
                                </td>
                            </tr>
                            @if (!collapsed)
                            {
                                foreach (var x in g.Rows)
                                {
                                    if (shown >= _shown) { break; }
                                    shown++;
                                    <tr id="row-@x.Id" class="@(x.Id == _view.SelectedId ? "selected" : "") @(x.InLastReport ? "" : "gone")" @onclick="() => Select(x.Id)">
                                        <td class="sel" @onclick:stopPropagation="true">
                                            <input type="checkbox" checked="@_selected.Contains(x.Id)" @onchange="e => Toggle(x.Id, e)" />
                                        </td>
                                        <td class="name">@(x.Name ?? "—")</td>
                                        <td class="cut" title="@Level(x)">@Level(x)</td>
                                        <td><ElementCell E="x.A" /></td>
                                        <td><ElementCell E="x.B" /></td>
                                        <td><span class="badge @Fmt.StateClass(x.State)">@Fmt.State(x.State)</span></td>
                                        @if (Wide) { <td title="Последний раз — @Fmt.Day(x.LastSeen)">@Fmt.Day(x.FirstSeen)</td> }
                                    </tr>
                                }
                            }
                        </tbody>
                    }
                </table>
                @if (VisibleCount > _shown)
                {
                    <div class="more"><button class="btn" @onclick="() => _shown += PageSize">Показать ещё (осталось @(VisibleCount - _shown))</button></div>
                }
            }
        </div>

        @if (SelectedVisible)
        {
            <aside class="panel">
                <div class="panel-nav">
                    <button class="btn small" disabled="@(SelectedIndex <= 0)" @onclick="() => Move(-1)" title="Предыдущая (↑)">‹</button>
                    <span class="muted small">@(SelectedIndex >= 0 ? $"{SelectedIndex + 1} из {_visible.Count}" : "нет в списке")</span>
                    <button class="btn small" disabled="@(SelectedIndex < 0 || SelectedIndex >= _visible.Count - 1)" @onclick="() => Move(1)" title="Следующая (↓)">›</button>
                    <label class="check small" title="После смены статуса сразу открывать следующую коллизию">
                        <input type="checkbox" @bind="_view.AutoNext" /> после статуса — к следующей
                    </label>
                    <span class="spacer"></span>
                    <a class="small" href="clash/@_view.SelectedId">отдельно</a>
                    <button class="btn link small" title="Закрыть карточку (Esc)" @onclick="() => _view.SelectedId = null">✕</button>
                </div>
                <ClashPanel ClashId="_view.SelectedId.Value" Compact="true" Changed="OnPanelChanged" />
            </aside>
        }
    </div>
</div>

@code {
    [Parameter] public long Id { get; set; }
    /// <summary>Критичность из адреса: «*» — все, «-» — без критичности (ScopeQuery).</summary>
    [SupplyParameterFromQuery(Name = "c")] public string CriticalityQuery { get; set; }
    [SupplyParameterFromQuery(Name = "b")] public string BlockQuery { get; set; }

    private const int PageSize = 300;

    private static readonly (ClashState? State, string Title)[] States =
    {
        (ClashState.Active, "Активные"), (ClashState.Fixed, "Исправлены"), (ClashState.Accepted, "Допущены"), (null, "Все"),
    };

    /// <summary>Группа «что с чем» — одна проверка (в своём блоке).</summary>
    private sealed class Group
    {
        public long TestId;
        public string TestName;
        /// <summary>Блок — подписью у группы, когда показаны все блоки.</summary>
        public string Block;
        public List<ClashRow> Rows = new();
    }

    private ProjectView _view;
    private ClashFilter _filter;
    private ProjectRow _project;
    private string _criticality, _block;
    private string _scopeKey;
    private List<string> _criticalities = new();
    private List<string> _blocks = new();
    /// <summary>Коллизии выбранной критичности и блока — из базы; дальше — отборы на странице.</summary>
    private List<ClashRow> _base = new();
    /// <summary>После поиска и полей, без статуса (числа на вкладках статуса).</summary>
    private List<ClashRow> _faceted = new();
    /// <summary>Строки списка (после статуса) — по группам; видимые (в развёрнутых группах) — для ↑ ↓ и «N из M».</summary>
    private List<ClashRow> _rows = new();
    private List<Group> _groups = new();
    private List<ClashRow> _visible = new();
    private readonly Dictionary<string, List<FacetValue>> _facetValues = ClashFacets.All.ToDictionary(f => f, _ => new List<FacetValue>());
    private readonly HashSet<long> _selected = new();
    private int _shown = PageSize;
    private string _bulkComment;
    private ClashState? _pendingState;
    private string _notice;
    private CancellationTokenSource _searchDelay;

    private bool FilterIsSet => !string.IsNullOrWhiteSpace(_filter.Search) || _filter.Facets.Values.Any(v => v.Count > 0);
    private bool AllSelected => _rows.Count > 0 && _rows.All(c => _selected.Contains(c.Id));
    private int SelectedIndex => _view.SelectedId.HasValue ? _visible.FindIndex(c => c.Id == _view.SelectedId.Value) : -1;
    private bool SelectedVisible => _view.SelectedId.HasValue;
    /// <summary>Список во всю ширину (карточка закрыта) — со столбцом «Впервые».</summary>
    private bool Wide => !SelectedVisible;
    private int VisibleCount => _visible.Count;

    private string Heading => CriticalityTitle(_criticality ?? "*") + (string.IsNullOrEmpty(_block) ? "" : " · " + _block);

    protected override void OnParametersSet()
    {
        _view = ViewState.For(Id);
        _filter = _view.Filter;
        _criticality = ScopeQuery.Decode(CriticalityQuery);
        _block = ScopeQuery.Decode(BlockQuery);
        // другая критичность или блок — другая работа: отметки и выбранная коллизия сбрасываются, поиск и поля — нет
        var key = ScopeQuery.Encode(_criticality) + "|" + ScopeQuery.Encode(_block);
        if (_scopeKey != null && _scopeKey != key)
        {
            _view.SelectedId = null;
            _selected.Clear();
            _shown = PageSize;
        }
        _scopeKey = key;
        LoadAll();
    }

    private void Go(string criticality, string block) => Nav.NavigateTo($"project/{Id}/clashes?c={Uri.EscapeDataString(criticality ?? "*")}&b={Uri.EscapeDataString(block ?? "*")}");

    // ───── загрузка и отборы ─────

    private void LoadAll()
    {
        _project = Store.Project(Id);
        if (_project == null) return;
        var tests = Store.Tests(Id);
        _criticalities = tests.Select(t => t.Criticality).Distinct().OrderBy(ReportPath.CriticalityOrder).ToList();
        _blocks = tests.Where(t => _criticality == null || t.Criticality == _criticality).Select(t => t.Block).Distinct()
            .OrderBy(ReportPath.BlockOrder).ThenBy(b => b, StringComparer.CurrentCultureIgnoreCase).ToList();
        if (_block != null && !_blocks.Contains(_block)) _block = null;
        _filter.Criticality = _criticality;
        _filter.Block = _block;
        _filter.TestId = null;
        _base = Store.Clashes(Id, _filter);
        Recompute();
    }

    /// <summary>Поиск → поля → статус; группы «что с чем»; числа у значений полей и у статусов.</summary>
    private void Recompute()
    {
        var searched = _base.Where(c => ClashFacets.MatchesSearch(c, _filter.Search)).ToList();
        _faceted = searched.Where(c => ClashFacets.Matches(c, _filter.Facets)).ToList();
        var state = _filter.State;
        _rows = state.HasValue ? _faceted.Where(c => c.State == state.Value).ToList() : _faceted;
        foreach (var f in ClashFacets.All)
        {
            var values = ClashFacets.Count(searched.Where(c => (!state.HasValue || c.State == state.Value) && ClashFacets.Matches(c, _filter.Facets, except: f)), f);
            var missing = FacetSet(f).Where(k => values.All(v => v.Key != k)).ToList();
            if (missing.Count > 0)
            {
                var all = ClashFacets.Count(_base, f);
                foreach (var k in missing) values.Add(new FacetValue { Key = k, Title = all.FirstOrDefault(v => v.Key == k)?.Title ?? k, Count = 0 });
            }
            _facetValues[f] = values;
        }
        // группы — в порядке базы (блок, проверка, номер коллизии)
        var showBlock = _block == null && _blocks.Count > 1;
        _groups = _rows.GroupBy(r => r.TestId)
            .Select(g => new Group { TestId = g.Key, TestName = g.First().TestName, Block = showBlock && g.First().Block != "" ? g.First().Block : null, Rows = g.ToList() })
            .ToList();
        _visible = _groups.Where(g => !_view.Collapsed.Contains(g.TestId)).SelectMany(g => g.Rows).ToList();
        _selected.IntersectWith(_rows.Select(c => c.Id));
        _shown = Math.Max(PageSize, Math.Min(_shown, _visible.Count));
    }

    private HashSet<string> FacetSet(string facet)
    {
        if (!_filter.Facets.TryGetValue(facet, out var set)) _filter.Facets[facet] = set = new HashSet<string>();
        return set;
    }

    private int StateCount(ClashState? state) => state.HasValue ? _faceted.Count(c => c.State == state.Value) : _faceted.Count;

    private void SetStateFilter(ClashState? state)
    {
        _filter.State = state;
        _notice = null;
        Recompute();
    }

    private async Task OnSearch(ChangeEventArgs e)
    {
        _filter.Search = e.Value?.ToString();
        // не пересчитывать на каждую букву: ждём паузу в наборе
        _searchDelay?.Cancel();
        var delay = _searchDelay = new CancellationTokenSource();
        try { await Task.Delay(250, delay.Token); }
        catch (TaskCanceledException) { return; }
        Recompute();
    }

    private void ResetFilter()
    {
        _filter.Search = null;
        foreach (var set in _filter.Facets.Values) set.Clear();
        Recompute();
    }

    // ───── группы ─────

    private void ToggleGroup(long testId)
    {
        if (!_view.Collapsed.Remove(testId)) _view.Collapsed.Add(testId);
        Recompute();
    }

    private void ToggleAllGroups()
    {
        if (_groups.All(g => _view.Collapsed.Contains(g.TestId))) _view.Collapsed.ExceptWith(_groups.Select(g => g.TestId));
        else _view.Collapsed.UnionWith(_groups.Select(g => g.TestId));
        Recompute();
    }

    private void ToggleGroupSelection(Group g, ChangeEventArgs e)
    {
        if (e.Value is bool on && on) _selected.UnionWith(g.Rows.Select(r => r.Id));
        else _selected.ExceptWith(g.Rows.Select(r => r.Id));
        _notice = null;
    }

    // ───── выбор и карточка ─────

    private void Select(long id)
    {
        _view.SelectedId = id;
        _notice = null;
    }

    private async Task Move(int step)
    {
        var i = SelectedIndex;
        var next = i < 0 ? 0 : i + step;
        if (next < 0 || next >= _visible.Count) return;
        _view.SelectedId = _visible[next].Id;
        if (next >= _shown) _shown = next + 1;
        StateHasChanged();
        await JS.InvokeVoidAsync("ras.reveal", "row-" + _view.SelectedId);
    }

    private async Task ListKey(KeyboardEventArgs e)
    {
        if (e.Key == "ArrowDown") await Move(1);
        else if (e.Key == "ArrowUp") await Move(-1);
        else if (e.Key == "Escape") _view.SelectedId = null;
    }

    /// <summary>В карточке сменили статус или добавили комментарий: обновить список; по желанию — к следующей.</summary>
    private async Task OnPanelChanged(ClashState? state)
    {
        var index = SelectedIndex;
        LoadAll();
        if (state == null || !_view.AutoNext) return;
        // коллизия могла пропасть из списка (отбор по статусу) — тогда «следующая» стоит на её месте
        var now = SelectedIndex;
        var next = now >= 0 ? now + 1 : index;
        if (next < 0 || next >= _visible.Count) return;
        _view.SelectedId = _visible[next].Id;
        StateHasChanged();
        await JS.InvokeVoidAsync("ras.reveal", "row-" + _view.SelectedId);
    }

    // ───── отметки и статус многим ─────

    private void Toggle(long id, ChangeEventArgs e)
    {
        if (e.Value is bool on && on) _selected.Add(id);
        else _selected.Remove(id);
        _notice = null;
    }

    private void ToggleAll(ChangeEventArgs e)
    {
        if (e.Value is bool on && on) _selected.UnionWith(_rows.Select(c => c.Id));
        else _selected.Clear();
        _notice = null;
    }

    /// <summary>Немного коллизий — сразу; много — с вопросом: одно нажатие не должно переписать весь проект.</summary>
    private void AskBulk(ClashState state)
    {
        if (_selected.Count > 10) _pendingState = state;
        else ApplyBulk(state);
    }

    private void ConfirmBulk()
    {
        if (_pendingState.HasValue) ApplyBulk(_pendingState.Value);
        _pendingState = null;
    }

    private void ApplyBulk(ClashState state)
    {
        var total = _selected.Count;
        var changed = Store.SetState(_selected, state, _bulkComment, null);
        _notice = $"«{Fmt.State(state)}»: изменено {changed} из {total}.";
        _selected.Clear();
        _bulkComment = null;
        LoadAll();
    }

    // ───── прочее ─────

    private static string CriticalityTitle(string c) => c == null || c == "*" ? "Все критичности" : c == "" ? "Все коллизии" : ReportPath.CriticalityTitle(c);

    private static string CriticalityClass(string c) => c == "Высокая" ? "crit-high" : c == "Средняя" ? "crit-mid" : "";

    /// <summary>Уровень коллизии: у обоих элементов один — он; разные — «А / Б».</summary>
    private static string Level(ClashRow x)
    {
        var a = x.A?.Level;
        var b = x.B?.Level;
        if (string.IsNullOrEmpty(a)) return b ?? "—";
        if (string.IsNullOrEmpty(b) || x.A.LevelKey == x.B.LevelKey) return a;
        return a + " / " + b;
    }

    public void Dispose() => _searchDelay?.Cancel();
}
