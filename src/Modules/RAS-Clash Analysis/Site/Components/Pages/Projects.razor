@page "/"
@inject ClashStore Store
@inject ReportImporter Importer
@inject BackupService Backup
@inject SiteOptions Options
@inject NavigationManager Nav

<PageTitle>Проекты · RAS Clash Analysis</PageTitle>

<h1>Проекты</h1>

@if (_projects.Count == 0)
{
    <p class="muted">Проектов ещё нет. Создайте первый: название и папка, куда Navisworks кладёт отчёты XML.</p>
}
else
{
    <table class="grid">
        <thead>
            <tr><th>Проект</th><th class="num">Активные</th><th class="num">Исправлены</th><th class="num">Допущены</th><th>Последний отчёт</th><th>Папка отчётов</th></tr>
        </thead>
        <tbody>
            @foreach (var p in _projects)
            {
                <tr class="clickable" @onclick="@(() => Nav.NavigateTo("project/" + p.Id))">
                    <td><a href="project/@p.Id" @onclick:stopPropagation="true">@p.Name</a></td>
                    <td class="num"><span class="badge state-active">@p.Counts.Active</span></td>
                    <td class="num">@p.Counts.Fixed</td>
                    <td class="num">@p.Counts.Accepted</td>
                    <td>@Fmt.Date(p.LastReport)</td>
                    <td class="path">@p.Folder</td>
                </tr>
            }
        </tbody>
    </table>
}

<div class="actions">
    @if (_projects.Count > 0 && !_showNew)
    {
        <button class="btn primary" @onclick="() => _showNew = true">+ Новый проект</button>
    }
    <button class="btn" disabled="@Importer.Busy" @onclick="ScanAll">@(Importer.Busy ? "Проверяем папки…" : "Проверить папки сейчас")</button>
    <span class="muted">
        Новые отчёты сайт ищет и сам — @(Options.ScanMinutes > 0 ? $"каждые {Options.ScanMinutes} мин" : "выключено")@(Importer.LastScan.HasValue ? $"; последняя проверка — {Fmt.Date(Importer.LastScan)}" : "").
    </span>
</div>

<ImportResults Results="Importer.LastResults" />

@if (_projects.Count == 0 || _showNew)
{
    <h2>Новый проект</h2>
    <div class="form">
        <label>Название <input @bind="_name" placeholder="Например: Апорт · Высокая · S08" /></label>
        <label>
            Папка с отчётами XML — скопируйте путь из проводника
            <input class="wide" @bind="_folder" placeholder="\\сервер\Проекты\…\XML" />
        </label>
        <div class="actions">
            <button class="btn primary" @onclick="Create">Создать и загрузить отчёты</button>
            @if (_projects.Count > 0) { <button class="btn link" @onclick="() => { _showNew = false; _error = null; }">Отмена</button> }
        </div>
        @if (_error != null) { <p class="error">@_error</p> }
    </div>
}

<footer class="status">
    База: <span class="path">@Options.DatabaseFile</span>.
    @if (Backup.LastError != null)
    {
        <span class="error">@Backup.LastError</span>
    }
    else if (Backup.LastServerCopy.HasValue)
    {
        <span>Копия на сервере — @Fmt.Date(Backup.LastServerCopy).</span>
    }
    else
    {
        <span class="muted">Копия базы на сервер — через 2 минуты после запуска сайта, потом каждый час.</span>
    }
</footer>

@code {
    private List<ProjectRow> _projects = new();
    private string _name;
    private string _folder;
    private string _error;
    private bool _showNew;

    protected override void OnInitialized() => _projects = Store.Projects();

    private async Task ScanAll()
    {
        await Importer.ScanAsync();
        _projects = Store.Projects();
    }

    private async Task Create()
    {
        _error = null;
        if (string.IsNullOrWhiteSpace(_name)) { _error = "Укажите название проекта."; return; }
        if (string.IsNullOrWhiteSpace(_folder)) { _error = "Укажите папку с отчётами."; return; }
        var folder = _folder.Trim().Trim('"');
        if (!Directory.Exists(folder)) { _error = "Папка не найдена или недоступна: " + folder; return; }
        if (_projects.Any(p => string.Equals(p.Name, _name.Trim(), StringComparison.CurrentCultureIgnoreCase)))
        { _error = "Проект с таким названием уже есть."; return; }
        var id = Store.AddProject(_name, folder);
        _name = _folder = null;
        _showNew = false;
        await Importer.ScanAsync(id);
        Nav.NavigateTo("project/" + id);
    }
}
