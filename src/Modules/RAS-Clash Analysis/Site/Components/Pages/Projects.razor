@page "/"
@inject ClashStore Store
@inject ReportImporter Importer
@inject BackupService Backup
@inject SiteOptions Options
@inject NavigationManager Nav

<PageTitle>Проекты · RAS Clash Analysis</PageTitle>

<h1>Проекты</h1>

@* папка со всеми проектами: каждая папка внутри неё с отчётами XML становится проектом сама *@
<div class="root-folder">
    @if (_editRoot)
    {
        <div class="form">
            <label>
                Папка со всеми проектами — каждая папка внутри неё (например, «Арман Кала») станет проектом с тем же названием
                <input class="wide" @bind="_rootInput" placeholder="\\сервер\BIM\Коллизии" />
            </label>
            <div class="actions">
                <button class="btn primary" @onclick="SaveRoot">Сохранить и найти проекты</button>
                @if (!string.IsNullOrEmpty(_root)) { <button class="btn link" @onclick="() => { _editRoot = false; _rootError = null; }">Отмена</button> }
                @if (!string.IsNullOrEmpty(_root)) { <button class="btn link" @onclick="ClearRoot">Не искать проекты сами</button> }
            </div>
            @if (_rootError != null) { <p class="error">@_rootError</p> }
        </div>
    }
    else
    {
        <span class="muted">Папка со всеми проектами:</span> <span class="path">@_root</span>
        <button class="btn link small" @onclick="() => { _editRoot = true; _rootInput = _root; }">изменить</button>
    }
</div>

@if (_projects.Count == 0)
{
    <p class="muted">Проектов ещё нет. Укажите папку со всеми проектами выше или создайте проект вручную: название и папка, куда кладутся отчёты XML.</p>
}
else
{
    <table class="grid">
        <thead>
            <tr>
                <th>Проект</th>
                @if (_crits.Count == 0) { <th class="num">Активные</th> }
                @foreach (var cr in _crits) { <th class="num">Активные · @(cr == "" ? "без критичности" : cr.ToLowerInvariant())</th> }
                <th class="num">Исправлены</th><th class="num">Допущены</th><th>Последний отчёт</th><th>Папка отчётов</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in _projects)
            {
                <tr class="clickable" @onclick="@(() => Nav.NavigateTo("project/" + p.Id))">
                    <td><a href="project/@p.Id" @onclick:stopPropagation="true">@p.Name</a></td>
                    @if (_crits.Count == 0) { <td class="num"><span class="badge state-active">@p.Counts.Active</span></td> }
                    @foreach (var cr in _crits)
                    {
                        <td class="num"><span class="badge state-active">@(p.ActiveByCriticality.TryGetValue(cr, out var n) ? n : 0)</span></td>
                    }
                    <td class="num">@p.Counts.Fixed</td>
                    <td class="num">@p.Counts.Accepted</td>
                    <td>@Fmt.Date(p.LastReport)</td>
                    <td class="path">@p.Folder</td>
                </tr>
            }
        </tbody>
    </table>
}

<div class="actions">
    @if (_projects.Count > 0 && !_showNew)
    {
        <button class="btn primary" @onclick="() => _showNew = true">+ Новый проект</button>
    }
    <button class="btn" disabled="@Importer.Busy" @onclick="ScanAll">@(Importer.Busy ? "Проверяем папки…" : "Проверить папки сейчас")</button>
    <span class="muted">
        Новые отчёты сайт ищет и сам — @(Options.ScanMinutes > 0 ? $"каждые {Options.ScanMinutes} мин" : "выключено")@(Importer.LastScan.HasValue ? $"; последняя проверка — {Fmt.Date(Importer.LastScan)}" : "").
    </span>
</div>

<ImportResults Results="Importer.LastResults" />

@if (_projects.Count == 0 || _showNew)
{
    <h2>Новый проект</h2>
    <div class="form">
        <label>Название <input @bind="_name" placeholder="Например: Апорт · Высокая · S08" /></label>
        <label>
            Папка с отчётами XML — скопируйте путь из проводника
            <input class="wide" @bind="_folder" placeholder="\\сервер\Проекты\…\XML" />
        </label>
        <div class="actions">
            <button class="btn primary" @onclick="Create">Создать и загрузить отчёты</button>
            @if (_projects.Count > 0) { <button class="btn link" @onclick="() => { _showNew = false; _error = null; }">Отмена</button> }
        </div>
        @if (_error != null) { <p class="error">@_error</p> }
    </div>
}

<footer class="status">
    База: <span class="path">@Options.DatabaseFile</span>.
    @if (Backup.LastError != null)
    {
        <span class="error">@Backup.LastError</span>
    }
    else if (Backup.LastServerCopy.HasValue)
    {
        <span>Копия на сервере — @Fmt.Date(Backup.LastServerCopy).</span>
    }
    else
    {
        <span class="muted">Копия базы на сервер — через 2 минуты после запуска сайта, потом каждый час.</span>
    }
</footer>

@code {
    private List<ProjectRow> _projects = new();
    private string _name;
    private string _folder;
    private string _error;
    private bool _showNew;
    private string _root, _rootInput, _rootError;
    private bool _editRoot;
    /// <summary>Критичности, которые есть в проектах (столбцы активных); пусто — один столбец «Активные».</summary>
    private List<string> _crits = new();

    protected override void OnInitialized()
    {
        _root = Store.Setting(ReportImporter.ProjectsRootKey);
        _editRoot = string.IsNullOrEmpty(_root);
        Load();
    }

    private void Load()
    {
        _projects = Store.Projects();
        var all = _projects.SelectMany(p => p.ActiveByCriticality.Keys).Distinct().ToList();
        _crits = all.Count == 1 && all[0] == "" ? new List<string>() : all.OrderBy(ReportPath.CriticalityOrder).ToList();
    }

    private async Task SaveRoot()
    {
        _rootError = null;
        var folder = (_rootInput ?? "").Trim().Trim('"');
        if (folder.Length == 0) { _rootError = "Укажите папку."; return; }
        if (!Directory.Exists(folder)) { _rootError = "Папка не найдена или недоступна: " + folder; return; }
        Store.SetSetting(ReportImporter.ProjectsRootKey, folder);
        _root = folder;
        _editRoot = false;
        await ScanAll();
    }

    private void ClearRoot()
    {
        Store.SetSetting(ReportImporter.ProjectsRootKey, "");
        _root = "";
        _rootInput = "";
    }

    private async Task ScanAll()
    {
        await Importer.ScanAsync();
        Load();
    }

    private async Task Create()
    {
        _error = null;
        if (string.IsNullOrWhiteSpace(_name)) { _error = "Укажите название проекта."; return; }
        if (string.IsNullOrWhiteSpace(_folder)) { _error = "Укажите папку с отчётами."; return; }
        var folder = _folder.Trim().Trim('"');
        if (!Directory.Exists(folder)) { _error = "Папка не найдена или недоступна: " + folder; return; }
        if (_projects.Any(p => string.Equals(p.Name, _name.Trim(), StringComparison.CurrentCultureIgnoreCase)))
        { _error = "Проект с таким названием уже есть."; return; }
        var id = Store.AddProject(_name, folder);
        _name = _folder = null;
        _showNew = false;
        await Importer.ScanAsync(id);
        Nav.NavigateTo("project/" + id);
        Load();
    }
}
