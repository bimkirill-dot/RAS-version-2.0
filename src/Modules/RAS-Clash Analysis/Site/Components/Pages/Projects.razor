@page "/"
@inject ClashStore Store
@inject ReportImporter Importer
@inject BackupService Backup
@inject SiteOptions Options
@inject NavigationManager Nav

<PageTitle>Проекты · RAS Clash Analysis</PageTitle>

<h1>Проекты</h1>

@if (_projects.Count == 0)
{
    <p class="muted">Проектов ещё нет. Добавьте первый: укажите папку проекта, куда кладутся отчёты Navisworks.</p>
}
else
{
    <table class="grid">
        <thead>
            <tr>
                <th>Проект</th>
                @if (_crits.Count == 0) { <th class="num">Активные</th> }
                @foreach (var cr in _crits) { <th class="num">Активные · @(cr == "" ? "без критичности" : cr.ToLowerInvariant())</th> }
                <th class="num">Исправлены</th><th class="num">Допущены</th><th>Последний отчёт</th><th>Папка проекта</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in _projects)
            {
                <tr class="clickable" @onclick="@(() => Nav.NavigateTo("project/" + p.Id))">
                    <td><a href="project/@p.Id" @onclick:stopPropagation="true">@p.Name</a></td>
                    @if (_crits.Count == 0) { <td class="num"><span class="badge state-active">@p.Counts.Active</span></td> }
                    @foreach (var cr in _crits)
                    {
                        <td class="num"><span class="badge state-active">@(p.ActiveByCriticality.TryGetValue(cr, out var n) ? n : 0)</span></td>
                    }
                    <td class="num">@p.Counts.Fixed</td>
                    <td class="num">@p.Counts.Accepted</td>
                    <td>@Fmt.Date(p.LastReport)</td>
                    <td class="path">@p.Folder</td>
                </tr>
            }
        </tbody>
    </table>
}

<div class="actions">
    @if (_projects.Count > 0 && !_showNew)
    {
        <button class="btn primary" @onclick="() => _showNew = true">+ Добавить проект</button>
    }
    <button class="btn" disabled="@Importer.Busy" @onclick="ScanAll">@(Importer.Busy ? "Проверяем папки…" : "Проверить папки сейчас")</button>
    <span class="muted">
        Новые отчёты в папках проектов сайт ищет и сам — @(Options.ScanMinutes > 0 ? $"каждые {Options.ScanMinutes} мин" : "выключено")@(Importer.LastScan.HasValue ? $"; последняя проверка — {Fmt.Date(Importer.LastScan)}" : "").
    </span>
</div>

<ImportResults Results="Importer.LastResults" />

@if (_projects.Count == 0 || _showNew)
{
    <h2>Новый проект</h2>
    <div class="form">
        <label>
            Папка проекта — скопируйте путь из проводника (например, …\Коллизии\Арман Кала)
            <input class="wide" value="@_folder" @onchange="FolderChanged" placeholder="\\сервер\…\Арман Кала" />
        </label>
        <label>
            Название — как у папки; можно поменять
            <input @bind="_name" placeholder="Арман Кала" />
        </label>
        <p class="muted small">
            Внутри папки проекта сайт сам разберёт даты прогонов, критичность («Высокая…», «Средняя…»), блоки (S1, S2…) и найдёт все отчёты XML.
        </p>
        <div class="actions">
            <button class="btn primary" @onclick="Create">Добавить и загрузить отчёты</button>
            @if (_projects.Count > 0) { <button class="btn link" @onclick="() => { _showNew = false; _error = null; }">Отмена</button> }
        </div>
        @if (_error != null) { <p class="error">@_error</p> }
    </div>
}

<footer class="status">
    База: <span class="path">@Options.DatabaseFile</span>.
    @if (Backup.LastError != null)
    {
        <span class="error">@Backup.LastError</span>
    }
    else if (Backup.LastServerCopy.HasValue)
    {
        <span>Копия на сервере — @Fmt.Date(Backup.LastServerCopy).</span>
    }
    else
    {
        <span class="muted">Копия базы на сервер — через 2 минуты после запуска сайта, потом каждый час.</span>
    }
</footer>

@code {
    private List<ProjectRow> _projects = new();
    private string _name;
    private string _folder;
    /// <summary>Название, подставленное из папки: пока человек его не менял, оно следует за папкой.</summary>
    private string _autoName;
    private string _error;
    private bool _showNew;
    /// <summary>Критичности, которые есть в проектах (столбцы активных); пусто — один столбец «Активные».</summary>
    private List<string> _crits = new();

    protected override void OnInitialized() => Load();

    private void Load()
    {
        _projects = Store.Projects();
        var all = _projects.SelectMany(p => p.ActiveByCriticality.Keys).Distinct().ToList();
        _crits = all.Count == 1 && all[0] == "" ? new List<string>() : all.OrderBy(ReportPath.CriticalityOrder).ToList();
    }

    /// <summary>Папку ввели — название проекта берётся из её имени (если название ещё не меняли руками).</summary>
    private void FolderChanged(ChangeEventArgs e)
    {
        _folder = e.Value?.ToString();
        var folder = (_folder ?? "").Trim().Trim('"').TrimEnd('\\', '/');
        var fromFolder = folder.Length == 0 ? null : Path.GetFileName(folder);
        if (string.IsNullOrWhiteSpace(_name) || _name == _autoName)
        {
            _name = fromFolder;
            _autoName = fromFolder;
        }
    }

    private async Task ScanAll()
    {
        await Importer.ScanAsync();
        Load();
    }

    private async Task Create()
    {
        _error = null;
        var folder = (_folder ?? "").Trim().Trim('"').TrimEnd('\\', '/');
        if (folder.Length == 0) { _error = "Укажите папку проекта."; return; }
        if (!Directory.Exists(folder)) { _error = "Папка не найдена или недоступна: " + folder; return; }
        if (string.IsNullOrWhiteSpace(_name)) { _error = "Укажите название проекта."; return; }
        if (_projects.Any(p => string.Equals(p.Name, _name.Trim(), StringComparison.CurrentCultureIgnoreCase)))
        { _error = "Проект с таким названием уже есть."; return; }
        if (_projects.Any(p => string.Equals(p.Folder.TrimEnd('\\', '/'), folder, StringComparison.OrdinalIgnoreCase)))
        { _error = "Эта папка уже добавлена как проект."; return; }
        var id = Store.AddProject(_name, folder);
        _name = _folder = _autoName = null;
        _showNew = false;
        await Importer.ScanAsync(id);
        Nav.NavigateTo("project/" + id);
    }
}
