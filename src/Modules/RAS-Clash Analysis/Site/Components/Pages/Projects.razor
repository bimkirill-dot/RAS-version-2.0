@page "/"
@inject ClashStore Store
@inject ReportImporter Importer
@inject SiteOptions Options
@inject NavigationManager Nav

<PageTitle>Проекты · Clash Analysis</PageTitle>

<div class="page-head">
    <div>
        @* у заголовка — «+» (добавить проект) и «обновить» (проверить папки сейчас; сайт проверяет и сам) — просьба разработчика 15.10.2026 *@
        <div class="title-row">
            <h1>Проекты</h1>
            <button class="icon-btn" title="Добавить проект" aria-label="Добавить проект" @onclick="OpenNew">
                <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 3v10M3 8h10" /></svg>
            </button>
            <button class="icon-btn @(Importer.Busy ? "busy" : "")" disabled="@Importer.Busy" aria-label="Проверить папки сейчас" @onclick="ScanAll"
                    title="@(Importer.Busy ? "Проверяем папки…" : "Проверить папки сейчас. Сайт проверяет и сам — " + (Options.ScanMinutes > 0 ? $"каждые {Options.ScanMinutes} мин" : "выключено") + (Importer.LastScan.HasValue ? $"; последняя проверка — {Fmt.Date(Importer.LastScan)}" : ""))">
                <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M13.2 8a5.2 5.2 0 1 1-1.6-3.75" /><path d="M13 2.2v3.1H9.9" /></svg>
            </button>
        </div>
        <div class="muted">Коллизии из отчётов Navisworks по всем проектам компании</div>
    </div>
</div>

@if (_projects.Count == 0)
{
    <div class="empty-state">
        <p class="muted">Проектов ещё нет. Добавьте первый: папку проекта, куда кладутся отчёты Navisworks, и его блоки.</p>
        <button class="btn primary" @onclick="OpenNew">+ Добавить проект</button>
    </div>
}
else
{
    @* карточки проектов: активные, исправлены, исправлено % — для показа руководству *@
    <div class="proj-grid">
        @foreach (var p in _projects)
        {
            var pct = FixedPercent(p);
            <a class="proj-card" href="project/@p.Id">
                <div class="pc-name">@p.Name</div>
                <div class="pc-meta muted small">@(p.LastReport.HasValue ? "Последний отчёт — " + Fmt.Day(p.LastReport.Value) : "Отчётов ещё нет")</div>
                @if (p.ManualBlocks && p.Blocks == 0) { <div class="pc-warn small">⚠ Нет блоков — отчёты не загружаются</div> }
                else if (p.ManualBlocks && Importer.OutsideBlocks(p.Id).Count > 0) { <div class="pc-warn small">⚠ Есть папки вне блоков</div> }
                @* строка есть всегда (и без перемен) — чтобы цифры и полоса у всех карточек стояли на одних местах *@
                <div class="pc-run small" title="Что принёс последний прогон каждой проверки">Последний прогон:
                    @if (p.LastRun.Any) { <Delta Value="p.LastRun" /> }
                    else if (p.Runs == 0) { <span>—</span> }
                    else if (p.Runs <= 1) { <span class="d-first">первая проверка</span> }
                    else { <span>без изменений</span> }
                </div>
                <div class="pc-nums">
                    <div class="pc-num k-active"><b>@p.Counts.Active</b><span>активные</span></div>
                    <div class="pc-num k-fixed"><b>@p.Counts.Fixed</b><span>исправлены</span></div>
                </div>
                <div class="pc-progress" title="Исправлено из всех, кроме допущенных">
                    <div class="kpi-bar"><i style="width:@pct%"></i></div>
                    <span class="small muted">исправлено @pct %</span>
                </div>
            </a>
        }
    </div>
}

@if (!string.IsNullOrEmpty(Deleted))
{
    <p class="notice">
        Проект «@Deleted» удалён с сайта. Папка с его отчётами не тронута;
        копия базы перед удалением — рядом с базой (файл «clashes.db.до-удаления-…»).
    </p>
}

<ImportResults Results="Importer.LastResults" />

@* добавление проекта — своим окном (образец разработчика, 15.10.2026): слева папка и название, справа — блоки карточками *@
@if (_showNew)
{
    <div class="dialog-back">
        <div class="dialog project-dialog" role="dialog" aria-modal="true" aria-label="Добавить проект">
            <div class="pd-head">
                <h2>Добавить проект</h2>
                <button class="btn link pd-close" title="Закрыть" disabled="@_creating" @onclick="CloseNew">✕</button>
            </div>
            <div class="pd-body">
                <div class="pd-left">
                    <label class="pd-field">
                        <span>Папка проекта</span>
                        <input value="@_folder" @onchange="FolderChanged" placeholder="\\сервер\…\Арман Кала" />
                        <small class="muted">Скопируйте путь из адресной строки проводника и вставьте сюда</small>
                    </label>
                    <label class="pd-field">
                        <span>Название проекта</span>
                        <input @bind="_name" placeholder="Как у папки" />
                        <small class="muted">Подставляется из папки; можно поменять</small>
                    </label>
                    <div class="pd-note">
                        <b>Блок</b> — папка внутри папки проекта. Отчёты загружаются только из папок блоков; без блоков — не загружаются,
                        даже если блок один. Блоки можно добавить и потом, в разделе «Проект».
                    </div>
                </div>
                <div class="pd-right">
                    <BlocksForm Title="Список блоков" ProjectFolder="@_folder" Items="_blocks" Changed="() => _blocksAuto = false" />
                </div>
            </div>
            <div class="pd-foot">
                @if (_error != null) { <span class="error">@_error</span> }
                <span class="spacer"></span>
                <button class="btn" disabled="@_creating" @onclick="CloseNew">Отмена</button>
                <button class="btn primary" disabled="@_creating" @onclick="Create">@(_creating ? "Добавляем и загружаем…" : "Добавить и загрузить отчёты")</button>
            </div>
        </div>
    </div>
}


@code {
    /// <summary>Название только что удалённого проекта — для сообщения.</summary>
    [SupplyParameterFromQuery(Name = "deleted")] public string Deleted { get; set; }

    private List<ProjectRow> _projects = new();
    private string _name;
    private string _folder;
    /// <summary>Название, подставленное из папки: пока человек его не менял, оно следует за папкой.</summary>
    private string _autoName;
    private string _error;
    private bool _showNew, _creating;
    private List<BlockDraft> _blocks = new();
    /// <summary>Блоки подставлены из папки и их не трогали — при смене папки подставляются заново.</summary>
    private bool _blocksAuto = true;

    protected override void OnInitialized() => Load();

    /// <summary>Сколько исправлено из всех, кроме допущенных, — %.</summary>
    private static int FixedPercent(ProjectRow p)
    {
        var all = p.Counts.Active + p.Counts.Fixed;
        return all == 0 ? 0 : (int)Math.Round(100.0 * p.Counts.Fixed / all);
    }

    private void Load()
    {
        _projects = Store.Projects();
    }

    /// <summary>Папку ввели — название проекта берётся из её имени (если название ещё не меняли руками).</summary>
    private void FolderChanged(ChangeEventArgs e)
    {
        // путь из проводника — без кавычек («Копировать как путь») и косой черты в конце
        var folder = (e.Value?.ToString() ?? "").Trim().Trim('"').TrimEnd('\\', '/');
        _folder = folder;
        var fromFolder = folder.Length == 0 ? null : Path.GetFileName(folder);
        if (string.IsNullOrWhiteSpace(_name) || _name == _autoName)
        {
            _name = fromFolder;
            _autoName = fromFolder;
        }
        // подсказка: папки, похожие на блоки (S1, «Блок 2»), — в список; если список уже правили руками — не трогаем
        if (_blocksAuto || _blocks.Count == 0)
        {
            _blocks = BlocksForm.Suggest(folder);
            _blocksAuto = true;
        }
    }

    private void OpenNew()
    {
        _name = _folder = _autoName = _error = null;
        _blocks = new List<BlockDraft>();
        _blocksAuto = true;
        _showNew = true;
    }

    private void CloseNew()
    {
        _showNew = false;
        _error = null;
    }

    private async Task ScanAll()
    {
        await Importer.ScanAsync();
        Load();
    }

    private async Task Create()
    {
        _error = null;
        var folder = ProjectFolders.Clean(_folder);
        if (folder.Length == 0) { _error = "Укажите папку проекта."; return; }
        if (!Directory.Exists(folder)) { _error = "Папка не найдена или недоступна: " + folder; return; }
        if (string.IsNullOrWhiteSpace(_name)) { _error = "Укажите название проекта."; return; }
        if (_projects.Any(p => string.Equals(p.Name, _name.Trim(), StringComparison.CurrentCultureIgnoreCase)))
        { _error = "Проект с таким названием уже есть."; return; }
        // та же папка, папка внутри другого проекта или с проектом внутри — отчёты считались бы дважды
        var conflict = ProjectFolders.Conflict(folder, _projects.Select(p => (p.Name, p.Folder)));
        if (conflict != null) { _error = conflict; return; }
        var problem = BlocksForm.Collect(folder, _blocks, out var blocks);
        if (problem != null) { _error = problem; return; }
        _creating = true;
        try
        {
            var id = Store.AddProject(_name, folder, blocks);
            await Importer.ScanAsync(id);
            Nav.NavigateTo("project/" + id);
        }
        finally
        {
            _creating = false;
        }
    }
}
