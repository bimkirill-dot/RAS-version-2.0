@page "/clash/{Id:long}"
@inject ClashStore Store

<PageTitle>@(_title ?? "Коллизия") · RAS Clash Analysis</PageTitle>

@if (_projectId == null)
{
    <h1>Коллизия не найдена</h1>
    <p><a href="/">К проектам</a></p>
    return;
}

<nav class="crumbs"><a href="/">Проекты</a> › <a href="project/@_projectId">@_projectName</a> ›</nav>
<p><a href="project/@_projectId">← К списку коллизий</a></p>

<ClashPanel ClashId="Id" />

@code {
    [Parameter] public long Id { get; set; }

    private long? _projectId;
    private string _projectName;
    private string _title;

    protected override void OnParametersSet()
    {
        var card = Store.Card(Id);
        _projectId = card?.ProjectId;
        _projectName = card?.ProjectName;
        _title = card?.Last?.Name;
    }
}
