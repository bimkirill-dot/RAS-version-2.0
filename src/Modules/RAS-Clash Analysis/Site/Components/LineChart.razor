@* Линии по прогонам для сводки проекта (например, «% исправлено» по категориям) — SVG без сторонних библиотек *@
<div class="chart-wrap">
    <svg class="chart" viewBox="0 0 @W @Height" role="img" aria-label="@Title">
        @for (var t = 0; t <= Ticks; t++)
        {
            var v = Max / Ticks * t;
            <line class="grid-line" x1="@Left" x2="@(W - Right)" y1="@F(Y(v))" y2="@F(Y(v))" />
            @Txt("axis", Left - 6, Y(v) + 4, "end", F(v) + Unit)
        }
        @for (var i = 0; i < Labels.Count; i++)
        {
            @* дат много — подписи через одну (две…), последняя — всегда *@
            if (i % LabelStep == 0 || i == Labels.Count - 1) { @Txt("axis", X(i), Height - 8, "middle", Labels[i]) }
        }
        @for (var s = 0; s < Series.Count; s++)
        {
            var (name, color, values) = Series[s];
            var index = s;
            var points = values.Select((v, i) => (v, i)).Where(p => p.v.HasValue).Select(p => $"{F(X(p.i))},{F(Y(p.v.Value))}").ToList();
            <g class="@SeriesClass(index)" @onmouseover="() => Hover(index)" @onmouseout="() => Hover(-1)">
                <title>@name: @string.Join(" → ", values.Select((v, i) => v.HasValue ? $"{Labels[i]} {F(v.Value)}{Unit}" : null).Where(s => s != null))</title>
                @if (points.Count > 1) { <polyline points="@string.Join(" ", points)" style="stroke: var(@color)" class="line" /> }
                @foreach (var p in values.Select((v, i) => (v, i)).Where(p => p.v.HasValue))
                {
                    <circle cx="@F(X(p.i))" cy="@F(Y(p.v.Value))" r="3.5" style="stroke: var(@color)" class="dot">@if (PointTitle != null) { <title>@PointTitle(index, p.i)</title> }</circle>
                }
            </g>
        }
    </svg>
    <div class="chart-legend">
        @for (var s = 0; s < Series.Count; s++)
        {
            var index = s;
            <span class="@SeriesClass(index)" @onmouseover="() => Hover(index)" @onmouseout="() => Hover(-1)"><i style="background: var(@Series[index].Color)"></i>@Series[index].Name</span>
        }
    </div>
</div>

@code {
    [Parameter] public List<string> Labels { get; set; } = new();
    /// <summary>Линии: название, переменная цвета, значение на каждую подпись (null — нет).</summary>
    [Parameter] public List<(string Name, string Color, List<double?> Values)> Series { get; set; } = new();
    [Parameter] public double Max { get; set; } = 100;
    [Parameter] public string Unit { get; set; } = "%";
    [Parameter] public string Title { get; set; }
    [Parameter] public int Height { get; set; } = 220;
    /// <summary>Подсказка точки (линия, номер подписи); нет — у точки подсказка линии.</summary>
    [Parameter] public Func<int, int, string> PointTitle { get; set; }

    private const int W = 900, Left = 46, Right = 24, Top = 14, Bottom = 30, Ticks = 4;

    /// <summary>Линия под мышью (в легенде или на графике) — ярче, остальные бледнее; −1 — никакой.</summary>
    private int _hover = -1;
    private void Hover(int index) => _hover = index;
    private string SeriesClass(int index) => _hover < 0 || Series.Count < 2 ? "" : index == _hover ? "hi" : "dim";
    /// <summary>Через сколько дат подпись: не теснее ~44 точек рисунка.</summary>
    private int LabelStep => Math.Max(1, (int)Math.Ceiling(Labels.Count * 44.0 / (W - Left - Right - 40)));

    private double X(int i) => Labels.Count <= 1 ? (Left + W - Right) / 2.0 : Left + 20 + (W - Left - Right - 40) * i / (double)(Labels.Count - 1);
    private double Y(double v) => Top + (Height - Bottom - Top) * (1 - v / Max);
    private static string F(double v) => v.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);

    /// <summary>Подпись в SVG (тег text в разметке Blazor внутри циклов писать нельзя).</summary>
    private static MarkupString Txt(string css, double x, double y, string anchor, string content, string transform = null) =>
        new MarkupString($"<text class=\"{css}\" " + (transform != null ? $"transform=\"{transform}\"" : $"x=\"{F(x)}\" y=\"{F(y)}\"")
                         + $" text-anchor=\"{anchor}\">{System.Net.WebUtility.HtmlEncode(content ?? "")}</text>");
}
