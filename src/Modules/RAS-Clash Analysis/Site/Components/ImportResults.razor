@* Итог последней проверки папок: что загружено, что пропущено и почему *@

@if (Results != null && Results.Count > 0)
{
    <details class="import" open="@Results.Any(r => r.Error)">
        <summary>
            Последняя проверка: загружено отчётов — @Results.Count(r => !r.Error && !r.Deleted)@(Results.Any(r => r.Deleted) ? $", удалено (файлов нет в папке) — {Results.Count(r => r.Deleted)}" : "")@(Results.Any(r => r.Error) ? $", не загружено или не удалено — {Results.Count(r => r.Error)}" : "")
        </summary>
        <ul>
            @foreach (var r in Results)
            {
                <li class="@(r.Error ? "error" : "")">
                    <b>@r.ProjectName</b> · <span class="path">@Path.GetFileName(r.File)</span> —
                    @if (r.Error || r.Deleted)
                    {
                        @r.Message
                    }
                    else
                    {
                        @($"новых {r.New}, снова в отчёте {r.Again}, вернулись после исправления {r.Reappeared}, исправлены {r.Fixed}")
                        if (r.Warning != null) { <div class="warn">⚠ @r.Warning</div> }
                    }
                </li>
            }
        </ul>
    </details>
}

@code {
    [Parameter] public IReadOnlyList<ImportResult> Results { get; set; }
}
