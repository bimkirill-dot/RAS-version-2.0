@* Сгруппированные столбики — у каждой подписи несколько рядов рядом (как «Проверки» на «Обзоре» у автора статьи: всего,
   активные, исправленные). SVG без сторонних библиотек; подписи поворачиваются, когда их много; Clicked — номер подписи. *@
<div class="chart-wrap">
    <svg class="chart" viewBox="0 0 @Width @Height" role="img" aria-label="@Title">
        @for (var t = 0; t <= Ticks; t++)
        {
            var v = Max / Ticks * t;
            var y = Y(v);
            <line class="grid-line" x1="@Left" x2="@(Width - Right)" y1="@F(y)" y2="@F(y)" />
            @Txt("axis", Left - 6, y + 4, "end", Fmt0(v))
        }
        @for (var i = 0; i < Labels.Count; i++)
        {
            var index = i;
            var x0 = Left + Slot * i + (Slot - GroupWidth) / 2;
            <g class="@(Clicked.HasDelegate ? "bar clickable" : "bar")" @onclick="() => Click(index)">
                <title>@Labels[i]: @string.Join(", ", Series.Select(s => $"{s.Name} — {Fmt0(s.Values[index])}"))</title>
                <rect class="bar-hit" x="@F(Left + Slot * i)" y="@Top" width="@F(Slot)" height="@F(Height - Bottom - Top)" />
                @for (var s = 0; s < Series.Count; s++)
                {
                    var value = Series[s].Values[i];
                    var h = Y(0) - Y(value);
                    <rect x="@F(x0 + s * (BarWidth + Gap))" y="@F(Y(0) - h)" width="@F(BarWidth)" height="@F(Math.Max(h, value > 0 ? 1 : 0))" rx="1.5" style="fill: var(@Series[s].Color)" />
                }
                @if (Rotate) { @Txt("axis", 0, 0, "end", Cut(Labels[i]), $"translate({F(Left + Slot * i + Slot / 2)}, {F(Height - Bottom + 10)}) rotate(-40)") }
                else { @Txt("axis", Left + Slot * i + Slot / 2, Height - Bottom + 16, "middle", Cut(Labels[i])) }
            </g>
        }
    </svg>
    <div class="chart-legend">
        @foreach (var (name, color, _) in Series) { <span><i style="background: var(@color)"></i>@name</span> }
    </div>
</div>

@code {
    [Parameter] public List<string> Labels { get; set; } = new();
    /// <summary>Ряды: название, переменная цвета, значение на каждую подпись.</summary>
    [Parameter] public List<(string Name, string Color, List<double> Values)> Series { get; set; } = new();
    [Parameter] public string Title { get; set; }
    [Parameter] public int Height { get; set; } = 320;
    [Parameter] public int Width { get; set; } = 900;
    [Parameter] public EventCallback<int> Clicked { get; set; }

    private const int Right = 12, Top = 16, Ticks = 4, Gap = 1;
    private bool Rotate => Labels.Count > 8;
    /// <summary>Слева — место под шкалу, а при повёрнутых подписях — ещё и под подпись первого столбика.</summary>
    private int Left => Rotate ? 120 : 46;
    private int Bottom => Rotate ? 120 : 30;
    private double Slot => Labels.Count == 0 ? 1 : (Width - Left - Right) / (double)Labels.Count;
    private double GroupWidth => Math.Min(Slot * 0.8, 26.0 * Math.Max(Series.Count, 1));
    private double BarWidth => Series.Count == 0 ? 1 : (GroupWidth - Gap * (Series.Count - 1)) / Series.Count;

    /// <summary>Верх шкалы — «круглое» число: 1, 2, 2.5, 5 × 10ⁿ на деление.</summary>
    private double Max
    {
        get
        {
            var top = Series.SelectMany(s => s.Values).DefaultIfEmpty(0).Max();
            if (top <= 0) return Ticks;
            var raw = top / Ticks;
            var mag = Math.Pow(10, Math.Floor(Math.Log10(raw)));
            var step = new[] { 1, 2, 2.5, 5, 10 }.Select(k => k * mag).First(s => s >= raw);
            return Math.Max(step * Ticks, Ticks);
        }
    }

    private double Y(double v) => Top + (Height - Bottom - Top) * (1 - v / Max);
    private static string F(double v) => v.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);
    private static string Fmt0(double v) => Math.Round(v).ToString("#,0", System.Globalization.CultureInfo.GetCultureInfo("ru-RU"));
    private string Cut(string s) => s == null ? "" : s.Length > 24 ? s[..23] + "…" : s;

    /// <summary>Подпись в SVG (тег text в разметке Blazor внутри циклов писать нельзя).</summary>
    private static MarkupString Txt(string css, double x, double y, string anchor, string content, string transform = null) =>
        new MarkupString($"<text class=\"{css}\" " + (transform != null ? $"transform=\"{transform}\"" : $"x=\"{F(x)}\" y=\"{F(y)}\"")
                         + $" text-anchor=\"{anchor}\">{System.Net.WebUtility.HtmlEncode(content ?? "")}</text>");

    private Task Click(int index) => Clicked.HasDelegate ? Clicked.InvokeAsync(index) : Task.CompletedTask;
}
