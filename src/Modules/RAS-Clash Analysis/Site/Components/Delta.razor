@* Что принёс прогон: «+3 новых · 2 исправлено · ↺ 1 вернулось» — нули не показываются (DECISIONS.md, «Что принёс прогон — везде»).
   Цвета — как у строки прогона над списком коллизий. *@
@if (Value != null && Value.Any)
{
    <span class="delta">
        @if (Value.New > 0) { <span class="d-new">+@Value.New @Fmt.Plural(Value.New, "новая", "новые", "новых").Split(' ')[1]</span> }
        @if (Value.Fixed > 0) { <span class="d-fixed">@Fmt.Plural(Value.Fixed, "исправлена", "исправлены", "исправлено")</span> }
        @if (Value.Returned > 0) { <span class="d-returned">↺ @Fmt.Plural(Value.Returned, "вернулась", "вернулись", "вернулось")</span> }
        @if (Value.NewTests.Count > 0)
        {
            <span class="d-tests" title="Впервые в прогоне: @string.Join("; ", Value.NewTests). Их коллизии — активные, но не «новые»: их просто впервые проверили.">+@Fmt.Plural(Value.NewTests.Count, "проверка", "проверки", "проверок") (@Fmt.Plural(Value.NewTestClashes, "коллизия", "коллизии", "коллизий"))</span>
        }
        @if (Value.DroppedTests.Count > 0)
        {
            <span class="d-dropped" title="Были в прошлом прогоне, в этом нет: @string.Join("; ", Value.DroppedTests). Их коллизии не меняются.">−@Fmt.Plural(Value.DroppedTests.Count, "проверка", "проверки", "проверок")</span>
        }
    </span>
}
else if (Value != null && FirstRun)
{
    <span class="delta"><span class="d-first" title="Раньше отчётов по этой проверке не было — все её коллизии исходные, не «новые»">первая проверка</span></span>
}
else if (Value != null && Unchanged)
{
    <span class="delta"><span class="d-same" title="Прогон ничего не изменил: новых, исправленных и вернувшихся нет">без изменений</span></span>
}

@code {
    [Parameter] public RunDelta Value { get; set; }
    /// <summary>Первый прогон проверки — «первая проверка» вместо пустого места.</summary>
    [Parameter] public bool FirstRun { get; set; }
    /// <summary>Не первый прогон и ничего не изменилось — «без изменений».</summary>
    [Parameter] public bool Unchanged { get; set; }
}
