@* Элемент коллизии в списке: категория · тип, ниже — модель и номер; длинное обрезается, целиком — в подсказке *@

@if (E == null)
{
    <span class="muted">—</span>
}
else
{
    <div class="el cut" title="@Fmt.Element(E)">@Fmt.Element(E)</div>
    <div class="el-sub cut" title="@Fmt.Model(E.ModelFile)">@(E.ElementId?.ToString() ?? "без номера") · @Fmt.Model(E.ModelFile)</div>
}

@code {
    [Parameter] public ElementView E { get; set; }
}
