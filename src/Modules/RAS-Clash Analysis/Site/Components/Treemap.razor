@* «Прямоугольники» (treemap): площадь — число, как «Категория / Семейство» у автора статьи. Раскладка — squarified (прямоугольники
   ближе к квадрату); подпись — если помещается, полностью — в подсказке; Clicked — номер элемента. SVG без сторонних библиотек. *@
<div class="chart-wrap">
    <svg class="chart treemap" viewBox="0 0 @Width @Height" role="img" aria-label="@Title">
        @for (var i = 0; i < _rects.Count; i++)
        {
            var index = i;
            var (item, x, y, w, h) = _rects[i];
            <g class="@(Clicked.HasDelegate ? "tm-cell clickable" : "tm-cell")" @onclick="() => Click(index)">
                <title>@item.Label: @item.Value</title>
                <rect x="@F(x + 1)" y="@F(y + 1)" width="@F(Math.Max(w - 2, 0))" height="@F(Math.Max(h - 2, 0))" rx="3" style="fill: var(@item.Color)" />
                @if (w > 46 && h > 22)
                {
                    @Txt(x + 7, y + 17, Fit(item.Label, w - 12), "tm-label")
                    @if (h > 40) { @Txt(x + 7, y + 33, item.Value.ToString(), "tm-value") }
                }
            </g>
        }
    </svg>
</div>

@code {
    public sealed class Item
    {
        public string Label;
        public int Value;
        /// <summary>Переменная цвета («--cat-blue»).</summary>
        public string Color;
    }

    [Parameter] public List<Item> Items { get; set; } = new();
    [Parameter] public string Title { get; set; }
    [Parameter] public int Width { get; set; } = 900;
    [Parameter] public int Height { get; set; } = 320;
    [Parameter] public EventCallback<int> Clicked { get; set; }

    private List<(Item Item, double X, double Y, double W, double H)> _rects = new();

    protected override void OnParametersSet() => _rects = Layout(Items.Where(i => i.Value > 0).OrderByDescending(i => i.Value).ToList(), 0, 0, Width, Height);

    /// <summary>Squarified: в полосу вдоль короткой стороны берутся элементы, пока худшее соотношение сторон не ухудшается.</summary>
    private static List<(Item, double, double, double, double)> Layout(List<Item> items, double x, double y, double w, double h)
    {
        var result = new List<(Item, double, double, double, double)>();
        var total = items.Sum(i => (double)i.Value);
        if (total <= 0) return result;
        var scale = w * h / total;
        var rest = items.Select(i => (Item: i, Area: i.Value * scale)).ToList();
        while (rest.Count > 0)
        {
            var side = Math.Min(w, h);
            var row = new List<(Item Item, double Area)> { rest[0] };
            var k = 1;
            while (k < rest.Count && Worst(row.Append(rest[k]).Select(r => r.Area).ToList(), side) <= Worst(row.Select(r => r.Area).ToList(), side))
                row.Add(rest[k++]);
            rest.RemoveRange(0, row.Count);
            var sum = row.Sum(r => r.Area);
            if (w >= h)
            {
                // столбец слева
                var cw = sum / h;
                var cy = y;
                foreach (var (item, area) in row) { var ch = area / cw; result.Add((item, x, cy, cw, ch)); cy += ch; }
                x += cw; w -= cw;
            }
            else
            {
                // полоса сверху
                var rh = sum / w;
                var cx = x;
                foreach (var (item, area) in row) { var cw = area / rh; result.Add((item, cx, y, cw, rh)); cx += cw; }
                y += rh; h -= rh;
            }
        }
        return result;
    }

    private static double Worst(List<double> areas, double side)
    {
        var sum = areas.Sum();
        if (sum <= 0 || side <= 0) return double.MaxValue;
        var max = areas.Max();
        var min = areas.Min();
        var s2 = side * side;
        return Math.Max(s2 * max / (sum * sum), sum * sum / (s2 * min));
    }

    /// <summary>Подпись по ширине прямоугольника (примерно 7 точек на знак).</summary>
    private static string Fit(string s, double width)
    {
        var n = (int)(width / 7);
        return s == null ? "" : s.Length <= n ? s : n <= 1 ? "" : s[..(n - 1)] + "…";
    }

    private static string F(double v) => v.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);

    private static MarkupString Txt(double x, double y, string content, string css) =>
        new MarkupString($"<text class=\"{css}\" x=\"{F(x)}\" y=\"{F(y)}\">{System.Net.WebUtility.HtmlEncode(content ?? "")}</text>");

    private Task Click(int index) => Clicked.HasDelegate ? Clicked.InvokeAsync(index) : Task.CompletedTask;
}
