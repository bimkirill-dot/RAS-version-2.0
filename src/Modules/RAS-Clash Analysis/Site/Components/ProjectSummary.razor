    // ───── сравнение ─────

    private void Compare()
    {
        if (_cmpA == null || _cmpB == null) return;
        _cmpError = string.CompareOrdinal(_cmpA, _cmpB) >= 0 ? "Дата «с» должна быть раньше даты «по»." : null;
        if (_cmpError != null) return;
        var from = DateTime.Parse(_cmpA);
        var to = DateTime.Parse(_cmpB);
        _cmpDays = _days.Count(d => d >= from && d <= to);
        _cmpClickable = _days.IndexOf(to) == _days.IndexOf(from) + 1;
        _cmpChange = _history.Change(from, to, _filter);
        _cmpBridge = Bridge(_cmpChange, _cmpClickable, out _cmpKinds);
        var typeOf = _rows.ToDictionary(r => r.Id, r => r.Type);
        Dictionary<string, int> ActiveByType(string day) => _history.StatesAt(DateTime.Parse(day), _filter)
            .Where(x => x.Value == ClashState.Active && typeOf.ContainsKey(x.Key)).GroupBy(x => typeOf[x.Key]).ToDictionary(g => g.Key, g => g.Count());
        var a = ActiveByType(_cmpA);
        var b = ActiveByType(_cmpB);
        _cmp = a.Keys.Union(b.Keys).Select(t => (t, a.GetValueOrDefault(t), b.GetValueOrDefault(t)))
            .OrderBy(x => x.Item3 - x.Item2).ThenBy(x => x.t, StringComparer.CurrentCultureIgnoreCase).ToList();
        _cmpTotal = b.Values.Sum() - a.Values.Sum();
        // что именно изменилось: пришли и ушли — по коллизиям
        _changed = new();
        foreach (var id in _cmpChange.Entered.Keys.Union(_cmpChange.Left.Keys))
        {
            if (!_byId.TryGetValue(id, out var row)) continue;
            _cmpChange.Entered.TryGetValue(id, out var e);
            _cmpChange.Left.TryGetValue(id, out var l);
            var what = string.Join(" → ", new[] { EnteredTitle(e), LeftTitle(l) }.Where(x => x != null));
            var css = l == RunChange.FixedKind || l == RunChange.FixedManualKind ? "run-fixed" : e == RunChange.ReturnedKind ? "run-returned" : l == null ? "run-new" : "";
            _changed.Add((row, what, css));
        }
        _changed = _changed.OrderBy(x => x.Css == "run-new" ? 0 : x.Css == "run-returned" ? 1 : x.Css == "" ? 2 : 3)
            .ThenBy(x => x.Row.Type, StringComparer.CurrentCultureIgnoreCase).ToList();
        _changedShown = 50;
    }

    private static string EnteredTitle(string kind) => kind switch
    {
        RunChange.NewKind => "новая", RunChange.NewTestsKind => "в новой проверке", RunChange.ReturnedKind => "вернулась",
        RunChange.UnacceptedKind => "снят допуск", _ => null,
    };

    private static string LeftTitle(string kind) => kind switch
    {
        RunChange.FixedKind => "исправлена", RunChange.FixedManualKind => "отмечена исправленной", RunChange.AcceptedKind => "допущена",
        RunChange.GoneKind => "нет данных", _ => null,
    };

    /// <summary>
    /// Шаги моста: активные на первую дату, что пришло и ушло, активные на вторую; итоги подписаны датами (разработчик, 19.10.2026:
    /// «не надо “Было”, “Стало”, “сейчас” — просто даты»). Нулевые изменения не показываются; clickable — шаги ведут к списку.
    /// </summary>
    private List<WaterfallChart.Step> Bridge(RunChange c, bool clickable, out List<string> kinds)
    {
        var steps = new List<WaterfallChart.Step>();
        var list = new List<string>();
        void Add(string label, string sub, bool total, double value, string color, string kind)
        {
            if (!total && value == 0) return;
            var press = kind != null && clickable;
            steps.Add(new WaterfallChart.Step { Label = label, Sub = sub, Total = total, Value = value, Color = color, Clickable = press });
            list.Add(press ? kind : null);
        }
        Add(Fmt.Day(c.Before), null, true, c.Was, "--accepted", null);
        Add("Новые", null, false, c.New, "--active", "new");
        Add("Новые", "проверки", false, c.NewTests, "--cat-violet", "tests");
        Add("Вернулись", null, false, c.Returned, "--cat-orange", "returned");
        Add("Сняли", "допуск", false, c.Unaccepted, "--cat-orange", null);
        Add("Исправлены", "по отчёту", false, -c.Fixed, "--fixed", "fixed");
        Add("Отмечены", "на сайте", false, -c.FixedManual, "--fixed", null);
        Add("Допущены", null, false, -c.Accepted, "--accepted", null);
        Add("Нет", "данных", false, -c.Gone, "--accepted", null);
        Add(Fmt.Day(c.Day), null, true, c.Now, "--active", null);
        kinds = list;
        return steps;
    }

    // ───── Excel (CSV: разделитель «;», UTF-8 с BOM — как у списка коллизий) ─────

    private static string Csv(IEnumerable<string> header, IEnumerable<IEnumerable<string>> rows)
    {
        static string Q(string v) => "\"" + (v ?? "").Replace("\"", "\"\"") + "\"";
        var sb = new System.Text.StringBuilder();
        sb.AppendLine(string.Join(";", header.Select(Q)));
        foreach (var r in rows) sb.AppendLine(string.Join(";", r.Select(Q)));
        return sb.ToString();
    }

    private Task Download(string what, string text) =>
        JS.InvokeVoidAsync("ras.download", $"{what} — {DateTime.Now:yyyy-MM-dd}.csv", text).AsTask();

    private static IEnumerable<string[]> GroupRows(IEnumerable<Group> groups) =>
        groups.Select(g => new[] { g.Title, g.Total.ToString(), g.Active.ToString(), g.Fixed.ToString(), g.Accepted.ToString(), g.Percent.ToString() });

    private Task ExportDashboard()
    {
        var kpis = new List<string[]>
        {
            new[] { "Дата", Fmt.Day(DateTime.Parse(_dashDate)) }, new[] { "Всего коллизий", _dash.Total.ToString() }, new[] { "Активные", _dash.Active.ToString() },
            new[] { "Исправленные", _dash.Fixed.ToString() }, new[] { "Допущенные", _dash.Accepted.ToString() }, new[] { "Прогресс, %", _dash.Percent.ToString() },
        };
        var text = Csv(new[] { "Показатель", "Значение" }, kpis) + Environment.NewLine
                   + (_dashSubs.Count == 0
                       ? Csv(new[] { LevelHead, "Всего", "Активные", "Исправлены", "Допущены", "Исправлено, %" }, GroupRows(_dashGroups))
                       // с подкатегориями: строка категории (подкатегория пустая), под ней — её подкатегории
                       : Csv(new[] { LevelHead, "Подкатегория", "Всего", "Активные", "Исправлены", "Допущены", "Исправлено, %" },
                             _dashGroups.SelectMany(g => GroupRows(new[] { g }).Select(r => r.Take(1).Append("").Concat(r.Skip(1)).ToArray())
                                 .Concat(_dashSubs.TryGetValue(g.Key, out var subs)
                                     ? GroupRows(subs).Select(r => new[] { g.Title }.Concat(r).ToArray())
                                     : Enumerable.Empty<string[]>()))));
        return Download("Дашборд", text);
    }

    private Task ExportAnalytics() => CurrentTab switch
    {
        "blocks" => Download("По блокам", Csv(new[] { "Блок", "Всего", "Активные", "Исправлены", "Допущены", "Исправлено, %" }, GroupRows(_blocks))),
        "dynamics" => Download("Динамика", Csv(new[] { LevelHead }.Concat(_days.Select(d => Fmt.Day(d) + ", %")),
            _progressLines.Select(l => new[] { l.Item1 }.Concat(l.Item3.Select(v => v?.ToString() ?? "")).ToArray()))),
        "recur" => Download("Рекуррентность", Csv(new[] { "Блок", "Проверка", "Элемент 1", "Номер 1", "Элемент 2", "Номер 2", "Повторы", "Вернулась", "Первый", "Последний", "Статус" },
            _recur.Select(x => new[] { x.Block, x.Type, Fmt.Element(x.A), x.A?.ElementId?.ToString(), Fmt.Element(x.B), x.B?.ElementId?.ToString(), x.Repeats.ToString(), x.ReturnCount.ToString(), Fmt.Day(x.FirstSeen), Fmt.Day(x.LastSeen), Fmt.State(x.State) }))),
        "quality" => Download("Качество данных", Csv(new[] { "Замечание", "Что сделать" }, _quality.Select(q => new[] { q.Text, q.Hint }))),
        _ => Download("Проверки", Csv(new[] { "Проверка", "Категория", "Всего", "Активные", "Исправлены", "Допущены", "Исправлено, %" },
            Sorted(_checks).Select(t => new[] { t.Title, CategoryText(t.Key), t.Total.ToString(), t.Active.ToString(), t.Fixed.ToString(), t.Accepted.ToString(), t.Percent.ToString() }))),
    };

    private Task ExportCompare()
    {
        var a = Fmt.Day(DateTime.Parse(_cmpA));
        var b = Fmt.Day(DateTime.Parse(_cmpB));
        var text = Csv(new[] { "Проверка", a, b, "Δ" }, _cmp.Select(x => new[] { x.Type, x.A.ToString(), x.B.ToString(), (x.B - x.A).ToString() }))
                   + Environment.NewLine
                   + Csv(new[] { "Что", "Блок", "Проверка", "Элемент 1", "Номер 1", "Элемент 2", "Номер 2", "Уровень", "Статус сейчас" },
                       _changed.Select(x => new[] { x.What, x.Row.Block, x.Row.Type, Fmt.Element(x.Row.A), x.Row.A?.ElementId?.ToString(), Fmt.Element(x.Row.B), x.Row.B?.ElementId?.ToString(), LevelOf(x.Row), Fmt.State(x.Row.State) }));
        return Download($"Сравнение отчётов {a} — {b}", text);
    }

    private string CategoryText(string type)
    {
        var name = (Tests ?? new()).FirstOrDefault(t => t.Type == type)?.Name ?? type;
        return string.Join(" › ", new[] { CategoryOf(name), SubOf(name) }.Where(x => x != ""));
    }

