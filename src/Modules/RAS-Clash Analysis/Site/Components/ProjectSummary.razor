    };
    private string LevelDative => _by switch
    {
        By.Category => "категориям", By.Sub => $"подкатегориям «{Category}»", By.Type => "типам проверок", _ => "блокам",
    };
    private string LevelHead => _by switch { By.Category => "Категория", By.Sub => "Подкатегория", By.Type => "Тип проверки", _ => "Блок" };

    /// <summary>Заголовок столбца: тип проверки — двумя строками, до «/» и после (различаются обычно концом названия).</summary>
    private RenderFragment ColHead(string key) => __builder =>
    {
        var title = GroupTitle(key);
        var cut = _by == By.Type ? title.IndexOf('/') : -1;
        if (cut < 0) { <span class="line">@Dot(GroupColor(key))@title</span> }
        else
        {
            <span class="line">@Dot(GroupColor(key))@title[..cut]</span>
            <span class="line">/ @title[(cut + 1)..]</span>
        }
    };

    private int Cell(string block, string col) => _cells.TryGetValue((block, _by == By.Block ? null : col), out var n) ? n : 0;

    /// <summary>Тепловая окраска клетки: чем больше — тем насыщеннее.</summary>
    private static string HeatOf(int n, int max) => n == 0 || max == 0 ? null : $"background: color-mix(in srgb, var(--active) {Math.Round(12 + 58.0 * n / max)}%, transparent)";

    /// <summary>Оси и уровень: «Ж-7 · 3 Этаж».</summary>
    private static string PlaceOf(ClashRow x) =>
        string.Join(" · ", new[] { x.GridLocation, LevelOf(x) }.Where(p => !string.IsNullOrWhiteSpace(p)));

    private static string ElementsTitle(ClashRow x) =>
        $"{Fmt.Element(x.A)} (ID {x.A?.ElementId}) × {Fmt.Element(x.B)} (ID {x.B?.ElementId})" + (string.IsNullOrEmpty(x.LastComment) ? "" : " · " + x.LastComment);

    private static string LevelOf(ClashRow x)
    {
        var a = x.A?.Level;
        var b = x.B?.Level;
        return string.IsNullOrEmpty(a) ? b ?? "" : string.IsNullOrEmpty(b) || ClashRules.LevelKey(a) == ClashRules.LevelKey(b) ? a : a + " / " + b;
    }

    private IEnumerable<Group> SortedTests
    {
        get
        {
            Func<Group, IComparable> key = _sortKey switch
            {
                "name" => g => g.Title, "total" => g => g.Total, "fixed" => g => g.Fixed, "accepted" => g => g.Accepted, "percent" => g => g.Percent, _ => g => g.Active,
            };
            return _sortDesc ? _tests.OrderByDescending(key) : _tests.OrderBy(key);
        }
    }

    private RenderFragment SortTh(string key, string title, string css) => __builder =>
    {
        var on = _sortKey == key;
        <th class="sortable @css @(on ? "sorted" : "")" @onclick="() => SortBy(key)">@title @(on ? (_sortDesc ? "▼" : "▲") : "")</th>
    };

    private void SortBy(string key)
    {
        if (_sortKey == key) _sortDesc = !_sortDesc;
        else { _sortKey = key; _sortDesc = key != "name"; }
    }

