    private string CategoryText(string type)
    {
        var name = (Tests ?? new()).FirstOrDefault(t => t.Type == type)?.Name ?? type;
        return string.Join(" › ", new[] { CategoryOf(name), SubOf(name) }.Where(x => x != ""));
    }

