@inject ClashStore Store
@inject IJSRuntime JS

@* Сводка проекта (DECISIONS.md модуля, «Сводка проекта», четвёртая волна 20.10.2026: «как у автора, но лучше»). Три страницы
   (подразделы «Сводки» на боковой панели): «Дашборд» — главное в первом экране на выбранную дату: крупные плитки с изменением,
   мелкие плитки, тренд, проверки; «Аналитика» — вкладки: обзор, по блокам, по моделям, по типам, по уровням, рекуррентность,
   качество данных, прогресс; «Сравнение отчётов» — две даты. Действуют отборы боковой панели (блок, тип проверки / категория).
   Деление — уровнем ниже выбранного: весь проект — по категориям, выбрана категория — по её подкатегориям, выбрана подкатегория
   (или у категории их нет) — по типам проверок; категорий нет — по блокам. Состояние на дату — по отчётам и журналу статусов
   сайта (Logic.RunHistory). Почти всё нажимается — к коллизиям; на каждой странице — Excel. *@
<div class="summary">
    @if (_days.Count == 0)
    {
        <p class="muted">@((Tests ?? new()).Count == 0 && (Rows ?? new()).Count == 0 && Category != null
            ? "В выбранной категории нет проверок в этом проекте — сводка пуста."
            : "Отчётов ещё нет — сводка появится после первой выгрузки.")</p>
    }
    else if (Page == "analytics")
    {
        <div class="sum-bar">
            <nav class="ana-tabs" aria-label="Аналитика">
                @foreach (var (key, title) in Tabs)
                {
                    var tab = key;
                    <button class="@(Tab == tab ? "on" : "")" @onclick="() => TabChanged.InvokeAsync(tab)">@title</button>
                }
            </nav>
            <button class="btn small no-print" @onclick="ExportAnalytics" title="Таблица этой вкладки — файлом для Excel">Excel</button>
        </div>

        @if (Tab == "blocks")
        {
            <section class="sum-block">
                <h3>Где больше всего активных <span class="muted small">— блоки × @(_by == By.Block ? "всего" : LevelName); нажать — коллизии</span></h3>
                @Matrix()
            </section>
            <section class="sum-block">
                <h3>Блоки</h3>
                @GroupTable(_blocks, "Блок", DrillBlock)
            </section>
        }
        else if (Tab == "models")
        {
            <section class="sum-block">
                <h3>Матрица моделей <span class="muted small">— активные коллизии между моделями@(_modelKeys.Count < _models.Count ? $" (первые {_modelKeys.Count} по числу активных)" : ""); нажать — коллизии модели</span></h3>
                <div class="matrix-wrap">
                    <table class="matrix model-matrix">
                        <thead>
                            <tr><th></th>@foreach (var m in _modelKeys) { <th class="col vert" title="@m"><span>@ModelTitle(m)</span></th> }</tr>
                        </thead>
                        <tbody>
                            @foreach (var a in _modelKeys)
                            {
                                var model = a;
                                <tr>
                                    <th title="@a">@ModelTitle(a)</th>
                                    @foreach (var b in _modelKeys)
                                    {
                                        var n = _pairs.TryGetValue(PairKey(a, b), out var v) ? v : 0;
                                        <td class="cell @(n == 0 ? "zero" : "")" style="@HeatOf(n, _pairMax)" title="@ModelTitle(a) × @ModelTitle(b): @n" @onclick="() => DrillModel(model)">@(n == 0 ? "" : n.ToString())</td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
            <section class="sum-block">
                <h3>Модели <span class="muted small">— коллизия считается у обеих своих моделей; новые и исправленные — с @Fmt.Day(_days[Math.Max(_days.Count - 2, 0)])</span></h3>
                <table class="grid sum-table models-table">
                    <thead><tr><th>Модель</th><th class="num">Всего</th><th class="num">Активные</th><th class="num">Новые</th><th class="num">Исправлены</th><th>Больше всего — с моделью</th><th class="sum-progress-head">Исправлено</th></tr></thead>
                    <tbody>
                        @foreach (var m in _models.Take(_modelsShown))
                        {
                            var model = m;
                            <tr class="clickable" @onclick="() => DrillModel(model.File)" title="@model.File">
                                <td class="cut">@model.Title</td>
                                <td class="num">@model.Total</td>
                                <td class="num k-active">@model.Active</td>
                                <td class="num">@(model.New > 0 ? "+" + model.New : "")</td>
                                <td class="num k-fixed">@(model.FixedPeriod > 0 ? model.FixedPeriod.ToString() : "")</td>
                                <td class="cut muted">@model.Partner</td>
                                <td class="sum-progress"><div class="kpi-bar"><i style="width:@model.Percent%"></i></div><span>@model.Percent %</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (_models.Count > _modelsShown) { <button class="btn link small" @onclick="() => _modelsShown = _models.Count">Показать все (@_models.Count)</button> }
            </section>
        }
        else if (Tab == "types")
        {
            <section class="sum-block">
                <h3>Категория / семейство <span class="muted small">— элементы в активных коллизиях; площадь — число коллизий; нажать — эти коллизии</span></h3>
                @if (_typeItems.Count == 0) { <p class="muted">Активных нет.</p> }
                else { <Treemap Title="Элементы в активных коллизиях" Items="_typeItems" Clicked="DrillTypeIndex" /> }
            </section>
            <section class="sum-block">
                <table class="grid sum-table">
                    <thead><tr><th>Категория</th><th>Семейство · тип</th><th class="num">Коллизий</th></tr></thead>
                    <tbody>
                        @foreach (var t in _types.Take(_typesShown))
                        {
                            var type = t;
                            <tr class="clickable" @onclick="() => DrillType(type.Key)">
                                <td>@type.Category</td><td class="cut">@type.Title</td><td class="num k-active">@type.Count</td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (_types.Count > _typesShown) { <button class="btn link small" @onclick="() => _typesShown = _types.Count">Показать все (@_types.Count)</button> }
            </section>
        }
        else if (Tab == "levels")
        {
            <section class="sum-block">
                <h3>Коллизии по уровням <span class="muted small">— активные, снизу вверх; нажать — коллизии уровня</span></h3>
                @if (_levels.Count == 0) { <p class="muted">Активных нет.</p> }
                else { <BarChart Title="Активные по уровням" Bars="_levelBars" Height="300" Clicked="DrillLevel" /> }
            </section>
        }
        else if (Tab == "recur")
        {
            <section class="sum-block">
                <h3>Повторяющиеся коллизии (@_recur.Count) <span class="muted small">— были в отчётах двух дат и больше, любой статус; нажать — коллизия</span></h3>
                <div class="recur-dist">
                    @foreach (var (title, count, hint) in _recurDist)
                    {
                        <span class="chip" title="@hint">@title <b>@count</b></span>
                    }
                </div>
                @if (_recur.Count == 0) { <p class="muted">Таких нет.</p> }
                else
                {
                    <table class="grid sum-table recur-table">
                        <colgroup><col style="width:22%" /><col style="width:25%" /><col style="width:13%" /><col style="width:8.5%" /><col style="width:8.5%" /><col style="width:7.5%" /><col style="width:7.5%" /><col style="width:8%" /></colgroup>
                        <thead><tr><th>Проверка</th><th>Элементы</th><th>Оси · уровень</th><th class="num" title="В скольких датах отчётов была">Повторы</th><th class="num" title="Сколько раз появлялась снова после исправления">↺ Вернулась,<br />раз</th><th>Первый</th><th>Последний</th><th>Статус</th></tr></thead>
                        <tbody>
                            @foreach (var x in _recur.Take(_recurShown))
                            {
                                var clash = x;
                                <tr class="clickable" @onclick="() => Drill.InvokeAsync(new SummaryDrill { ClashId = clash.Id })" title="@ElementsTitle(clash)">
                                    <td class="cut">@if (clash.Block != "") { <span class="tag">@clash.Block</span> }@clash.Type</td>
                                    <td class="cut">@Fmt.Short(clash.A) × @Fmt.Short(clash.B)</td>
                                    <td class="cut">@PlaceOf(clash)</td>
                                    <td class="num"><b>@clash.Repeats</b></td>
                                    <td class="num">@(clash.ReturnCount > 0 ? clash.ReturnCount.ToString() : "")</td>
                                    <td>@Fmt.Day(clash.FirstSeen)</td>
                                    <td>@Fmt.Day(clash.LastSeen)</td>
                                    <td><span class="badge @Fmt.StateClass(clash.State)">@Fmt.State(clash.State)</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    @if (_recur.Count > _recurShown) { <button class="btn link small" @onclick="() => _recurShown += 30">Показать ещё (@(_recur.Count - _recurShown))</button> }
                }
            </section>
        }
        else if (Tab == "quality")
        {
            <section class="sum-block">
                <h3>Качество данных <span class="muted small">— что мешает считать точно; нажать — к отчётам или коллизиям</span></h3>
                @if (_quality.Count == 0) { <p class="quality-ok">✓ Замечаний нет</p> }
                else
                {
                    <ul class="quality">
                        @foreach (var q in _quality)
                        {
                            var item = q;
                            <li class="@(item.Drill != null ? "clickable" : "")" @onclick="() => QualityClick(item.Drill)">⚠ <b>@item.Text</b> <span class="muted">— @item.Hint</span></li>
                        }
                    </ul>
                }
            </section>
        }
        else if (Tab == "progress")
        {
            <section class="sum-block">
                <h3>Прогресс по @LevelDative</h3>
                @GroupTable(_groups, LevelHead, null)
            </section>
            @if (_days.Count > 1)
            {
                <section class="sum-block">
                    <h3>Динамика исправления <span class="muted small">— % исправлено по датам отчётов</span></h3>
                    <LineChart Title="% исправлено по датам отчётов" Labels="_dayLabels" Series="_progressLines" Height="240" />
                </section>
            }
        }
        else
        {
            @* обзор: проверки сгруппированными столбиками и тренд — как «Обзор» у автора *@
            <section class="sum-block">
                <h3>Проверки (@_overviewKeys.Count) <span class="muted small">— всего, активные, исправленные; нажать — коллизии проверки</span></h3>
                <GroupedBarChart Title="Проверки" Labels="_overviewLabels" Series="_overviewSeries" Clicked="DrillOverview" />
            </section>
            <section class="sum-block">
                <h3>Тренд</h3>
                <BarChart Title="Тренд по датам отчётов" Bars="_trend" Legend="_trendLegend" Height="250" />
            </section>
        }
    }
    else if (Page == "compare")
    {
        @* сравнение отчётов — как у автора: даты, итог, таблица по проверкам; плюс изменение количества и что изменилось *@
        @if (_days.Count < 2) { <p class="muted">Для сравнения нужны отчёты хотя бы двух дат.</p> }
        else
        {
            <div class="sum-bar">
                <div class="compare-bar">
                    <select @bind="_cmpA" @bind:after="Compare">@foreach (var d in _days) { <option value="@d.ToString("yyyy-MM-dd")">@Fmt.Day(d)</option> }</select>
                    <span class="muted">→</span>
                    <select @bind="_cmpB" @bind:after="Compare">@foreach (var d in _days) { <option value="@d.ToString("yyyy-MM-dd")">@Fmt.Day(d)</option> }</select>
                </div>
                <button class="btn small no-print" @onclick="ExportCompare" title="Таблица по проверкам и список изменений — файлом для Excel">Excel</button>
            </div>
            @if (_cmpError != null) { <p class="muted">@_cmpError</p> }
            else
            {
                <div class="cmp-info">
                    <div>Отчёты: <b>@Fmt.Day(DateTime.Parse(_cmpA)) → @Fmt.Day(DateTime.Parse(_cmpB))</b></div>
                    <div class="muted">Дат в периоде: @_cmpDays · активных было @_cmpChange.Was, стало @_cmpChange.Now ·
                        <span class="delta-total @(_cmpTotal > 0 ? "up" : _cmpTotal < 0 ? "down" : "")">Δ = @(_cmpTotal > 0 ? "+" : _cmpTotal < 0 ? "−" : "")@Math.Abs(_cmpTotal)</span></div>
                </div>
                <section class="sum-block">
                    <table class="grid sum-table">
                        <thead><tr><th>Проверка</th><th class="num">@Fmt.Day(DateTime.Parse(_cmpA))</th><th class="num">@Fmt.Day(DateTime.Parse(_cmpB))</th><th class="num">Δ</th></tr></thead>
                        <tbody>
                            @foreach (var (type, a, b) in _cmp)
                            {
                                var d = b - a;
                                var name = type;
                                <tr class="clickable" @onclick="() => DrillTest(name)">
                                    <td>@Dot(TypeColor(type))@type</td><td class="num">@a</td><td class="num">@b</td>
                                    <td class="num delta-cell @(d > 0 ? "up" : d < 0 ? "down" : "")">@(d > 0 ? "+" : d < 0 ? "−" : "")@Math.Abs(d)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </section>
                <section class="sum-block">
                    <h3>Изменение количества активных коллизий <span class="muted small">— было, добавилось, ушло, стало@(_cmpClickable ? "; нажать — эти коллизии" : "")</span></h3>
                    <WaterfallChart Title="Изменение количества активных коллизий" Steps="_cmpBridge" Clicked="DrillCmp" Width="900" Height="260" />
                </section>
                <section class="sum-block">
                    <h3>Что изменилось (@_changed.Count) <span class="muted small">— коллизии, которые пришли или ушли; нажать — коллизия</span></h3>
                    @if (_changed.Count == 0) { <p class="muted">Ничего не изменилось.</p> }
                    else
                    {
                        <table class="grid sum-table changed-table">
                            <colgroup><col style="width:17%" /><col style="width:29%" /><col style="width:32%" /><col style="width:11%" /><col style="width:11%" /></colgroup>
                            <thead><tr><th>Что</th><th>Проверка</th><th>Элементы</th><th>Уровень</th><th>Статус сейчас</th></tr></thead>
                            <tbody>
                                @foreach (var (row, what, css) in _changed.Take(_changedShown))
                                {
                                    var clash = row;
                                    <tr class="clickable" @onclick="() => Drill.InvokeAsync(new SummaryDrill { ClashId = clash.Id })" title="@ElementsTitle(clash)">
                                        <td><span class="tag @css">@what</span></td>
                                        <td class="cut">@if (clash.Block != "") { <span class="tag">@clash.Block</span> }@clash.Type</td>
                                        <td class="cut">@Fmt.Short(clash.A) × @Fmt.Short(clash.B)</td>
                                        <td class="cut">@LevelOf(clash)</td>
                                        <td><span class="badge @Fmt.StateClass(clash.State)">@Fmt.State(clash.State)</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        @if (_changed.Count > _changedShown) { <button class="btn link small" @onclick="() => _changedShown += 50">Показать ещё (@(_changed.Count - _changedShown))</button> }
                    }
                </section>
            }
        }
    }
    else
    {
        @* дашборд — как у автора: на дату, крупные плитки с изменением к прошлой дате, мелкие плитки, тренд, проверки *@
        <div class="sum-bar">
            <div class="dash-date">
                <span class="muted">на</span>
                <select value="@_dashDate" @onchange="PickDashDate" title="Дата отчётов">
                    @for (var i = _days.Count - 1; i >= 0; i--)
                    {
                        var day = _days[i];
                        <option value="@day.ToString("yyyy-MM-dd")" @key="day">@Fmt.Day(day)@(i == _days.Count - 1 ? " — сейчас" : "")</option>
                    }
                </select>
                <span class="muted small">· @Fmt.Plural(_dashReports, "отчёт", "отчёта", "отчётов") · @Fmt.Plural(_dashDayCount, "дата", "даты", "дат")</span>
            </div>
            <button class="btn small no-print" @onclick="ExportDashboard" title="Плитки и таблица проверок — файлом для Excel">Excel</button>
        </div>

        <div class="kpi-big">
            @Big("Всего коллизий", "⚠", _dash.Total, _dashPrev?.Total, null, null, null)
            @Big("Активные", "", _dash.Active, _dashPrev?.Active, "k-active", true, _dashIsNow ? ClashState.Active : null)
            @Big("Исправленные", "✓", _dash.Fixed, _dashPrev?.Fixed, "k-fixed", false, _dashIsNow ? ClashState.Fixed : null)
            <div class="kpi-card">
                <div class="kc-label">Прогресс</div>
                <div class="kc-value @(_dash.Percent >= 50 ? "k-fixed" : "k-active")">@_dash.Percent %</div>
                @if (_dashPrev != null) { @Change(_dash.Percent - _dashPrev.Percent, false, " п.п.") }
                <div class="kpi-bar"><i style="width:@_dash.Percent%"></i></div>
            </div>
        </div>
        <div class="kpi-small">
            @Small("Допущенные", _dash.Accepted.ToString(), "k-accepted", _dashIsNow ? () => DrillState(ClashState.Accepted) : null, null)
            @Small("Новые за прогон", _dashChange == null ? "—" : "+" + (_dashChange.New + _dashChange.NewTests), null,
                   _dashChange != null && _dashIsNow ? () => DrillRun("new", _dashDate) : null,
                   _dashChange != null && _dashChange.NewTests > 0 ? $"в новых проверках — {_dashChange.NewTests}" : null)
            @Small("Вернулись", _dashChange == null ? "—" : _dashChange.Returned.ToString(), _dashChange != null && _dashChange.Returned > 0 ? "k-active" : null,
                   _dashChange != null && _dashIsNow && _dashChange.Returned > 0 ? () => DrillRun("returned", _dashDate) : null, "после исправления")
            @if (_dashIsNow)
            {
                @Small("Нет отчёта", Fmt.Plural(Missing, "проверка", "проверки", "проверок"), Missing > 0 ? "warn-text" : null,
                       Missing > 0 ? () => Drill.InvokeAsync(new SummaryDrill { ToReports = true }) : null, "в последнем прогоне")
            }
            else
            {
                @Small("Отчётов на дату", _dashReports.ToString(), null, null, null)
            }
        </div>

        <section class="sum-block">
            <h3>Тренд коллизий</h3>
            <BarChart Title="Тренд по датам отчётов" Bars="_trend" Legend="_trendLegend" Height="240" />
        </section>

        <section class="sum-block">
            <h3>Проверки <span class="muted small">— на @Fmt.Day(DateTime.Parse(_dashDate))@(_dashIsNow ? "" : " (по отчётам)"); нажать на заголовок — сортировка, на строку — коллизии</span></h3>
            <table class="grid sum-table">
                <thead>
                    <tr>
                        @SortTh("name", "Проверка", null)
                        <th>Категория</th>
                        @SortTh("total", "Всего", "num")
                        @SortTh("active", "Акт.", "num")
                        @SortTh("fixed", "Испр.", "num")
                        @SortTh("accepted", "Допуск", "num")
                        @SortTh("percent", "Исправлено", "sum-progress-head")
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in SortedTests)
                    {
                        var test = t;
                        <tr class="clickable" @onclick="() => DrillTest(test.Key)">
                            <td>@test.Title</td>
                            <td>@CategoryChips(test.Key)</td>
                            <td class="num">@test.Total</td>
                            <td class="num k-active">@test.Active</td>
                            <td class="num k-fixed">@test.Fixed</td>
                            <td class="num">@test.Accepted</td>
                            <td class="sum-progress"><div class="kpi-bar"><i style="width:@test.Percent%"></i></div><span>@test.Percent %</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </section>
        @Help()
    }
</div>

@code {
    public sealed class Counts
    {
        public int Active, Fixed, Accepted;
        public int Total => Active + Fixed + Accepted;
        /// <summary>Исправлено из всех, кроме допущенных, — % (как на главной).</summary>
        public int Percent => Active + Fixed == 0 ? 0 : (int)Math.Round(100.0 * Fixed / (Active + Fixed));
        public void Add(ClashState s) { if (s == ClashState.Active) Active++; else if (s == ClashState.Fixed) Fixed++; else Accepted++; }
    }

    private sealed class Group
    {
        public string Key, Title, Color;
        public int Active, Fixed, Accepted;
        public int Total => Active + Fixed + Accepted;
        public int Percent => Active + Fixed == 0 ? 0 : (int)Math.Round(100.0 * Fixed / (Active + Fixed));
    }

    /// <summary>Модель (файл): коллизии, где она один из двух элементов.</summary>
    private sealed class ModelRow
    {
        public string File, Title, Partner;
        public int Active, Fixed, Accepted, New, FixedPeriod;
        public int Total => Active + Fixed + Accepted;
        public int Percent => Active + Fixed == 0 ? 0 : (int)Math.Round(100.0 * Fixed / (Active + Fixed));
    }

    private sealed class TypeRow { public string Category, Title, Key; public int Count; }

    private sealed class QualityItem { public string Text, Hint; public SummaryDrill Drill; }

    [Parameter] public long ProjectId { get; set; }
    /// <summary>Страница сводки: dash — дашборд, analytics — аналитика, compare — сравнение отчётов.</summary>
    [Parameter] public string Page { get; set; } = "dash";
    /// <summary>Вкладка «Аналитики» (overview / blocks / models / types / levels / recur / quality / progress).</summary>
    [Parameter] public string Tab { get; set; } = "overview";
    [Parameter] public EventCallback<string> TabChanged { get; set; }
    /// <summary>Коллизии в отборах боковой панели — нынешнее состояние.</summary>
    [Parameter] public List<ClashRow> Rows { get; set; } = new();
    /// <summary>Проверки в отборах боковой панели.</summary>
    [Parameter] public List<TestRow> Tests { get; set; } = new();
    [Parameter] public List<ReportRow> Reports { get; set; } = new();
    /// <summary>Проверки без отчёта в последнем прогоне (RunCheck).</summary>
    [Parameter] public int Missing { get; set; }
    [Parameter] public IReadOnlyList<string> Outside { get; set; } = Array.Empty<string>();
    [Parameter] public Func<string, string> CategoryOf { get; set; } = _ => "";
    [Parameter] public Func<string, string> SubOf { get; set; } = _ => "";
    /// <summary>Категории по порядку из «Настроек».</summary>
    [Parameter] public List<string> Categories { get; set; } = new();
    /// <summary>Подкатегории категорий по порядку из «Настроек».</summary>
    [Parameter] public Dictionary<string, List<string>> SubOrder { get; set; } = new();
    /// <summary>Выбранные на боковой панели категория и подкатегория (null — нет).</summary>
    [Parameter] public string Category { get; set; }
    [Parameter] public string Subcategory { get; set; }
    /// <summary>Цвет: категория или «категория\u001fподкатегория» → ключ палитры (у подкатегории без своего — цвет категории).</summary>
    [Parameter] public Dictionary<string, string> Colors { get; set; } = new();
    [Parameter] public EventCallback<SummaryDrill> Drill { get; set; }

    private static readonly (string Key, string Title)[] Tabs =
    {
        ("overview", "Обзор"), ("blocks", "По блокам"), ("models", "По моделям"), ("types", "По типам"), ("levels", "По уровням"),
        ("recur", "Рекуррентность"), ("quality", "Качество данных"), ("progress", "Прогресс"),
    };

    /// <summary>По чему делится сводка: на уровень ниже выбранного на боковой панели.</summary>
    private enum By { Block, Category, Sub, Type }
    private By _by;

    private static readonly string[] Palette =
        { "--cat-violet", "--cat-teal", "--cat-orange", "--cat-blue", "--cat-green", "--cat-pink", "--cat-amber", "--cat-indigo", "--cat-red", "--cat-cyan", "--cat-lime", "--cat-brown" };

    private List<ClashRow> _rows = new();
    private Dictionary<long, ClashRow> _byId = new();
    private List<DateTime> _days = new();
    private RunHistory _history;
    private Func<long, bool> _filter;
    private List<string> _categories = new(), _matrixRows = new(), _matrixCols = new(), _dayLabels = new();

    // дашборд
    private string _dashDate;
    private bool _dashIsNow;
    private Counts _dash = new(), _dashPrev;
    private RunChange _dashChange;
    private int _dashReports, _dashDayCount;
    private List<Group> _tests = new();
    private string _sortKey = "active";
    private bool _sortDesc = true;
    private List<BarChart.Bar> _trend = new();
    private List<(string, string)> _trendLegend = new() { ("Активные", "--active"), ("Исправленные", "--fixed"), ("Допущенные", "--accepted") };

    // аналитика
    private List<string> _overviewLabels = new(), _overviewKeys = new();
    private List<(string, string, List<double>)> _overviewSeries = new();
    private Dictionary<(string Block, string Col), int> _cells = new();
    private int _cellMax;
    private List<Group> _blocks = new(), _groups = new();
    private List<ModelRow> _models = new();
    private int _modelsShown = 10;
    private List<string> _modelKeys = new();
    private Dictionary<string, int> _pairs = new();
    private int _pairMax;
    private List<TypeRow> _types = new();
    private List<Treemap.Item> _typeItems = new();
    private int _typesShown = 15;
    private List<FacetValue> _levels = new();
    private List<BarChart.Bar> _levelBars = new();
    private List<ClashRow> _recur = new();
    private int _recurShown = 30;
    /// <summary>Сколько коллизий встречалось 1, 2, 3 и больше раз; сколько возвращалось после исправления.</summary>
    private List<(string Title, int Count, string Hint)> _recurDist = new();
    private List<QualityItem> _quality = new();
    private List<(string, string, List<double?>)> _progressLines = new();
    private HashSet<long> _explained = new();
    private RunChange _lastChange;

    // сравнение
    private string _cmpA, _cmpB, _cmpError;
    private bool _cmpClickable;
    private int _cmpDays, _cmpTotal, _changedShown = 50;
    private RunChange _cmpChange;
    private List<WaterfallChart.Step> _cmpBridge = new();
    private List<string> _cmpKinds = new();
    private List<(string Type, int A, int B)> _cmp = new();
    private List<(ClashRow Row, string What, string Css)> _changed = new();

    private object _lastRows;
    private int _lastKey;

    protected override void OnParametersSet()
    {
        var key = HashCode.Combine(Tests?.Count, Categories?.Count, Reports?.Count, Missing, Outside?.Count, string.Join("|", Colors.Select(c => c.Key + c.Value)), Category, Subcategory);
        if (ReferenceEquals(Rows, _lastRows) && key == _lastKey) return;
        _lastRows = Rows;
        _lastKey = key;
        _rows = Rows ?? new List<ClashRow>();
        _byId = _rows.ToDictionary(r => r.Id);
        var testIds = (Tests ?? new()).Select(t => t.Id).ToHashSet();
        _filter = testIds.Contains;
        _history = Store.RunHistory(ProjectId);
        _explained = Store.ExplainedClashes(ProjectId);
        _days = _history.Days(_filter);
        if (_days.Count == 0) return;
        _categories = Categories.Where(c => (Tests ?? new()).Any(t => CategoryOf(t.Name) == c)).ToList();
        _by = Category != null
            ? (Subcategory == null && Category != "" && (Tests ?? new()).Any(t => SubOf(t.Name) != "") ? By.Sub : By.Type)
            : _categories.Count > 0 ? By.Category : By.Block;
        _dayLabels = _days.Select(d => d.ToString("dd.MM")).ToList();
        _lastChange = _days.Count > 1 ? _history.Change(_days[^2], _days[^1], _filter) : null;

        // тренд по датам отчётов: стопкой, над столбиком — новые
        _trend = new();
        foreach (var day in _days)
        {
            var counts = new Counts();
            foreach (var s in _history.StatesAt(day, _filter).Values) counts.Add(s);
            var fresh = _history.NewAt(day, _filter).Count;
            _trend.Add(new BarChart.Bar
            {
                Label = Fmt.Day(day), Note = fresh > 0 ? "+" + fresh : null,
                Parts = new() { (counts.Active, "--active", "активные"), (counts.Fixed, "--fixed", "исправленные"), (counts.Accepted, "--accepted", "допущенные") },
            });
        }

        if (_dashDate == null || !_days.Any(d => d.ToString("yyyy-MM-dd") == _dashDate)) _dashDate = _days[^1].ToString("yyyy-MM-dd");
        BuildDashboard();
        BuildAnalytics();

        if (_days.Count > 1 && (_cmpA == null || !_days.Any(d => d.ToString("yyyy-MM-dd") == _cmpA)))
        {
            _cmpA = _days[^2].ToString("yyyy-MM-dd");
            _cmpB = _days[^1].ToString("yyyy-MM-dd");
        }
        Compare();
    }

    // ───── дашборд ─────

    /// <summary>Плитки и проверки на выбранную дату; изменение — к предыдущей дате отчётов.</summary>
    private void BuildDashboard()
    {
        var day = DateTime.Parse(_dashDate);
        var index = _days.IndexOf(day);
        _dashIsNow = index == _days.Count - 1;
        var states = _history.StatesAt(day, _filter);
        _dash = new Counts();
        foreach (var s in states.Values) _dash.Add(s);
        _dashPrev = null;
        _dashChange = null;
        if (index > 0)
        {
            _dashPrev = new Counts();
            foreach (var s in _history.StatesAt(_days[index - 1], _filter).Values) _dashPrev.Add(s);
            _dashChange = _history.Change(_days[index - 1], day, _filter);
        }
        _dashDayCount = index + 1;
        _dashReports = Reports.Count(r => r.ReportDate.Date <= day);
        // проверки на дату: по типам
        var typeOf = _rows.ToDictionary(r => r.Id, r => r.Type);
        _tests = states.Where(x => typeOf.ContainsKey(x.Key)).GroupBy(x => typeOf[x.Key]).Select(g => new Group
        {
            Key = g.Key, Title = g.Key,
            Active = g.Count(x => x.Value == ClashState.Active), Fixed = g.Count(x => x.Value == ClashState.Fixed), Accepted = g.Count(x => x.Value == ClashState.Accepted),
        }).ToList();
    }

    private void PickDashDate(ChangeEventArgs e)
    {
        _dashDate = e.Value?.ToString() ?? _dashDate;
        BuildDashboard();
    }

    private RenderFragment Big(string label, string icon, int value, int? before, string css, bool? lessIsBetter, ClashState? drill) => __builder =>
    {
        <div class="kpi-card @(drill.HasValue ? "clickable" : "")" @onclick="() => BigClick(drill)">
            <div class="kc-label">@label</div>
            <div class="kc-value @css">@if (icon != "") { <span class="kc-icon">@icon</span> }@value.ToString("#,0", System.Globalization.CultureInfo.GetCultureInfo("ru-RU"))</div>
            @if (before.HasValue) { @Change(value - before.Value, lessIsBetter, "") }
        </div>
    };

    private Task BigClick(ClashState? drill) => drill.HasValue ? DrillState(drill.Value) : Task.CompletedTask;

    private RenderFragment Small(string label, string value, string css, Func<Task> click, string note) => __builder =>
    {
        <div class="kpi-card small @(click != null ? "clickable" : "")" @onclick="() => SmallClick(click)">
            <div class="kc-label">@label</div>
            <div class="kc-value @css">@value</div>
            @if (note != null) { <div class="kc-note muted">@note</div> }
        </div>
    };

    private static Task SmallClick(Func<Task> click) => click == null ? Task.CompletedTask : click();

    /// <summary>Изменение к прошлой дате со стрелкой; у величин без «лучше / хуже» (lessIsBetter = null) — нейтрально.</summary>
    private RenderFragment Change(int d, bool? lessIsBetter, string unit) => __builder =>
    {
        bool? good = d == 0 || lessIsBetter == null ? null : (d < 0) == lessIsBetter.Value;
        <div class="st-change @(good == true ? "good" : good == false ? "bad" : "muted")" title="К прошлой дате отчётов">
            @(d > 0 ? "↗ +" : d < 0 ? "↘ −" : "→ ")@Math.Abs(d)@unit
        </div>
    };

    /// <summary>Категория и подкатегория проверки — цветными метками, как в списке коллизий.</summary>
    private RenderFragment CategoryChips(string type) => __builder =>
    {
        var name = (Tests ?? new()).FirstOrDefault(t => t.Type == type)?.Name ?? type;
        var cat = CategoryOf(name);
        var sub = SubOf(name);
        if (cat != "") { <span class="cat-chip" style="--chip: var(--cat-@(Colors.TryGetValue(cat, out var c) ? c : "gray"))">@cat</span> }
        if (sub != "") { <span class="cat-chip" style="--chip: var(--cat-@(SubColor(cat, sub) ?? "gray"))">@sub</span> }
    };

    // ───── аналитика ─────

    private void BuildAnalytics()
    {
        var active = _rows.Where(r => r.State == ClashState.Active).ToList();

        // обзор: проверки по убыванию «всего» — всего, активные, исправленные
        var byType = _rows.GroupBy(r => r.Type).Select(g => (Type: g.Key, Total: g.Count(), Active: g.Count(r => r.State == ClashState.Active), Fixed: g.Count(r => r.State == ClashState.Fixed)))
            .OrderByDescending(x => x.Total).ThenBy(x => x.Type, StringComparer.CurrentCultureIgnoreCase).ToList();
        _overviewKeys = byType.Select(x => x.Type).ToList();
        _overviewLabels = _overviewKeys;
        _overviewSeries = new()
        {
            ("Всего", "--cat-blue", byType.Select(x => (double)x.Total).ToList()),
            ("Активные", "--active", byType.Select(x => (double)x.Active).ToList()),
            ("Исправленные", "--fixed", byType.Select(x => (double)x.Fixed).ToList()),
        };

        // по блокам: матрица и таблица
        _matrixRows = _rows.Select(r => r.Block).Distinct().OrderBy(ReportPath.BlockOrder).ThenBy(b => b, StringComparer.CurrentCultureIgnoreCase).ToList();
        _matrixCols = LevelOrder();
        _cells = active.GroupBy(r => (r.Block, Col: _by == By.Block ? null : KeyOf(r.TestName, r.Type)))
            .ToDictionary(g => (g.Key.Block, g.Key.Col), g => g.Count());
        _cellMax = _cells.Values.DefaultIfEmpty(0).Max();
        _blocks = _rows.GroupBy(r => r.Block).Select(g => GroupOf(g.Key, BlockTitle(g.Key), null, g))
            .OrderBy(g => _matrixRows.IndexOf(g.Key)).ToList();

        // по моделям: коллизия — у обеих своих моделей; за период — последние изменения
        var models = new Dictionary<string, (ModelRow Row, Dictionary<string, int> Partners)>(StringComparer.OrdinalIgnoreCase);
        _pairs = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
        foreach (var r in _rows)
        {
            var files = new[] { r.A?.ModelFile, r.B?.ModelFile }.Where(f => !string.IsNullOrWhiteSpace(f)).Distinct(StringComparer.OrdinalIgnoreCase).ToList();
            if (r.State == ClashState.Active && files.Count > 0)
            {
                var key = PairKey(files[0], files.Count > 1 ? files[1] : files[0]);
                _pairs[key] = _pairs.TryGetValue(key, out var p) ? p + 1 : 1;
            }
            foreach (var file in files)
            {
                if (!models.TryGetValue(file, out var m))
                    models[file] = m = (new ModelRow { File = file, Title = ModelTitle(file) }, new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase));
                if (r.State == ClashState.Active) m.Row.Active++;
                else if (r.State == ClashState.Fixed) m.Row.Fixed++;
                else m.Row.Accepted++;
                if (_lastChange != null)
                {
                    if (_lastChange.Entered.TryGetValue(r.Id, out var e) && (e == RunChange.NewKind || e == RunChange.NewTestsKind)) m.Row.New++;
                    if (_lastChange.Left.TryGetValue(r.Id, out var l) && (l == RunChange.FixedKind || l == RunChange.FixedManualKind)) m.Row.FixedPeriod++;
                }
                if (r.State == ClashState.Active)
                {
                    var other = files.FirstOrDefault(f => !string.Equals(f, file, StringComparison.OrdinalIgnoreCase)) ?? file;
                    m.Partners[other] = m.Partners.TryGetValue(other, out var n) ? n + 1 : 1;
                }
            }
        }
        _models = models.Values.Select(v =>
        {
            var top = v.Partners.OrderByDescending(p => p.Value).FirstOrDefault();
            v.Row.Partner = top.Key == null ? "" : (string.Equals(top.Key, v.Row.File, StringComparison.OrdinalIgnoreCase) ? "сама с собой" : ModelTitle(top.Key)) + $" — {top.Value}";
            return v.Row;
        }).OrderByDescending(m => m.Active).ThenByDescending(m => m.Total).ThenBy(m => m.Title, StringComparer.CurrentCultureIgnoreCase).ToList();
        _modelsShown = 10;
        _modelKeys = _models.Where(m => m.Active > 0).Take(12).Select(m => m.File).ToList();
        _pairMax = _pairs.Values.DefaultIfEmpty(0).Max();

        // по типам: категория / семейство · тип элементов в активных коллизиях (пара одного типа — один раз)
        var types = new Dictionary<string, (TypeRow Row, HashSet<long> Ids)>(StringComparer.Ordinal);
        foreach (var r in active)
            foreach (var e in new[] { r.A, r.B })
            {
                if (e == null) continue;
                var title = Fmt.Short(e);
                var key = ClashFacets.ElementTypeKey(e);
                if (title == "—" || key == null) continue;
                if (!types.TryGetValue(key, out var t))
                    types[key] = t = (new TypeRow { Category = e.Category ?? "", Title = title, Key = key }, new HashSet<long>());
                t.Ids.Add(r.Id);
            }
        _types = types.Values.Select(v => { v.Row.Count = v.Ids.Count; return v.Row; })
            .OrderByDescending(t => t.Count).ThenBy(t => t.Title, StringComparer.CurrentCultureIgnoreCase).ToList();
        _typesShown = 15;
        var categoryColor = new Dictionary<string, string>(StringComparer.CurrentCultureIgnoreCase);
        _typeItems = _types.Take(40).Select(t =>
        {
            if (!categoryColor.TryGetValue(t.Category, out var color)) categoryColor[t.Category] = color = Palette[categoryColor.Count % Palette.Length];
            return new Treemap.Item { Label = (t.Category == "" ? "" : t.Category + " / ") + t.Title, Value = t.Count, Color = color };
        }).ToList();

        // по уровням: активные, снизу вверх
        _levels = ClashFacets.Count(active, ClashFacets.Level);
        _levelBars = _levels.Select(v => new BarChart.Bar { Label = v.Title, Parts = new() { (v.Count, "--cat-violet", "активные") } }).ToList();

        // рекуррентность: были в отчётах двух дат и больше
        _recur = _rows.Where(r => r.Repeats >= 2)
            .OrderByDescending(r => r.Repeats).ThenByDescending(r => r.ReturnCount).ThenBy(r => r.State == ClashState.Active ? 0 : 1).ThenBy(r => r.FirstSeen)
            .ToList();
        _recurShown = 30;
        _recurDist = new()
        {
            ("1 раз", _rows.Count(r => r.Repeats <= 1), "Были в отчётах одной даты"),
            ("2 раза", _rows.Count(r => r.Repeats == 2), "Были в отчётах двух дат"),
            ("3 и больше", _rows.Count(r => r.Repeats >= 3), "Были в отчётах трёх дат и больше"),
            ("↺ вернулись", _rows.Count(r => r.ReturnCount > 0), "Исправлялись и появлялись снова"),
        };

        // качество данных: отчёты, папки, категории, допущенные без пояснения, отмеченные и ждущие отчёта
        _quality = new();
        var toReports = new SummaryDrill { ToReports = true };
        var incomplete = Reports.Count(r => r.Warning != null && r.Warning.Contains("неполный"));
        var suspicious = Reports.Count(r => r.Suspicious);
        var renamed = Reports.Count(r => r.Warning != null && r.Warning.Contains("Модели названы иначе"));
        if (incomplete > 0) _quality.Add(new() { Text = $"Неполные отчёты: {incomplete}", Hint = "выгружены не все статусы, пропавшие из них не считаются исправленными", Drill = toReports });
        if (suspicious > 0) _quality.Add(new() { Text = $"«Исправлены сразу много»: {suspicious}", Hint = "проверьте, подгрузились ли модели; если нет — «Вернуть активными»", Drill = toReports });
        if (renamed > 0) _quality.Add(new() { Text = $"Модели названы иначе, чем в соседнем прогоне: {renamed}", Hint = "держите имена файлов моделей постоянными", Drill = toReports });
        if (Missing > 0) _quality.Add(new() { Text = $"Нет отчёта в последнем прогоне: {Fmt.Plural(Missing, "проверка", "проверки", "проверок")}", Hint = "выгружайте все проверки, даже пустые", Drill = toReports });
        if (Outside.Count > 0) _quality.Add(new() { Text = $"Папки вне блоков: {string.Join(", ", Outside.Select(f => f == "" ? "(сама папка проекта)" : f))}", Hint = "отчёты из них не загружены — добавьте блоки в разделе «Проект»" });
        var uncategorized = Categories.Count > 0 ? (Tests ?? new()).Where(t => CategoryOf(t.Name) == "").Select(t => t.Name).Distinct().Count() : 0;
        if (uncategorized > 0) _quality.Add(new() { Text = $"Проверки без категории: {uncategorized}", Hint = "добавьте их в «Настройки» → «Категории проверок»" });
        var noReason = _rows.Count(r => r.State == ClashState.Accepted && !_explained.Contains(r.Id));
        if (noReason > 0) _quality.Add(new() { Text = $"Допущены без пояснения: {noReason}", Hint = "допуск лучше объяснять комментарием", Drill = new SummaryDrill { State = ClashState.Accepted } });
        var marked = _rows.Count(r => r.State == ClashState.Fixed && r.InLastReport);
        if (marked > 0) _quality.Add(new() { Text = $"Отмечены исправленными на сайте, а в отчёте ещё есть: {marked}", Hint = "подтвердятся следующим отчётом; если коллизия в нём снова будет — вернётся в активные", Drill = new SummaryDrill { State = ClashState.Fixed } });

        // прогресс по категориям (или блокам) + линии % по датам
        Func<ClashRow, string> groupOf = _by == By.Block ? r => r.Block : r => KeyOf(r.TestName, r.Type);
        var order = _by == By.Block ? _matrixRows : _matrixCols;
        _groups = _rows.GroupBy(groupOf).Select(g => GroupOf(g.Key, GroupTitle(g.Key), GroupColor(g.Key), g)).OrderBy(g => order.IndexOf(g.Key)).ToList();
        var testGroup = (Tests ?? new()).ToDictionary(t => t.Id, t => _by == By.Block ? t.Block : KeyOf(t.Name, t.Type));
        _progressLines = _groups.Select((g, i) =>
        {
            var color = g.Color is string c ? "--cat-" + c : Palette[i % Palette.Length];
            var values = _days.Select(day =>
            {
                var cnt = new Counts();
                foreach (var s in _history.StatesAt(day, id => _filter(id) && testGroup.TryGetValue(id, out var k) && k == g.Key).Values) cnt.Add(s);
                return cnt.Total == 0 ? (double?)null : cnt.Percent;
            }).ToList();
            return (g.Title, color, values);
        }).ToList();
    }

    private RenderFragment Matrix() => __builder =>
    {
        <div class="matrix-wrap">
            <table class="matrix">
                <thead>
                    <tr>
                        <th></th>
                        @foreach (var c in _matrixCols) { <th class="col" title="@GroupTitle(c)">@ColHead(c)</th> }
                        <th class="num">Всего</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var b in _matrixRows)
                    {
                        var block = b;
                        <tr>
                            <th>@BlockTitle(block)</th>
                            @foreach (var c in _matrixCols)
                            {
                                var col = c;
                                var n = Cell(block, col);
                                <td class="cell @(n == 0 ? "zero" : "")" style="@HeatOf(n, _cellMax)" title="@(n) активных" @onclick="() => DrillCell(block, col)">@(n == 0 ? "—" : n.ToString())</td>
                            }
                            <td class="num total" @onclick="() => DrillCell(block, null)">@_rows.Count(r => r.Block == block && r.State == ClashState.Active)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    };

    /// <summary>Таблица групп: всего, активные, исправлены, допущены, % исправлено; click — переход (null — только цифры).</summary>
    private RenderFragment GroupTable(List<Group> groups, string head, Func<string, Task> click) => __builder =>
    {
        <table class="grid sum-table">
            <thead><tr><th>@head</th><th class="num">Всего</th><th class="num">Активные</th><th class="num">Исправлены</th><th class="num">Допущены</th><th class="sum-progress-head">Исправлено</th></tr></thead>
            <tbody>
                @foreach (var g in groups)
                {
                    var group = g;
                    <tr class="@(click != null ? "clickable" : "")" @onclick="() => GroupClick(click, group.Key)">
                        <td>@Dot(group.Color)@group.Title</td>
                        <td class="num">@group.Total</td>
                        <td class="num k-active">@group.Active</td>
                        <td class="num k-fixed">@group.Fixed</td>
                        <td class="num">@group.Accepted</td>
                        <td class="sum-progress"><div class="kpi-bar"><i style="width:@group.Percent%"></i></div><span>@group.Percent %</span></td>
                    </tr>
                }
            </tbody>
        </table>
    };

    private static Task GroupClick(Func<string, Task> click, string key) => click == null ? Task.CompletedTask : click(key);

    private static string PairKey(string a, string b) => string.CompareOrdinal(a.ToLowerInvariant(), b.ToLowerInvariant()) <= 0 ? a + "\u001f" + b : b + "\u001f" + a;
    private static string ModelTitle(string file) => System.IO.Path.GetFileNameWithoutExtension(file);

    // ───── сравнение ─────

    private void Compare()
    {
        if (_cmpA == null || _cmpB == null) return;
        _cmpError = string.CompareOrdinal(_cmpA, _cmpB) >= 0 ? "Дата «с» должна быть раньше даты «по»." : null;
        if (_cmpError != null) return;
        var from = DateTime.Parse(_cmpA);
        var to = DateTime.Parse(_cmpB);
        _cmpDays = _days.Count(d => d >= from && d <= to);
        _cmpClickable = _days.IndexOf(to) == _days.IndexOf(from) + 1;
        _cmpChange = _history.Change(from, to, _filter);
        _cmpBridge = Bridge(_cmpChange, _cmpClickable, to == _days[^1], out _cmpKinds);
        var typeOf = _rows.ToDictionary(r => r.Id, r => r.Type);
        Dictionary<string, int> ActiveByType(string day) => _history.StatesAt(DateTime.Parse(day), _filter)
            .Where(x => x.Value == ClashState.Active && typeOf.ContainsKey(x.Key)).GroupBy(x => typeOf[x.Key]).ToDictionary(g => g.Key, g => g.Count());
        var a = ActiveByType(_cmpA);
        var b = ActiveByType(_cmpB);
        _cmp = a.Keys.Union(b.Keys).Select(t => (t, a.GetValueOrDefault(t), b.GetValueOrDefault(t)))
            .OrderBy(x => x.Item3 - x.Item2).ThenBy(x => x.t, StringComparer.CurrentCultureIgnoreCase).ToList();
        _cmpTotal = b.Values.Sum() - a.Values.Sum();
        // что именно изменилось: пришли и ушли — по коллизиям
        _changed = new();
        foreach (var id in _cmpChange.Entered.Keys.Union(_cmpChange.Left.Keys))
        {
            if (!_byId.TryGetValue(id, out var row)) continue;
            _cmpChange.Entered.TryGetValue(id, out var e);
            _cmpChange.Left.TryGetValue(id, out var l);
            var what = string.Join(" → ", new[] { EnteredTitle(e), LeftTitle(l) }.Where(x => x != null));
            var css = l == RunChange.FixedKind || l == RunChange.FixedManualKind ? "run-fixed" : e == RunChange.ReturnedKind ? "run-returned" : l == null ? "run-new" : "";
            _changed.Add((row, what, css));
        }
        _changed = _changed.OrderBy(x => x.Css == "run-new" ? 0 : x.Css == "run-returned" ? 1 : x.Css == "" ? 2 : 3)
            .ThenBy(x => x.Row.Type, StringComparer.CurrentCultureIgnoreCase).ToList();
        _changedShown = 50;
    }

    private static string EnteredTitle(string kind) => kind switch
    {
        RunChange.NewKind => "новая", RunChange.NewTestsKind => "в новой проверке", RunChange.ReturnedKind => "вернулась",
        RunChange.UnacceptedKind => "снят допуск", _ => null,
    };

    private static string LeftTitle(string kind) => kind switch
    {
        RunChange.FixedKind => "исправлена", RunChange.FixedManualKind => "отмечена исправленной", RunChange.AcceptedKind => "допущена",
        RunChange.GoneKind => "нет данных", _ => null,
    };

    /// <summary>Шаги моста; нулевые изменения не показываются; clickable — шаги ведут к списку; toNow — «стало» = сейчас.</summary>
    private List<WaterfallChart.Step> Bridge(RunChange c, bool clickable, bool toNow, out List<string> kinds)
    {
        var steps = new List<WaterfallChart.Step>();
        var list = new List<string>();
        void Add(string label, string sub, bool total, double value, string color, string kind)
        {
            if (!total && value == 0) return;
            var press = kind != null && clickable;
            steps.Add(new WaterfallChart.Step { Label = label, Sub = sub, Total = total, Value = value, Color = color, Clickable = press });
            list.Add(press ? kind : null);
        }
        Add("Было", Fmt.Day(c.Before), true, c.Was, "--accepted", null);
        Add("Новые", null, false, c.New, "--active", "new");
        Add("Новые", "проверки", false, c.NewTests, "--cat-violet", "tests");
        Add("Вернулись", null, false, c.Returned, "--cat-orange", "returned");
        Add("Сняли", "допуск", false, c.Unaccepted, "--cat-orange", null);
        Add("Исправлены", "по отчёту", false, -c.Fixed, "--fixed", "fixed");
        Add("Отмечены", "на сайте", false, -c.FixedManual, "--fixed", null);
        Add("Допущены", null, false, -c.Accepted, "--accepted", null);
        Add("Нет", "данных", false, -c.Gone, "--accepted", null);
        Add("Стало", toNow ? "сейчас" : Fmt.Day(c.Day), true, c.Now, "--active", null);
        kinds = list;
        return steps;
    }

    // ───── Excel (CSV: разделитель «;», UTF-8 с BOM — как у списка коллизий) ─────

    private static string Csv(IEnumerable<string> header, IEnumerable<IEnumerable<string>> rows)
    {
        static string Q(string v) => "\"" + (v ?? "").Replace("\"", "\"\"") + "\"";
        var sb = new System.Text.StringBuilder();
        sb.AppendLine(string.Join(";", header.Select(Q)));
        foreach (var r in rows) sb.AppendLine(string.Join(";", r.Select(Q)));
        return sb.ToString();
    }

