    private static string BlockTitle(string block) => block == "" ? "без блока" : ReportPath.BlockTitle(block);

    /// <summary>Ключ группы у проверки — по уровню деления: категория, подкатегория или тип проверки.</summary>
    private string KeyOf(string testName, string type) => _by switch
    {
        By.Category => CategoryOf(testName),
        By.Sub => SubOf(testName),
        By.Type => type,
        _ => null,
    };

    /// <summary>Порядок групп уровня: как в «Настройках» (без категории / подкатегории — в конце), типы — по числу активных.</summary>
    private List<string> LevelOrder()
    {
        switch (_by)
        {
            case By.Category:
                return _categories.Concat(_rows.Any(r => CategoryOf(r.TestName) == "") ? new[] { "" } : Array.Empty<string>()).ToList();
            case By.Sub:
                var here = _rows.Select(r => SubOf(r.TestName)).ToHashSet();
                var order = SubOrder.TryGetValue(Category, out var so) ? so : new List<string>();
                return order.Where(here.Contains).Concat(here.Contains("") ? new[] { "" } : Array.Empty<string>()).ToList();
            case By.Type:
                return _rows.GroupBy(r => r.Type).OrderByDescending(g => g.Count(r => r.State == ClashState.Active))
                    .ThenBy(g => g.Key, StringComparer.CurrentCultureIgnoreCase).Select(g => g.Key).ToList();
            default:
                return new List<string>();
        }
    }

    private static Group GroupOf(string key, string title, string color, IEnumerable<ClashRow> rows) => new Group
    {
        Key = key, Title = title, Color = color,
        Active = rows.Count(r => r.State == ClashState.Active), Fixed = rows.Count(r => r.State == ClashState.Fixed), Accepted = rows.Count(r => r.State == ClashState.Accepted),
    };

    private string GroupTitle(string key) => _by switch
    {
        By.Category => key == "" ? "Без категории" : key,
        By.Sub => key == "" ? "Без подкатегории" : key,
        By.Type => key,
        _ => BlockTitle(key),
    };

    /// <summary>Цвет группы: категории, подкатегории выбранной категории; у типов и блоков — нет.</summary>
    private string GroupColor(string key) => _by switch
    {
        By.Category => Colors.TryGetValue(key, out var c) ? c : null,
        By.Sub => SubColor(Category, key),
        By.Type => TypeColor(key),
        _ => null,
    };

    private string SubColor(string category, string sub) =>
        sub == "" ? (Colors.TryGetValue(category, out var c) ? c : null) : Colors.TryGetValue(category + "\u001f" + sub, out var s) ? s : null;

    /// <summary>Цвет типа проверки — подкатегории или категории его проверки.</summary>
    private string TypeColor(string type)
    {
        var name = (Tests ?? new()).FirstOrDefault(t => t.Type == type)?.Name ?? type;
        var category = CategoryOf(name);
        return category == "" ? null : SubColor(category, SubOf(name));
    }

