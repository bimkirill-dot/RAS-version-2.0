@* Карточка коллизии — по образцу автора статьи: сведения таблицей в два столбца, снимок, объекты А и Б, статус.
   Справа от списка в проекте (Compact) и отдельной страницей. *@
@inject ClashStore Store
@inject IJSRuntime JS

@if (_card == null)
{
    <p class="muted">Коллизия не найдена.</p>
    return;
}

<div class="clash-card @(Compact ? "compact" : "wide")">
    @* верх закреплён: что это, статус, кнопки статуса (клавиши 1 · 2 · 3) и комментарий к ним — без прокрутки
       (разбор удобства 13.10.2026: кнопки были внизу карточки, на каждой коллизии — прокрутка вниз и вверх) *@
    <div class="cc-top">
        <div class="cc-head">
            <h2>@(_card.Last?.Name ?? "Коллизия") <span class="badge big @Fmt.StateClass(_card.State)">@Fmt.State(_card.State)</span></h2>
            @if ((_card.RunKind != null && _card.RunDay.HasValue) || _card.ReturnCount > 0)
            {
                <div class="cc-notes">
                    @if (_card.RunKind != null && _card.RunDay.HasValue)
                    {
                        @* что сделал с ней последний прогон её проверки *@
                        <span class="run-note @_card.RunKind">
                            @(_card.RunKind switch { "new" => "+ Новая", "fixed" => "Исправлена", _ => "↺ Вернулась" }) — прогон @Fmt.Day(_card.RunDay.Value)
                        </span>
                    }
                    @if (_card.ReturnCount > 0)
                    {
                        <span class="returned-note">↺ возвращалась после исправления — @Fmt.Plural(_card.ReturnCount, "раз", "раза", "раз")</span>
                    }
                </div>
            }
            @if (_card.Last != null && _card.Last.Elements.Count > 0)
            {
                <div class="cc-what" title="@string.Join(" × ", _card.Last.Elements.Select(Fmt.Element))">
                    @for (var i = 0; i < _card.Last.Elements.Count; i++)
                    {
                        var e = _card.Last.Elements[i];
                        if (i > 0) { <span class="x">×</span> }
                        <span class="w">@Fmt.Short(e)</span>
                    }
                    <span class="muted"> · @Level</span>
                </div>
            }
        </div>
        <div class="state-buttons">
            @* три статуса, как у автора статьи; «Исправлена», а следующий прогон её нашёл — снова «Активная» с ↺ *@
            @foreach (var (s, title, key) in Buttons)
            {
                var current = s == _card.State;
                <button class="btn state @Fmt.StateClass(s) @(current ? "current" : "")" disabled="@current" data-key="@key"
                        title="@(current ? "Текущий статус" : (s == ClashState.Fixed ? "Если следующий прогон её найдёт — снова «Активная»" : "Сделать «" + title + "»") + " · клавиша " + key)"
                        @onclick="() => SetState(s)">@(current ? "✓ " : "")@title <kbd>@key</kbd></button>
            }
        </div>
        <textarea rows="1" placeholder="Комментарий к статусу (Ctrl+Enter — без статуса)"
                  @bind="_comment" @bind:event="oninput" @onkeydown="CommentKey"></textarea>
        @if (!string.IsNullOrWhiteSpace(_comment))
        {
            <button class="btn small" @onclick="AddComment">Добавить комментарий</button>
        }
    </div>

    <div class="cc-body" @ref="_body">
    @* сведения — таблицей в два столбца; пустое (нет в отчётах Navisworks) не показывается *@
    <table class="facts2">
        @foreach (var row in FactRows)
        {
            <tr>
                @foreach (var f in row)
                {
                    <th>@f.Label</th>
                    <td title="@f.Title">@if (f.Dist) { <span class="dist">@f.Value</span> } else { @f.Value }</td>
                }
                @if (row.Count == 1) { <th></th><td></td> }
            </tr>
        }
    </table>

    <div class="cc-shot">
        @if (_card.Last?.HasImage == true)
        {
            <a href="snimok/@_card.Last.Id" target="_blank" title="Открыть снимок целиком"><img src="snimok/@_card.Last.Id" alt="Снимок коллизии" /></a>
        }
        else
        {
            <div class="no-shot">Снимка нет</div>
        }
    </div>

    @if (_card.Last != null)
    {
        for (var i = 0; i < _card.Last.Elements.Count; i++)
        {
            var e = _card.Last.Elements[i];
            var key = i;
            <div class="obj">
                <div class="obj-title">Объект @(i == 0 ? "А" : "Б")</div>
                <div class="obj-id">
                    <span>ID:</span>
                    @if (e.ElementId.HasValue)
                    {
                        <button class="copy-id" title="Скопировать номер — в Revit «Выбор по коду»" @onclick="() => Copy(key, e.ElementId.Value)">
                            <span class="mono">@e.ElementId</span> <span class="copy-icon">@(_copied == key ? "✓" : "⧉")</span>
                        </button>
                    }
                    else
                    {
                        <span class="muted">без номера</span>
                    }
                    @if (_copied == key) { <span class="small notice">скопировано</span> }
                </div>
                <div class="obj-path">@string.Join(" → ", new[] { e.Category, e.Family, e.Type }.Where(x => !string.IsNullOrEmpty(x)))</div>
                <div class="muted small">Уровень: @(e.Level ?? "—")@(string.IsNullOrEmpty(e.Name) ? "" : " · " + e.Name)</div>
                <div class="muted small">Файл: @(e.ModelFile ?? "—")</div>
            </div>
        }
    }

    <details class="cc-more" open="@(!Compact)">
        <summary>История (@_card.Events.Count)</summary>
        <ul class="history">
            @foreach (var ev in _card.Events)
            {
                <li class="ev-@ev.Kind">
                    <span class="when">@Fmt.Date(ev.Time)</span>
                    <span class="what">
                        @if (ev.NewState.HasValue && ev.Kind != EventKinds.Found)
                        {
                            <span>@Fmt.State(ev.OldState) → <span class="badge @Fmt.StateClass(ev.NewState.Value)">@Fmt.State(ev.NewState.Value)</span></span>
                        }
                        @if (ev.Text != null) { <span class="text">@ev.Text</span> }
                        @if (ev.Author != null) { <span class="muted">· @ev.Author</span> }
                    </span>
                </li>
            }
        </ul>
    </details>

    <details class="cc-more">
        <summary>В отчётах (@_card.Occurrences.Count)</summary>
        <table class="grid small">
            <thead><tr><th>Отчёт</th><th>Имя</th><th>Navisworks</th></tr></thead>
            <tbody>
                @foreach (var o in _card.Occurrences)
                {
                    <tr title="@o.ReportFile"><td>@Fmt.Date(o.ReportDate)</td><td>@(o.Name ?? "—")</td><td>@Fmt.Navis(o.NavisStatus)</td></tr>
                }
            </tbody>
        </table>
        @if (_card.Last != null)
        {
            <dl class="facts">
                <dt>Наборы</dt><dd>@_card.LeftSet ↔ @_card.RightSet</dd>
                @if (_card.Last.GroupName != null) { <dt>Группа</dt><dd>@_card.Last.GroupName</dd> }
                @if (_card.Last.Description != null) { <dt>Описание</dt><dd>@_card.Last.Description</dd> }
                <dt>Точка Navisworks, м</dt><dd>@Fmt.Meters(_card.Last.X, _card.Units); @Fmt.Meters(_card.Last.Y, _card.Units); @Fmt.Meters(_card.Last.Z, _card.Units)</dd>
            </dl>
        }
    </details>
    </div>
</div>

@code {
    [Parameter] public long ClashId { get; set; }
    /// <summary>Узкая — справа от списка; иначе — отдельная страница.</summary>
    [Parameter] public bool Compact { get; set; }
    /// <summary>Статус изменён (новый статус) или добавлен комментарий (null).</summary>
    [Parameter] public EventCallback<ClashState?> Changed { get; set; }

    private static readonly (ClashState State, string Title, string Key)[] Buttons =
    {
        (ClashState.Active, "Активная", "1"), (ClashState.Fixed, "Исправлена", "2"), (ClashState.Accepted, "Допущена", "3"),
    };

    /// <summary>Сведение карточки: подпись, значение, подсказка; Dist — значение как «расстояние» (красной плашкой).</summary>
    private sealed record Fact(string Label, string Value, string Title = null, bool Dist = false);

    /// <summary>Сведения по два в строке; расстояние, оси, статус Navisworks — только если они есть в отчёте.</summary>
    private List<List<Fact>> FactRows
    {
        get
        {
            var l = _card.Last;
            var facts = new List<Fact>
            {
                new("Проверка", _card.Type, _card.Type != _card.TestName ? "В Navisworks: " + _card.TestName : null),
                new("Блок", _card.Block == "" ? "—" : _card.Block),
                new("Дата", Fmt.Day(_card.LastSeen), "Впервые — " + Fmt.Day(_card.FirstSeen)),
                new("Встречалась", Fmt.Plural(Repeats, "раз", "раза", "раз") + ((l?.Points ?? 1) > 1 ? " · " + Fmt.Plural(l.Points, "точка", "точки", "точек") : ""),
                    (l?.Points ?? 1) > 1 ? "Navisworks нашёл несколько точек касания этих же элементов — это одна коллизия" : null),
            };
            if (l?.Distance != null) facts.Add(new("Расстояние", Fmt.MmAbs(l.Distance, _card.Units), null, true));
            if (!string.IsNullOrEmpty(l?.GridLocation)) facts.Add(new("Оси", l.GridLocation));
            if (l != null && l.NavisStatus != NavisworksStatus.New) facts.Add(new("Статус Navisworks", Fmt.Navis(l.NavisStatus)));
            var rows = new List<List<Fact>>();
            for (var i = 0; i < facts.Count; i += 2) rows.Add(facts.Skip(i).Take(2).ToList());
            return rows;
        }
    }

    private ElementReference _body;
    /// <summary>Открыта другая коллизия — карточку в начало (иначе новая открывалась прокрученной вниз).</summary>
    private bool _toTop;

    private ClashCard _card;
    private long _loadedId = -1;
    private string _comment;
    private int _copied = -1;

    /// <summary>В скольких прогонах (днях отчётов) встречалась.</summary>
    private int Repeats => _card.Occurrences.Select(o => o.ReportDate.Date).Distinct().Count();

    /// <summary>Уровень: у обоих элементов один — он; разные — «А / Б».</summary>
    private string Level
    {
        get
        {
            var levels = (_card.Last?.Elements ?? new List<ElementView>()).Select(e => e.Level).Where(l => !string.IsNullOrEmpty(l)).ToList();
            if (levels.Count == 0) return "—";
            return levels.Select(ClashRules.LevelKey).Distinct().Count() == 1 ? levels[0] : string.Join(" / ", levels);
        }
    }

    protected override void OnParametersSet()
    {
        if (ClashId == _loadedId) return;
        _toTop = _loadedId != -1;
        _loadedId = ClashId;
        _comment = null;
        _copied = -1;
        _card = Store.Card(ClashId);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_toTop) return;
        _toTop = false;
        await JS.InvokeVoidAsync("ras.top", _body);
    }

    /// <summary>Перечитать (после смены статуса из списка).</summary>
    public void Refresh() => _card = Store.Card(ClashId);

    private async Task SetState(ClashState state)
    {
        Store.SetState(new[] { ClashId }, state, _comment, null);
        _comment = null;
        _card = Store.Card(ClashId);
        await Changed.InvokeAsync(state);
    }

    private async Task AddComment()
    {
        if (string.IsNullOrWhiteSpace(_comment)) return;
        Store.AddComment(ClashId, _comment, null);
        _comment = null;
        _card = Store.Card(ClashId);
        await Changed.InvokeAsync(null);
    }

    private async Task CommentKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && e.CtrlKey) await AddComment();
    }

    private async Task Copy(int index, long id)
    {
        if (await JS.InvokeAsync<bool>("ras.copy", id.ToString()))
        {
            _copied = index;
            StateHasChanged();
            await Task.Delay(2000);
            if (_copied == index) _copied = -1;
        }
    }
}
