<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Сайт модуля RAS-Clash Analysis — единая база коллизий (PRINCIPLES.md, «Сайт модуля»; DECISIONS.md модуля).
    Не часть Revit: собирается и запускается отдельно — site.cmd в корне (tools\Site.ps1); revit.cmd его не собирает.
    Разбор отчётов — общий с модулем в Revit (..\Reports, исходниками, без копий).
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>RASv2.ClashAnalysis.Site</AssemblyName>
    <RootNamespace>RASv2.ClashAnalysis.Site</RootNamespace>
    <OutputPath>$(RasRoot)out\site\bin\</OutputPath>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- приложению нужны его библиотеки рядом (в Directory.Build.props выключено — для частей плагина в Revit) -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Reports\*.cs" LinkBase="Reports" />
    <Compile Include="..\..\..\Shared\RasPaths.cs" Link="Shared\RasPaths.cs" />
    <!-- регламент для BIM-специалистов — страница «Регламент» (Components\Pages\Reglament.razor): тот же файл, без копий -->
    <EmbeddedResource Include="..\Регламент выгрузки отчётов.md" LogicalName="Reglament.md" />
  </ItemGroup>

  <ItemGroup>
    <!-- база SQLite (решение разработчика 09.10.2026) -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.31" />
  </ItemGroup>

</Project>
