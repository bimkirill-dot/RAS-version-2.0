<Window x:Class="RASv2.BlockMirrorRotation.UI.ResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Отразить блок — итог" Width="760" Height="520" MinWidth="480" MinHeight="300"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}" FontFamily="Segoe UI" FontSize="13">
    <!-- итог «Отразить блок» (DECISIONS.md модуля, набросок 11.11.2026): сводка, список «вид → элемент → что не так»
         (щелчок — вид открыт, элемент выделен), журнал, «Закрыть». Окно немодальное — по Revit можно ходить.
         Кнопки, кисти — общие образцы ядра. -->
    <DockPanel Margin="20,16,20,16">
        <TextBlock x:Name="Summary" DockPanel.Dock="Top" TextWrapping="Wrap" />
        <TextBlock x:Name="Hint" DockPanel.Dock="Top" Margin="0,6,0,10" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"
                   Text="Щелчок по строке — откроется вид, элемент будет выделен." />
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="Закрыть" Style="{StaticResource PrimaryButton}" IsCancel="True" Click="Close_Click" />
            <Button x:Name="OpenLog" DockPanel.Dock="Left" Content="Открыть журнал" Click="OpenLog_Click" HorizontalAlignment="Left"
                    ToolTip="Всё, что сделано, — текстом: пригодится разработчику" />
        </DockPanel>
        <ListView x:Name="Rows" SelectionMode="Single" SelectionChanged="Rows_SelectionChanged"
                  Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}" BorderBrush="{DynamicResource Line}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Вид" Width="200">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding View}" TextTrimming="CharacterEllipsis" ToolTip="{Binding View}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Элемент" Width="170">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Element}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Element}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Что не так" Width="320">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Problem}" TextWrapping="Wrap" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
