<Window x:Class="RASv2.BlockMirrorRotation.UI.MirrorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Отразить блок" Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}" FontFamily="Segoe UI" FontSize="13">
    <!-- «Отразить блок» (DECISIONS.md модуля, набросок 11.11.2026; ось отражения — в окне Revit «Отразить проект», не здесь):
         что будет, галочка «Переименовать оси», «Выполнить» / «Отмена». Кнопки, кисти — общие образцы ядра. -->
    <StackPanel Margin="20,16,20,16">
        <TextBlock Text="Отразить блок" FontSize="15" FontWeight="SemiBold" />
        <TextBlock x:Name="Info" TextWrapping="Wrap" Margin="0,8,0,0" />
        <TextBlock TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource Muted}"
                   Text="Ось отражения выберите в окне Revit «Отразить проект» — оно откроется после «Выполнить». Отменить всё — Ctrl+Z дважды." />
        <CheckBox x:Name="Rename" IsChecked="True" Margin="0,14,0,0">
            <TextBlock TextWrapping="Wrap"
                       Text="Переименовать оси: вертикальные — цифрами слева направо, горизонтальные — буквами снизу вверх" />
        </CheckBox>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="Go" Content="Выполнить" Style="{StaticResource PrimaryButton}" IsDefault="True" Margin="0,0,8,0" Click="Go_Click" />
            <Button Content="Отмена" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
