<Window x:Class="RASv2.SheetManager.UI.SignAuditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Подпись — актуализация" Width="820" Height="560" MinWidth="620" MinHeight="380" ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}" FontFamily="Segoe UI" FontSize="13">
    <!-- «Актуализировать» (DECISIONS.md модуля): что не так в семействе подписей — списком; что плагин исправит сам —
         с галочкой, остальное — только сведения. Кнопки, поля, кисти — общие образцы ядра (подключаются до разметки). -->
    <Window.Resources>
        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Window.Resources>

    <Grid Margin="20,14,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="Heading" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10" />

        <Border Grid.Row="1" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="3">
            <ListBox x:Name="List" Background="{DynamicResource Bg}" BorderThickness="0" HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="B" Background="Transparent" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="B" Property="Background" Value="{DynamicResource Row}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid MinHeight="38" Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                      IsChecked="{Binding Checked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Fixable}"
                                      Visibility="{Binding CheckVisibility}" />
                            <TextBlock Grid.Column="1" Margin="8,0" VerticalAlignment="Center" Text="{Binding Name}" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                            <TextBlock Grid.Column="2" Margin="8,0" VerticalAlignment="Center" Text="{Binding Text}" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Info}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource Muted}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBox Grid.Column="3" Width="70" Height="30" Margin="8,0" Text="{Binding Initial, UpdateSourceTrigger=PropertyChanged}"
                                     Visibility="{Binding InitialVisibility}" ToolTip="Инициал: «Д» → «Фамилия Д.»" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <DockPanel Grid.Row="2" Margin="0,12,0,0" LastChildFill="False">
            <TextBlock x:Name="Note" DockPanel.Dock="Left" Style="{StaticResource MutedText}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="420" />
            <Button DockPanel.Dock="Right" Content="Закрыть" MinWidth="100" Margin="8,0,0,0" IsCancel="True" />
            <Button x:Name="FixButton" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" MinWidth="160" Click="Fix_Click" />
        </DockPanel>
    </Grid>
</Window>
