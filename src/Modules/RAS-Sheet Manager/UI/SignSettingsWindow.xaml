<Window x:Class="RASv2.SheetManager.UI.SignSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Подпись — настройки" Width="860" Height="600" MinWidth="720" MinHeight="460" ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}" FontFamily="Segoe UI" FontSize="13">
    <!-- Общие настройки кнопки «Подпись» (DECISIONS.md модуля): файл на сервере, Data\RAS-Sheet Manager. Разделы — слева
         (разработчик, 27.10.2026: «разделим на несколько категорий»), как настройки сайта коллизий. Кнопки, поля, кисти —
         общие образцы ядра (подключаются до разметки). Таблица и формула — в окне «Подпись», цвет — всегда синий. -->
    <Window.Resources>
        <Style x:Key="Title" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="Head" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,16,0,6" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,4" />
        </Style>
        <!-- подпись поля: переносится по словам, а не обрезается -->
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,12,4" />
        </Style>
        <Style x:Key="Num" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="64" />
            <Setter Property="HorizontalContentAlignment" Value="Right" />
        </Style>
        <Style x:Key="Unit" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8,0,12,0" />
        </Style>
        <!-- значение только для чтения: как поле, но без рамки ввода -->
        <Style x:Key="ReadOnlyValue" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,6" />
        </Style>
        <Style x:Key="Code" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Margin" Value="0,2,0,2" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <!-- раздел слева: выбранный — подсветка и полоса цвета акцента -->
        <Style x:Key="NavItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="B" Background="Transparent" Padding="12,9" BorderThickness="3,0,0,0" BorderBrush="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource Row}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource Row}" />
                                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- разделы -->
        <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
            <ListBox x:Name="Nav" Background="Transparent" BorderThickness="0" Margin="0,12,0,0" SelectionChanged="Nav_Changed"
                     ItemContainerStyle="{StaticResource NavItem}">
                <ListBoxItem Content="Папка и размер" />
                <ListBoxItem Content="Очистка" />
                <ListBoxItem Content="Регламент наименования" />
                <ListBoxItem Content="Формула" />
            </ListBox>
        </Border>

        <Grid Grid.Column="1" Margin="24,16,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer x:Name="Scroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
                <Grid>
                    <!-- ───── Папка и размер ───── -->
                    <StackPanel x:Name="SectionSize">
                        <TextBlock Style="{StaticResource Title}" Text="Папка и размер подписи" />
                        <TextBlock Style="{StaticResource Head}" Margin="0,0,0,6" Text="Папка с подписями по умолчанию" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Обзор…" Margin="8,3,0,3" Click="Browse_Click" />
                            <TextBox x:Name="Folder" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource Hint}" Text="Обычно — папка на сервере. В окне «Подпись» её можно сменить; запоминается последняя." />

                        <DockPanel Margin="0,18,0,6">
                            <Button DockPanel.Dock="Right" Content="Вернуть по умолчанию" Click="SizeDefaults_Click"
                                    ToolTip="Одной высоты 7 мм, ширина не больше 22 мм (и остальные размеры — как были изначально)" />
                            <TextBlock Text="Размер подписи — чтобы влезала в ячейку штампа" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </DockPanel>
                        <!-- ровные колонки: поля одно под другим (разработчик, 27.10.2026: «поля криво») -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="u1" />
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="36" />
                                <RowDefinition Height="36" />
                                <RowDefinition Height="36" />
                                <RowDefinition Height="36" />
                            </Grid.RowDefinitions>
                            <RadioButton x:Name="ModeHeight" GroupName="mode" Content="Одной высоты" />
                            <TextBox Grid.Column="1" x:Name="HeightBox" Style="{StaticResource Num}" ToolTip="Высота подписи, мм" />
                            <TextBlock Grid.Column="2" Style="{StaticResource Unit}" Text="мм, ширина не больше" />
                            <TextBox Grid.Column="3" x:Name="MaxWidthBox" Style="{StaticResource Num}" ToolTip="Наибольшая ширина, мм" />
                            <TextBlock Grid.Column="4" Style="{StaticResource Unit}" Text="мм" />

                            <RadioButton Grid.Row="1" x:Name="ModeWidth" GroupName="mode" Content="Одной ширины" />
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="WidthBox" Style="{StaticResource Num}" ToolTip="Ширина подписи, мм" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource Unit}" Text="мм, высота не больше" />
                            <TextBox Grid.Row="1" Grid.Column="3" x:Name="MaxHeightBox" Style="{StaticResource Num}" ToolTip="Наибольшая высота, мм" />
                            <TextBlock Grid.Row="1" Grid.Column="4" Style="{StaticResource Unit}" Text="мм" />

                            <RadioButton Grid.Row="2" x:Name="ModeBox" GroupName="mode" Content="Вписать в рамку" />
                            <TextBox Grid.Row="2" Grid.Column="1" x:Name="BoxWidth" Style="{StaticResource Num}" ToolTip="Ширина рамки, мм" />
                            <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource Unit}" Text="мм шириной," />
                            <TextBox Grid.Row="2" Grid.Column="3" x:Name="BoxHeight" Style="{StaticResource Num}" ToolTip="Высота рамки, мм" />
                            <TextBlock Grid.Row="2" Grid.Column="4" Style="{StaticResource Unit}" Text="мм высотой" />

                            <RadioButton Grid.Row="3" Grid.ColumnSpan="5" x:Name="ModeKeep" GroupName="mode" Content="Как в DWG — не менять размер" />
                        </Grid>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,4"
                                   Text="В рамку — пропорции подписи сохраняются. Центр подписи — в начале координат файла. Меняет размер только новых подписей; уже очищенные — «Обновить» в окне «Подпись»." />
                    </StackPanel>

                    <!-- ───── Очистка ───── -->
                    <StackPanel x:Name="SectionClean" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource Title}" Text="Очистка" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8"
                                   Text="Из исходного DWG остаются только линии подписи (тексты, размеры, точки — выбрасываются), линии упрощаются, подпись приводится к размеру из раздела «Папка и размер». Очищенные файлы лежат в папке «clean», к их имени добавляется «_clean»." />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="230" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource Label}" Text="Точность упрощения линий" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBox x:Name="Tolerance" Style="{StaticResource Num}" />
                                <TextBlock Style="{StaticResource Unit}" Text="мм" />
                            </StackPanel>
                            <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="Штриховки" />
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,6">
                                <RadioButton x:Name="HatchOutline" GroupName="hatch" Content="оставить контуром" Margin="0,0,18,0" />
                                <RadioButton x:Name="HatchDrop" GroupName="hatch" Content="убрать" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource Head}" Text="AutoCAD Core Console (accoreconsole.exe)" />
                        <TextBox x:Name="Acad" />
                        <TextBlock x:Name="AcadFound" Style="{StaticResource Hint}" />
                    </StackPanel>

                    <!-- ───── Регламент наименования (разработчик, 27.10.2026: «в самом плагине, в настройках») ───── -->
                    <StackPanel x:Name="SectionNaming" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource Title}" Text="Регламент наименования файлов подписей" />
                        <Border BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="3" Padding="14,10">
                            <StackPanel>
                                <TextBlock x:Name="RegulationPattern" Style="{StaticResource Code}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <ItemsControl x:Name="RegulationRules">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,3">
                                                <TextBlock DockPanel.Dock="Left" Text="•" Margin="0,0,8,0" />
                                                <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Примеры" Foreground="{DynamicResource Muted}" Margin="0,10,0,2" />
                                <ItemsControl x:Name="RegulationExamples">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Style="{StaticResource Code}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource Head}" Text="Что проверяет плагин" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="230" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource Label}" Text="Слово перед фамилией" />
                            <TextBlock Grid.Column="1" x:Name="FileWordText" Style="{StaticResource ReadOnlyValue}" />
                            <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="Со знаком «!» на месте отдела" />
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="LeadersText" Style="{StaticResource ReadOnlyValue}" />
                        </Grid>
                        <TextBlock Style="{StaticResource Hint}" Text="Регламент меняет только разработчик плагина." />
                    </StackPanel>


                    <!-- ───── Формула (разработчик, 27.10.2026: в окне «Подпись» — только таблица выбора) ───── -->
                    <StackPanel x:Name="SectionForm" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource Title}" Text="Формула подписи" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10"
                                   Text="У каждого человека — параметр Да/Нет с формулой: size_lookup(«таблица», «столбец», если фамилии нет, параметр с фамилией) = номер. Если на выбранную таблицу в семействе уже есть формулы, плагин берёт столбец, параметр и значение из них (у семейства ГИП — свои). Значения ниже — когда формул на таблицу ещё нет (новое семейство или новая таблица)." />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="230" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource Label}" Text="Номер — из столбца таблицы" />
                            <TextBox Grid.Column="1" x:Name="FormColumn" Width="180" HorizontalAlignment="Left" />
                            <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="Параметр с фамилией" />
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="FormKey" Width="180" HorizontalAlignment="Left" />
                            <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="Если фамилии нет в таблице" />
                            <TextBox Grid.Row="2" Grid.Column="1" x:Name="FormDefault" Style="{StaticResource Num}" HorizontalAlignment="Left" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- внизу: кто и когда менял, ошибка, кнопки -->
            <DockPanel Grid.Row="1" Margin="0,12,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button x:Name="SaveButton" Content="Сохранить" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Save_Click" />
                    <Button Content="Отмена" IsCancel="True" Margin="8,0,0,0" />
                </StackPanel>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock x:Name="Error" Foreground="{DynamicResource Error}" TextWrapping="Wrap" Margin="0,0,0,4" Visibility="Collapsed" />
                    <TextBlock x:Name="Changed" Style="{StaticResource Hint}" Margin="0" />
                </StackPanel>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
