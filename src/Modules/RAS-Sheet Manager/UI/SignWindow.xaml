<Window x:Class="RASv2.SheetManager.UI.SignWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Подпись" Width="1020" Height="700" MinWidth="820" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}" FontFamily="Segoe UI" FontSize="13">
    <!-- «Подпись» (DECISIONS.md модуля): папка → очистка новых → список с картинками → «Добавить». Цвета — кисти ядра (WindowTheme). -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Vis" />
        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource Field}" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="MinHeight" Value="26" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            <Setter Property="Margin" Value="0,0,16,0" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinWidth" Value="100" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Padding" Value="12,3" />
        </Style>
        <Style x:Key="Head" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid Margin="20,14,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- семейство и шестерёнка -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <Button x:Name="SettingsButton" DockPanel.Dock="Right" MinWidth="32" Width="32" Height="28" Padding="0" Click="Settings_Click"
                    ToolTip="Настройки: размер подписей, очистка, таблица выбора, AutoCAD">
                <Path Width="16" Height="16" Stretch="Uniform" Stroke="{DynamicResource Fg}" StrokeThickness="1.6" StrokeLineJoin="Round"
                      Data="M13.85 7.05 L14.50 4.09 L17.50 4.09 L18.15 7.05 L20.81 8.16 L23.35 6.52 L25.48 8.65 L23.84 11.19 L24.95 13.85 L27.91 14.50 L27.91 17.50 L24.95 18.15 L23.84 20.81 L25.48 23.35 L23.35 25.48 L20.81 23.84 L18.15 24.95 L17.50 27.91 L14.50 27.91 L13.85 24.95 L11.19 23.84 L8.65 25.48 L6.52 23.35 L8.16 20.81 L7.05 18.15 L4.09 17.50 L4.09 14.50 L7.05 13.85 L8.16 11.19 L6.52 8.65 L8.65 6.52 L11.19 8.16 Z M16 12 A4 4 0 1 0 16 20 A4 4 0 1 0 16 12 Z" />
            </Button>
            <TextBlock VerticalAlignment="Center">
                <Run Text="Семейство:" Foreground="{DynamicResource Muted}" />
                <Run x:Name="FamilyName" FontWeight="SemiBold" />
            </TextBlock>
        </DockPanel>

        <!-- папка -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource Label}" Text="Папка с подписями" />
            <TextBox x:Name="FolderBox" Grid.Column="1" KeyDown="Folder_KeyDown" LostKeyboardFocus="Folder_LostFocus" />
            <Button Grid.Column="2" Content="Обзор…" Margin="8,0,0,0" Click="Browse_Click" />
        </Grid>

        <!-- таблица выбора и масштаб -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource Label}" Text="Таблица выбора" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ComboBox x:Name="TableBox" MinWidth="320" MinHeight="26" SelectionChanged="Table_Changed" />
                <TextBox x:Name="NewTableBox" Width="260" Margin="8,0,0,0" Visibility="Collapsed" LostKeyboardFocus="NewTable_LostFocus"
                         ToolTip="Имя новой таблицы выбора — так она будет называться в семействе" />
            </StackPanel>
            <TextBlock Grid.Column="2" Style="{StaticResource Label}" Margin="16,0,8,0" Text="Масштаб" />
            <TextBox x:Name="ScaleBox" Grid.Column="3" Width="70" HorizontalContentAlignment="Right"
                     ToolTip="1 — как очищена; 1,5 — в полтора раза крупнее (например, в семействе подписей ГИПов). Запоминается для этого семейства." />
        </Grid>

        <!-- ход очистки и фильтр -->
        <DockPanel Grid.Row="3" Margin="0,2,0,6">
            <CheckBox x:Name="ShowAdded" DockPanel.Dock="Right" Checked="ShowAdded_Changed" Unchecked="ShowAdded_Changed" />
            <ProgressBar x:Name="Progress" Width="160" Height="6" Margin="0,0,10,0" Visibility="Collapsed" VerticalAlignment="Center" />
            <TextBlock x:Name="StatusText" Style="{StaticResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <!-- список подписей -->
        <Border Grid.Row="4" BorderBrush="{DynamicResource Line}" BorderThickness="1">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Background="{DynamicResource Row}" Height="28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36" />
                        <ColumnDefinition Width="136" />
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="130" />
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="AllBox" HorizontalAlignment="Center" Click="All_Click" ToolTip="Отметить все, которые можно" />
                    <TextBlock Grid.Column="1" Style="{StaticResource Head}" Text="Подпись" Margin="6,0" />
                    <TextBlock Grid.Column="2" Style="{StaticResource Head}" Text="Фамилия" Margin="6,0" />
                    <TextBlock Grid.Column="3" Style="{StaticResource Head}" Text="Номер" Margin="6,0" />
                    <TextBlock Grid.Column="4" Style="{StaticResource Head}" Text="Что будет" Margin="6,0" />
                    <TextBlock Grid.Column="5" Style="{StaticResource Head}" Text="Размер" Margin="6,0" />
                    <TextBlock Grid.Column="6" Style="{StaticResource Head}" Text="DWG: исходный → очищенный" Margin="6,0" TextWrapping="Wrap" FontSize="11" />
                </Grid>
                <ListBox x:Name="List" Background="{DynamicResource Bg}" BorderThickness="0" HorizontalContentAlignment="Stretch"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="B" Background="Transparent" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="B" Property="Background" Value="{DynamicResource Row}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="48" ToolTip="{Binding FileTip}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="136" />
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="130" />
                                </Grid.ColumnDefinitions>
                                <CheckBox HorizontalAlignment="Center" IsChecked="{Binding Checked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{Binding CanCheck}" />
                                <Border Grid.Column="1" Margin="6,4" Background="{DynamicResource Field}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="2">
                                    <Image Source="{Binding Preview}" Stretch="Uniform" Margin="4,2" />
                                </Border>
                                <TextBox Grid.Column="2" Margin="6,0" Text="{Binding Name, UpdateSourceTrigger=LostFocus}" />
                                <TextBlock Grid.Column="3" Margin="6,0" VerticalAlignment="Center" Text="{Binding NumberText}" Foreground="{DynamicResource Muted}" />
                                <TextBlock Grid.Column="4" Margin="6,0" VerticalAlignment="Center" Text="{Binding Status}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSkip}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Grid.Column="5" Margin="6,0" VerticalAlignment="Center" Text="{Binding SizeText}" />
                                <TextBlock Grid.Column="6" Margin="6,0" VerticalAlignment="Center" Text="{Binding BytesText}" Foreground="{DynamicResource Muted}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- точка вставки, таблицы, кнопки -->
        <Grid Grid.Row="5" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="AnchorText" />
                <StackPanel x:Name="PointChoice" Orientation="Horizontal" Visibility="Collapsed">
                    <TextBlock Text="Центр подписи:" Margin="0,0,10,0" />
                    <RadioButton x:Name="PointOrigin" GroupName="point" Content="в начало координат семейства" IsChecked="True" />
                    <RadioButton x:Name="PointPick" GroupName="point" Content="указать на виде после «Добавить»" />
                </StackPanel>
                <CheckBox x:Name="RemoveUnused" Margin="0,6,0,0" Visibility="Collapsed" />
                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Error}" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button x:Name="AddButton" IsDefault="True" Click="Add_Click" FontWeight="SemiBold" />
                <Button Content="Отмена" IsCancel="True" Margin="8,0,0,0" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
