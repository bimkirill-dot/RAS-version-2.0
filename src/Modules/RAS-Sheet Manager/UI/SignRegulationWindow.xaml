<Window x:Class="RASv2.SheetManager.UI.SignRegulationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Регламент наименования подписей" Width="620" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}" FontFamily="Segoe UI" FontSize="13">
    <!-- Регламент наименования файлов подписей (DECISIONS.md модуля); слово, отделы и «!» — из настроек. Цвета — кисти ядра. -->
    <Window.Resources>
        <Style x:Key="Head" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,14,0,6" />
        </Style>
        <Style x:Key="Item" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,2" />
        </Style>
        <Style x:Key="Code" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Margin" Value="16,2,0,2" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="20,10,20,18">
        <TextBlock Style="{StaticResource Head}" Margin="0,4,0,6" Text="Как назвать файл подписи" />
        <TextBlock x:Name="Pattern" Style="{StaticResource Code}" FontSize="15" FontWeight="SemiBold" />

        <TextBlock Style="{StaticResource Head}" Text="Правила" />
        <TextBlock x:Name="Rules" Style="{StaticResource Item}" />

        <TextBlock Style="{StaticResource Head}" Text="Примеры" />
        <StackPanel x:Name="Examples" />

        <TextBlock Style="{StaticResource Head}" Text="Если назван не так" />
        <TextBlock Style="{StaticResource Item}"
                   Text="Подпись, названная не по регламенту, в семейство не добавляется — в списке будет написано, что не так. Переименуйте файл в папке с подписями и откройте папку в окне «Подпись» заново." />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Закрыть" MinWidth="100" Padding="12,4" IsCancel="True" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
