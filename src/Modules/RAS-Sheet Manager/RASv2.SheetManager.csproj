<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Модуль «RAS-Sheet Manager» — инструменты для листов (панель «Менеджер листов»). Сейчас — одна кнопка «Подпись»:
    очистка DWG-подписей (AutoCAD Core Console) и добавление их в семейство подписей (MODULE.md, DECISIONS.md модуля).
    Зависит только от ядра.
  -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <AssemblyName>RASv2.SheetManager</AssemblyName>
    <RootNamespace>RASv2.SheetManager</RootNamespace>
    <UseRevitApi>true</UseRevitApi>
    <UseWPF>true</UseWPF>
    <!-- окно выбора папки (FolderBrowserDialog) — одно для .NET Framework 4.8 и .NET 8 -->
    <UseWindowsForms>true</UseWindowsForms>
    <OutputPath>$(RasOut)parts\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- ядро лежит в той же папке сборки — отдельная копия рядом с модулем не нужна -->
    <ProjectReference Include="..\..\Core\RASv2.Core.csproj" Private="false" />
    <!-- иконки кнопок: Icons\<имя>32.png и Icons\<имя>16.png, вшиты в сборку (RibbonIcons в ядре) -->
    <None Remove="Icons\*.png" />
    <EmbeddedResource Include="Icons\*.png" LogicalName="Icons.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
