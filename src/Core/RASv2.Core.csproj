<Project Sdk="Microsoft.NET.Sdk">

  <!-- Ядро: общее для всех модулей (PRINCIPLES.md, раздел 5). Загружается загрузчиком из локальной копии сборки. -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <AssemblyName>RASv2.Core</AssemblyName>
    <RootNamespace>RASv2.Core</RootNamespace>
    <UseRevitApi>true</UseRevitApi>
    <!-- картинки иконок кнопок (RibbonIcons) -->
    <UseWPF>true</UseWPF>
    <OutputPath>$(RasOut)parts\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Shared\RasPaths.cs" Link="Shared\RasPaths.cs" />
    <!-- лента Revit изнутри (AdWindows.dll — часть самого Revit, с плагином не копируется): кнопка без подписи -->
    <Reference Include="AdWindows">
      <HintPath>$(RevitDir)\AdWindows.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- раскладка кнопок по панелям вкладки (RibbonLayout) — едет в сборку рядом с ядром -->
    <None Update="ribbon.txt" CopyToOutputDirectory="PreserveNewest" />
    <!-- режимы модулей у всех (ModuleSwitches) — тоже в сборке, как раскладка (разработчик, 20.10.2026) -->
    <None Update="modules.txt" CopyToOutputDirectory="PreserveNewest" />
    <!-- иконки кнопок: Icons\<имя>32.png и Icons\<имя>16.png, вшиты в сборку (RibbonIcons в ядре) -->
    <None Remove="Icons\*.png" />
    <EmbeddedResource Include="Icons\*.png" LogicalName="Icons.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
