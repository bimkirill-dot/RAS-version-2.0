<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Проверки логики без Revit: обычная консольная программа, без сторонних библиотек.
    Собирается и запускается под обе платформы (Revit 2023 и 2026). Логику берёт из исходников модулей (Compile Include),
    чтобы не тянуть Revit API.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>RASv2.Tests</AssemblyName>
    <RootNamespace>RASv2.Tests</RootNamespace>
    <OutputPath>$(RasOut)tests\</OutputPath>
    <MhDir>..\..\src\Modules\RAS-Model History\</MhDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\Loader\BuildResolver.cs" Link="Loader\BuildResolver.cs" />
    <Compile Include="..\..\src\Core\RibbonLayout.cs" Link="Core\RibbonLayout.cs" />
    <Compile Include="..\..\src\Core\ModuleSwitches.cs" Link="Core\ModuleSwitches.cs" />
    <Compile Include="..\..\src\Core\PluginFile.cs" Link="Core\PluginFile.cs" />
    <Compile Include="..\..\src\Core\ErrorFuse.cs" Link="Core\ErrorFuse.cs" />
    <Compile Include="..\..\src\Core\WhatsNew.cs" Link="Core\WhatsNew.cs" />
  </ItemGroup>

  <!-- RAS-Clash Analysis: разбор отчётов Navisworks — без Revit, под обе версии -->
  <ItemGroup>
    <Compile Include="..\..\src\Modules\RAS-Clash Analysis\Reports\*.cs" LinkBase="ClashAnalysis" />
    <Compile Include="..\..\src\Modules\RAS-Clash Analysis\Site\Logic\*.cs" LinkBase="ClashAnalysis\Site" />
    <Compile Include="..\..\src\Modules\RAS-Clash Analysis\Site\Data\Models.cs" Link="ClashAnalysis\Site\Models.cs" />
    <!-- мост в Revit: логика без Revit API -->
    <Compile Include="..\..\src\Modules\RAS-Clash Analysis\Revit\Logic\*.cs" LinkBase="ClashAnalysis\Revit" />
    <Compile Include="..\..\src\Modules\RAS-Clash Analysis\Revit\Bridge\BridgeMessages.cs" Link="ClashAnalysis\Revit\BridgeMessages.cs" />
    <Compile Include="..\..\src\Modules\RAS-Clash Analysis\Navisworks\Logic\*.cs" LinkBase="ClashAnalysis\Navisworks" />
  </ItemGroup>

  <!-- RAS-Sheet Manager: очистка подписей и план добавления — без Revit и AutoCAD, под обе версии -->
  <ItemGroup>
    <Compile Include="..\..\src\Modules\RAS-Sheet Manager\Logic\*.cs" LinkBase="SheetManager" />
  </ItemGroup>

  <!-- логика RAS-Model History: модуль пока только для Revit 2026 (.NET 8) -->
  <ItemGroup Condition="'$(RevitVersion)' == '2026'">
    <Compile Include="$(MhDir)Tracking\ChangeRecord.cs" Link="ModelHistory\ChangeRecord.cs" />
    <Compile Include="$(MhDir)Tracking\SyncStatus.cs" Link="ModelHistory\SyncStatus.cs" />
    <Compile Include="$(MhDir)Tracking\JournalAudit.cs" Link="ModelHistory\JournalAudit.cs" />
    <Compile Include="$(MhDir)Tracking\JournalDedup.cs" Link="ModelHistory\JournalDedup.cs" />
    <Compile Include="$(MhDir)Tracking\PeriodDiff.cs" Link="ModelHistory\PeriodDiff.cs" />
    <Compile Include="$(MhDir)Tracking\UndoPairs.cs" Link="ModelHistory\UndoPairs.cs" />
    <Compile Include="$(MhDir)Tracking\EmployeeIndex.cs" Link="ModelHistory\EmployeeIndex.cs" />
    <Compile Include="$(MhDir)UI\RecordFilter.cs" Link="ModelHistory\RecordFilter.cs" />
    <Compile Include="$(MhDir)Storage\LegacyFolders.cs" Link="ModelHistory\LegacyFolders.cs" />
    <Compile Include="$(MhDir)Tracking\ElementInfo.cs" Link="ModelHistory\ElementInfo.cs" />
    <Compile Include="$(MhDir)Tracking\DeletionCascade.cs" Link="ModelHistory\DeletionCascade.cs" />
    <Compile Include="$(MhDir)Tracking\UnknownElementResolver.cs" Link="ModelHistory\UnknownElementResolver.cs" />
    <Compile Include="$(MhDir)Tracking\ElementInfoCache.cs" Link="ModelHistory\ElementInfoCache.cs" />
    <Compile Include="$(MhDir)UI\WarmupProgress.cs" Link="ModelHistory\WarmupProgress.cs" />
    <Compile Include="$(MhDir)Tracking\StorageReplacement.cs" Link="ModelHistory\StorageReplacement.cs" />
    <Compile Include="$(MhDir)Tracking\JournalLinks.cs" Link="ModelHistory\JournalLinks.cs" />
    <Compile Include="$(MhDir)Storage\SpySettings.cs" Link="ModelHistory\SpySettings.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(RevitVersion)' != '2026'">
    <Compile Remove="ModelHistoryTests.cs" />
    <Compile Remove="ModelHistoryStubs.cs" />
    <Compile Remove="ModelHistoryElementTests.cs" />
    <Compile Remove="ModelHistoryRestoreTests.cs" />
    <Compile Remove="ModelHistorySettingsTests.cs" />
  </ItemGroup>

</Project>
