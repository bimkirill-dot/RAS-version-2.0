<Project>
  <!--
    Общее для всех проектов RAS v. 2.0 (PRINCIPLES.md, раздел 9).
    Версия Revit выбирается при сборке: -p:RevitVersion=2023 (.NET Framework 4.8) или 2026 (.NET 8).
    Сборку под обе версии делают build.cmd и publish.cmd (tools\Release.ps1).
  -->
  <PropertyGroup>
    <RevitVersion Condition="'$(RevitVersion)' == ''">2026</RevitVersion>
    <RasRoot>$(MSBuildThisFileDirectory)</RasRoot>
    <!-- куда складываются результаты: out\bin\<год>\loader | parts | tests -->
    <RasOut>$(RasRoot)out\bin\$(RevitVersion)\</RasOut>
    <!-- промежуточные файлы — отдельно для каждой версии Revit, иначе сборки 2023 и 2026 мешают друг другу -->
    <BaseIntermediateOutputPath>$(MSBuildProjectDirectory)\obj\$(RevitVersion)\</BaseIntermediateOutputPath>
    <!-- служебные файлы другой версии (obj\2023 при сборке 2026 и наоборот) — не исходники -->
    <DefaultItemExcludes>$(DefaultItemExcludes);obj\**;bin\**</DefaultItemExcludes>

    <TargetFramework Condition="'$(RevitVersion)' == '2023'">net48</TargetFramework>
    <TargetFramework Condition="'$(RevitVersion)' == '2026'">net8.0-windows</TargetFramework>
    <DefineConstants>$(DefineConstants);REVIT$(RevitVersion)</DefineConstants>
    <RevitDir Condition="'$(RevitDir)' == ''">C:\Program Files\Autodesk\Revit $(RevitVersion)</RevitDir>

    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <SatelliteResourceLanguages>ru</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Company>RAS Group</Company>
    <Product>RAS v. 2.0</Product>
    <Version>2.0.0</Version>
    <!-- коммит git в сборку не пишем: иначе загрузчик «менялся» бы с каждым коммитом и просил переустановки;
         коммит сборки записан в build.txt (tools\Release.ps1) -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- MSB3277 — конфликт версий внутри ссылок самого Revit API 2026; на работу не влияет и заслоняет настоящие предупреждения -->
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3277</MSBuildWarningsAsMessages>
  </PropertyGroup>

  <!--
    Revit API — только проектам с UseRevitApi=true. Свойство из проекта здесь видно: MSBuild вычисляет
    элементы после всех свойств. Private=false — Revit API берётся из самого Revit, с плагином не копируется.
  -->
  <ItemGroup Condition="'$(UseRevitApi)' == 'true'">
    <Reference Include="RevitAPI">
      <HintPath>$(RevitDir)\RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(RevitDir)\RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
